diff --git a/tests/test_audit.py b/tests/test_audit.py
new file mode 100644
index 0000000..9163cd5
--- /dev/null
+++ b/tests/test_audit.py
@@ -0,0 +1,15 @@
+from adminhub import audit, users
+
+
+def test_record_appends_an_entry(conn):
+    audit.record(conn, "root", "deactivate", 3)
+
+    row = conn.execute("SELECT actor, action, target_id FROM audit_log").fetchone()
+    assert tuple(row) == ("root", "deactivate", 3)
+
+
+def test_bulk_deactivation_is_audited_per_user(conn):
+    users.deactivate_users(conn, [1, 2], actor="root")
+
+    rows = conn.execute("SELECT target_id FROM audit_log ORDER BY target_id").fetchall()
+    assert [row["target_id"] for row in rows] == [1, 2]
