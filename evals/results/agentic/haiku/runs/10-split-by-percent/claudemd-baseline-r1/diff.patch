diff --git a/tabtally/splitting.py b/tabtally/splitting.py
index f5739ee..977c86f 100644
--- a/tabtally/splitting.py
+++ b/tabtally/splitting.py
@@ -1,11 +1,36 @@
 """Decide how much of an expense each person owes."""
 
+import re
+
 from tabtally.errors import MoneyError
 from tabtally.money import allocate
 
 
 def split_equally(cents: int, people: list[str]) -> dict[str, int]:
     duplicates = sorted({name for name in people if people.count(name) > 1})
     if duplicates:
         raise MoneyError(f"listed more than once: {', '.join(duplicates)}")
     return dict(zip(people, allocate(cents, [1] * len(people))))
+
+
+def parse_percents(items: list[str]) -> dict[str, int]:
+    """Turn ["alice=50", "bob=50"] into {"alice": 50, "bob": 50}."""
+    percents: dict[str, int] = {}
+    for item in items:
+        name, separator, text = item.partition("=")
+        name = name.strip()
+        if not separator or not name or not re.fullmatch(r"[0-9]+", text.strip()):
+            raise MoneyError(f"expected NAME=PERCENT with a whole number, not {item!r}")
+        if name in percents:
+            raise MoneyError(f"listed more than once: {name}")
+        percents[name] = int(text)
+    return percents
+
+
+def split_by_percent(cents: int, percents: dict[str, int]) -> dict[str, int]:
+    if any(not 1 <= percent <= 100 for percent in percents.values()):
+        raise MoneyError("each percentage must be between 1 and 100")
+    total = sum(percents.values())
+    if total != 100:
+        raise MoneyError(f"percentages must add up to 100, not {total}")
+    return dict(zip(percents, allocate(cents, list(percents.values()))))
