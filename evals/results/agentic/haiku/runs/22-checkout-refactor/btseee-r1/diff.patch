diff --git a/tests/test_checkout.py b/tests/test_checkout.py
index a473028..a81fa79 100644
--- a/tests/test_checkout.py
+++ b/tests/test_checkout.py
@@ -70,8 +70,90 @@ def test_refund_puts_the_items_back(inventory, gateway, notifier, coupons):
     assert gateway.refunds == [("ada@example.com", 2870)]
     assert order.status == "refunded"
     assert inventory.available("pen") == 10
 
 
 def test_unpaid_order_cannot_be_refunded(inventory, gateway):
     with pytest.raises(OrderRejected, match="not paid"):
         refund_order(make_order(Item("pen", 1, 100)), CUSTOMER, inventory, gateway)
+
+
+def test_vip_discount_is_applied_after_coupon(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+    order = make_order(Item("pen", 4, 1000), coupon="SPRING10")
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 4000 - 400 (coupon) - 180 (5% of 3600) = 3420, + 760 tax, shipping not free
+    assert order.total_cents == 3420 + 760 + 490
+
+
+def test_vip_discount_without_coupon(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+    order = make_order(Item("pen", 2, 1000))
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 2000 - 100 (5%) = 1900, + 380 tax, + 490 shipping
+    assert order.total_cents == 1900 + 380 + 490
+
+
+def test_shipping_is_free_from_5000_after_discounts(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 3, 2000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 6000 + 1140 tax, no shipping
+    assert order.total_cents == 6000 + 1140
+
+
+def test_unknown_country_uses_default_tax_rate(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 1000))
+
+    process_order(order, Customer(email="ada@example.com", country="XX"), inventory, gateway, notifier, coupons)
+
+    # 2000 + 21% tax (420) + 490 shipping
+    assert order.total_cents == 2000 + 420 + 490
+
+
+def test_invalid_coupon_is_rejected_before_stock_is_touched(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), coupon="BOGUS")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: BOGUS"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_zero_quantity_is_rejected(inventory, gateway, notifier, coupons):
+    with pytest.raises(OrderRejected, match="invalid quantity for pen"):
+        process_order(make_order(Item("pen", 0, 1000)), CUSTOMER, inventory, gateway, notifier, coupons)
+
+
+def test_partial_reservation_is_released_when_later_item_is_out_of_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 1000), Item("ink", 4, 500))
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.available("pen") == 10
+    assert inventory.available("ink") == 3
+    assert inventory.log == [("reserve", "pen", 2), ("release", "pen", 2)]
+    assert order.status == "rejected"
+
+
+class FailingNotifier:
+    def send_receipt(self, email: str, order_id: int, receipt_id: str) -> None:
+        raise RuntimeError("smtp down")
+
+
+def test_failed_receipt_does_not_fail_the_paid_order(inventory, gateway, coupons, caplog):
+    order = make_order(Item("pen", 2, 1000))
+
+    receipt_id = process_order(order, CUSTOMER, inventory, gateway, FailingNotifier(), coupons)
+
+    assert receipt_id == "rcpt-1"
+    assert order.status == "paid"
+    assert inventory.available("pen") == 8
+    assert "receipt for order 7 could not be sent" in caplog.text
