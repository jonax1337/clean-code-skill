 def test_unpaid_order_cannot_be_refunded(inventory, gateway):
     with pytest.raises(OrderRejected, match="not paid"):
         refund_order(make_order(Item("pen", 1, 100)), CUSTOMER, inventory, gateway)
+
+
+# Characterization tests: pin the current behavior of the branches above so refactoring cannot change it.
+
+
+def test_non_positive_quantity_is_rejected_before_any_stock_is_touched(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), Item("ink", 0, 100))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == []
+    assert gateway.charges == []
+    assert order.status == "new"
+
+
+def test_unknown_coupon_is_rejected_before_any_stock_is_touched(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), coupon="NOPE")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: NOPE"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == []
+    assert gateway.charges == []
+    assert order.status == "new"
+
+
+def test_vip_discount_is_applied_after_the_coupon_and_before_shipping(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+    order = make_order(Item("pen", 2, 1000))
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 2000 - 5% VIP = 1900, tax 19% of the undiscounted 2000 = 380, shipping 490 (below 5000)
+    assert order.total_cents == 1900 + 380 + 490
+
+
+def test_vip_discount_is_taken_on_the_already_couponed_price(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+    order = make_order(Item("pen", 4, 1000), coupon="SPRING10")
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 4000 - 10% = 3600, then 5% of 3600 = 180 -> 3420; tax 760; shipping 490
+    assert order.total_cents == 3420 + 760 + 490
+
+
+def test_shipping_is_free_from_5000_cents_after_discounts(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # exactly 5000 qualifies; tax 950
+    assert order.total_cents == 5000 + 950
+
+
+def test_shipping_is_charged_when_the_discount_drops_the_total_below_5000(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000), coupon="SPRING10")
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 5000 - 10% = 4500 (< 5000, so shipping applies); tax 950 on 5000
+    assert order.total_cents == 4500 + 950 + 490
+
+
+def test_tax_is_rounded_per_line(inventory, gateway, notifier, coupons):
+    # 3 cents * 19% = 0.57 -> 1 per line; the two lines together would give 1.14 -> 1
+    order = make_order(Item("pen", 1, 3), Item("ink", 1, 3))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 6 + 2 + 490
+
+
+def test_out_of_stock_on_a_later_item_releases_the_earlier_reservations(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 1000), Item("ink", 4, 500))
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.available("pen") == 10
+    assert inventory.available("ink") == 3
+    assert inventory.log == [("reserve", "pen", 2), ("release", "pen", 2)]
+    assert gateway.charges == []
+
+
+def test_failed_receipt_does_not_fail_a_paid_order(inventory, gateway, coupons):
+    class BrokenNotifier:
+        def send_receipt(self, email: str, order_id: int, receipt_id: str) -> None:
+            raise RuntimeError("smtp down")
+
+    order = make_order(Item("pen", 2, 1000))
+
+    receipt_id = process_order(order, CUSTOMER, inventory, gateway, BrokenNotifier(), coupons)
+
+    assert receipt_id == "rcpt-1"
+    assert (order.status, order.total_cents) == ("paid", 2870)
+    assert gateway.charges == [("ada@example.com", 2870)]
+    assert inventory.available("pen") == 8
+
+
+def test_paid_order_redeems_its_coupon_once(inventory, gateway, notifier):
+    coupons = CouponBook({"ONCE": (10, 1)})
