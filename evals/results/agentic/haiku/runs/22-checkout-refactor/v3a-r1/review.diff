+# Characterization tests: pin down current pricing and error behavior of process_order.
+
+class FailingNotifier:
+    def send_receipt(self, email: str, order_id: int, receipt_id: str) -> None:
+        raise RuntimeError("smtp down")
+
+
+def test_vip_discount_applies_after_coupon(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+    order = make_order(Item("pen", 4, 1000), coupon="SPRING10")
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # subtotal 4000, coupon 400, vip 5% of 3600 = 180, tax 760, shipping 490
+    assert order.total_cents == 4000 - 580 + 760 + 490
+
+
+def test_free_shipping_starts_at_5000_after_discount(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # subtotal 5000 reaches the threshold, so no shipping; tax 950
+    assert order.total_cents == 5000 + 950
+
+
+def test_tax_is_rounded_per_line(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 333), Item("pen", 1, 333))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 63.27 rounds to 63 per line (126 total); the combined line would give 127
+    assert order.total_cents == 666 + 126 + 490
+
+
