 def test_unpaid_order_cannot_be_refunded(inventory, gateway):
     with pytest.raises(OrderRejected, match="not paid"):
         refund_order(make_order(Item("pen", 1, 100)), CUSTOMER, inventory, gateway)
+
+
+# Characterization tests: pin current checkout behavior before refactoring.
+
+def test_successful_checkout_reserves_then_commits_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 1000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [("reserve", "pen", 2), ("commit", "pen", 2)]
+
+
+def test_order_with_zero_quantity_is_rejected(inventory, gateway, notifier, coupons):
+    with pytest.raises(OrderRejected, match="invalid quantity for pen"):
+        process_order(make_order(Item("pen", 0, 1000)), CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert gateway.charges == []
+
+
+def test_unknown_coupon_is_rejected_before_stock_is_touched(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), coupon="BOGUS")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: BOGUS"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_vip_customer_gets_five_percent_off_after_coupon(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+    order = make_order(Item("pen", 4, 1000))
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 4000 - 5% VIP = 3800, + 760 tax, shipping is not free below 5000
+    assert order.total_cents == 3800 + 760 + 490
+
+
+def test_order_from_free_shipping_threshold_pays_no_shipping(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 3, 2000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 6000 + 1140 tax, no shipping
+    assert order.total_cents == 6000 + 1140
+
+
+def test_tax_is_rounded_per_line_not_on_the_total(inventory, gateway, notifier, coupons):
+    # Switzerland: 8.1%. Each 5-cent line taxes to 0.405 -> 0; rounding the 10-cent total would give 1.
+    swiss = Customer(email="ada@example.com", country="CH")
+    order = make_order(Item("pen", 1, 5), Item("ink", 1, 5))
+
+    process_order(order, swiss, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 10 + 0 + 490
+
+
+def test_unknown_country_uses_default_tax_rate(inventory, gateway, notifier, coupons):
+    us = Customer(email="ada@example.com", country="US")
+    order = make_order(Item("pen", 1, 1000))
+
+    process_order(order, us, inventory, gateway, notifier, coupons)
+
+    # 1000 + 21% tax (210) + 490 shipping
+    assert order.total_cents == 1000 + 210 + 490
+
+
+def test_out_of_stock_releases_stock_reserved_so_far(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 1000), Item("ink", 4, 500))
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [("reserve", "pen", 2), ("release", "pen", 2)]
+    assert inventory.available("pen") == 10
+
+
+def test_declined_payment_releases_stock_in_reverse_of_reserve(inventory, notifier, coupons):
+    order = make_order(Item("pen", 3, 1000))
+
+    with pytest.raises(OrderRejected, match="payment declined"):
+        process_order(order, CUSTOMER, inventory, FakeGateway(decline=True), notifier, coupons)
+
+    assert inventory.log == [("reserve", "pen", 3), ("release", "pen", 3)]
+
+
+def test_paid_order_still_succeeds_when_receipt_cannot_be_sent(inventory, gateway, coupons):
+    class BrokenNotifier:
+        def send_receipt(self, email: str, order_id: int, receipt_id: str) -> None:
+            raise RuntimeError("smtp down")
+
+    order = make_order(Item("pen", 2, 1000))
+
+    receipt_id = process_order(order, CUSTOMER, inventory, gateway, BrokenNotifier(), coupons)
+
+    assert receipt_id == "rcpt-1"
+    assert order.status == "paid"
