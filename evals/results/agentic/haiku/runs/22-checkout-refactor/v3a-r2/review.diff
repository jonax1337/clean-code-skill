+# Characterization tests: pin current behavior of the branches above.
+
+
+class FailingNotifier:
+    def send_receipt(self, email: str, order_id: int, receipt_id: str) -> None:
+        raise RuntimeError("smtp down")
+
+
+def test_zero_quantity_is_rejected_before_anything_happens(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 0, 1000))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for pen"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert gateway.charges == []
+    assert inventory.log == []
+
+
+def test_unknown_coupon_is_rejected_before_reserving_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), coupon="NOPE")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: NOPE"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_vip_customer_gets_five_percent_off(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 4, 1000))
+    vip = Customer(email="ada@example.com", vip=True)
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 4000 - 5% = 3800, + 760 tax, shipping is not free below 5000
+    assert order.total_cents == 3800 + 760 + 490
+
+
+def test_vip_discount_stacks_after_coupon(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 4, 1000), coupon="SPRING10")
+    vip = Customer(email="ada@example.com", vip=True)
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # coupon 400, then VIP 5% of 3600 = 180, total discount 580
+    assert order.total_cents == (4000 - 580) + 760 + 490
+
+
+def test_shipping_is_free_at_exactly_fifty_euros_after_discount(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 5000 + 950 tax + 0 shipping
+    assert order.total_cents == 5000 + 950
+
+
+def test_tax_is_rounded_per_line(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 3), Item("ink", 1, 3))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 19% of 3 is 0.57 -> 1 per line, so 2 in total (a single rounding would give 1)
+    assert order.total_cents == 6 + 2 + 490
+
+
+def test_partial_reservation_is_released_when_later_item_is_out_of_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 1000), Item("ink", 4, 500))
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.available("pen") == 10
+    assert inventory.available("ink") == 3
+    assert inventory.log[-1] == ("release", "pen", 2)
+
+
+def test_declined_payment_does_not_redeem_the_coupon(inventory, notifier, coupons):
