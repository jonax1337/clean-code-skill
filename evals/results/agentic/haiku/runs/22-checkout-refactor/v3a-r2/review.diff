+def _check_items(order: Order) -> None:
     if not order.items:
         raise OrderRejected("order has no items")
     for item in order.items:
         if item.quantity <= 0:
             raise OrderRejected(f"invalid quantity for {item.sku}")
 
+
+def _price_order(order: Order, customer: Customer, coupons: CouponBook) -> _Amounts:
+    subtotal, tax = _subtotal_and_tax(order.items, customer.country)
+    discount = _discount_cents(order, customer, coupons, subtotal)
+    shipping = 0 if subtotal - discount >= FREE_SHIPPING_FROM_CENTS else SHIPPING_CENTS
+    return _Amounts(subtotal, tax, discount, shipping)
+
