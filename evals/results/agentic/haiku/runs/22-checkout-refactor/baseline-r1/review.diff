+def _check_items(order: Order) -> None:
     if not order.items:
         raise OrderRejected("order has no items")
     for item in order.items:
         if item.quantity <= 0:
             raise OrderRejected(f"invalid quantity for {item.sku}")
 
+
+def _price_order(order: Order, customer: Customer, coupons: CouponBook) -> _Price:
+    subtotal, tax = _subtotal_and_tax(order.items, customer.country)
+    discount = _discount(order, customer, subtotal, coupons)
+    shipping = _shipping(subtotal - discount)
+    return _Price(subtotal=subtotal, tax=tax, discount=discount, shipping=shipping)
