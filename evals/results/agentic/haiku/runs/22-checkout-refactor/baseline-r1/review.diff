+# Characterization tests: they pin current behaviour of process_order's branches.
+
+def test_vip_discount_applies_after_coupon_and_before_shipping(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+    order = make_order(Item("pen", 2, 1000))
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 2000 - 5% VIP = 1900 (still under free shipping), + 380 tax, + 490 shipping
+    assert order.total_cents == 1900 + 380 + 490
+
+
+def test_shipping_is_free_from_threshold(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 3, 2000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 6000 + 1140 tax, free shipping
+    assert order.total_cents == 6000 + 1140
+
+
+def test_non_positive_quantity_is_rejected_before_any_side_effect(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), Item("ink", 0, 500))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == []
+    assert gateway.charges == []
+    assert order.status == "new"
+
+
+def test_invalid_coupon_is_rejected_before_reserving_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), coupon="NOPE")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: NOPE"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_partial_out_of_stock_releases_earlier_reservations(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 1000), Item("ink", 4, 500))
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.available("pen") == 10
+    assert inventory.available("ink") == 3
+    assert order.status == "rejected"
+    assert gateway.charges == []
+
+
+def test_failed_receipt_does_not_fail_the_order(inventory, gateway, coupons):
+    class BrokenNotifier:
+        def send_receipt(self, email, order_id, receipt_id):
+            raise RuntimeError("smtp down")
+
+    order = make_order(Item("pen", 2, 1000))
+
+    receipt_id = process_order(order, CUSTOMER, inventory, gateway, BrokenNotifier(), coupons)
+
+    assert receipt_id == "rcpt-1"
+    assert order.status == "paid"
+    assert inventory.available("pen") == 8
