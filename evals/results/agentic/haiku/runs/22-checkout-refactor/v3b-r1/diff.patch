+++ b/tests/test_checkout_characterization.py
@@ -0,0 +1,155 @@
+"""Pins the current behavior of process_order, including edge cases the other tests do not cover."""
+
+import pytest
+
+from shop.checkout import process_order
+from shop.errors import OrderRejected, PaymentDeclined
+from shop.models import Customer, Item, Order
+from tests.conftest import FakeGateway
+
+CUSTOMER = Customer(email="ada@example.com")
+
+
+def make_order(*items: Item, coupon: str | None = None) -> Order:
+    return Order(id=7, items=list(items), coupon=coupon)
+
+
+def run(order, customer, inventory, gateway, notifier, coupons):
+    return process_order(order, customer, inventory, gateway, notifier, coupons)
+
+
+def test_vip_discount_applies_after_coupon_and_before_shipping(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 4, 1000), coupon="SPRING10")
+    customer = Customer(email="ada@example.com", vip=True)
+
+    run(order, customer, inventory, gateway, notifier, coupons)
+
+    # coupon: 4000 * 10 // 100 = 400; vip: (4000 - 400) * 5 // 100 = 180; discounted 3420
+    # tax 19% of 4000 = 760; 3420 < 5000 so shipping 490
+    assert order.total_cents == 3420 + 760 + 490
+
+
+def test_vip_discount_without_coupon(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 3, 1000))
+    customer = Customer(email="ada@example.com", vip=True)
+
+    run(order, customer, inventory, gateway, notifier, coupons)
+
+    # vip: 3000 * 5 // 100 = 150; tax 570; shipping 490
+    assert order.total_cents == 3000 - 150 + 570 + 490
+
+
+def test_shipping_is_free_at_exactly_the_threshold(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000))
+
+    run(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 5000 + 950
+
+
+def test_shipping_threshold_is_checked_after_discount(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000), coupon="SPRING10")
+
+    run(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 5000 - 10% = 4500 < 5000, so shipping is charged; tax is on the undiscounted 5000
+    assert order.total_cents == 4500 + 950 + 490
+
+
+def test_tax_is_rounded_per_line_not_on_the_total(inventory, gateway, notifier, coupons):
+    # 2 cents * 19% = 0.38 rounds to 0 per line; the 4 cent total would give 0.76 -> 1
+    order = make_order(Item("pen", 1, 2), Item("ink", 1, 2))
+
+    run(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 4 + 0 + 490
+
+
+def test_unknown_country_uses_default_tax_rate(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000))
+    customer = Customer(email="ada@example.com", country="XX")
+
+    run(order, customer, inventory, gateway, notifier, coupons)
+
+    # default 21% of 1000 = 210
+    assert order.total_cents == 1000 + 210 + 490
+
+
+def test_non_positive_quantity_is_rejected_before_stock_is_touched(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), Item("ink", 0, 500))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for ink"):
+        run(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == []
+    assert order.status == "new"
+
+
+def test_invalid_coupon_is_rejected_before_stock_is_touched(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), coupon="NOPE")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: NOPE"):
+        run(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_partial_reservation_is_released_when_a_later_item_is_out_of_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 1000), Item("ink", 4, 500))
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        run(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.available("pen") == 10
+    assert inventory.available("ink") == 3
+    assert order.status == "rejected"
+
+
+def test_declined_payment_does_not_redeem_the_coupon(inventory, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), coupon="SPRING10")
+
+    with pytest.raises(OrderRejected):
+        run(order, CUSTOMER, inventory, FakeGateway(decline=True), notifier, coupons)
+
+    assert coupons.discount_percent("SPRING10") == 10
+
+
+def test_gateway_error_other_than_decline_propagates_and_keeps_the_reservation(inventory, notifier, coupons):
+    # Current behavior: only PaymentDeclined releases stock. Pinned as-is; see the report.
+    class BrokenGateway(FakeGateway):
+        def charge(self, email, amount_cents):
+            raise ConnectionError("gateway down")
+
+    order = make_order(Item("pen", 3, 1000))
+
+    with pytest.raises(ConnectionError):
+        run(order, CUSTOMER, inventory, BrokenGateway(), notifier, coupons)
+
+    assert inventory.available("pen") == 7
+    assert order.status == "new"
+
+
+def test_receipt_failure_is_logged_and_does_not_fail_the_order(inventory, gateway, coupons, caplog):
+    class BrokenNotifier:
+        def send_receipt(self, email, order_id, receipt_id):
+            raise RuntimeError("smtp down")
+
+    order = make_order(Item("pen", 1, 1000))
+
+    with caplog.at_level("WARNING", logger="shop.checkout"):
+        receipt_id = run(order, CUSTOMER, inventory, gateway, BrokenNotifier(), coupons)
+
+    assert receipt_id == "rcpt-1"
+    assert order.status == "paid"
+    assert "receipt for order 7 could not be sent" in caplog.text
+
+
+def test_paid_order_logs_its_total(inventory, gateway, notifier, coupons, caplog):
+    order = make_order(Item("pen", 2, 1000))
+
+    with caplog.at_level("INFO", logger="shop.checkout"):
+        run(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert "order 7 paid: 2870 cents" in caplog.text
+
