+def _send_receipt_quietly(notifier: ReceiptNotifier, customer: Customer, order: Order, receipt_id: str) -> None:
+    # The order is already paid, so a failed receipt is logged rather than reported to the caller.
     try:
         notifier.send_receipt(customer.email, order.id, receipt_id)
