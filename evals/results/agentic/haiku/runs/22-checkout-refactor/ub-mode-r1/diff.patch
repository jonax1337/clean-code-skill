+def validate_items(order: Order) -> None:
     if not order.items:
         raise OrderRejected("order has no items")
     for item in order.items:
         if item.quantity <= 0:
             raise OrderRejected(f"invalid quantity for {item.sku}")
 
+
+def price_order(order: Order, customer: Customer, coupons: CouponBook) -> Pricing:
+    subtotal = sum(item.unit_price_cents * item.quantity for item in order.items)
+    tax = line_tax(order.items, tax_rate(customer.country))
+    discount = order_discount(order, customer, coupons, subtotal)
+    shipping = 0 if subtotal - discount >= FREE_SHIPPING_FROM_CENTS else SHIPPING_CENTS
+    return Pricing(subtotal=subtotal, discount=discount, tax=tax, shipping=shipping)
+
