+def release_stock(inventory: Inventory, items: list[Item]) -> None:
+    for item in items:
+        inventory.release(item.sku, item.quantity)
+
+
+def settle(order: Order, inventory: Inventory, coupons: CouponBook, total: int) -> None:
     for item in order.items:
         inventory.commit(item.sku, item.quantity)
     if order.coupon is not None:
         coupons.redeem(order.coupon)
     order.status = "paid"
     order.total_cents = total
     logger.info("order %s paid: %s cents", order.id, total)
 
+
+def send_receipt(notifier: ReceiptNotifier, customer: Customer, order: Order, receipt_id: str) -> None:
+    """A failed receipt must not fail an order that is already paid."""
