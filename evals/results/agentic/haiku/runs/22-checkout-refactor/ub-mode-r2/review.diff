+# Characterization tests: they pin the current behavior of process_order so the refactor can be checked.
+
+
+def test_vip_customer_gets_five_percent_off_before_shipping_is_decided(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 1000))
+    vip = Customer(email="ada@example.com", vip=True)
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 2000 - 5% = 1900, + 380 tax, shipping still 490 because 1900 is below 5000
+    assert order.total_cents == 1900 + 380 + 490
+
+
+def test_subtotal_of_exactly_the_free_shipping_threshold_ships_free(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 5000 + 950 + 0
+
+
+def test_shipping_is_decided_after_the_coupon_discount(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1100), coupon="SPRING10")
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 5500 - 10% = 4950 is below the threshold, so shipping is charged
+    assert order.total_cents == 4950 + 1045 + 490
+
+
+def test_tax_is_rounded_half_up_per_line(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 50), Item("ink", 1, 50))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # Each line: 50 * 0.19 = 9.5 -> 10, so tax is 20 (a single 100 * 0.19 would give 19)
+    assert order.total_cents == 100 + 20 + 490
+
+
+def test_half_cent_tax_rounds_up_not_to_even(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 150))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 150 * 0.19 = 28.5 -> 29
+    assert order.total_cents == 150 + 29 + 490
+
+
