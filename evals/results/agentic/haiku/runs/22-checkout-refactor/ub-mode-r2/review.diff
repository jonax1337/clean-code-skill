+def test_gateway_error_other_than_a_decline_propagates_unchanged(inventory, notifier, coupons):
+    class BrokenGateway(FakeGateway):
+        def charge(self, email: str, amount_cents: int) -> str:
+            raise RuntimeError("gateway down")
+
+    order = make_order(Item("pen", 2, 1000))
