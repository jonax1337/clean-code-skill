+
+def test_order_with_zero_quantity_is_rejected(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 0, 1000))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for pen"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert gateway.charges == []
+    assert inventory.available("pen") == 10
+
+
+def test_unknown_coupon_is_rejected_before_stock_is_touched(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), coupon="NOPE")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: NOPE"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert gateway.charges == []
+    assert inventory.available("pen") == 10
+
+
+def test_vip_customer_gets_an_extra_discount(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+    order = make_order(Item("pen", 2, 1000))
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 2000 - 5% VIP = 1900, + 19% tax on 2000 (380), shipping 490 since 1900 is below the free threshold
+    assert order.total_cents == 1900 + 380 + 490
+
+
+def test_shipping_threshold_is_checked_after_the_coupon(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000), coupon="SPRING10")
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 5000 - 10% = 4500 is below the threshold, so shipping is charged; tax is on 5000 (950)
+    assert order.total_cents == 4500 + 950 + 490
+
+
+def test_shipping_is_free_at_exactly_the_threshold(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 5000 + 950 + 0
+
+
+def test_tax_is_rounded_per_line_not_on_the_total(inventory, gateway, notifier, coupons):
+    # 3 * 19% = 0.57 rounds to 1 per line (2 in total); 6 * 19% = 1.14 would round to 1
+    order = make_order(Item("pen", 1, 3), Item("pen", 1, 3))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert gateway.charges == [("ada@example.com", 6 + 2 + 490)]
+
+
+def test_partial_reservation_is_released_when_a_later_item_is_out_of_stock(
+    inventory, gateway, notifier, coupons
+):
+    order = make_order(Item("pen", 2, 1000), Item("ink", 4, 500))
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "rejected"
+    assert inventory.available("pen") == 10
+    assert inventory.available("ink") == 3
+    assert gateway.charges == []
+
+
+def test_failing_receipt_does_not_fail_a_paid_order(inventory, gateway, coupons, caplog):
+    class BrokenNotifier:
+        def send_receipt(self, email: str, order_id: int, receipt_id: str) -> None:
+            raise RuntimeError("smtp down")
+
+    order = make_order(Item("pen", 2, 1000))
+
+    receipt_id = process_order(order, CUSTOMER, inventory, gateway, BrokenNotifier(), coupons)
+
+    assert receipt_id == "rcpt-1"
+    assert order.status == "paid"
+    assert inventory.available("pen") == 8
+    assert "could not be sent" in caplog.text
