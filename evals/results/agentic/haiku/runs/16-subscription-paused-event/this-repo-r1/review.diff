+test("an active subscription can be paused until a resume date", () => {
+  const active = replay([started]);
+  assert.equal(active.resumeOn, null);
+
+  const paused = reduceSubscription(active, {
+    type: "subscription_paused",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-02T08:30:00Z",
+    resumeOn: "2025-05-01",
+    reason: "vacation",
+  });
+  assert.equal(paused.status, "paused");
+  assert.equal(paused.resumeOn, "2025-05-01");
+});
+
+test("only an active subscription can be paused", () => {
+  const pause: SubscriptionEvent = {
+    type: "subscription_paused",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-02T08:30:00Z",
+    resumeOn: "2025-05-01",
+    reason: "vacation",
+  };
+  const pastDue = reduceSubscription(replay([started]), {
+    type: "payment_failed",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-02-05T00:00:00Z",
+    attempt: 1,
+  });
+  assert.equal(reduceSubscription(pastDue, pause), pastDue);
+
+  const canceled = replay([
+    started,
+    { type: "subscription_canceled", subscriptionId: "sub_1", occurredAt: "2025-03-01T00:00:00Z", reason: "too expensive" },
+  ]);
+  assert.equal(reduceSubscription(canceled, pause), canceled);
+});
+
+test("pausing a paused subscription keeps its original resume date", () => {
+  const paused = reduceSubscription(replay([started]), {
+    type: "subscription_paused",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-02T08:30:00Z",
+    resumeOn: "2025-05-01",
+    reason: "vacation",
+  });
+  const pausedAgain = reduceSubscription(paused, {
+    type: "subscription_paused",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-03T08:30:00Z",
+    resumeOn: "2025-06-01",
+    reason: "still on vacation",
+  });
+  assert.equal(pausedAgain, paused);
+});
+
+test("payments leave a paused subscription as it is", () => {
+  const paused = replay([
+    started,
+    { type: "subscription_paused", subscriptionId: "sub_1", occurredAt: "2025-04-02T08:30:00Z", resumeOn: "2025-05-01", reason: "vacation" },
+  ]);
+  const failed = reduceSubscription(paused, {
+    type: "payment_failed",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-03T00:00:00Z",
+    attempt: 1,
+  });
+  assert.equal(failed, paused);
+
+  const recovered = reduceSubscription(paused, {
+    type: "payment_recovered",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-04T00:00:00Z",
+  });
+  assert.equal(recovered, paused);
+});
+
+test("cancelling a paused subscription clears the resume date", () => {
+  const paused = replay([
+    started,
+    { type: "subscription_paused", subscriptionId: "sub_1", occurredAt: "2025-04-02T08:30:00Z", resumeOn: "2025-05-01", reason: "vacation" },
+  ]);
+  const canceled = reduceSubscription(paused, {
+    type: "subscription_canceled",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-10T00:00:00Z",
+    reason: "too expensive",
+  });
+  assert.equal(canceled.status, "canceled");
+  assert.equal(canceled.resumeOn, null);
+  assert.equal(canceled.canceledAt, "2025-04-10T00:00:00Z");
+});
+
