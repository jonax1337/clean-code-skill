diff --git a/test/subscription.test.ts b/test/subscription.test.ts
index f154a91..9832bdf 100644
--- a/test/subscription.test.ts
+++ b/test/subscription.test.ts
@@ -59,11 +59,75 @@ test("cancelling records when it happened and a canceled subscription stays canc
     type: "payment_failed",
     subscriptionId: "sub_1",
     occurredAt: "2025-03-02T00:00:00Z",
     attempt: 1,
   });
   assert.equal(afterFailure, canceled);
 });
 
+const paused: SubscriptionEvent = {
+  type: "subscription_paused",
+  subscriptionId: "sub_1",
+  occurredAt: "2025-04-02T08:30:00Z",
+  resumeOn: "2025-05-01",
+  reason: "vacation",
+};
+
+test("pausing an active subscription pauses it until the resume date", () => {
+  const state = replay([started, paused]);
+  assert.equal(state.status, "paused");
+  assert.equal(state.resumeOn, "2025-05-01");
+  assert.equal(state.canceledAt, null);
+});
+
+test("a subscription that is not active cannot be paused", () => {
+  const pastDue = replay([
+    started,
+    { type: "payment_failed", subscriptionId: "sub_1", occurredAt: "2025-02-05T00:00:00Z", attempt: 1 },
+  ]);
+  assert.equal(reduceSubscription(pastDue, paused), pastDue);
+
+  const canceled = replay([
+    started,
+    { type: "subscription_canceled", subscriptionId: "sub_1", occurredAt: "2025-03-01T00:00:00Z", reason: "moving" },
+  ]);
+  assert.equal(reduceSubscription(canceled, paused), canceled);
+});
+
+test("a second pause does not move the resume date of a paused subscription", () => {
+  const state = replay([started, paused]);
+  const again = reduceSubscription(state, { ...paused, occurredAt: "2025-04-03T00:00:00Z", resumeOn: "2025-06-01" });
+  assert.equal(again, state);
+});
+
+test("payment events leave a paused subscription as it is", () => {
+  const state = replay([started, paused]);
+  const failed = reduceSubscription(state, {
+    type: "payment_failed",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-10T00:00:00Z",
+    attempt: 1,
+  });
+  assert.equal(failed, state);
+
+  const recovered = reduceSubscription(state, {
+    type: "payment_recovered",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-11T00:00:00Z",
+  });
+  assert.equal(recovered, state);
+});
+
+test("cancelling a paused subscription cancels it and clears the resume date", () => {
+  const canceled = replay([
+    started,
+    paused,
+    { type: "subscription_canceled", subscriptionId: "sub_1", occurredAt: "2025-04-20T00:00:00Z", reason: "no longer needed" },
+  ]);
+  assert.equal(canceled.status, "canceled");
+  assert.equal(canceled.resumeOn, null);
+  assert.equal(canceled.canceledAt, "2025-04-20T00:00:00Z");
+});
+
 test("a history that does not begin with the start is rejected", () => {
