 export function reduceSubscription(state: Subscription, event: SubscriptionEvent): Subscription {
   switch (event.type) {
     case "subscription_started":
       // A repeated start event changes nothing.
       return state;
     case "plan_changed":
       return { ...state, plan: event.to };
