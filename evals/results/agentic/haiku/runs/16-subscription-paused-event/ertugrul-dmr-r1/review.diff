+  reason: "vacation",
+};
+
+test("pausing an active subscription pauses it until the resume date", () => {
+  const paused = replay([started, pausedEvent]);
+  assert.equal(paused.status, "paused");
+  assert.equal(paused.resumeOn, "2025-05-01");
+  assert.equal(paused.canceledAt, null);
+});
+
+test("a started subscription has no resume date", () => {
+  assert.equal(replay([started]).resumeOn, null);
+});
+
+test("only an active subscription can be paused", () => {
+  const pastDue = reduceSubscription(replay([started]), {
+    type: "payment_failed",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-02-05T00:00:00Z",
+    attempt: 1,
+  });
+  assert.equal(reduceSubscription(pastDue, pausedEvent), pastDue);
+
+  const canceled = replay([
+    started,
+    { type: "subscription_canceled", subscriptionId: "sub_1", occurredAt: "2025-03-01T00:00:00Z", reason: "x" },
+  ]);
+  assert.equal(reduceSubscription(canceled, pausedEvent), canceled);
+});
+
+test("pausing a paused subscription keeps the first pause", () => {
+  const paused = replay([started, pausedEvent]);
+  const again = reduceSubscription(paused, { ...pausedEvent, occurredAt: "2025-04-03T00:00:00Z", resumeOn: "2025-06-01" });
+  assert.equal(again, paused);
+});
+
+test("payment events leave a paused subscription as it is", () => {
+  const paused = replay([started, pausedEvent]);
+  const failed = reduceSubscription(paused, {
+    type: "payment_failed",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-10T00:00:00Z",
+    attempt: 1,
+  });
+  assert.equal(failed, paused);
+
+  const recovered = reduceSubscription(paused, {
+    type: "payment_recovered",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-11T00:00:00Z",
+  });
+  assert.equal(recovered, paused);
+});
+
+test("cancelling a paused subscription cancels it and clears the resume date", () => {
+  const canceled = reduceSubscription(replay([started, pausedEvent]), {
+    type: "subscription_canceled",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-20T00:00:00Z",
+    reason: "moved on",
+  });
+  assert.equal(canceled.status, "canceled");
+  assert.equal(canceled.resumeOn, null);
