diff --git a/test/subscription.test.ts b/test/subscription.test.ts
index f154a91..b230816 100644
--- a/test/subscription.test.ts
+++ b/test/subscription.test.ts
@@ -5,23 +5,88 @@ import { reduceSubscription, replay } from "../src/subscription.ts";
 
 const started: SubscriptionEvent = {
   type: "subscription_started",
   subscriptionId: "sub_1",
   occurredAt: "2025-01-05T09:00:00Z",
   plan: "basic",
 };
 
+const pause: SubscriptionEvent = {
+  type: "subscription_paused",
+  subscriptionId: "sub_1",
+  occurredAt: "2025-04-02T08:30:00Z",
+  resumeOn: "2025-05-01",
+  reason: "vacation",
+};
+
 test("a started subscription is active on its plan", () => {
   const state = replay([started]);
   assert.equal(state.id, "sub_1");
   assert.equal(state.plan, "basic");
   assert.equal(state.status, "active");
   assert.equal(state.startedAt, "2025-01-05T09:00:00Z");
   assert.equal(state.canceledAt, null);
+  assert.equal(state.resumeOn, null);
+});
+
+test("pausing an active subscription pauses it until the resume date", () => {
+  const paused = replay([started, pause]);
+  assert.equal(paused.status, "paused");
+  assert.equal(paused.resumeOn, "2025-05-01");
+});
+
+test("only an active subscription can be paused", () => {
+  const pastDue = reduceSubscription(replay([started]), {
+    type: "payment_failed",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-02-05T00:00:00Z",
+    attempt: 1,
+  });
+  assert.equal(reduceSubscription(pastDue, pause), pastDue);
+
+  const canceled = replay([
+    started,
+    { type: "subscription_canceled", subscriptionId: "sub_1", occurredAt: "2025-03-01T00:00:00Z", reason: "too expensive" },
+  ]);
+  assert.equal(reduceSubscription(canceled, pause), canceled);
+
+  const paused = replay([started, pause]);
+  assert.equal(reduceSubscription(paused, { ...pause, resumeOn: "2025-06-01" }), paused);
+});
+
+test("payment events leave a paused subscription as it is", () => {
+  const paused = replay([started, pause]);
+  assert.equal(
+    reduceSubscription(paused, {
+      type: "payment_failed",
+      subscriptionId: "sub_1",
+      occurredAt: "2025-05-01T00:00:00Z",
+      attempt: 1,
+    }),
+    paused,
+  );
+  assert.equal(
+    reduceSubscription(paused, {
+      type: "payment_recovered",
+      subscriptionId: "sub_1",
+      occurredAt: "2025-05-01T00:00:00Z",
+    }),
+    paused,
+  );
+});
+
+test("cancelling a paused subscription ends the pause and clears the resume date", () => {
+  const canceled = replay([
+    started,
+    pause,
+    { type: "subscription_canceled", subscriptionId: "sub_1", occurredAt: "2025-04-10T00:00:00Z", reason: "moved on" },
+  ]);
+  assert.equal(canceled.status, "canceled");
+  assert.equal(canceled.resumeOn, null);
 });
 
 test("a plan change switches the plan", () => {
   const state = replay([
     started,
     { type: "plan_changed", subscriptionId: "sub_1", occurredAt: "2025-02-01T00:00:00Z", from: "basic", to: "pro" },
   ]);
   assert.equal(state.plan, "pro");
