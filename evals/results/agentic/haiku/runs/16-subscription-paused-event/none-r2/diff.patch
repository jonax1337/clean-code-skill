diff --git a/test/subscription.test.ts b/test/subscription.test.ts
index f154a91..db0ed2a 100644
--- a/test/subscription.test.ts
+++ b/test/subscription.test.ts
@@ -59,11 +59,69 @@ test("cancelling records when it happened and a canceled subscription stays canc
     type: "payment_failed",
     subscriptionId: "sub_1",
     occurredAt: "2025-03-02T00:00:00Z",
     attempt: 1,
   });
   assert.equal(afterFailure, canceled);
 });
 
+const pausedOn = (resumeOn: string): SubscriptionEvent => ({
+  type: "subscription_paused",
+  subscriptionId: "sub_1",
+  occurredAt: "2025-04-02T08:30:00Z",
+  resumeOn,
+  reason: "vacation",
+});
+
+test("pausing an active subscription pauses it until the resume date", () => {
+  const paused = replay([started, pausedOn("2025-05-01")]);
+  assert.equal(paused.status, "paused");
+  assert.equal(paused.resumeOn, "2025-05-01");
+  assert.equal(paused.canceledAt, null);
+});
+
+test("pausing a subscription that is not active changes nothing", () => {
+  const pastDue = replay([
+    started,
+    { type: "payment_failed", subscriptionId: "sub_1", occurredAt: "2025-02-05T00:00:00Z", attempt: 1 },
+  ]);
+  assert.equal(reduceSubscription(pastDue, pausedOn("2025-05-01")), pastDue);
+
+  const canceled = replay([
+    started,
+    { type: "subscription_canceled", subscriptionId: "sub_1", occurredAt: "2025-03-01T00:00:00Z", reason: "x" },
+  ]);
+  assert.equal(reduceSubscription(canceled, pausedOn("2025-05-01")), canceled);
+
+  const paused = replay([started, pausedOn("2025-05-01")]);
+  assert.equal(reduceSubscription(paused, pausedOn("2025-06-01")), paused);
+});
+
+test("payment events leave a paused subscription as it is", () => {
+  const paused = replay([started, pausedOn("2025-05-01")]);
+  const failed = reduceSubscription(paused, {
+    type: "payment_failed",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-05-01T00:00:00Z",
+    attempt: 1,
+  });
+  assert.equal(failed, paused);
+  assert.equal(
+    reduceSubscription(paused, { type: "payment_recovered", subscriptionId: "sub_1", occurredAt: "2025-05-02T00:00:00Z" }),
+    paused,
+  );
+});
+
+test("cancelling a paused subscription cancels it and clears the resume date", () => {
+  const canceled = replay([
+    started,
+    pausedOn("2025-05-01"),
+    { type: "subscription_canceled", subscriptionId: "sub_1", occurredAt: "2025-04-10T00:00:00Z", reason: "moved" },
+  ]);
+  assert.equal(canceled.status, "canceled");
+  assert.equal(canceled.canceledAt, "2025-04-10T00:00:00Z");
+  assert.equal(canceled.resumeOn, null);
+});
+
 test("a history that does not begin with the start is rejected", () => {
   assert.throws(() => replay([]), /starts with subscription_started/);
 });
