     default:
       return assertNever(event);
   }
 }
 
 function startedSubscription(event: SubscriptionStarted): Subscription {
   return {
     id: event.subscriptionId,
     plan: event.plan,
     status: "active",
     failedAttempts: 0,
     startedAt: event.occurredAt,
     canceledAt: null,
+    resumeOn: null,
   };
 }
