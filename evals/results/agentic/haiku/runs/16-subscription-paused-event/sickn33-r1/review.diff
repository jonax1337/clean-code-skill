+const paused = (occurredAt = "2025-04-02T08:30:00Z"): SubscriptionEvent => ({
+  type: "subscription_paused",
+  subscriptionId: "sub_1",
+  occurredAt,
+  resumeOn: "2025-05-01",
+  reason: "vacation",
+});
+
+test("pausing an active subscription records the resume date until it is canceled", () => {
+  const state = replay([started, paused()]);
+  assert.equal(state.status, "paused");
+  assert.equal(state.resumeOn, "2025-05-01");
+
+  const canceled = reduceSubscription(state, {
+    type: "subscription_canceled",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-10T00:00:00Z",
+    reason: "moved away",
+  });
+  assert.equal(canceled.status, "canceled");
+  assert.equal(canceled.canceledAt, "2025-04-10T00:00:00Z");
+  assert.equal(canceled.resumeOn, null);
+});
+
+test("a paused subscription ignores payment events", () => {
+  const state = replay([started, paused()]);
+  const failed = reduceSubscription(state, {
+    type: "payment_failed",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-15T00:00:00Z",
+    attempt: 1,
+  });
+  assert.equal(failed, state);
+
+  const recovered = reduceSubscription(state, {
+    type: "payment_recovered",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-04-15T00:00:00Z",
+  });
+  assert.equal(recovered, state);
+});
+
+test("only an active subscription can be paused", () => {
+  const pastDue = reduceSubscription(replay([started]), {
+    type: "payment_failed",
+    subscriptionId: "sub_1",
+    occurredAt: "2025-02-05T00:00:00Z",
+    attempt: 1,
+  });
+  assert.equal(reduceSubscription(pastDue, paused()), pastDue);
+
+  const alreadyPaused = replay([started, paused("2025-04-02T08:30:00Z")]);
+  assert.equal(reduceSubscription(alreadyPaused, paused("2025-04-03T00:00:00Z")), alreadyPaused);
+
+  const canceled = replay([
+    started,
+    { type: "subscription_canceled", subscriptionId: "sub_1", occurredAt: "2025-03-01T00:00:00Z", reason: "too expensive" },
+  ]);
+  assert.equal(reduceSubscription(canceled, paused()), canceled);
+});
