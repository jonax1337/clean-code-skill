@@ -0,0 +1,43 @@
+package shop;
+
+import java.math.BigDecimal;
+import java.util.Optional;
+
+public final class RefundOrderHandler implements CommandHandler<RefundOrder> {
+    private final OrderRepository orders;
+
+    public RefundOrderHandler(OrderRepository orders) {
+        this.orders = orders;
+    }
+
+    @Override
+    public Result<Order> handle(RefundOrder command) {
+        Validator validator = new Validator()
+                .requireText("orderId", command.orderId())
+                .requireMoney("amount", command.amount());
+        if (!validator.isValid()) {
+            return validator.failure();
+        }
+        Optional<Order> found = orders.find(command.orderId());
+        if (found.isEmpty()) {
+            return Result.failure(ErrorCode.NOT_FOUND, "Order " + command.orderId() + " does not exist");
+        }
+        Order order = found.get();
+        if (order.status() != OrderStatus.SHIPPED && order.status() != OrderStatus.DELIVERED) {
+            return Result.failure(
+                    ErrorCode.INVALID_STATE,
+                    "Only shipped or delivered orders can be refunded, but order " + order.id() + " is "
+                            + order.status());
+        }
+        BigDecimal refundable = order.amountPaid().subtract(order.amountRefunded());
+        if (command.amount().compareTo(refundable) > 0) {
+            return Result.failure(
+                    ErrorCode.INVALID_INPUT,
+                    "Refund " + command.amount() + " is more than the refundable amount " + refundable
+                            + " of order " + order.id());
+        }
+        order.recordRefund(command.amount());
+        orders.save(order);
+        return Result.ok(order);
+    }
+}
diff --git a/src/test/java/shop/RefundOrderHandlerTest.java b/src/test/java/shop/RefundOrderHandlerTest.java
new file mode 100644
index 0000000..28c1f03
--- /dev/null
+++ b/src/test/java/shop/RefundOrderHandlerTest.java
@@ -0,0 +1,134 @@
+package shop;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.math.BigDecimal;
+import org.junit.jupiter.api.Test;
+
+class RefundOrderHandlerTest {
+    private final OrderRepository orders = new InMemoryOrderRepository();
+    private final CommandBus bus = OrderServices.createBus(orders);
+
+    private void placeAndPay(String orderId, String total, String paid) {
+        bus.dispatch(new PlaceOrder(orderId, "c-1", new BigDecimal(total)));
+        bus.dispatch(new PayOrder(orderId, new BigDecimal(paid)));
+    }
+
+    private void placeAndShip(String orderId, String total, String paid) {
+        placeAndPay(orderId, total, paid);
+        bus.dispatch(new ShipOrder(orderId));
+    }
+
+    @Test
+    void recordsAPartialRefundOnAShippedOrderAndKeepsItsStatus() {
+        placeAndShip("o-1", "100.00", "100.00");
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("30.00")));
+
+        assertTrue(result.isOk());
+        Order stored = orders.find("o-1").orElseThrow();
+        assertEquals(0, new BigDecimal("30.00").compareTo(stored.amountRefunded()));
+        assertEquals(OrderStatus.SHIPPED, stored.status());
+    }
+
+    @Test
+    void allowsRefundingADeliveredOrder() {
+        placeAndShip("o-1", "100.00", "100.00");
+        bus.dispatch(new DeliverOrder("o-1"));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("100.00")));
+
+        assertTrue(result.isOk());
+        assertEquals(OrderStatus.DELIVERED, orders.find("o-1").orElseThrow().status());
+    }
+
+    @Test
+    void accumulatesRefundsAcrossCommands() {
+        placeAndShip("o-1", "100.00", "100.00");
+        bus.dispatch(new RefundOrder("o-1", new BigDecimal("30.00")));
+
+        bus.dispatch(new RefundOrder("o-1", new BigDecimal("20.00")));
+
+        assertEquals(0, new BigDecimal("50.00").compareTo(orders.find("o-1").orElseThrow().amountRefunded()));
+    }
+
+    @Test
+    void capsTotalRefundsAtWhatTheCustomerPaidNotTheOrderTotal() {
+        placeAndShip("o-1", "100.00", "80.00");
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("80.01")));
+
+        assertFalse(result.isOk());
+        assertEquals(ErrorCode.INVALID_INPUT, result.error().code());
+        assertEquals(0, BigDecimal.ZERO.compareTo(orders.find("o-1").orElseThrow().amountRefunded()));
+    }
+
+    @Test
+    void rejectsARefundThatWouldExceedThePaidAmountAcrossSeveralRefunds() {
+        placeAndShip("o-1", "100.00", "100.00");
+        bus.dispatch(new RefundOrder("o-1", new BigDecimal("70.00")));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("30.01")));
+
+        assertFalse(result.isOk());
+        assertEquals(ErrorCode.INVALID_INPUT, result.error().code());
+        assertEquals(0, new BigDecimal("70.00").compareTo(orders.find("o-1").orElseThrow().amountRefunded()));
+    }
+
+    @Test
+    void allowsRefundingTheExactRemainingAmount() {
+        placeAndShip("o-1", "100.00", "100.00");
+        bus.dispatch(new RefundOrder("o-1", new BigDecimal("70.00")));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("30.00")));
+
+        assertTrue(result.isOk());
+        assertEquals(0, new BigDecimal("100.00").compareTo(orders.find("o-1").orElseThrow().amountRefunded()));
+    }
+
+    @Test
+    void rejectsAPlacedOrder() {
+        bus.dispatch(new PlaceOrder("o-1", "c-1", new BigDecimal("100.00")));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("10.00")));
+
+        assertEquals(ErrorCode.INVALID_STATE, result.error().code());
+    }
+
+    @Test
+    void rejectsAPaidOrderThatHasNotShipped() {
+        placeAndPay("o-1", "100.00", "100.00");
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("10.00")));
+
+        assertEquals(ErrorCode.INVALID_STATE, result.error().code());
+    }
+
+    @Test
+    void rejectsACancelledOrder() {
+        bus.dispatch(new PlaceOrder("o-1", "c-1", new BigDecimal("100.00")));
+        bus.dispatch(new CancelOrder("o-1"));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("10.00")));
+
+        assertEquals(ErrorCode.INVALID_STATE, result.error().code());
+    }
+
+    @Test
+    void rejectsANonPositiveAmount() {
+        placeAndShip("o-1", "100.00", "100.00");
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", BigDecimal.ZERO));
+
+        assertEquals(ErrorCode.INVALID_INPUT, result.error().code());
+    }
+
+    @Test
+    void reportsAnUnknownOrder() {
+        Result<Order> result = bus.dispatch(new RefundOrder("missing", new BigDecimal("10.00")));
+
+        assertEquals(ErrorCode.NOT_FOUND, result.error().code());
+    }
+}
