index 0000000..7c2f236
--- /dev/null
+++ b/src/test/java/shop/RefundOrderHandlerTest.java
@@ -0,0 +1,115 @@
+package shop;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.math.BigDecimal;
+import org.junit.jupiter.api.Test;
+
+class RefundOrderHandlerTest {
+    private final OrderRepository orders = new InMemoryOrderRepository();
+    private final CommandBus bus = OrderServices.createBus(orders);
+
+    private void placeAndPay(String orderId, String paid) {
+        bus.dispatch(new PlaceOrder(orderId, "c-1", new BigDecimal("100.00")));
+        bus.dispatch(new PayOrder(orderId, new BigDecimal(paid)));
+    }
+
+    @Test
+    void refundsAShippedOrderAndKeepsItsStatus() {
+        placeAndPay("o-1", "100.00");
+        bus.dispatch(new ShipOrder("o-1"));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("30.00")));
+
+        assertTrue(result.isOk());
+        Order stored = orders.find("o-1").orElseThrow();
+        assertEquals(0, new BigDecimal("30.00").compareTo(stored.amountRefunded()));
+        assertEquals(OrderStatus.SHIPPED, stored.status());
+    }
+
+    @Test
+    void refundsADeliveredOrder() {
+        placeAndPay("o-1", "100.00");
+        bus.dispatch(new ShipOrder("o-1"));
+        bus.dispatch(new DeliverOrder("o-1"));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("100.00")));
+
+        assertTrue(result.isOk());
+        assertEquals(OrderStatus.DELIVERED, orders.find("o-1").orElseThrow().status());
+    }
+
+    @Test
+    void accumulatesPartialRefunds() {
+        placeAndPay("o-1", "100.00");
+        bus.dispatch(new ShipOrder("o-1"));
+        bus.dispatch(new RefundOrder("o-1", new BigDecimal("30.00")));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("70.00")));
+
+        assertTrue(result.isOk());
+        assertEquals(0, new BigDecimal("100.00").compareTo(orders.find("o-1").orElseThrow().amountRefunded()));
+    }
+
+    @Test
+    void capsRefundsAtTheAmountActuallyPaid() {
+        placeAndPay("o-1", "80.00");
+        bus.dispatch(new ShipOrder("o-1"));
+        bus.dispatch(new RefundOrder("o-1", new BigDecimal("50.00")));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("30.01")));
+
+        assertFalse(result.isOk());
+        assertEquals(ErrorCode.INVALID_INPUT, result.error().code());
+        assertEquals(0, new BigDecimal("50.00").compareTo(orders.find("o-1").orElseThrow().amountRefunded()));
+    }
+
+    @Test
+    void rejectsAPaidOrderThatHasNotShipped() {
+        placeAndPay("o-1", "100.00");
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("10.00")));
+
+        assertFalse(result.isOk());
+        assertEquals(ErrorCode.INVALID_STATE, result.error().code());
+        assertEquals(0, BigDecimal.ZERO.compareTo(orders.find("o-1").orElseThrow().amountRefunded()));
+    }
+
+    @Test
+    void rejectsAPlacedOrder() {
+        bus.dispatch(new PlaceOrder("o-1", "c-1", new BigDecimal("100.00")));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("10.00")));
+
+        assertEquals(ErrorCode.INVALID_STATE, result.error().code());
+    }
+
+    @Test
+    void rejectsACancelledOrder() {
+        placeAndPay("o-1", "100.00");
+        bus.dispatch(new CancelOrder("o-1"));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("10.00")));
+
+        assertEquals(ErrorCode.INVALID_STATE, result.error().code());
+    }
+
+    @Test
+    void rejectsANonPositiveAmount() {
+        placeAndPay("o-1", "100.00");
+        bus.dispatch(new ShipOrder("o-1"));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", BigDecimal.ZERO));
+
+        assertEquals(ErrorCode.INVALID_INPUT, result.error().code());
+    }
+
+    @Test
+    void reportsAnUnknownOrder() {
+        Result<Order> result = bus.dispatch(new RefundOrder("missing", new BigDecimal("10.00")));
+
+        assertEquals(ErrorCode.NOT_FOUND, result.error().code());
+    }
+}
