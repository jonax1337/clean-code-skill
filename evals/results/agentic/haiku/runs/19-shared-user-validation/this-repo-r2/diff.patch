diff --git a/src/validation.js b/src/validation.js
new file mode 100644
index 0000000..1268053
--- /dev/null
+++ b/src/validation.js
@@ -0,0 +1,43 @@
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const MAX_NAME_LENGTH = 80;
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+
+// Each check returns { value } when the input is valid, or { error } with the message to report.
+
+export function checkEmail(raw, { lowercase = true } = {}) {
+  let email = typeof raw === 'string' ? raw.trim() : '';
+  if (lowercase) {
+    email = email.toLowerCase();
+  }
+  if (email === '') {
+    return { error: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { error: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function checkName(raw, { required = true } = {}) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  if (name === '' && required) {
+    return { error: 'name is required' };
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return { error: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
+
+export function checkRole(raw, allowedRoles) {
+  if (!allowedRoles.includes(raw)) {
+    return { error: 'role is invalid' };
+  }
+  return { value: raw };
+}
+
+// Messages from the failed checks, in the order the checks were listed.
+export function errorsOf(results) {
+  return results.filter((result) => result.error).map((result) => result.error);
+}
diff --git a/test/validation.test.js b/test/validation.test.js
new file mode 100644
index 0000000..fef82e8
--- /dev/null
+++ b/test/validation.test.js
@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { checkEmail, checkName, checkRole, errorsOf } from '../src/validation.js';
+
+test('checkEmail trims and lowercases by default', () => {
+  assert.deepEqual(checkEmail('  Ann@Example.com '), { value: 'ann@example.com' });
+});
+
+test('checkEmail keeps case when lowercase is false', () => {
+  assert.deepEqual(checkEmail(' Bob@Example.com ', { lowercase: false }), { value: 'Bob@Example.com' });
+});
+
+test('checkEmail reports a missing or non-string email as required', () => {
+  assert.deepEqual(checkEmail(undefined), { error: 'email is required' });
+  assert.deepEqual(checkEmail(null), { error: 'email is required' });
+  assert.deepEqual(checkEmail('   '), { error: 'email is required' });
+});
+
+test('checkEmail reports a malformed email as invalid', () => {
+  assert.deepEqual(checkEmail('nope'), { error: 'email is invalid' });
+});
+
+test('checkName requires a name by default', () => {
+  assert.deepEqual(checkName('  '), { error: 'name is required' });
+  assert.deepEqual(checkName(' Ann '), { value: 'Ann' });
+});
+
+test('checkName allows an empty name when not required', () => {
+  assert.deepEqual(checkName(undefined, { required: false }), { value: '' });
+});
+
+test('checkName enforces the 80 character limit even when optional', () => {
+  const long = 'x'.repeat(81);
+  assert.deepEqual(checkName(long), { error: 'name must be at most 80 characters' });
+  assert.deepEqual(checkName(long, { required: false }), { error: 'name must be at most 80 characters' });
+  assert.deepEqual(checkName('x'.repeat(80)), { value: 'x'.repeat(80) });
+});
+
+test('checkRole accepts only the listed roles', () => {
+  assert.deepEqual(checkRole('admin', ['admin']), { value: 'admin' });
+  assert.deepEqual(checkRole('owner', ['admin']), { error: 'role is invalid' });
+});
+
+test('errorsOf keeps only failures, in order', () => {
+  const results = [{ value: 'a' }, { error: 'first' }, { value: 'b' }, { error: 'second' }];
+  assert.deepEqual(errorsOf(results), ['first', 'second']);
+});
