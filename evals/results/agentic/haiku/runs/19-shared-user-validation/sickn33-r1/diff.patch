diff --git a/src/validation/userFields.js b/src/validation/userFields.js
new file mode 100644
index 0000000..1d61f67
--- /dev/null
+++ b/src/validation/userFields.js
@@ -0,0 +1,41 @@
+export const ALL_ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ['admin', 'member', 'viewer'];
+export const MAX_NAME_LENGTH = 80;
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+
+export function normalizeEmail(value, { lowercase = true } = {}) {
+  if (typeof value !== 'string') {
+    return '';
+  }
+  const trimmed = value.trim();
+  return lowercase ? trimmed.toLowerCase() : trimmed;
+}
+
+export function normalizeName(value) {
+  return typeof value === 'string' ? value.trim() : '';
+}
+
+export function emailErrors(email) {
+  if (email === '') {
+    return ['email is required'];
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return ['email is invalid'];
+  }
+  return [];
+}
+
+export function nameErrors(name, { required = true } = {}) {
+  if (name === '') {
+    return required ? ['name is required'] : [];
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return [`name must be at most ${MAX_NAME_LENGTH} characters`];
+  }
+  return [];
+}
+
+export function roleErrors(role, allowedRoles) {
+  return allowedRoles.includes(role) ? [] : ['role is invalid'];
+}
