diff --git a/src/validation/user.js b/src/validation/user.js
new file mode 100644
index 0000000..307ed8e
--- /dev/null
+++ b/src/validation/user.js
@@ -0,0 +1,34 @@
+// Single source of truth for user field rules. Handlers compose these checks;
+// a rule change (pattern, length limit, role list) only needs to be made here.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const DEFAULT_ROLE = 'member';
+export const MAX_NAME_LENGTH = 80;
+
+export function normalizeEmail(raw) {
+  return typeof raw === 'string' ? raw.trim().toLowerCase() : '';
+}
+
+export function normalizeName(raw) {
+  return typeof raw === 'string' ? raw.trim() : '';
+}
+
+// Each check returns an error message, or null when the value is acceptable.
+
+export function checkEmail(email) {
+  if (email === '') return 'email is required';
+  if (!EMAIL_PATTERN.test(email)) return 'email is invalid';
+  return null;
+}
+
+export function checkName(name, { required = true } = {}) {
+  if (name === '' && required) return 'name is required';
+  if (name.length > MAX_NAME_LENGTH) return `name must be at most ${MAX_NAME_LENGTH} characters`;
+  return null;
+}
+
+export function checkRole(role, { allowed = ROLES, required = false } = {}) {
+  if (role === undefined) return required ? 'role is required' : null;
+  return allowed.includes(role) ? null : 'role is invalid';
+}
