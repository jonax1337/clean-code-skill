diff --git a/src/validation/userFields.js b/src/validation/userFields.js
new file mode 100644
index 0000000..a9a4740
--- /dev/null
+++ b/src/validation/userFields.js
@@ -0,0 +1,41 @@
+// Shared rules for user-related input. Every user handler validates email, name
+// and role through these functions, so a rule change only has to be made here.
+//
+// Each check returns either { value } with the normalized input, or { message }
+// describing why it failed.
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ['admin', 'member', 'viewer'];
+export const MAX_NAME_LENGTH = 80;
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+
+export function checkEmail(raw, { lowercase = true } = {}) {
+  const trimmed = typeof raw === 'string' ? raw.trim() : '';
+  const value = lowercase ? trimmed.toLowerCase() : trimmed;
+  if (value === '') {
+    return { message: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(value)) {
+    return { message: 'email is invalid' };
+  }
+  return { value };
+}
+
+export function checkName(raw, { required = true } = {}) {
+  const value = typeof raw === 'string' ? raw.trim() : '';
+  if (value === '') {
+    return required ? { message: 'name is required' } : { value };
+  }
+  if (value.length > MAX_NAME_LENGTH) {
+    return { message: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value };
+}
+
+export function checkRole(raw, allowedRoles = ROLES) {
+  if (!allowedRoles.includes(raw)) {
+    return { message: 'role is invalid' };
+  }
+  return { value: raw };
+}
