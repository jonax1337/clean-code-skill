diff --git a/src/validation/userFields.js b/src/validation/userFields.js
new file mode 100644
index 0000000..d366434
--- /dev/null
+++ b/src/validation/userFields.js
@@ -0,0 +1,56 @@
+// Shared validation rules for user-like payloads (createUser, updateUser, inviteUser).
+// Each validator returns { value, error }: `error` is null when the input is valid,
+// otherwise it is the message to report. Callers decide which options apply.
+
+export const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ['admin', 'member', 'viewer'];
+export const DEFAULT_ROLE = 'member';
+export const MAX_NAME_LENGTH = 80;
+
+function valid(value) {
+  return { value, error: null };
+}
+
+function invalid(error) {
+  return { value: undefined, error };
+}
+
+// `lowercase` defaults to true; pass false to keep the address's original casing.
+export function validateEmail(raw, { lowercase = true } = {}) {
+  let email = typeof raw === 'string' ? raw.trim() : '';
+  if (lowercase) {
+    email = email.toLowerCase();
+  }
+  if (email === '') {
+    return invalid('email is required');
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return invalid('email is invalid');
+  }
+  return valid(email);
+}
+
+// `required` makes an empty name an error; otherwise an empty name is accepted as ''.
+export function validateName(raw, { required = true } = {}) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  if (name === '') {
+    return required ? invalid('name is required') : valid('');
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return invalid(`name must be at most ${MAX_NAME_LENGTH} characters`);
+  }
+  return valid(name);
+}
+
+// `allowed` is the list of roles this operation accepts.
+// `required` makes an undefined role an error instead of passing through.
+export function validateRole(raw, { allowed = ROLES, required = false } = {}) {
+  if (raw === undefined) {
+    return required ? invalid('role is required') : valid(undefined);
+  }
+  if (!allowed.includes(raw)) {
+    return invalid('role is invalid');
+  }
+  return valid(raw);
+}
diff --git a/test/userFields.test.js b/test/userFields.test.js
new file mode 100644
index 0000000..8ac493a
--- /dev/null
+++ b/test/userFields.test.js
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { validateEmail, validateName, validateRole } from '../src/validation/userFields.js';
+
+test('email is trimmed and lowercased by default, but casing can be kept', () => {
+  assert.deepEqual(validateEmail('  Ann@Example.com '), { value: 'ann@example.com', error: null });
+  assert.deepEqual(validateEmail(' Ann@Example.com ', { lowercase: false }), { value: 'Ann@Example.com', error: null });
+});
+
+test('email reports required for empty or non-string input and invalid for a bad shape', () => {
+  assert.equal(validateEmail(undefined).error, 'email is required');
+  assert.equal(validateEmail(42).error, 'email is required');
+  assert.equal(validateEmail('nope').error, 'email is invalid');
+});
+
+test('name is required unless told otherwise', () => {
+  assert.equal(validateName('   ').error, 'name is required');
+  assert.deepEqual(validateName('   ', { required: false }), { value: '', error: null });
+});
+
+test('name rejects anything longer than 80 characters', () => {
+  assert.equal(validateName('x'.repeat(81)).error, 'name must be at most 80 characters');
+  assert.equal(validateName('x'.repeat(80)).error, null);
+});
+
+test('role checks against the allowed list and can require a value', () => {
+  assert.equal(validateRole('owner', { allowed: ['admin'] }).error, 'role is invalid');
+  assert.equal(validateRole('owner').error, null);
+  assert.equal(validateRole(undefined, { required: true }).error, 'role is required');
+  assert.equal(validateRole(undefined).error, null);
+});
