diff --git a/src/validation.js b/src/validation.js
new file mode 100644
index 0000000..4f66a9e
--- /dev/null
+++ b/src/validation.js
@@ -0,0 +1,42 @@
+// The single home for user field rules. Each validator returns either { value } or { error }.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ['admin', 'member', 'viewer'];
+
+export function validateEmail(raw) {
+  const email = typeof raw === 'string' ? raw.trim().toLowerCase() : '';
+  if (email === '') {
+    return { error: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { error: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function validateName(raw, { required = true } = {}) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  if (name === '') {
+    return required ? { error: 'name is required' } : { value: '' };
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return { error: 'name must be at most 80 characters' };
+  }
+  return { value: name };
+}
+
+export function validateRole(raw, allowed = ROLES) {
+  if (raw === undefined) {
+    return { error: 'role is required' };
+  }
+  if (!allowed.includes(raw)) {
+    return { error: 'role is invalid' };
+  }
+  return { value: raw };
+}
+
+export function errorsOf(results) {
+  return results.flatMap((result) => (result.error ? [result.error] : []));
+}
