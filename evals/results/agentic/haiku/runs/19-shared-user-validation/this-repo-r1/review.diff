diff --git a/src/userValidation.js b/src/userValidation.js
new file mode 100644
index 0000000..8aa3e24
--- /dev/null
+++ b/src/userValidation.js
@@ -0,0 +1,40 @@
+// Shared rules for user fields. Each check returns an error message, or null when the value is acceptable.
+// Handlers decide which checks apply (required, optional, default role); the rules themselves live here.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ['admin', 'member', 'viewer'];
+const MAX_NAME_LENGTH = 80;
+
+export function emailError(email) {
+  if (email === '') {
+    return 'email is required';
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return 'email is invalid';
+  }
+  return null;
+}
+
+export function nameError(name) {
+  if (name === '') {
+    return 'name is required';
+  }
+  return nameLengthError(name);
+}
+
+export function nameLengthError(name) {
+  if (name.length > MAX_NAME_LENGTH) {
+    return `name must be at most ${MAX_NAME_LENGTH} characters`;
+  }
+  return null;
+}
+
+export function roleError(role, allowedRoles = ROLES) {
+  return allowedRoles.includes(role) ? null : 'role is invalid';
+}
+
+// Returns the trimmed string, or '' when the input is not a string.
+export function trimmed(value) {
+  return typeof value === 'string' ? value.trim() : '';
+}
diff --git a/test/userValidation.test.js b/test/userValidation.test.js
new file mode 100644
index 0000000..9af3f7a
--- /dev/null
+++ b/test/userValidation.test.js
@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { INVITABLE_ROLES, emailError, nameError, nameLengthError, roleError } from '../src/userValidation.js';
+
+test('email rules: required, then format', () => {
+  assert.equal(emailError(''), 'email is required');
+  assert.equal(emailError('nope'), 'email is invalid');
+  assert.equal(emailError('ann@example.com'), null);
+});
+
+test('name rules: required, then at most 80 characters', () => {
+  assert.equal(nameError(''), 'name is required');
+  assert.equal(nameError('a'.repeat(80)), null);
+  assert.equal(nameError('a'.repeat(81)), 'name must be at most 80 characters');
+});
+
+test('name length alone does not require a name', () => {
+  assert.equal(nameLengthError(''), null);
+  assert.equal(nameLengthError('a'.repeat(81)), 'name must be at most 80 characters');
+});
+
+test('role rules default to every role and can be narrowed', () => {
+  assert.equal(roleError('owner'), null);
+  assert.equal(roleError('god'), 'role is invalid');
+  assert.equal(roleError('owner', INVITABLE_ROLES), 'role is invalid');
+  assert.equal(roleError('viewer', INVITABLE_ROLES), null);
+});
