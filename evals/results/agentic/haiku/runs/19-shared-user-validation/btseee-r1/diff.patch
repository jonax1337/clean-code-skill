diff --git a/src/validation/userFields.js b/src/validation/userFields.js
new file mode 100644
index 0000000..4ba3ac7
--- /dev/null
+++ b/src/validation/userFields.js
@@ -0,0 +1,39 @@
+export const USER_ROLES = ['owner', 'admin', 'member', 'viewer'];
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+// Each check returns { value } when the input is valid, or { error } with the message to report.
+
+export function checkEmail(raw) {
+  const email = typeof raw === 'string' ? raw.trim().toLowerCase() : '';
+  if (email === '') {
+    return { error: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { error: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function checkName(raw, { required }) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  if (name === '' && required) {
+    return { error: 'name is required' };
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return { error: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
+
+export function checkRole(raw, allowedRoles) {
+  if (!allowedRoles.includes(raw)) {
+    return { error: 'role is invalid' };
+  }
+  return { value: raw };
+}
+
+export function errorsOf(results) {
+  return results.flatMap((result) => (result.error ? [result.error] : []));
+}
