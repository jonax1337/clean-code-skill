@@ -4,16 +4,26 @@ import { inviteUser } from '../src/handlers/inviteUser.js';
 import { ann, storeWith } from './helpers.js';
 
 test('creates a pending invitation', () => {
   const result = inviteUser(storeWith(), { body: { email: ' bob@example.com ', name: 'Bob', role: 'viewer' } });
   assert.equal(result.status, 201);
   assert.deepEqual(result.body, { id: 1, email: 'bob@example.com', name: 'Bob', role: 'viewer', status: 'pending' });
 });
 
+test('stores the invitee email lowercased, like users', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'Bob@Example.com', role: 'member' } });
+  assert.equal(result.body.email, 'bob@example.com');
+});
+
+test('rejects owner as an invitation role', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'bob@example.com', role: 'owner' } });
+  assert.deepEqual(result.body.messages, ['role is invalid']);
+});
+
 test('requires a role', () => {
   const result = inviteUser(storeWith(), { body: { email: 'bob@example.com' } });
   assert.deepEqual(result.body.messages, ['role is required']);
 });
 
 test('answers 409 when a user already has the email', () => {
   const result = inviteUser(storeWith(ann()), { body: { email: 'ann@example.com', role: 'member' } });
   assert.equal(result.status, 409);
diff --git a/test/userFields.test.js b/test/userFields.test.js
new file mode 100644
index 0000000..db83891
--- /dev/null
+++ b/test/userFields.test.js
@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { USER_ROLES, checkEmail, checkName, checkRole } from '../src/validation/userFields.js';
+
+test('email is trimmed, lowercased and format-checked', () => {
+  assert.deepEqual(checkEmail('  Ann@Example.com '), { value: 'ann@example.com' });
+  assert.deepEqual(checkEmail(''), { error: 'email is required' });
+  assert.deepEqual(checkEmail(42), { error: 'email is required' });
+  assert.deepEqual(checkEmail('nope'), { error: 'email is invalid' });
+});
+
+test('name is trimmed and length-checked; required only when asked', () => {
+  assert.deepEqual(checkName(' Ann Lee ', { required: true }), { value: 'Ann Lee' });
+  assert.deepEqual(checkName('   ', { required: true }), { error: 'name is required' });
+  assert.deepEqual(checkName(undefined, { required: false }), { value: '' });
+  assert.deepEqual(checkName('x'.repeat(81), { required: false }), { error: 'name must be at most 80 characters' });
+});
+
+test('role must be one of the allowed roles', () => {
+  assert.deepEqual(checkRole('admin', USER_ROLES), { value: 'admin' });
+  assert.deepEqual(checkRole('god', USER_ROLES), { error: 'role is invalid' });
+});
