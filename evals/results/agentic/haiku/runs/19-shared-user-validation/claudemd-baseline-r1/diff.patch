diff --git a/src/validation/user.js b/src/validation/user.js
new file mode 100644
index 0000000..55152ba
--- /dev/null
+++ b/src/validation/user.js
@@ -0,0 +1,51 @@
+// Shared field rules for user and invitation payloads. Every rule that clients see
+// (see docs/api.md) lives here, so a fix only has to be made once.
+//
+// Each check appends at most one message to `messages` and returns the cleaned value,
+// or undefined when the value was rejected.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ['admin', 'member', 'viewer'];
+export const MAX_NAME_LENGTH = 80;
+
+// `lowercase` defaults to true. inviteUser passes false because it has never lowercased
+// invitation emails; see the note in docs/api.md before changing that.
+export function checkEmail(value, messages, { lowercase = true } = {}) {
+  let email = typeof value === 'string' ? value.trim() : '';
+  if (lowercase) {
+    email = email.toLowerCase();
+  }
+  if (email === '') {
+    messages.push('email is required');
+    return undefined;
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    messages.push('email is invalid');
+    return undefined;
+  }
+  return email;
+}
+
+// `required` defaults to true. An empty name is only accepted when it is not required.
+export function checkName(value, messages, { required = true } = {}) {
+  const name = typeof value === 'string' ? value.trim() : '';
+  if (name === '' && required) {
+    messages.push('name is required');
+    return undefined;
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    messages.push(`name must be at most ${MAX_NAME_LENGTH} characters`);
+    return undefined;
+  }
+  return name;
+}
+
+export function checkRole(value, messages, allowed = ROLES) {
+  if (!allowed.includes(value)) {
+    messages.push('role is invalid');
+    return undefined;
+  }
+  return value;
+}
diff --git a/test/validation.test.js b/test/validation.test.js
new file mode 100644
index 0000000..ddba83f
--- /dev/null
+++ b/test/validation.test.js
@@ -0,0 +1,62 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { INVITABLE_ROLES, checkEmail, checkName, checkRole } from '../src/validation/user.js';
+
+test('checkEmail trims and lowercases by default', () => {
+  const messages = [];
+  assert.equal(checkEmail('  Ann@Example.com ', messages), 'ann@example.com');
+  assert.deepEqual(messages, []);
+});
+
+test('checkEmail keeps case when lowercase is false', () => {
+  const messages = [];
+  assert.equal(checkEmail(' Ann@Example.com ', messages, { lowercase: false }), 'Ann@Example.com');
+  assert.deepEqual(messages, []);
+});
+
+test('checkEmail reports a missing or blank email as required', () => {
+  for (const value of [undefined, null, 42, '   ']) {
+    const messages = [];
+    assert.equal(checkEmail(value, messages), undefined);
+    assert.deepEqual(messages, ['email is required']);
+  }
+});
+
+test('checkEmail reports a malformed email as invalid', () => {
+  const messages = [];
+  assert.equal(checkEmail('nope', messages), undefined);
+  assert.deepEqual(messages, ['email is invalid']);
+});
+
+test('checkName requires a name by default', () => {
+  const messages = [];
+  assert.equal(checkName('  ', messages), undefined);
+  assert.deepEqual(messages, ['name is required']);
+});
+
+test('checkName accepts an empty name when not required', () => {
+  const messages = [];
+  assert.equal(checkName(undefined, messages, { required: false }), '');
+  assert.deepEqual(messages, []);
+});
+
+test('checkName rejects names longer than 80 characters even when not required', () => {
+  for (const required of [true, false]) {
+    const messages = [];
+    assert.equal(checkName('x'.repeat(81), messages, { required }), undefined);
+    assert.deepEqual(messages, ['name must be at most 80 characters']);
+  }
+});
+
+test('checkName accepts exactly 80 characters after trimming', () => {
+  const messages = [];
+  assert.equal(checkName(` ${'x'.repeat(80)} `, messages), 'x'.repeat(80));
+  assert.deepEqual(messages, []);
+});
+
+test('checkRole accepts all roles by default and only the allowed list when given', () => {
+  const messages = [];
+  assert.equal(checkRole('owner', messages), 'owner');
+  assert.equal(checkRole('owner', messages, INVITABLE_ROLES), undefined);
+  assert.deepEqual(messages, ['role is invalid']);
+});
