diff --git a/src/validation/user.js b/src/validation/user.js
new file mode 100644
index 0000000..363f3ee
--- /dev/null
+++ b/src/validation/user.js
@@ -0,0 +1,47 @@
+// The one place where user and invitation fields are checked and normalized.
+// Each parser returns { value, messages }; messages is empty when the field is valid.
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ['admin', 'member', 'viewer'];
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+const valid = (value) => ({ value, messages: [] });
+const invalid = (message) => ({ value: undefined, messages: [message] });
+
+export function parseEmail(raw) {
+  const email = typeof raw === 'string' ? raw.trim().toLowerCase() : '';
+  if (email === '') {
+    return invalid('email is required');
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return invalid('email is invalid');
+  }
+  return valid(email);
+}
+
+export function parseName(raw, { required }) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  if (name === '' && required) {
+    return invalid('name is required');
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return invalid('name must be at most 80 characters');
+  }
+  return valid(name);
+}
+
+export function parseRole(raw, allowed) {
+  if (raw === undefined) {
+    return invalid('role is required');
+  }
+  if (!allowed.includes(raw)) {
+    return invalid('role is invalid');
+  }
+  return valid(raw);
+}
+
+export function collectMessages(...fields) {
+  return fields.flatMap((field) => field.messages);
+}
