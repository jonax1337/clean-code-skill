+package com.acme.relay;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.net.URISyntaxException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class MainTest {
+    private static final String VALID = """
+            upstream.url=https://uplink.example.com/v1/events
+            api.token=s3cret
+            """;
+
+    @TempDir
+    Path dir;
+
+    @Test
+    void startsWithAValidConfig() throws Exception {
+        Run run = start(VALID);
+
+        assertEquals(0, run.exitCode, run.stderr);
+    }
+
+    @Test
+    void refusesToStartWithAnInvalidConfigAndSaysWhatIsWrong() throws Exception {
+        Run run = start(VALID + "worker.threads=four\n");
+
+        assertEquals(2, run.exitCode);
+        assertTrue(run.stderr.contains("worker.threads"), run.stderr);
+        assertTrue(run.stdout.isEmpty(), run.stdout);
+    }
+
+    @Test
+    void refusesToStartWhenTheConfigFileIsMissing() throws Exception {
+        Run run = launch(dir.resolve("absent.properties"));
+
+        assertEquals(2, run.exitCode);
+        assertTrue(run.stderr.contains("absent.properties"), run.stderr);
+    }
+
+    private Run start(String content) throws IOException, InterruptedException {
+        return launch(Files.writeString(dir.resolve("config.properties"), content));
+    }
+
+    /** Runs the relay the way ops does: a new JVM, the config path as argument, and empty stdin. */
+    private static Run launch(Path configFile) throws IOException, InterruptedException {
+        Path classes;
+        try {
+            classes = Path.of(Main.class.getProtectionDomain().getCodeSource().getLocation().toURI());
+        } catch (URISyntaxException e) {
+            throw new IOException(e);
+        }
+        String java = ProcessHandle.current().info().command().orElse("java");
+        Process process = new ProcessBuilder(
+                        List.of(java, "-cp", classes.toString(), Main.class.getName(), configFile.toString()))
+                .start();
+        process.getOutputStream().close();
+        String stdout = new String(process.getInputStream().readAllBytes());
+        String stderr = new String(process.getErrorStream().readAllBytes());
+        return new Run(process.waitFor(), stdout, stderr);
+    }
+
+    private record Run(int exitCode, String stdout, String stderr) {}
+}
