+//! Splits one log line into tokens.
+//!
+//! A line is a run of tokens separated by spaces or tabs:
+//!
+//! - `[...]` is a timestamp. It must be followed by a separator or the end of the line.
+//! - `key=value` is a pair. The value is either bare (up to the next separator, possibly empty)
+//!   or double-quoted, where `\"`, `\\`, `\n` and `\t` are the only valid escapes and must be followed
+//!   by a separator or the end of the line.
+//! - Anything else up to the next separator is a word.
+//!
+//! The first malformed token ends the line: its error is yielded and nothing after it.
+//!
+//! The scanner is a three-state machine. [`State::Token`] starts a token, [`State::Value`] scans the
+//! value right after a `=`, and [`State::Done`] is entered at the end of the line or after an error.
+//! Each token kind has its own scanning method; the helpers at the bottom hold the byte-level rules.
+
 use crate::error::LexError;
 
 /// One piece of a log line, borrowed from the line itself.
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
 pub enum Token<'a> {
     /// The text between `[` and `]`.
     Timestamp(&'a str),
     /// The name in front of `=`.
@@ -15,160 +31,196 @@ pub enum Token<'a> {
     Word(&'a str),
 }
 
 /// Streams the tokens of one line. After the first error it yields nothing more.
 #[derive(Debug, Clone)]
