+
+/// What the scanner expects next.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum State {
+    /// The start of a token: a timestamp, a key, a word, or an error.
+    Token,
+    /// Right after `key=`: the value of the pair.
+    Value,
+    /// The line has ended or failed; nothing more is yielded.
+    Done,
 }
 
 impl<'a> Tokens<'a> {
     pub fn new(src: &'a str) -> Self {
-        Tokens { src, pos: 0, st: 0 }
+        Tokens {
+            src,
+            pos: 0,
+            state: State::Token,
+        }
+    }
+
+    /// Scans a token that starts at the current position, which holds a byte that is not a blank.
+    fn scan_token(&mut self) -> Result<Token<'a>, LexError> {
+        let start = self.pos;
+        let b = self.src.as_bytes();
+        match b[start] {
+            b'[' => self.scan_timestamp(start),
+            b'"' => Err(LexError::UnexpectedQuote { pos: start }),
+            b'=' => Err(LexError::EmptyKey { pos: start }),
+            _ => self.scan_key_or_word(start),
+        }
+    }
+
+    /// Scans `[...]`, where `open` is the position of the `[`.
+    fn scan_timestamp(&mut self, open: usize) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let b = src.as_bytes();
+        let close = find_timestamp_end(b, open)?;
+        self.pos = end_of_token(b, close)?;
+        Ok(Token::Timestamp(&src[open + 1..close]))
+    }
+
+    /// Scans a name that runs up to `=` (a key) or to a separator (a word).
+    fn scan_key_or_word(&mut self, start: usize) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let b = src.as_bytes();
+        let mut end = start;
+        while end < b.len() && !is_blank(b[end]) && b[end] != b'=' {
+            if b[end] == b'"' {
+                return Err(LexError::UnexpectedQuote { pos: end });
+            }
+            end += 1;
+        }
+        if b.get(end) == Some(&b'=') {
+            self.state = State::Value;
+            self.pos = end + 1;
+            Ok(Token::Key(&src[start..end]))
+        } else {
+            self.pos = end;
+            Ok(Token::Word(&src[start..end]))
+        }
+    }
+
+    /// Scans the value that follows a `=`. An empty value is a bare token that consumes nothing.
+    fn scan_value(&mut self) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let b = src.as_bytes();
+        let start = self.pos;
+        self.state = State::Token;
+        match b.get(start) {
+            Some(b'"') => self.scan_quoted(start),
+            Some(&c) if !is_blank(c) => self.scan_bare(start),
+            _ => Ok(Token::Bare(&src[start..start])),
+        }
+    }
+
+    /// Scans `"..."`, where `open` is the position of the opening quote.
+    fn scan_quoted(&mut self, open: usize) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let b = src.as_bytes();
+        let close = find_quoted_end(b, open)?;
+        self.pos = end_of_token(b, close)?;
+        Ok(Token::Quoted(&src[open + 1..close]))
+    }
+
+    /// Scans an unquoted value up to the next separator. Unlike a key, it may contain `=`.
+    fn scan_bare(&mut self, start: usize) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let b = src.as_bytes();
+        let mut end = start;
+        while end < b.len() && !is_blank(b[end]) {
+            if b[end] == b'"' {
+                return Err(LexError::UnexpectedQuote { pos: end });
+            }
+            end += 1;
+        }
+        self.pos = end;
+        Ok(Token::Bare(&src[start..end]))
+    }
+
+    /// Marks the line as finished. Every way out of the line leaves the position at its end.
+    fn finish(&mut self) {
+        self.state = State::Done;
+        self.pos = self.src.len();
     }
 }
 
 /// Tokenizes one log line without copying any of it.
 pub fn tokenize(line: &str) -> Tokens<'_> {
     Tokens::new(line)
 }
 
