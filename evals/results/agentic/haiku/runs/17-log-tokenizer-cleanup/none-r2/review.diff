index 35088c9..45d3132 100644
--- a/tests/tokens.rs
+++ b/tests/tokens.rs
@@ -61,15 +61,53 @@ fn unterminated_quote_is_an_error() {
 #[test]
 fn unterminated_timestamp_is_an_error() {
     assert_eq!(
         tokens("[2024-05-01 level=info"),
         Err(LexError::UnterminatedTimestamp { pos: 0 })
     );
 }
 
+#[test]
+fn each_error_reports_its_position() {
+    assert_eq!(tokens("[a[b]"), Err(LexError::NestedBracket { pos: 2 }));
+    assert_eq!(tokens("[a]b"), Err(LexError::ExpectedSeparator { pos: 3 }));
+    assert_eq!(tokens("x\"y"), Err(LexError::UnexpectedQuote { pos: 1 }));
+    assert_eq!(tokens("\"x\""), Err(LexError::UnexpectedQuote { pos: 0 }));
+    assert_eq!(tokens("=x"), Err(LexError::EmptyKey { pos: 0 }));
+    assert_eq!(tokens("k=a\"b"), Err(LexError::UnexpectedQuote { pos: 3 }));
+    assert_eq!(tokens("k=\"a\"b"), Err(LexError::ExpectedSeparator { pos: 5 }));
+    assert_eq!(tokens("k=\"a\\x\""), Err(LexError::InvalidEscape { pos: 4 }));
+    assert_eq!(tokens("k=\"a\\"), Err(LexError::UnterminatedQuote { pos: 2 }));
+}
+
+#[test]
+fn empty_values_and_separators() {
+    assert_eq!(
+        tokens("a= b=\"\" c=d\te="),
+        Ok(vec![
+            Token::Key("a"),
+            Token::Bare(""),
+            Token::Key("b"),
+            Token::Quoted(""),
+            Token::Key("c"),
+            Token::Bare("d"),
+            Token::Key("e"),
+            Token::Bare(""),
+        ])
+    );
+}
+
+#[test]
+fn bare_values_may_contain_equals_signs() {
+    assert_eq!(
+        tokens("k=a=b"),
+        Ok(vec![Token::Key("k"), Token::Bare("a=b")])
+    );
+}
+
 #[test]
 fn iteration_stops_after_an_error() {
     let mut stream = tokenize("ok =bad later=1");
     assert_eq!(stream.next(), Some(Ok(Token::Word("ok"))));
     assert_eq!(stream.next(), Some(Err(LexError::EmptyKey { pos: 3 })));
     assert_eq!(stream.next(), None);
 }
