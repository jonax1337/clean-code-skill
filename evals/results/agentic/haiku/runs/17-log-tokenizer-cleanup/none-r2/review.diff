+fn is_blank(c: u8) -> bool {
+    c == b' ' || c == b'\t'
+}
+
+/// The first position at or after `i` that is not a space or tab.
+fn skip_blanks(b: &[u8], mut i: usize) -> usize {
+    while i < b.len() && is_blank(b[i]) {
+        i += 1;
+    }
+    i
+}
+
+/// The position of the `]` that closes the timestamp opened at `open`.
+fn find_timestamp_end(b: &[u8], open: usize) -> Result<usize, LexError> {
+    let mut i = open + 1;
+    loop {
+        match b.get(i) {
+            None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+            Some(b']') => return Ok(i),
+            Some(b'[') => return Err(LexError::NestedBracket { pos: i }),
+            Some(_) => i += 1,
         }
     }
 }
+
+/// The position of the `"` that closes the quoted value opened at `open`, stepping over escapes.
+fn find_quoted_end(b: &[u8], open: usize) -> Result<usize, LexError> {
+    let mut i = open + 1;
+    loop {
+        match b.get(i) {
+            None => return Err(LexError::UnterminatedQuote { pos: open }),
+            Some(b'"') => return Ok(i),
+            Some(b'\\') => match b.get(i + 1) {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                Some(_) => return Err(LexError::InvalidEscape { pos: i }),
+            },
+            Some(_) => i += 1,
+        }
+    }
+}
+
+/// Checks that a token closed by the character at `close` is followed by a separator or the end of
+/// the line, and returns the position just after `close`.
+fn end_of_token(b: &[u8], close: usize) -> Result<usize, LexError> {
+    let next = close + 1;
+    match b.get(next) {
+        Some(&c) if !is_blank(c) => Err(LexError::ExpectedSeparator { pos: next }),
+        _ => Ok(next),
+    }
+}
