+impl<'a> Tokens<'a> {
+    /// Reads a token that starts at `start`, a byte that is not a blank: a timestamp, a key,
+    /// a word, or a stray character that makes the line malformed.
+    fn read_token(&mut self, start: usize) -> Result<Token<'a>, LexError> {
+        match self.src.as_bytes()[start] {
+            b'[' => self.read_timestamp(start),
+            b'"' => Err(LexError::UnexpectedQuote { pos: start }),
+            b'=' => Err(LexError::EmptyKey { pos: start }),
+            _ => self.read_word_or_key(start),
+        }
+    }
+
+    /// Reads the value that follows a `=`. It is empty when a blank or the end of the line follows.
+    fn read_value(&mut self) -> Result<Token<'a>, LexError> {
+        let bytes = self.src.as_bytes();
+        let start = self.pos;
+        self.state = State::Token;
+        match bytes.get(start) {
+            Some(b'"') => self.read_quoted(start),
+            Some(&c) if !is_blank(c) => self.read_bare(start),
+            _ => Ok(Token::Bare(&self.src[start..start])),
+        }
+    }
+
+    /// `[...]`, which must be followed by a blank or the end of the line.
+    fn read_timestamp(&mut self, open: usize) -> Result<Token<'a>, LexError> {
+        let bytes = self.src.as_bytes();
+        let text_start = open + 1;
+        let mut close = text_start;
+        loop {
+            match bytes.get(close) {
+                None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+                Some(b']') => break,
+                Some(b'[') => return Err(LexError::NestedBracket { pos: close }),
+                Some(_) => close += 1,
             }
-            _ => None,
         }
+        self.expect_separator(close + 1)?;
+        self.pos = close + 1;
+        Ok(Token::Timestamp(&self.src[text_start..close]))
+    }
+
+    /// A run up to a blank. If `=` ends it, the run is a key and a value follows.
+    /// A quote inside the run is an error.
+    fn read_word_or_key(&mut self, start: usize) -> Result<Token<'a>, LexError> {
+        let bytes = self.src.as_bytes();
+        let n = bytes.len();
+        let mut end = start;
+        while end < n && !is_blank(bytes[end]) && bytes[end] != b'=' {
+            if bytes[end] == b'"' {
+                return Err(LexError::UnexpectedQuote { pos: end });
+            }
+            end += 1;
+        }
+        if end < n && bytes[end] == b'=' {
+            self.state = State::Value;
+            self.pos = end + 1;
+            Ok(Token::Key(&self.src[start..end]))
+        } else {
+            self.pos = end;
+            Ok(Token::Word(&self.src[start..end]))
+        }
+    }
+
+    /// `"..."` with the escapes `\"`, `\\`, `\n` and `\t`. The quotes are not part of the token.
+    fn read_quoted(&mut self, open: usize) -> Result<Token<'a>, LexError> {
+        let bytes = self.src.as_bytes();
+        let text_start = open + 1;
+        let mut i = text_start;
+        let close = loop {
+            match bytes.get(i) {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"') => break i,
+                Some(b'\\') => match bytes.get(i + 1) {
+                    None => return Err(LexError::UnterminatedQuote { pos: open }),
+                    Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                    Some(_) => return Err(LexError::InvalidEscape { pos: i }),
+                },
+                Some(_) => i += 1,
+            }
+        };
+        self.expect_separator(close + 1)?;
+        self.pos = close + 1;
+        Ok(Token::Quoted(&self.src[text_start..close]))
+    }
+
+    /// An unquoted value, up to the next blank. A quote inside it is an error.
+    fn read_bare(&mut self, start: usize) -> Result<Token<'a>, LexError> {
+        let bytes = self.src.as_bytes();
+        let mut end = start;
+        while end < bytes.len() && !is_blank(bytes[end]) {
+            if bytes[end] == b'"' {
+                return Err(LexError::UnexpectedQuote { pos: end });
+            }
+            end += 1;
+        }
+        self.pos = end;
+        Ok(Token::Bare(&self.src[start..end]))
+    }
+
+    /// Checks that the byte at `pos`, if there is one, is a blank. Anything else glued to the
+    /// previous token is an error.
+    fn expect_separator(&self, pos: usize) -> Result<(), LexError> {
+        match self.src.as_bytes().get(pos) {
+            Some(&c) if !is_blank(c) => Err(LexError::ExpectedSeparator { pos }),
+            _ => Ok(()),
+        }
+    }
+}
+
+#[inline]
+fn is_blank(c: u8) -> bool {
+    c == b' ' || c == b'\t'
+}
+
+/// The index of the first byte at or after `from` that is not a blank, or the length if there is none.
+#[inline]
+fn skip_blanks(bytes: &[u8], from: usize) -> usize {
+    let mut i = from;
+    while i < bytes.len() && is_blank(bytes[i]) {
+        i += 1;
     }
+    i
 }
