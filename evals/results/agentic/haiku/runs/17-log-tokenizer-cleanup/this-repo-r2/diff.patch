+impl<'a> Tokens<'a> {
+    /// Lexes the token that starts at `self.pos`. That position is neither blank nor the end of the line.
+    #[inline]
+    fn lex_token(&mut self) -> Result<Token<'a>, LexError> {
+        let p = self.pos;
+        match self.src.as_bytes()[p] {
+            b'[' => self.lex_timestamp(p),
+            b'"' => Err(LexError::UnexpectedQuote { pos: p }),
+            b'=' => Err(LexError::EmptyKey { pos: p }),
+            _ => self.lex_key_or_word(p),
+        }
+    }
+
+    /// `[...]` followed by a blank or the end of the line.
+    #[inline]
+    fn lex_timestamp(&mut self, open: usize) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let bytes = src.as_bytes();
+        let close = find_timestamp_end(bytes, open)?;
+        require_separator(bytes, close + 1)?;
+        self.pos = close + 1;
+        Ok(Token::Timestamp(&src[open + 1..close]))
+    }
+
+    /// A word, or a key when the unquoted run is followed by `=`.
+    #[inline]
+    fn lex_key_or_word(&mut self, start: usize) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let bytes = src.as_bytes();
+        let end = scan_unquoted(bytes, start, |c| is_blank(c) || c == b'=')?;
+        if bytes.get(end) == Some(&b'=') {
+            self.state = State::Value;
+            self.pos = end + 1;
+            Ok(Token::Key(&src[start..end]))
+        } else {
+            self.pos = end;
+            Ok(Token::Word(&src[start..end]))
+        }
+    }
+
+    /// The value after `key=`: quoted, bare, or empty.
+    #[inline]
+    fn lex_value(&mut self) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let bytes = src.as_bytes();
+        let p = self.pos;
+        // Every value completes a pair, so the next token starts fresh.
+        self.state = State::Start;
+        if p >= bytes.len() || is_blank(bytes[p]) {
+            // Empty value. The blank is left for the next call to skip.
+            return Ok(Token::Bare(&src[p..p]));
+        }
+        if bytes[p] == b'"' {
+            let close = find_quote_end(bytes, p)?;
+            require_separator(bytes, close + 1)?;
+            self.pos = close + 1;
+            Ok(Token::Quoted(&src[p + 1..close]))
+        } else {
+            let end = scan_unquoted(bytes, p, is_blank)?;
+            self.pos = end;
+            Ok(Token::Bare(&src[p..end]))
+        }
+    }
+}
+
+#[inline]
+fn is_blank(c: u8) -> bool {
+    c == b' ' || c == b'\t'
+}
+
+/// Index of the first byte at or after `from` that is not a blank.
+#[inline]
+fn skip_blanks(bytes: &[u8], from: usize) -> usize {
+    let mut p = from;
+    while p < bytes.len() && is_blank(bytes[p]) {
+        p += 1;
+    }
+    p
+}
+
+/// Index of the `]` that closes the timestamp opened at `open`.
+#[inline]
+fn find_timestamp_end(bytes: &[u8], open: usize) -> Result<usize, LexError> {
+    match bytes[open + 1..]
+        .iter()
+        .position(|&c| c == b']' || c == b'[')
+    {
+        Some(offset) => {
+            let i = open + 1 + offset;
+            if bytes[i] == b'[' {
+                Err(LexError::NestedBracket { pos: i })
+            } else {
+                Ok(i)
+            }
+        }
+        None => Err(LexError::UnterminatedTimestamp { pos: open }),
+    }
+}
+
+/// Index of the `"` that closes the quoted value opened at `open`. Only `\"`, `\\`, `\n` and `\t` may be escaped.
+#[inline]
+fn find_quote_end(bytes: &[u8], open: usize) -> Result<usize, LexError> {
+    let unterminated = LexError::UnterminatedQuote { pos: open };
+    let mut i = open + 1;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'"' => return Ok(i),
+            b'\\' => {
+                let Some(&escaped) = bytes.get(i + 1) else {
+                    return Err(unterminated);
+                };
+                if !matches!(escaped, b'"' | b'\\' | b'n' | b't') {
+                    return Err(LexError::InvalidEscape { pos: i });
                 }
+                i += 2;
             }
-            _ => None,
+            _ => i += 1,
+        }
+    }
+    Err(unterminated)
+}
+
+/// Index of the first byte at or after `from` that satisfies `is_end`, or the end of the line.
+/// A `"` before that point is an error, because unquoted text may not contain quotes.
+#[inline]
+fn scan_unquoted(
+    bytes: &[u8],
+    from: usize,
+    is_end: impl Fn(u8) -> bool,
+) -> Result<usize, LexError> {
+    let mut i = from;
+    while i < bytes.len() && !is_end(bytes[i]) {
+        if bytes[i] == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: i });
         }
+        i += 1;
+    }
+    Ok(i)
+}
+
+/// A timestamp or quoted value must be followed by a blank or the end of the line.
+#[inline]
+fn require_separator(bytes: &[u8], at: usize) -> Result<(), LexError> {
+    match bytes.get(at) {
+        Some(&c) if !is_blank(c) => Err(LexError::ExpectedSeparator { pos: at }),
+        _ => Ok(()),
     }
 }
