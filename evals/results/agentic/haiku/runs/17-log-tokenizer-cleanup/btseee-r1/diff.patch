+
+fn is_blank(byte: u8) -> bool {
+    byte == b' ' || byte == b'\t'
+}
+
+/// Scans unquoted text from `from` up to the first byte that satisfies `is_stop`, or the end of
+/// the line. A double quote inside unquoted text is an error.
+fn scan_unquoted(
+    bytes: &[u8],
+    from: usize,
+    is_stop: impl Fn(u8) -> bool,
+) -> Result<usize, LexError> {
+    let mut end = from;
+    while let Some(&byte) = bytes.get(end) {
+        if is_stop(byte) {
+            break;
+        }
+        if byte == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: end });
+        }
+        end += 1;
+    }
+    Ok(end)
+}
+
+/// Checks that the byte at `at`, if any, is a blank.
+fn expect_separator(bytes: &[u8], at: usize) -> Result<(), LexError> {
+    match bytes.get(at) {
+        Some(&byte) if !is_blank(byte) => Err(LexError::ExpectedSeparator { pos: at }),
+        _ => Ok(()),
     }
 }
diff --git a/tests/tokens.rs b/tests/tokens.rs
index 35088c9..9a25edf 100644
--- a/tests/tokens.rs
+++ b/tests/tokens.rs
@@ -68,8 +68,69 @@ fn unterminated_timestamp_is_an_error() {
 
 #[test]
 fn iteration_stops_after_an_error() {
     let mut stream = tokenize("ok =bad later=1");
     assert_eq!(stream.next(), Some(Ok(Token::Word("ok"))));
     assert_eq!(stream.next(), Some(Err(LexError::EmptyKey { pos: 3 })));
     assert_eq!(stream.next(), None);
 }
+
+#[test]
+fn bare_values_may_contain_equals_signs() {
+    assert_eq!(
+        tokens("k=a=b").unwrap(),
+        vec![Token::Key("k"), Token::Bare("a=b")]
+    );
+}
+
+#[test]
+fn empty_quoted_value_is_allowed() {
+    assert_eq!(tokens("k=\"\"").unwrap(), vec![Token::Key("k"), Token::Quoted("")]);
+}
+
+#[test]
+fn invalid_escape_points_at_the_backslash() {
+    assert_eq!(
+        tokens(r#"msg="a\q""#),
+        Err(LexError::InvalidEscape { pos: 6 })
+    );
+}
+
+#[test]
+fn trailing_backslash_in_quote_is_unterminated() {
+    assert_eq!(
+        tokens(r#"k="ab\"#),
+        Err(LexError::UnterminatedQuote { pos: 2 })
+    );
+}
+
+#[test]
+fn text_after_a_closing_quote_must_be_separated() {
+    assert_eq!(
+        tokens("msg=\"a\"b"),
+        Err(LexError::ExpectedSeparator { pos: 7 })
+    );
+}
+
+#[test]
+fn text_after_a_closing_bracket_must_be_separated() {
+    assert_eq!(
+        tokens("[2024]x"),
+        Err(LexError::ExpectedSeparator { pos: 6 })
+    );
+}
+
+#[test]
+fn nested_bracket_is_an_error() {
+    assert_eq!(tokens("[a[b]"), Err(LexError::NestedBracket { pos: 2 }));
+}
+
+#[test]
+fn quote_inside_a_word_or_bare_value_is_an_error() {
+    assert_eq!(tokens("ab\"c"), Err(LexError::UnexpectedQuote { pos: 2 }));
+    assert_eq!(tokens("k=a\"b"), Err(LexError::UnexpectedQuote { pos: 3 }));
+}
+
+#[test]
+fn quote_at_token_start_is_an_error() {
+    assert_eq!(tokens("\"x\""), Err(LexError::UnexpectedQuote { pos: 0 }));
+}
