+    fn skip_blanks(&mut self) {
+        let bytes = self.src.as_bytes();
+        while self.pos < bytes.len() && is_blank(bytes[self.pos]) {
+            self.pos += 1;
+        }
+    }
+
+    /// Lexes the token at `self.pos`, which is neither blank nor past the end.
+    fn lex_token(&mut self) -> Result<Token<'a>, LexError> {
+        let pos = self.pos;
+        match self.src.as_bytes()[pos] {
+            b'[' => self.lex_timestamp(),
+            b'"' => Err(LexError::UnexpectedQuote { pos }),
+            b'=' => Err(LexError::EmptyKey { pos }),
+            _ => self.lex_key_or_word(),
+        }
+    }
+
+    /// `[text]`, which must be followed by a blank or the end of the line.
+    fn lex_timestamp(&mut self) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let bytes = src.as_bytes();
+        let open = self.pos;
+        let text_start = open + 1;
+        let mut close = text_start;
+        loop {
+            match bytes.get(close) {
+                None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+                Some(b']') => break,
+                Some(b'[') => return Err(LexError::NestedBracket { pos: close }),
+                Some(_) => close += 1,
+            }
+        }
+        expect_separator(bytes, close + 1)?;
+        self.pos = close + 1;
+        Ok(Token::Timestamp(&src[text_start..close]))
+    }
+
+    /// `key=`, which switches to `AfterEquals`, or a word running up to the next blank.
+    fn lex_key_or_word(&mut self) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let bytes = src.as_bytes();
+        let start = self.pos;
+        let end = scan_unquoted(bytes, start, |byte| is_blank(byte) || byte == b'=')?;
+        if bytes.get(end) == Some(&b'=') {
+            self.pos = end + 1;
+            self.state = State::AfterEquals;
+            Ok(Token::Key(&src[start..end]))
+        } else {
+            self.pos = end;
+            Ok(Token::Word(&src[start..end]))
+        }
+    }
+
+    /// The value after `=`: quoted, bare, or empty when a blank or the end of the line follows.
+    fn lex_value(&mut self) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let bytes = src.as_bytes();
+        let start = self.pos;
+        self.state = State::Between;
+        match bytes.get(start) {
+            None => Ok(Token::Bare("")),
+            Some(&byte) if is_blank(byte) => Ok(Token::Bare("")),
+            Some(b'"') => self.lex_quoted(),
+            Some(_) => {
+                let end = scan_unquoted(bytes, start, is_blank)?;
+                self.pos = end;
+                Ok(Token::Bare(&src[start..end]))
+            }
+        }
+    }
+
+    /// `"text"`. Only `\"`, `\\`, `\n` and `\t` may be escaped; the escapes stay in the token.
+    fn lex_quoted(&mut self) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let bytes = src.as_bytes();
+        let open = self.pos;
+        let text_start = open + 1;
+        let mut close = text_start;
+        loop {
+            match bytes.get(close) {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"') => break,
+                Some(b'\\') => match bytes.get(close + 1) {
+                    None => return Err(LexError::UnterminatedQuote { pos: open }),
+                    Some(b'"' | b'\\' | b'n' | b't') => close += 2,
+                    Some(_) => return Err(LexError::InvalidEscape { pos: close }),
+                },
+                Some(_) => close += 1,
+            }
+        }
+        expect_separator(bytes, close + 1)?;
+        self.pos = close + 1;
+        Ok(Token::Quoted(&src[text_start..close]))
     }
 }
 
