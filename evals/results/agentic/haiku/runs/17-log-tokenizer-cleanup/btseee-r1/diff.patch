+/// What the lexer expects next. Each token kind has its own method; `Tokens::next` picks one.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum State {
+    /// Between tokens: a timestamp, a key, a word or an error comes next.
+    Between,
+    /// Right after a `=`: a value comes next, and it may be empty.
+    AfterEquals,
+    /// The line is finished, or an error was returned.
+    Done,
 }
 
