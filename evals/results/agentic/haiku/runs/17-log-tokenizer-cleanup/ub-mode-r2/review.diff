index 35088c9..4df939d 100644
--- a/tests/tokens.rs
+++ b/tests/tokens.rs
@@ -68,8 +68,69 @@ fn unterminated_timestamp_is_an_error() {
 
 #[test]
 fn iteration_stops_after_an_error() {
     let mut stream = tokenize("ok =bad later=1");
     assert_eq!(stream.next(), Some(Ok(Token::Word("ok"))));
     assert_eq!(stream.next(), Some(Err(LexError::EmptyKey { pos: 3 })));
     assert_eq!(stream.next(), None);
 }
+
+#[test]
+fn every_error_reports_the_byte_offset_it_failed_at() {
+    assert_eq!(tokens("[a[b]"), Err(LexError::NestedBracket { pos: 2 }));
+    assert_eq!(tokens("[a]x"), Err(LexError::ExpectedSeparator { pos: 3 }));
+    assert_eq!(tokens("\"x"), Err(LexError::UnexpectedQuote { pos: 0 }));
+    assert_eq!(tokens("=x"), Err(LexError::EmptyKey { pos: 0 }));
+    assert_eq!(tokens("a b =c"), Err(LexError::EmptyKey { pos: 4 }));
+    assert_eq!(tokens("ab\"c"), Err(LexError::UnexpectedQuote { pos: 2 }));
+    assert_eq!(tokens("a\"b=c"), Err(LexError::UnexpectedQuote { pos: 1 }));
+    assert_eq!(tokens("k=a\"b"), Err(LexError::UnexpectedQuote { pos: 3 }));
+    assert_eq!(tokens(r#"k="a\x""#), Err(LexError::InvalidEscape { pos: 4 }));
+    assert_eq!(tokens(r#"k="a\"#), Err(LexError::UnterminatedQuote { pos: 2 }));
+    assert_eq!(tokens(r#"k="abc\""#), Err(LexError::UnterminatedQuote { pos: 2 }));
+    assert_eq!(tokens(r#"k="a"b"#), Err(LexError::ExpectedSeparator { pos: 5 }));
+    assert_eq!(tokens("[t]=x"), Err(LexError::ExpectedSeparator { pos: 3 }));
+}
+
+#[test]
+fn empty_values_are_bare_or_quoted_and_empty() {
+    assert_eq!(
+        tokens("k= x=1").unwrap(),
+        vec![Token::Key("k"), Token::Bare(""), Token::Key("x"), Token::Bare("1")]
+    );
+    assert_eq!(tokens("k=").unwrap(), vec![Token::Key("k"), Token::Bare("")]);
+    assert_eq!(tokens(r#"k="""#).unwrap(), vec![Token::Key("k"), Token::Quoted("")]);
+    assert_eq!(tokens("[]").unwrap(), vec![Token::Timestamp("")]);
+}
+
+#[test]
+fn quoted_values_may_hold_separators_and_brackets() {
+    assert_eq!(
+        tokens(r#"k="[=] \t a b""#).unwrap(),
+        vec![Token::Key("k"), Token::Quoted(r"[=] \t a b")]
+    );
+}
+
+#[test]
+fn bare_values_keep_equals_signs_and_words_keep_brackets() {
+    assert_eq!(
+        tokens("k=a=b").unwrap(),
+        vec![Token::Key("k"), Token::Bare("a=b")]
+    );
+    assert_eq!(
+        tokens("a=b=c a[b").unwrap(),
+        vec![Token::Key("a"), Token::Bare("b=c"), Token::Word("a[b")]
+    );
+}
+
+#[test]
+fn leading_and_trailing_blanks_yield_no_extra_tokens() {
+    assert_eq!(tokens("\t a \t").unwrap(), vec![Token::Word("a")]);
+}
+
+#[test]
+fn multibyte_text_is_kept_whole() {
+    assert_eq!(
+        tokens("é=ü wörd").unwrap(),
+        vec![Token::Key("é"), Token::Bare("ü"), Token::Word("wörd")]
+    );
+}
