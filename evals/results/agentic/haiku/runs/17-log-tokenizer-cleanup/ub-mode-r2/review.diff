+
+/// What the next token may be, as decided by the token before it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum State {
+    /// Between tokens.
+    Start,
+    /// Right after `key=`.
+    Value,
+    /// The line ended or failed.
+    Done,
 }
 
+/// A token that was recognized, the offset just past it, and the state that follows.
+struct Scanned<'a> {
+    token: Token<'a>,
+    end: usize,
+    next: State,
+}
+
+type Scan<'a> = Result<Scanned<'a>, LexError>;
+
 impl<'a> Tokens<'a> {
     pub fn new(src: &'a str) -> Self {
-        Tokens { src, pos: 0, st: 0 }
+        Tokens { src, pos: 0, state: State::Start }
+    }
+
+    /// Moves past a scanned token. On error the stream is finished.
+    fn emit(&mut self, scan: Scan<'a>) -> Result<Token<'a>, LexError> {
+        match scan {
+            Ok(found) => {
+                self.pos = found.end;
+                self.state = found.next;
+                Ok(found.token)
+            }
+            Err(error) => {
+                self.state = State::Done;
+                Err(error)
+            }
+        }
     }
 }
 
 /// Tokenizes one log line without copying any of it.
 pub fn tokenize(line: &str) -> Tokens<'_> {
     Tokens::new(line)
 }
 
