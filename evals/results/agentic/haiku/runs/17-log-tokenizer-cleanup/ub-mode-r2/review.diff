+//! Splits one log line into tokens.
+//!
+//! Tokens are separated by spaces or tabs. The tokenizer keeps a [`State`] that says what the next token
+//! may be:
+//!
+//! - `Start`: `[text]` is a timestamp, `key=` opens a pair, and anything else up to a separator is a word.
+//! - `Value`: the value of the pair just opened, bare or `"quoted"`. An empty bare value is allowed.
+//!
+//! Every token must be followed by a separator or the end of the line. The first error ends the stream.
+//!
+//! To add a form to the line format, write a `scan_*` function for it and route to it from [`scan_start`]
+//! or [`scan_value`].
+
 use crate::error::LexError;
 
 /// One piece of a log line, borrowed from the line itself.
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
 pub enum Token<'a> {
     /// The text between `[` and `]`.
     Timestamp(&'a str),
     /// The name in front of `=`.
