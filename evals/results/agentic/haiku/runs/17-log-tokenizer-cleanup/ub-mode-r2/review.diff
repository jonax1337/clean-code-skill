+
+fn is_blank(c: u8) -> bool {
+    c == b' ' || c == b'\t'
+}
+
+fn skip_blanks(b: &[u8], mut p: usize) -> usize {
+    while p < b.len() && is_blank(b[p]) {
+        p += 1;
+    }
+    p
+}
+
+/// A token must be followed by a separator or the end of the line.
+fn expect_separator(b: &[u8], at: usize) -> Result<(), LexError> {
+    match b.get(at).copied() {
+        Some(c) if !is_blank(c) => Err(LexError::ExpectedSeparator { pos: at }),
+        _ => Ok(()),
+    }
+}
+
+/// Walks over plain text from `start` until `halts` is true, rejecting a quote on the way.
+/// Returns the offset where the run stops.
+#[inline]
+fn plain_run(b: &[u8], start: usize, halts: impl Fn(u8) -> bool) -> Result<usize, LexError> {
+    let mut i = start;
+    while i < b.len() && !halts(b[i]) {
+        if b[i] == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: i });
+        }
+        i += 1;
+    }
+    Ok(i)
+}
+
+/// Scans the token at `p`, which is neither blank nor past the end.
+fn scan_start(src: &str, p: usize) -> Scan<'_> {
+    match src.as_bytes()[p] {
+        b'[' => scan_timestamp(src, p),
+        b'"' => Err(LexError::UnexpectedQuote { pos: p }),
+        b'=' => Err(LexError::EmptyKey { pos: p }),
+        _ => scan_key_or_word(src, p),
+    }
+}
+
+/// Scans the value of the pair whose `=` ends just before `p`.
+fn scan_value(src: &str, p: usize) -> Scan<'_> {
+    match src.as_bytes().get(p).copied() {
+        None | Some(b' ' | b'\t') => Ok(Scanned { token: Token::Bare(&src[p..p]), end: p, next: State::Start }),
+        Some(b'"') => scan_quoted(src, p),
+        Some(_) => scan_bare(src, p),
+    }
+}
+
+fn scan_timestamp(src: &str, open: usize) -> Scan<'_> {
+    let b = src.as_bytes();
+    let close = closing_bracket(b, open)?;
+    expect_separator(b, close + 1)?;
+    Ok(Scanned { token: Token::Timestamp(&src[open + 1..close]), end: close + 1, next: State::Start })
+}
+
+fn scan_quoted(src: &str, open: usize) -> Scan<'_> {
+    let b = src.as_bytes();
+    let close = closing_quote(b, open)?;
+    expect_separator(b, close + 1)?;
+    Ok(Scanned { token: Token::Quoted(&src[open + 1..close]), end: close + 1, next: State::Start })
+}
+
+fn scan_bare(src: &str, start: usize) -> Scan<'_> {
+    let end = plain_run(src.as_bytes(), start, is_blank)?;
+    Ok(Scanned { token: Token::Bare(&src[start..end]), end, next: State::Start })
+}
+
+fn scan_key_or_word(src: &str, start: usize) -> Scan<'_> {
+    let b = src.as_bytes();
+    let end = plain_run(b, start, |c| is_blank(c) || c == b'=')?;
+    if b.get(end).copied() == Some(b'=') {
+        Ok(Scanned { token: Token::Key(&src[start..end]), end: end + 1, next: State::Value })
+    } else {
+        Ok(Scanned { token: Token::Word(&src[start..end]), end, next: State::Start })
+    }
+}
+
+/// Offset of the `]` that closes the timestamp opened at `open`.
+fn closing_bracket(b: &[u8], open: usize) -> Result<usize, LexError> {
+    let mut i = open + 1;
+    loop {
+        match b.get(i).copied() {
+            None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+            Some(b']') => return Ok(i),
+            Some(b'[') => return Err(LexError::NestedBracket { pos: i }),
+            Some(_) => i += 1,
+        }
+    }
+}
+
+/// Offset of the `"` that closes the value opened at `open`, stepping over valid escapes.
+fn closing_quote(b: &[u8], open: usize) -> Result<usize, LexError> {
+    let mut i = open + 1;
+    loop {
+        match b.get(i).copied() {
+            None => return Err(LexError::UnterminatedQuote { pos: open }),
+            Some(b'"') => return Ok(i),
+            Some(b'\\') => match b.get(i + 1).copied() {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                Some(_) => return Err(LexError::InvalidEscape { pos: i }),
+            },
+            Some(_) => i += 1,
         }
     }
 }
