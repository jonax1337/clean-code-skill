+    /// Reads `[...]` whose opening bracket is at `open`.
+    fn timestamp(&mut self, open: usize) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let b = src.as_bytes();
+        let start = open + 1;
+        let mut close = start;
+        loop {
+            match b.get(close) {
+                None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+                Some(b']') => break,
+                Some(b'[') => return Err(LexError::NestedBracket { pos: close }),
+                Some(_) => close += 1,
+            }
+        }
+        expect_separator(b, close + 1)?;
+        self.pos = close + 1;
+        Ok(Token::Timestamp(&src[start..close]))
