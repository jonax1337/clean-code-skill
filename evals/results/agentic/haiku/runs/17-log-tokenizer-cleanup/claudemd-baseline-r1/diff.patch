+    /// Reads the token that starts at `p`, the first non-blank byte of a field.
+    fn start_token(&mut self, p: usize) -> Result<Token<'a>, LexError> {
+        match self.src.as_bytes()[p] {
+            b'[' => self.timestamp(p),
+            b'"' => Err(LexError::UnexpectedQuote { pos: p }),
+            b'=' => Err(LexError::EmptyKey { pos: p }),
+            _ => self.key_or_word(p),
+        }
+    }
