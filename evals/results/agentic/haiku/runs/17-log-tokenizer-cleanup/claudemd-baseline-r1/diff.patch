+    /// Reads a bare value starting at `start`, which runs up to the next blank.
+    fn bare(&mut self, start: usize) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let end = scan_run(src.as_bytes(), start, is_blank)?;
+        self.pos = end;
+        Ok(Token::Bare(&src[start..end]))
+    }
