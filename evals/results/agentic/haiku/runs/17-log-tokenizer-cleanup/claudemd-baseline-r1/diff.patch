@@ -61,15 +61,64 @@ fn unterminated_quote_is_an_error() {
 #[test]
 fn unterminated_timestamp_is_an_error() {
     assert_eq!(
         tokens("[2024-05-01 level=info"),
         Err(LexError::UnterminatedTimestamp { pos: 0 })
     );
 }
 
+#[test]
+fn nested_bracket_is_an_error() {
+    assert_eq!(tokens("[a[b]"), Err(LexError::NestedBracket { pos: 2 }));
+}
+
+#[test]
+fn timestamp_must_be_followed_by_a_separator() {
+    assert_eq!(tokens("[x]y"), Err(LexError::ExpectedSeparator { pos: 3 }));
+    assert_eq!(tokens("[x]"), Ok(vec![Token::Timestamp("x")]));
+    assert_eq!(tokens("[]"), Ok(vec![Token::Timestamp("")]));
+}
+
+#[test]
+fn quote_outside_a_value_is_an_error() {
+    assert_eq!(tokens("\"x\""), Err(LexError::UnexpectedQuote { pos: 0 }));
+    assert_eq!(tokens("ab\"c"), Err(LexError::UnexpectedQuote { pos: 2 }));
+    assert_eq!(tokens("a=x\"y"), Err(LexError::UnexpectedQuote { pos: 3 }));
+}
+
+#[test]
+fn missing_key_is_an_error() {
+    assert_eq!(tokens("=x"), Err(LexError::EmptyKey { pos: 0 }));
+}
+
+#[test]
+fn unknown_escape_is_an_error() {
+    assert_eq!(tokens(r#"a="x\q""#), Err(LexError::InvalidEscape { pos: 4 }));
+}
+
+#[test]
+fn quoted_value_must_be_followed_by_a_separator() {
+    assert_eq!(tokens(r#"a="x"b"#), Err(LexError::ExpectedSeparator { pos: 5 }));
+}
+
+#[test]
+fn value_ending_in_a_backslash_is_unterminated() {
+    assert_eq!(tokens(r#"a="x\"#), Err(LexError::UnterminatedQuote { pos: 2 }));
+}
+
+#[test]
+fn empty_values_and_equals_signs_in_values() {
+    assert_eq!(
+        tokens("a= b=1"),
+        Ok(vec![Token::Key("a"), Token::Bare(""), Token::Key("b"), Token::Bare("1")])
+    );
+    assert_eq!(tokens("a="), Ok(vec![Token::Key("a"), Token::Bare("")]));
+    assert_eq!(tokens("a=b=c"), Ok(vec![Token::Key("a"), Token::Bare("b=c")]));
+}
+
 #[test]
 fn iteration_stops_after_an_error() {
     let mut stream = tokenize("ok =bad later=1");
     assert_eq!(stream.next(), Some(Ok(Token::Word("ok"))));
     assert_eq!(stream.next(), Some(Err(LexError::EmptyKey { pos: 3 })));
     assert_eq!(stream.next(), None);
 }
