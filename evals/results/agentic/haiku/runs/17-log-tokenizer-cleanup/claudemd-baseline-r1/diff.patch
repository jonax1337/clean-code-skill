+
+fn is_blank(c: u8) -> bool {
+    c == b' ' || c == b'\t'
+}
+
+/// The first index at or after `from` that is not a blank.
+fn skip_blanks(b: &[u8], mut from: usize) -> usize {
+    while from < b.len() && is_blank(b[from]) {
+        from += 1;
+    }
+    from
+}
+
+/// Scans forward from `from` to the first byte that satisfies `ends`, or to the end of the line.
+/// A `"` before that point is an error, since quotes may only open a value.
+fn scan_run(b: &[u8], mut from: usize, ends: impl Fn(u8) -> bool) -> Result<usize, LexError> {
+    while from < b.len() {
+        let c = b[from];
+        if c == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: from });
+        }
+        if ends(c) {
+            break;
+        }
+        from += 1;
+    }
+    Ok(from)
+}
+
+/// Finds the closing quote of the value opened at `open`, checking its escapes on the way.
+fn closing_quote(b: &[u8], open: usize) -> Result<usize, LexError> {
+    let mut i = open + 1;
+    loop {
+        match b.get(i) {
+            None => return Err(LexError::UnterminatedQuote { pos: open }),
+            Some(b'"') => return Ok(i),
+            Some(b'\\') => match b.get(i + 1) {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                Some(_) => return Err(LexError::InvalidEscape { pos: i }),
+            },
+            Some(_) => i += 1,
+        }
+    }
+}
+
+/// A token must be followed by a blank or the end of the line; `at` is the byte right after it.
+fn expect_separator(b: &[u8], at: usize) -> Result<(), LexError> {
+    match b.get(at) {
+        Some(&c) if !is_blank(c) => Err(LexError::ExpectedSeparator { pos: at }),
+        _ => Ok(()),
     }
 }
