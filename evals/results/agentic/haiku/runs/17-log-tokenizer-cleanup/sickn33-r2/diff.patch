+/// The index of the first byte at or after `from` that is not a blank.
+#[inline]
+fn skip_blanks(bytes: &[u8], mut from: usize) -> usize {
+    while bytes.get(from).is_some_and(|&byte| is_blank(byte)) {
+        from += 1;
     }
