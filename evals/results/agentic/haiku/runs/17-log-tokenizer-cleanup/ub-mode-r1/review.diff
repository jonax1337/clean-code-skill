+/// Scans the token that starts at `p`, which is not blank and is inside the line.
+fn scan_start(src: &str, p: usize) -> Scanned<'_> {
+    match src.as_bytes()[p] {
+        b'[' => scan_timestamp(src, p),
+        b'"' => Err(LexError::UnexpectedQuote { pos: p }),
+        b'=' => Err(LexError::EmptyKey { pos: p }),
+        _ => scan_key_or_word(src, p),
+    }
+}
+
+/// Scans the value that follows a `=`, which is empty when a blank or the end comes first.
+#[inline(always)]
+fn scan_value(src: &str, p: usize) -> Scanned<'_> {
+    let b = src.as_bytes();
+    match b.get(p).copied() {
+        Some(b'"') => scan_quoted(src, p),
+        Some(c) if !is_blank(c) => {
+            let end = run_until(b, p, is_blank)?;
+            Ok((Token::Bare(&src[p..end]), end))
         }
+        _ => Ok((Token::Bare(&src[p..p]), p)),
     }
 }
+
+/// Scans `[...]` where `open` is the index of the `[`.
+fn scan_timestamp(src: &str, open: usize) -> Scanned<'_> {
+    let b = src.as_bytes();
+    let start = open + 1;
+    let mut close = start;
+    loop {
+        match b.get(close).copied() {
+            None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+            Some(b']') => break,
+            Some(b'[') => return Err(LexError::NestedBracket { pos: close }),
+            Some(_) => close += 1,
+        }
+    }
+    expect_separator(b, close + 1)?;
+    Ok((Token::Timestamp(&src[start..close]), close + 1))
+}
+
+/// Scans `"..."` where `open` is the index of the opening quote.
+fn scan_quoted(src: &str, open: usize) -> Scanned<'_> {
+    let b = src.as_bytes();
+    let start = open + 1;
+    let close = find_closing_quote(b, start, open)?;
+    expect_separator(b, close + 1)?;
+    Ok((Token::Quoted(&src[start..close]), close + 1))
+}
+
+/// Finds the quote that ends a quoted value, stepping over each valid escape pair.
+fn find_closing_quote(b: &[u8], start: usize, open: usize) -> Result<usize, LexError> {
+    let mut i = start;
+    loop {
+        match b.get(i).copied() {
+            None => return Err(LexError::UnterminatedQuote { pos: open }),
+            Some(b'"') => return Ok(i),
+            Some(b'\\') => match b.get(i + 1).copied() {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                Some(_) => return Err(LexError::InvalidEscape { pos: i }),
+            },
+            Some(_) => i += 1,
+        }
+    }
+}
+
+/// Scans a run that ends at a `=` (a key) or at a blank or the end (a word).
+#[inline(always)]
+fn scan_key_or_word(src: &str, start: usize) -> Scanned<'_> {
+    let b = src.as_bytes();
+    let end = run_until(b, start, |c| is_blank(c) || c == b'=')?;
+    if b.get(end) == Some(&b'=') {
+        Ok((Token::Key(&src[start..end]), end + 1))
+    } else {
+        Ok((Token::Word(&src[start..end]), end))
+    }
+}
+
+/// Advances from `from` to the first byte that `ends` accepts, or to the end of the line.
+/// A `"` on the way is an error, because quotes only start a value.
+// Inlined on purpose: this loop is the hot path of every line.
+#[inline(always)]
+fn run_until(b: &[u8], from: usize, ends: impl Fn(u8) -> bool) -> Result<usize, LexError> {
+    let mut i = from;
+    while let Some(&c) = b.get(i) {
+        if ends(c) {
+            return Ok(i);
+        }
+        if c == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: i });
+        }
+        i += 1;
+    }
+    Ok(i)
+}
+
+/// A token must be followed by a blank or the end of the line.
+#[inline(always)]
+fn expect_separator(b: &[u8], at: usize) -> Result<(), LexError> {
+    match b.get(at) {
+        Some(&c) if !is_blank(c) => Err(LexError::ExpectedSeparator { pos: at }),
+        _ => Ok(()),
+    }
+}
+
+fn skip_blanks(b: &[u8], mut p: usize) -> usize {
+    while b.get(p).is_some_and(|&c| is_blank(c)) {
+        p += 1;
+    }
+    p
+}
+
+fn is_blank(c: u8) -> bool {
+    c == b' ' || c == b'\t'
+}
