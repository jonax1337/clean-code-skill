+/// What the scanner expects next.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum State {
+    /// Between tokens: a timestamp, a key, a word or a stray character.
+    Start,
+    /// Right after `key=`: the value comes next.
+    Value,
+    /// The line is finished, either read to its end or stopped by an error.
+    Done,
+}
