+
+fn is_blank(byte: u8) -> bool {
+    byte == b' ' || byte == b'\t'
+}
+
+/// Returns the first index at or after `i` that is not a space or tab.
+#[inline]
+fn skip_blanks(bytes: &[u8], mut i: usize) -> usize {
+    while i < bytes.len() && is_blank(bytes[i]) {
+        i += 1;
+    }
+    i
+}
+
+/// Returns the end of a bare run starting at `start`: the next blank, or `=` when `stop_at_equals`.
+/// A `"` anywhere in the run is an error.
+#[inline(always)]
+fn scan_plain(bytes: &[u8], start: usize, stop_at_equals: bool) -> Result<usize, LexError> {
+    let mut end = start;
+    while let Some(&byte) = bytes.get(end) {
+        if is_blank(byte) || (stop_at_equals && byte == b'=') {
+            break;
+        }
+        if byte == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: end });
+        }
+        end += 1;
+    }
+    Ok(end)
+}
+
+/// Returns the index of the `]` closing the timestamp opened at `open`.
+#[inline]
+fn find_timestamp_end(bytes: &[u8], open: usize) -> Result<usize, LexError> {
+    let mut i = open + 1;
+    loop {
+        match bytes.get(i).copied() {
+            None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+            Some(b']') => return Ok(i),
+            Some(b'[') => return Err(LexError::NestedBracket { pos: i }),
+            Some(_) => i += 1,
+        }
+    }
+}
+
+/// Returns the index of the `"` closing the quoted value opened at `open`, stepping over escapes.
+#[inline]
+fn find_quote_end(bytes: &[u8], open: usize) -> Result<usize, LexError> {
+    let mut i = open + 1;
+    loop {
+        match bytes.get(i).copied() {
+            None => return Err(LexError::UnterminatedQuote { pos: open }),
+            Some(b'"') => return Ok(i),
+            Some(b'\\') => match bytes.get(i + 1).copied() {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                Some(_) => return Err(LexError::InvalidEscape { pos: i }),
+            },
+            Some(_) => i += 1,
+        }
+    }
+}
+
+/// A closing `]` or `"` must be followed by a blank or the end of the line. `end` is the index after it.
+#[inline]
+fn check_separator(bytes: &[u8], end: usize) -> Result<(), LexError> {
+    match bytes.get(end) {
+        Some(&byte) if !is_blank(byte) => Err(LexError::ExpectedSeparator { pos: end }),
+        _ => Ok(()),
+    }
+}
