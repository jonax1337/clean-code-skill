+test("importing 30k contacts into a book of 50k finishes quickly", () => {
+  const existing = Array.from({ length: 50_000 }, (_, i) => contact(`e${i}`, `user${i}@x.io`));
+  // 10k incoming emails match existing ones (merged); 20k are new (appended).
+  const incoming = Array.from({ length: 30_000 }, (_, i) => contact(`i${i}`, `USER${i + 40_000}@x.io`));
+  const started = performance.now();
+  const result = mergeContacts(existing, incoming);
+  const elapsed = performance.now() - started;
+  assert.equal(result.length, 70_000);
+  assert.ok(elapsed < 1000, `took ${elapsed.toFixed(0)} ms`);
+});
