 test("duplicates inside the incoming list are merged with each other", () => {
   const result = mergeContacts([], [contact("1", "a@x.io", { phone: "111" }), contact("2", "a@x.io", { name: "" })]);
   assert.equal(result.length, 1);
   assert.equal(result[0].phone, "111");
 });
+
+test("an incoming contact merges into the first existing entry when the stored book already has duplicates", () => {
+  const result = mergeContacts(
+    [contact("1", "a@x.io", { tags: ["one"] }), contact("2", "A@x.io", { tags: ["two"] })],
+    [contact("3", "a@x.io", { tags: ["three"] })],
+  );
+  assert.equal(result.length, 2);
+  assert.equal(result[0].id, "1");
+  assert.deepEqual(result[0].tags, ["one", "three"]);
+  assert.equal(result[1].id, "2");
+});
+
+test("large imports merge correctly against a large address book", () => {
+  const existing = Array.from({ length: 50_000 }, (_, i) => contact(`e${i}`, `user${i}@x.io`));
+  const incoming = Array.from({ length: 30_000 }, (_, i) => {
+    const n = i * 2; // every other incoming email already exists, the rest are new
+    return contact(`i${i}`, n < 50_000 ? ` USER${n}@x.IO ` : `new${i}@x.io`);
+  });
+  const result = mergeContacts(existing, incoming);
+  assert.equal(result.length, 50_000 + 5_000); // 25k incoming match existing emails; 5k are new
+  assert.equal(result[0].id, "e0");
+  assert.equal(result.at(-1)?.id, "i29999");
+});
