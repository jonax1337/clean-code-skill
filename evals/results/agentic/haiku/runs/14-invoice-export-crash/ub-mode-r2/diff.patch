diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..af0ab0c
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,24 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { loadCustomerRecords } from "../src/sources.js";
+
+function dataDir(billing, crm) {
+  const directory = mkdtempSync(join(tmpdir(), "invoice-export-"));
+  writeFileSync(join(directory, "billing-customers.json"), JSON.stringify(billing));
+  writeFileSync(join(directory, "crm-customers.json"), JSON.stringify(crm));
+  return directory;
+}
+
+test("loadCustomerRecords gives CRM customers the same customerId field as billing customers", () => {
+  const directory = dataDir(
+    [{ customerId: "C-1", name: "Acme", country: "DE" }],
+    [{ customer_id: "C-2201", name: "Birch & Co", country: "NL" }],
+  );
+  assert.deepEqual(loadCustomerRecords(directory), [
+    { customerId: "C-1", name: "Acme", country: "DE" },
+    { customerId: "C-2201", name: "Birch & Co", country: "NL" },
+  ]);
+});
