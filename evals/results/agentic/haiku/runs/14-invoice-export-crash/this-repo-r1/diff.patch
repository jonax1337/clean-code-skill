diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..2bcef62
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,10 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { buildCustomerIndex } from "../src/customers.js";
+import { loadCustomerRecords } from "../src/sources.js";
+
+test("loadCustomerRecords gives CRM customers the customerId key that billing uses", () => {
+  const customers = buildCustomerIndex(loadCustomerRecords("data"));
+  assert.deepEqual(customers.get("C-2201"), { customerId: "C-2201", name: "Birch & Co", country: "NL" });
+  assert.equal(customers.get("C-1001").name, "Acme GmbH");
+});
