+import { requireCustomer } from "./customers.js";
 import { toCsv } from "./csv.js";
 import { invoiceTotalCents } from "./invoices.js";
 import { formatCents } from "./money.js";
 
 const HEADER = ["invoice_id", "customer", "issued_on", "total"];
 
 function invoiceRow(invoice, customers) {
-  const customer = customers.get(invoice.customerId);
+  const customer = requireCustomer(customers, invoice.customerId, `invoice ${invoice.id}`);
   return [invoice.id, customer.name, invoice.issuedOn, formatCents(invoiceTotalCents(invoice))];
 }
 
 /** One CSV row per invoice, in the order given, for the accounting import. */
 export function exportInvoices(invoices, customers) {
   return toCsv([HEADER, ...invoices.map((invoice) => invoiceRow(invoice, customers))]);
 }
diff --git a/src/sources.js b/src/sources.js
index 637fd82..d24d75c 100644
--- a/src/sources.js
+++ b/src/sources.js
@@ -4,15 +4,20 @@ import { join } from "node:path";
 function readJson(directory, file) {
   return JSON.parse(readFileSync(join(directory, file), "utf8"));
 }
 
 export function loadInvoices(directory) {
   return readJson(directory, "invoices.json");
 }
 
+/** The CRM writes `customer_id` where billing writes `customerId`; translate it here, where the file enters. */
+function fromCrmRecord({ customer_id, ...fields }) {
+  return { ...fields, customerId: customer_id };
+}
+
 /** The customers of both systems in one list: billing first, then the CRM. */
 export function loadCustomerRecords(directory) {
   return [
     ...readJson(directory, "billing-customers.json"),
-    ...readJson(directory, "crm-customers.json"),
+    ...readJson(directory, "crm-customers.json").map(fromCrmRecord),
   ];
 }
