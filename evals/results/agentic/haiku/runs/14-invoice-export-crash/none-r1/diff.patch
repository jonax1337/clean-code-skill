diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..54ac80c
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,17 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { loadCustomerRecords } from "../src/sources.js";
+
+test("loadCustomerRecords gives CRM customers the same customerId field as billing customers", () => {
+  const dir = mkdtempSync(join(tmpdir(), "sources-"));
+  writeFileSync(join(dir, "billing-customers.json"), JSON.stringify([{ customerId: "C-1", name: "Acme", country: "DE" }]));
+  writeFileSync(join(dir, "crm-customers.json"), JSON.stringify([{ customer_id: "C-2201", name: "Birch & Co", country: "NL" }]));
+
+  assert.deepEqual(loadCustomerRecords(dir), [
+    { customerId: "C-1", name: "Acme", country: "DE" },
+    { customerId: "C-2201", name: "Birch & Co", country: "NL" },
+  ]);
+});
