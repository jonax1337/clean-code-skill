diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..1964ecf
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,19 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { buildCustomerIndex } from "../src/customers.js";
+import { loadCustomerRecords, loadInvoices } from "../src/sources.js";
+
+const DATA = new URL("../data", import.meta.url).pathname.replace(/^\/([A-Za-z]:)/, "$1");
+
+test("every customer record, from both systems, is indexed by customerId", () => {
+  const index = buildCustomerIndex(loadCustomerRecords(DATA));
+  assert.equal(index.has(undefined), false);
+  for (const invoice of loadInvoices(DATA)) {
+    assert.ok(index.get(invoice.customerId), `no customer for ${invoice.id}`);
+  }
+});
+
+test("CRM customers keep their name under the billing id field", () => {
+  const index = buildCustomerIndex(loadCustomerRecords(DATA));
+  assert.equal(index.get("C-2201").name, "Birch & Co");
+});
