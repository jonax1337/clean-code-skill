     }
 
+    /** What the customer paid minus what has already been refunded. */
+    public BigDecimal refundableAmount() {
+        return amountPaid.subtract(amountRefunded);
+    }
+
+    public void recordRefund(BigDecimal amount) {
+        this.amountRefunded = amountRefunded.add(amount);
+    }
+
     public void markPaid(BigDecimal amount) {
         this.status = OrderStatus.PAID;
         this.amountPaid = amount;
     }
 
     public void markShipped() {
         this.status = OrderStatus.SHIPPED;
     }
