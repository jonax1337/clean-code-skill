@@ -0,0 +1,44 @@
+package shop;
+
+import java.math.BigDecimal;
+import java.util.Optional;
+
+public final class RefundOrderHandler implements CommandHandler<RefundOrder> {
+    private final OrderRepository orders;
+
+    public RefundOrderHandler(OrderRepository orders) {
+        this.orders = orders;
+    }
+
+    @Override
+    public Result<Order> handle(RefundOrder command) {
+        Validator validator = new Validator()
+                .requireText("orderId", command.orderId())
+                .requireMoney("amount", command.amount());
+        if (!validator.isValid()) {
+            return validator.failure();
+        }
+        Optional<Order> found = orders.find(command.orderId());
+        if (found.isEmpty()) {
+            return Result.failure(ErrorCode.NOT_FOUND, "Order " + command.orderId() + " does not exist");
+        }
+        Order order = found.get();
+        if (order.status() != OrderStatus.SHIPPED && order.status() != OrderStatus.DELIVERED) {
+            return Result.failure(
+                    ErrorCode.INVALID_STATE,
+                    "Only shipped or delivered orders can be refunded, but order " + order.id() + " is "
+                            + order.status());
+        }
+        // Capped by what the customer paid, not by the total: a voucher may have covered part of the total.
+        BigDecimal refundable = order.amountPaid().subtract(order.amountRefunded());
+        if (command.amount().compareTo(refundable) > 0) {
+            return Result.failure(
+                    ErrorCode.INVALID_INPUT,
+                    "Refund " + command.amount() + " is more than the " + refundable + " still refundable on order "
+                            + order.id());
+        }
+        order.refund(command.amount());
+        orders.save(order);
+        return Result.ok(order);
+    }
+}
diff --git a/src/test/java/shop/RefundOrderHandlerTest.java b/src/test/java/shop/RefundOrderHandlerTest.java
new file mode 100644
index 0000000..d4a2b81
--- /dev/null
+++ b/src/test/java/shop/RefundOrderHandlerTest.java
@@ -0,0 +1,127 @@
+package shop;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.math.BigDecimal;
+import org.junit.jupiter.api.Test;
+
+class RefundOrderHandlerTest {
+    private final OrderRepository orders = new InMemoryOrderRepository();
+    private final CommandBus bus = OrderServices.createBus(orders);
+
+    /** Ships an order with a total of 100.00 of which the customer paid {@code paid}; a voucher covered the rest. */
+    private void shipOrderPaying(String paid) {
+        bus.dispatch(new PlaceOrder("o-1", "c-1", new BigDecimal("100.00")));
+        bus.dispatch(new PayOrder("o-1", new BigDecimal(paid)));
+        bus.dispatch(new ShipOrder("o-1"));
+    }
+
+    private Order stored() {
+        return orders.find("o-1").orElseThrow();
+    }
+
+    private static void assertMoney(String expected, BigDecimal actual) {
+        assertEquals(0, new BigDecimal(expected).compareTo(actual), "expected " + expected + " but was " + actual);
+    }
+
+    @Test
+    void refundsPartOfAShippedOrderAndKeepsItsStatus() {
+        shipOrderPaying("80.00");
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("30.00")));
+
+        assertTrue(result.isOk());
+        assertMoney("30.00", stored().amountRefunded());
+        assertEquals(OrderStatus.SHIPPED, stored().status());
+    }
+
+    @Test
+    void refundsADeliveredOrderAndKeepsItsStatus() {
+        shipOrderPaying("80.00");
+        bus.dispatch(new DeliverOrder("o-1"));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("80.00")));
+
+        assertTrue(result.isOk());
+        assertMoney("80.00", stored().amountRefunded());
+        assertEquals(OrderStatus.DELIVERED, stored().status());
+    }
+
+    @Test
+    void addsUpSeveralPartialRefundsUpToTheAmountPaid() {
+        shipOrderPaying("80.00");
+
+        bus.dispatch(new RefundOrder("o-1", new BigDecimal("30.00")));
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("50.00")));
+
+        assertTrue(result.isOk());
+        assertMoney("80.00", stored().amountRefunded());
+    }
+
+    @Test
+    void rejectsRefundingMoreThanWasPaidEvenIfTheTotalIsHigher() {
+        shipOrderPaying("80.00");
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("80.01")));
+
+        assertFalse(result.isOk());
+        assertEquals(ErrorCode.INVALID_INPUT, result.error().code());
+        assertMoney("0", stored().amountRefunded());
+    }
+
+    @Test
+    void rejectsARefundThatWouldPushTheRefundsOverTheAmountPaid() {
+        shipOrderPaying("80.00");
+        bus.dispatch(new RefundOrder("o-1", new BigDecimal("50.00")));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("30.01")));
+
+        assertFalse(result.isOk());
+        assertEquals(ErrorCode.INVALID_INPUT, result.error().code());
+        assertMoney("50.00", stored().amountRefunded());
+    }
+
+    @Test
+    void rejectsAnOrderThatIsOnlyPaid() {
+        bus.dispatch(new PlaceOrder("o-1", "c-1", new BigDecimal("100.00")));
+        bus.dispatch(new PayOrder("o-1", new BigDecimal("100.00")));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("10.00")));
+
+        assertEquals(ErrorCode.INVALID_STATE, result.error().code());
+        assertMoney("0", stored().amountRefunded());
+    }
+
+    @Test
+    void rejectsACancelledOrder() {
+        bus.dispatch(new PlaceOrder("o-1", "c-1", new BigDecimal("100.00")));
+        bus.dispatch(new PayOrder("o-1", new BigDecimal("100.00")));
+        bus.dispatch(new CancelOrder("o-1"));
+
+        Result<Order> result = bus.dispatch(new RefundOrder("o-1", new BigDecimal("10.00")));
+
+        assertEquals(ErrorCode.INVALID_STATE, result.error().code());
+    }
+
+    @Test
+    void rejectsAnInvalidAmount() {
+        shipOrderPaying("80.00");
+
+        assertEquals(ErrorCode.INVALID_INPUT, bus.dispatch(new RefundOrder("o-1", BigDecimal.ZERO)).error().code());
+        assertEquals(
+                ErrorCode.INVALID_INPUT, bus.dispatch(new RefundOrder("o-1", new BigDecimal("-5"))).error().code());
+        assertEquals(
+                ErrorCode.INVALID_INPUT, bus.dispatch(new RefundOrder("o-1", new BigDecimal("1.001"))).error().code());
+        assertEquals(ErrorCode.INVALID_INPUT, bus.dispatch(new RefundOrder("o-1", null)).error().code());
+        assertMoney("0", stored().amountRefunded());
+    }
+
+    @Test
+    void reportsAnUnknownOrder() {
+        Result<Order> result = bus.dispatch(new RefundOrder("missing", new BigDecimal("10.00")));
+
+        assertEquals(ErrorCode.NOT_FOUND, result.error().code());
+    }
+}
