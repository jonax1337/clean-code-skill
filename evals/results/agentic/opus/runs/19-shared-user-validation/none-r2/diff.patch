diff --git a/src/validation/user.js b/src/validation/user.js
new file mode 100644
index 0000000..8963c56
--- /dev/null
+++ b/src/validation/user.js
@@ -0,0 +1,58 @@
+// Shared user field rules. See docs/api.md: the messages are part of the API contract.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ROLES.filter((role) => role !== 'owner');
+
+// Each field validator returns { value } on success or { message } on failure.
+
+export function validateEmail(raw) {
+  const email = typeof raw === 'string' ? raw.trim().toLowerCase() : '';
+  if (email === '') {
+    return { message: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { message: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function validateName(raw, { optional = false } = {}) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  if (name === '' && !optional) {
+    return { message: 'name is required' };
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return { message: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
+
+export function validateRole(raw, { roles = ROLES } = {}) {
+  if (!roles.includes(raw)) {
+    return { message: 'role is invalid' };
+  }
+  return { value: raw };
+}
+
+/**
+ * Runs the given field validators in order (email, name, role, as callers pass them)
+ * and collects the results.
+ *
+ * @param {Array<[string, { value?: unknown, message?: string }]>} checks
+ * @returns {{ values: Record<string, unknown>, messages: string[] }}
+ */
+export function collect(checks) {
+  const values = {};
+  const messages = [];
+  for (const [field, result] of checks) {
+    if (result.message !== undefined) {
+      messages.push(result.message);
+    } else {
+      values[field] = result.value;
+    }
+  }
+  return { values, messages };
+}
diff --git a/test/userValidation.test.js b/test/userValidation.test.js
new file mode 100644
index 0000000..863a6b1
--- /dev/null
+++ b/test/userValidation.test.js
@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { inviteUser } from '../src/handlers/inviteUser.js';
+import { createStore } from '../src/store.js';
+import { validateEmail, validateName, validateRole } from '../src/validation/user.js';
+import { ann, storeWith } from './helpers.js';
+
+test('validateEmail trims, lowercases and checks the shape', () => {
+  assert.deepEqual(validateEmail(' Ann@Example.COM '), { value: 'ann@example.com' });
+  assert.deepEqual(validateEmail(undefined), { message: 'email is required' });
+  assert.deepEqual(validateEmail(42), { message: 'email is required' });
+  assert.deepEqual(validateEmail('   '), { message: 'email is required' });
+  assert.deepEqual(validateEmail('nope'), { message: 'email is invalid' });
+});
+
+test('validateName trims, enforces length and is optionally allowed to be empty', () => {
+  assert.deepEqual(validateName(' Ann '), { value: 'Ann' });
+  assert.deepEqual(validateName(''), { message: 'name is required' });
+  assert.deepEqual(validateName(undefined, { optional: true }), { value: '' });
+  assert.deepEqual(validateName('x'.repeat(80)), { value: 'x'.repeat(80) });
+  assert.deepEqual(validateName('x'.repeat(81)), { message: 'name must be at most 80 characters' });
+  assert.deepEqual(validateName('x'.repeat(81), { optional: true }), { message: 'name must be at most 80 characters' });
+});
+
+test('validateRole checks against the allowed list', () => {
+  assert.deepEqual(validateRole('owner'), { value: 'owner' });
+  assert.deepEqual(validateRole('god'), { message: 'role is invalid' });
+  assert.deepEqual(validateRole('owner', { roles: ['admin'] }), { message: 'role is invalid' });
+});
+
+test('inviteUser stores the email in lowercase and matches existing users case-insensitively', () => {
+  const result = inviteUser(createStore(), { body: { email: 'Bob@Example.com', role: 'viewer' } });
+  assert.equal(result.body.email, 'bob@example.com');
+
+  const conflict = inviteUser(storeWith(ann()), { body: { email: 'ANN@example.com', role: 'member' } });
+  assert.equal(conflict.status, 409);
+});
+
+test('inviteUser rejects owner and reports messages in field order', () => {
+  const result = inviteUser(createStore(), { body: { email: 'nope', name: 'x'.repeat(81), role: 'owner' } });
+  assert.deepEqual(result.body.messages, ['email is invalid', 'name must be at most 80 characters', 'role is invalid']);
+});
