diff --git a/test/validation.user.test.js b/test/validation.user.test.js
new file mode 100644
index 0000000..a92ae50
--- /dev/null
+++ b/test/validation.user.test.js
@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { INVITABLE_ROLES, validateUser } from '../src/validation/user.js';
+
+test('normalises email and name and applies the default role', () => {
+  const result = validateUser({ email: ' Ann@Example.com ', name: ' Ann ' }, { defaultRole: 'member' });
+  assert.deepEqual(result, { values: { email: 'ann@example.com', name: 'Ann', role: 'member' }, messages: [] });
+});
+
+test('reports one message per failing field in the order email, name, role', () => {
+  const result = validateUser({ email: 'nope', name: 'x'.repeat(81), role: 'god' });
+  assert.deepEqual(result.messages, ['email is invalid', 'name must be at most 80 characters', 'role is invalid']);
+});
+
+test('treats missing, blank and non-string values as required', () => {
+  const result = validateUser({ email: '   ', name: 42 }, { defaultRole: 'member' });
+  assert.deepEqual(result.messages, ['email is required', 'name is required']);
+});
+
+test('partial mode validates only the fields that are present', () => {
+  assert.deepEqual(validateUser({ name: ' Bo ' }, { partial: true }), { values: { name: 'Bo' }, messages: [] });
+  assert.deepEqual(validateUser({ name: '' }, { partial: true }).messages, ['name is required']);
+  assert.deepEqual(validateUser({}, { partial: true }), { values: {}, messages: [] });
+});
+
+test('nameOptional accepts a missing name as an empty string but still enforces the length', () => {
+  const options = { nameOptional: true, roles: INVITABLE_ROLES };
+  assert.equal(validateUser({ email: 'a@b.co', role: 'viewer' }, options).values.name, '');
+  assert.deepEqual(validateUser({ email: 'a@b.co', name: 'x'.repeat(81), role: 'viewer' }, options).messages, [
+    'name must be at most 80 characters',
+  ]);
+});
+
+test('requires a role when there is no default', () => {
+  assert.deepEqual(validateUser({ email: 'a@b.co', name: 'A' }).messages, ['role is required']);
+});
