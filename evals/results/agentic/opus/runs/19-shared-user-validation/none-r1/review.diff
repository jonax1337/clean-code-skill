diff --git a/src/validation/user.js b/src/validation/user.js
new file mode 100644
index 0000000..825fcef
--- /dev/null
+++ b/src/validation/user.js
@@ -0,0 +1,67 @@
+// The single home for user field rules (see docs/api.md, "Conventions" and "Validation messages").
+// Message strings are part of the API contract: do not reword them.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ROLES.filter((role) => role !== 'owner');
+
+function trimmed(value) {
+  return typeof value === 'string' ? value.trim() : '';
+}
+
+function checkEmail(raw) {
+  const email = trimmed(raw).toLowerCase();
+  if (email === '') return { message: 'email is required' };
+  if (!EMAIL_PATTERN.test(email)) return { message: 'email is invalid' };
+  return { value: email };
+}
+
+function checkName(raw, { allowBlank }) {
+  const name = trimmed(raw);
+  if (name === '' && !allowBlank) return { message: 'name is required' };
+  if (name.length > MAX_NAME_LENGTH) return { message: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  return { value: name };
+}
+
+function checkRole(raw, { allowed }) {
+  if (raw === undefined) return { message: 'role is required' };
+  if (!allowed.includes(raw)) return { message: 'role is invalid' };
+  return { value: raw };
+}
+
+/**
+ * Validates and normalises the email, name and role of a user-like body.
+ *
+ * Options:
+ * - partial: only validate fields that are present (PATCH semantics); absent fields are left out of `values`.
+ * - nameOptional: a missing or blank name is accepted and stored as ''.
+ * - defaultRole: used when role is absent (ignored when partial).
+ * - roles: the roles that may be assigned.
+ *
+ * Returns `{ values, messages }`; messages follow the documented order email, name, role.
+ */
+export function validateUser(body, { partial = false, nameOptional = false, defaultRole, roles = ROLES } = {}) {
+  const input = body ?? {};
+  const values = {};
+  const messages = [];
+
+  const fields = [
+    ['email', () => checkEmail(input.email)],
+    ['name', () => checkName(input.name, { allowBlank: nameOptional })],
+    ['role', () => checkRole(input.role === undefined ? defaultRole : input.role, { allowed: roles })],
+  ];
+
+  for (const [field, check] of fields) {
+    if (partial && input[field] === undefined) continue;
+    const result = check();
+    if (result.message) {
+      messages.push(result.message);
+    } else {
+      values[field] = result.value;
+    }
+  }
+
+  return { values, messages };
+}
