diff --git a/src/userValidation.js b/src/userValidation.js
new file mode 100644
index 0000000..5840529
--- /dev/null
+++ b/src/userValidation.js
@@ -0,0 +1,55 @@
+// The single home of the user field rules in docs/api.md. Each rule takes the raw
+// request value and returns either { value } (normalized) or { message }.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+const ROLES = ['owner', 'admin', 'member', 'viewer'];
+const INVITABLE_ROLES = ROLES.filter((role) => role !== 'owner');
+
+const trimmed = (raw) => (typeof raw === 'string' ? raw.trim() : '');
+
+function email(raw) {
+  const value = trimmed(raw).toLowerCase();
+  if (value === '') return { message: 'email is required' };
+  if (!EMAIL_PATTERN.test(value)) return { message: 'email is invalid' };
+  return { value };
+}
+
+function name(raw) {
+  const value = trimmed(raw);
+  if (value === '') return { message: 'name is required' };
+  if (value.length > MAX_NAME_LENGTH) return { message: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  return { value };
+}
+
+const roleIn = (allowed) => (raw) => (allowed.includes(raw) ? { value: raw } : { message: 'role is invalid' });
+
+// Presence policies: what to do when the field is absent from the body.
+const SKIP = {};
+const required = (rule, message) => (raw) => (raw === undefined ? { message } : rule(raw));
+const optional = (rule) => (raw) => (raw === undefined ? SKIP : rule(raw));
+const orDefault = (rule, fallback) => (raw) => rule(raw === undefined ? fallback : raw);
+const blankAllowed = (rule) => (raw) => (trimmed(raw) === '' ? { value: '' } : rule(raw));
+
+// Runs the rules in their declared order (email, name, role) and collects one
+// message per failing field.
+function validate(body, rules) {
+  const messages = [];
+  const values = {};
+  for (const [field, rule] of Object.entries(rules)) {
+    const result = rule((body ?? {})[field]);
+    if (result === SKIP) continue;
+    if (result.message) messages.push(result.message);
+    else values[field] = result.value;
+  }
+  return { messages, values };
+}
+
+export const validateNewUser = (body) =>
+  validate(body, { email, name, role: orDefault(roleIn(ROLES), 'member') });
+
+export const validateUserChanges = (body) =>
+  validate(body, { email: optional(email), name: optional(name), role: optional(roleIn(ROLES)) });
+
+export const validateInvitation = (body) =>
+  validate(body, { email, name: blankAllowed(name), role: required(roleIn(INVITABLE_ROLES), 'role is required') });
diff --git a/test/createUser.test.js b/test/createUser.test.js
index a7c28df..d2cbb1e 100644
--- a/test/createUser.test.js
+++ b/test/createUser.test.js
@@ -21,8 +21,24 @@ test('rejects an unknown role', () => {
   assert.deepEqual(result.body.messages, ['role is invalid']);
 });
 
 test('answers 409 when the email is taken', () => {
   const result = createUser(storeWith(ann()), { body: { email: 'ANN@example.com', name: 'Other Ann' } });
   assert.equal(result.status, 409);
   assert.equal(result.body.message, 'email already in use');
 });
+
+test('reports every failing field in the order email, name, role', () => {
+  const result = createUser(storeWith(), { body: { email: 'nope', name: 'x'.repeat(81), role: 'god' } });
+  assert.equal(result.status, 400);
+  assert.deepEqual(result.body.messages, ['email is invalid', 'name must be at most 80 characters', 'role is invalid']);
+});
+
+test('rejects a blank or non-string name and a non-string email', () => {
+  const result = createUser(storeWith(), { body: { email: 42, name: '   ' } });
+  assert.deepEqual(result.body.messages, ['email is required', 'name is required']);
+});
+
+test('accepts a name of exactly 80 characters', () => {
+  const result = createUser(storeWith(), { body: { email: 'ann@example.com', name: 'x'.repeat(80) } });
+  assert.equal(result.status, 201);
+});
