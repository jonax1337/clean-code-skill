@@ -20,8 +20,27 @@ test('rejects a present but invalid email', () => {
   assert.deepEqual(result.body.messages, ['email is invalid']);
 });
 
 test('answers 409 when the email belongs to another user', () => {
   const store = storeWith(ann(), ann({ email: 'bob@example.com', name: 'Bob' }));
   const result = updateUser(store, { params: { id: '2' }, body: { email: 'Ann@example.com' } });
   assert.equal(result.status, 409);
 });
+
+test('holds present fields to the create rules and reports them in order', () => {
+  const result = updateUser(storeWith(ann()), {
+    params: { id: '1' },
+    body: { email: '', name: 'x'.repeat(81), role: 'god' },
+  });
+  assert.equal(result.status, 400);
+  assert.deepEqual(result.body.messages, ['email is required', 'name must be at most 80 characters', 'role is invalid']);
+});
+
+test('rejects a body without any of the three fields', () => {
+  const result = updateUser(storeWith(ann()), { params: { id: '1' }, body: { nickname: 'A' } });
+  assert.deepEqual(result.body.messages, ['no fields to update']);
+});
+
+test('stores a changed email trimmed and lowercase, and a changed role', () => {
+  const result = updateUser(storeWith(ann()), { params: { id: '1' }, body: { email: ' Anna@Example.com ', role: 'admin' } });
+  assert.deepEqual(result.body, { id: 1, email: 'anna@example.com', name: 'Ann Lee', role: 'admin' });
+});
