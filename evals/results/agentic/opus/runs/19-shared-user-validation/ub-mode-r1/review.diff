   assert.deepEqual(result.body.messages, ['role is required']);
 });
 
 test('answers 409 when a user already has the email', () => {
   const result = inviteUser(storeWith(ann()), { body: { email: 'ann@example.com', role: 'member' } });
   assert.equal(result.status, 409);
 });
+
+test('stores the email trimmed and lowercase, and a missing name as an empty string', () => {
+  const result = inviteUser(storeWith(), { body: { email: ' Bob@Example.COM ', role: 'member' } });
+  assert.equal(result.status, 201);
+  assert.equal(result.body.email, 'bob@example.com');
+  assert.equal(result.body.name, '');
+});
+
+test('answers 409 when the email of a pending invitation differs only in case', () => {
+  const store = storeWith();
+  inviteUser(store, { body: { email: 'bob@example.com', role: 'member' } });
+  const result = inviteUser(store, { body: { email: 'BOB@example.com', role: 'member' } });
+  assert.equal(result.status, 409);
+});
+
+test('cannot grant owner, and still limits a given name to 80 characters', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'nope', name: 'x'.repeat(81), role: 'owner' } });
+  assert.deepEqual(result.body.messages, ['email is invalid', 'name must be at most 80 characters', 'role is invalid']);
+});
