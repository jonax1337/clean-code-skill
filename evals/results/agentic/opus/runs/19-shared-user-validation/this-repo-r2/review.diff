diff --git a/src/userValidation.js b/src/userValidation.js
new file mode 100644
index 0000000..25873bf
--- /dev/null
+++ b/src/userValidation.js
@@ -0,0 +1,38 @@
+// Field rules shared by the user and invitation handlers. Clients match on the message strings,
+// so their wording is part of the API contract (see docs/api.md).
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+
+export function normalizeEmail(value) {
+  return typeof value === 'string' ? value.trim().toLowerCase() : '';
+}
+
+export function normalizeName(value) {
+  return typeof value === 'string' ? value.trim() : '';
+}
+
+export function emailError(email) {
+  if (email === '') {
+    return 'email is required';
+  }
+  return EMAIL_PATTERN.test(email) ? null : 'email is invalid';
+}
+
+export function nameError(name) {
+  return name === '' ? 'name is required' : nameLengthError(name);
+}
+
+export function nameLengthError(name) {
+  return name.length > MAX_NAME_LENGTH ? `name must be at most ${MAX_NAME_LENGTH} characters` : null;
+}
+
+export function roleError(role, allowedRoles = ROLES) {
+  return allowedRoles.includes(role) ? null : 'role is invalid';
+}
+
+export function errorMessages(...errors) {
+  return errors.filter((error) => error !== null);
+}
diff --git a/test/createUser.test.js b/test/createUser.test.js
index a7c28df..5c86980 100644
--- a/test/createUser.test.js
+++ b/test/createUser.test.js
@@ -21,8 +21,25 @@ test('rejects an unknown role', () => {
   assert.deepEqual(result.body.messages, ['role is invalid']);
 });
 
 test('answers 409 when the email is taken', () => {
   const result = createUser(storeWith(ann()), { body: { email: 'ANN@example.com', name: 'Other Ann' } });
   assert.equal(result.status, 409);
   assert.equal(result.body.message, 'email already in use');
 });
+
+test('rejects an email that is not of the form local@domain.tld', () => {
+  const result = createUser(storeWith(), { body: { email: 'ann@example', name: 'Ann' } });
+  assert.deepEqual(result.body.messages, ['email is invalid']);
+});
+
+test('accepts a name of 80 characters and rejects one of 81', () => {
+  const accepted = createUser(storeWith(), { body: { email: 'ann@example.com', name: 'a'.repeat(80) } });
+  const rejected = createUser(storeWith(), { body: { email: 'ann@example.com', name: 'a'.repeat(81) } });
+  assert.equal(accepted.status, 201);
+  assert.deepEqual(rejected.body.messages, ['name must be at most 80 characters']);
+});
+
+test('reports every failing field in the order email, name, role', () => {
+  const result = createUser(storeWith(), { body: { email: 42, name: '   ', role: 'god' } });
+  assert.deepEqual(result.body.messages, ['email is required', 'name is required', 'role is invalid']);
+});
diff --git a/test/inviteUser.test.js b/test/inviteUser.test.js
index b4517c9..f85f8d3 100644
--- a/test/inviteUser.test.js
+++ b/test/inviteUser.test.js
@@ -13,8 +13,41 @@ test('requires a role', () => {
   const result = inviteUser(storeWith(), { body: { email: 'bob@example.com' } });
   assert.deepEqual(result.body.messages, ['role is required']);
 });
 
 test('answers 409 when a user already has the email', () => {
   const result = inviteUser(storeWith(ann()), { body: { email: 'ann@example.com', role: 'member' } });
   assert.equal(result.status, 409);
 });
+
+test('allows a missing name and stores it as an empty string', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'bob@example.com', role: 'member' } });
+  assert.equal(result.status, 201);
+  assert.equal(result.body.name, '');
+});
+
+test('rejects a name longer than 80 characters', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'bob@example.com', name: 'a'.repeat(81), role: 'member' } });
+  assert.deepEqual(result.body.messages, ['name must be at most 80 characters']);
+});
+
+test('cannot grant the owner role', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'bob@example.com', role: 'owner' } });
+  assert.deepEqual(result.body.messages, ['role is invalid']);
+});
+
+test('rejects an invalid email', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'bob', role: 'member' } });
+  assert.deepEqual(result.body.messages, ['email is invalid']);
+});
+
+test('stores the email in lowercase', () => {
+  const result = inviteUser(storeWith(), { body: { email: ' Bob@Example.com ', role: 'viewer' } });
+  assert.equal(result.body.email, 'bob@example.com');
+});
+
+test('answers 409 when a pending invitation has the email in another case', () => {
+  const store = storeWith();
+  inviteUser(store, { body: { email: 'bob@example.com', role: 'viewer' } });
+  const result = inviteUser(store, { body: { email: 'BOB@example.com', role: 'viewer' } });
+  assert.equal(result.status, 409);
+});
