diff --git a/src/validation/userFields.js b/src/validation/userFields.js
new file mode 100644
index 0000000..3f13dda
--- /dev/null
+++ b/src/validation/userFields.js
@@ -0,0 +1,55 @@
+// The single home of the email, name and role rules for users and invitations.
+// A field rule takes the raw request value and returns { value } or { error }.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ROLES.filter((role) => role !== 'owner');
+
+function trimmed(raw) {
+  return typeof raw === 'string' ? raw.trim() : '';
+}
+
+export function email({ lowercase = true } = {}) {
+  return (raw) => {
+    const value = lowercase ? trimmed(raw).toLowerCase() : trimmed(raw);
+    if (value === '') return { error: 'email is required' };
+    if (!EMAIL_PATTERN.test(value)) return { error: 'email is invalid' };
+    return { value };
+  };
+}
+
+export function name({ required = true } = {}) {
+  return (raw) => {
+    const value = trimmed(raw);
+    if (required && value === '') return { error: 'name is required' };
+    if (value.length > MAX_NAME_LENGTH) return { error: `name must be at most ${MAX_NAME_LENGTH} characters` };
+    return { value };
+  };
+}
+
+export function role({ allowed = ROLES, fallback } = {}) {
+  return (raw) => {
+    const value = raw === undefined ? fallback : raw;
+    if (value === undefined) return { error: 'role is required' };
+    if (!allowed.includes(value)) return { error: 'role is invalid' };
+    return { value };
+  };
+}
+
+// Runs each field rule in order. With `partial`, fields absent from the body are skipped.
+export function validateFields(body, rules, { partial = false } = {}) {
+  const values = {};
+  const messages = [];
+  for (const [field, rule] of Object.entries(rules)) {
+    if (partial && body[field] === undefined) continue;
+    const { value, error } = rule(body[field]);
+    if (error) {
+      messages.push(error);
+    } else {
+      values[field] = value;
+    }
+  }
+  return { values, messages };
+}
diff --git a/test/userValidation.pin.test.js b/test/userValidation.pin.test.js
new file mode 100644
index 0000000..6bb1902
--- /dev/null
+++ b/test/userValidation.pin.test.js
@@ -0,0 +1,49 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createUser } from '../src/handlers/createUser.js';
+import { inviteUser } from '../src/handlers/inviteUser.js';
+import { updateUser } from '../src/handlers/updateUser.js';
+import { ann, storeWith } from './helpers.js';
+
+const longName = 'x'.repeat(81);
+
+test('create reports every invalid field in email, name, role order', () => {
+  const result = createUser(storeWith(), { body: { email: 42, name: longName, role: null } });
+  assert.equal(result.status, 400);
+  assert.deepEqual(result.body.messages, ['email is required', 'name must be at most 80 characters', 'role is invalid']);
+});
+
+test('create rejects a blank name and accepts an 80 character one', () => {
+  assert.deepEqual(createUser(storeWith(), { body: { email: 'a@b.co', name: '  ' } }).body.messages, ['name is required']);
+  assert.equal(createUser(storeWith(), { body: { email: 'a@b.co', name: 'x'.repeat(80) } }).status, 201);
+});
+
+test('create accepts owner', () => {
+  assert.equal(createUser(storeWith(), { body: { email: 'a@b.co', name: 'A', role: 'owner' } }).body.role, 'owner');
+});
+
+test('update reports every invalid present field', () => {
+  const result = updateUser(storeWith(ann()), { params: { id: '1' }, body: { email: '', name: longName, role: 'god' } });
+  assert.deepEqual(result.body.messages, ['email is required', 'name must be at most 80 characters', 'role is invalid']);
+});
+
+test('update rejects a blank name and an empty body', () => {
+  assert.deepEqual(updateUser(storeWith(ann()), { params: { id: '1' }, body: { name: ' ' } }).body.messages, ['name is required']);
+  assert.deepEqual(updateUser(storeWith(ann()), { params: { id: '1' }, body: {} }).body.messages, ['no fields to update']);
+});
+
+test('update lowercases email and accepts owner', () => {
+  const result = updateUser(storeWith(ann()), { params: { id: '1' }, body: { email: ' New@Example.com ', role: 'owner' } });
+  assert.deepEqual(result.body, { id: 1, email: 'new@example.com', name: 'Ann Lee', role: 'owner' });
+});
+
+test('invite allows a missing name but not a long one', () => {
+  assert.equal(inviteUser(storeWith(), { body: { email: 'a@b.co', role: 'member' } }).body.name, '');
+  assert.deepEqual(inviteUser(storeWith(), { body: { email: 'a@b.co', name: longName, role: 'member' } }).body.messages,
+    ['name must be at most 80 characters']);
+});
+
+test('invite cannot grant owner and validates email', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'nope', role: 'owner' } });
+  assert.deepEqual(result.body.messages, ['email is invalid', 'role is invalid']);
+});
