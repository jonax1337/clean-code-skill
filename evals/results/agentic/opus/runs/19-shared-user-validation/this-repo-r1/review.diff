diff --git a/src/userValidation.js b/src/userValidation.js
new file mode 100644
index 0000000..759547e
--- /dev/null
+++ b/src/userValidation.js
@@ -0,0 +1,56 @@
+// Each check returns { value } with the normalized input, or { error } with the message clients match on.
+// The message wording is part of the API contract (docs/api.md).
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ROLES.filter((role) => role !== 'owner');
+
+export function checkEmail(input) {
+  const email = typeof input === 'string' ? input.trim().toLowerCase() : '';
+  if (email === '') {
+    return { error: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { error: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function checkName(input) {
+  const name = normalizeName(input);
+  if (name === '') {
+    return { error: 'name is required' };
+  }
+  return checkNameLength(name);
+}
+
+export function checkOptionalName(input) {
+  return checkNameLength(normalizeName(input));
+}
+
+export function checkRole(input, allowedRoles) {
+  if (input === undefined) {
+    return { error: 'role is required' };
+  }
+  if (!allowedRoles.includes(input)) {
+    return { error: 'role is invalid' };
+  }
+  return { value: input };
+}
+
+export function errorMessages(checks) {
+  return checks.filter((check) => check.error !== undefined).map((check) => check.error);
+}
+
+function normalizeName(input) {
+  return typeof input === 'string' ? input.trim() : '';
+}
+
+function checkNameLength(name) {
+  if (name.length > MAX_NAME_LENGTH) {
+    return { error: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
diff --git a/test/createUser.test.js b/test/createUser.test.js
index a7c28df..5a2ade1 100644
--- a/test/createUser.test.js
+++ b/test/createUser.test.js
@@ -21,8 +21,25 @@ test('rejects an unknown role', () => {
   assert.deepEqual(result.body.messages, ['role is invalid']);
 });
 
 test('answers 409 when the email is taken', () => {
   const result = createUser(storeWith(ann()), { body: { email: 'ANN@example.com', name: 'Other Ann' } });
   assert.equal(result.status, 409);
   assert.equal(result.body.message, 'email already in use');
 });
+
+test('reports every failing field in the order email, name, role', () => {
+  const result = createUser(storeWith(), { body: { email: 'nope', name: '   ', role: 'god' } });
+  assert.deepEqual(result.body.messages, ['email is invalid', 'name is required', 'role is invalid']);
+});
+
+test('accepts a name of exactly 80 characters and rejects 81', () => {
+  const accepted = createUser(storeWith(), { body: { email: 'ann@example.com', name: 'a'.repeat(80) } });
+  const rejected = createUser(storeWith(), { body: { email: 'ann@example.com', name: 'a'.repeat(81) } });
+  assert.equal(accepted.status, 201);
+  assert.deepEqual(rejected.body.messages, ['name must be at most 80 characters']);
+});
+
+test('rejects a null role instead of defaulting it', () => {
+  const result = createUser(storeWith(), { body: { email: 'ann@example.com', name: 'Ann', role: null } });
+  assert.deepEqual(result.body.messages, ['role is invalid']);
+});
