 });
 
 test('answers 409 when the email belongs to another user', () => {
   const store = storeWith(ann(), ann({ email: 'bob@example.com', name: 'Bob' }));
   const result = updateUser(store, { params: { id: '2' }, body: { email: 'Ann@example.com' } });
   assert.equal(result.status, 409);
 });
+
+test('rejects a body without any known field', () => {
+  const result = updateUser(storeWith(ann()), { params: { id: '1' }, body: { nickname: 'A' } });
+  assert.deepEqual(result.body.messages, ['no fields to update']);
+});
+
+test('holds present fields to the create rules', () => {
+  const result = updateUser(storeWith(ann()), { params: { id: '1' }, body: { email: '', name: 7, role: 'god' } });
+  assert.deepEqual(result.body.messages, ['email is required', 'name is required', 'role is invalid']);
+});
+
+test('stores a changed email trimmed and in lowercase', () => {
+  const result = updateUser(storeWith(ann()), { params: { id: '1' }, body: { email: ' Anna@Example.com ', role: 'admin' } });
+  assert.deepEqual(result.body, { id: 1, email: 'anna@example.com', name: 'Ann Lee', role: 'admin' });
+});
