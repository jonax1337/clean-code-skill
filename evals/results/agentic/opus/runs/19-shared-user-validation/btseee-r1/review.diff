diff --git a/src/userFields.js b/src/userFields.js
new file mode 100644
index 0000000..1302894
--- /dev/null
+++ b/src/userFields.js
@@ -0,0 +1,67 @@
+// The single home for the user field rules in docs/api.md. Each check returns either
+// { value } with the normalized input or { message } with the client-facing error.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ROLES.filter((role) => role !== 'owner');
+
+export function checkEmail(input) {
+  const value = trimmed(input).toLowerCase();
+  if (value === '') {
+    return { message: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(value)) {
+    return { message: 'email is invalid' };
+  }
+  return { value };
+}
+
+export function checkName(input) {
+  const value = trimmed(input);
+  if (value === '') {
+    return { message: 'name is required' };
+  }
+  return checkNameLength(value);
+}
+
+// For invitations: the invitee fills in their name on accepting, so blank is stored as ''.
+export function checkOptionalName(input) {
+  return checkNameLength(trimmed(input));
+}
+
+export function checkRole(input, allowedRoles) {
+  if (input === undefined) {
+    return { message: 'role is required' };
+  }
+  if (!allowedRoles.includes(input)) {
+    return { message: 'role is invalid' };
+  }
+  return { value: input };
+}
+
+// Combines named check results, in insertion order, into the valid values and the messages.
+export function collectChecks(checks) {
+  const values = {};
+  const messages = [];
+  for (const [field, check] of Object.entries(checks)) {
+    if (check.message) {
+      messages.push(check.message);
+    } else {
+      values[field] = check.value;
+    }
+  }
+  return { values, messages };
+}
+
+function trimmed(input) {
+  return typeof input === 'string' ? input.trim() : '';
+}
+
+function checkNameLength(value) {
+  if (value.length > MAX_NAME_LENGTH) {
+    return { message: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value };
+}
diff --git a/test/createUser.test.js b/test/createUser.test.js
