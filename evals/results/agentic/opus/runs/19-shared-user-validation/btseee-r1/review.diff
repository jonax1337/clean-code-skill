+++ b/test/createUser.test.js
@@ -21,8 +21,13 @@ test('rejects an unknown role', () => {
   assert.deepEqual(result.body.messages, ['role is invalid']);
 });
 
 test('answers 409 when the email is taken', () => {
   const result = createUser(storeWith(ann()), { body: { email: 'ANN@example.com', name: 'Other Ann' } });
   assert.equal(result.status, 409);
   assert.equal(result.body.message, 'email already in use');
 });
+
+test('reports every failing field in the order email, name, role', () => {
+  const result = createUser(storeWith(), { body: { email: 'nope', name: 'x'.repeat(81), role: 'god' } });
+  assert.deepEqual(result.body.messages, ['email is invalid', 'name must be at most 80 characters', 'role is invalid']);
+});
diff --git a/test/inviteUser.test.js b/test/inviteUser.test.js
index b4517c9..10f68d9 100644
--- a/test/inviteUser.test.js
+++ b/test/inviteUser.test.js
@@ -13,8 +13,29 @@ test('requires a role', () => {
   const result = inviteUser(storeWith(), { body: { email: 'bob@example.com' } });
   assert.deepEqual(result.body.messages, ['role is required']);
 });
 
 test('answers 409 when a user already has the email', () => {
   const result = inviteUser(storeWith(ann()), { body: { email: 'ann@example.com', role: 'member' } });
   assert.equal(result.status, 409);
 });
+
+test('stores the email in lowercase', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'Bob@Example.com', role: 'viewer' } });
+  assert.equal(result.body.email, 'bob@example.com');
+});
+
+test('answers 409 when a user has the email in another case', () => {
+  const result = inviteUser(storeWith(ann()), { body: { email: 'ANN@example.com', role: 'member' } });
+  assert.equal(result.status, 409);
+});
+
+test('stores a missing name as an empty string', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'bob@example.com', name: '  ', role: 'viewer' } });
+  assert.equal(result.status, 201);
+  assert.equal(result.body.name, '');
+});
+
+test('cannot grant the owner role', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'bob@example.com', role: 'owner' } });
+  assert.deepEqual(result.body.messages, ['role is invalid']);
+});
diff --git a/test/updateUser.test.js b/test/updateUser.test.js
index 0d9af47..76ff078 100644
--- a/test/updateUser.test.js
+++ b/test/updateUser.test.js
@@ -20,8 +20,18 @@ test('rejects a present but invalid email', () => {
   assert.deepEqual(result.body.messages, ['email is invalid']);
 });
 
 test('answers 409 when the email belongs to another user', () => {
   const store = storeWith(ann(), ann({ email: 'bob@example.com', name: 'Bob' }));
   const result = updateUser(store, { params: { id: '2' }, body: { email: 'Ann@example.com' } });
   assert.equal(result.status, 409);
 });
+
+test('rejects a body without any of the fields', () => {
+  const result = updateUser(storeWith(ann()), { params: { id: '1' }, body: {} });
+  assert.deepEqual(result.body.messages, ['no fields to update']);
+});
+
+test('rejects a present but blank name', () => {
+  const result = updateUser(storeWith(ann()), { params: { id: '1' }, body: { name: ' ' } });
+  assert.deepEqual(result.body.messages, ['name is required']);
+});
