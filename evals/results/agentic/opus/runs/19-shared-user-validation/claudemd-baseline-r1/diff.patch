diff --git a/test/userValidation.test.js b/test/userValidation.test.js
new file mode 100644
index 0000000..f837062
--- /dev/null
+++ b/test/userValidation.test.js
@@ -0,0 +1,33 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { INVITABLE_ROLES, validateEmail, validateName, validateRole } from '../src/userValidation.js';
+
+test('validateEmail trims and lowercases', () => {
+  assert.deepEqual(validateEmail('  Ann@Example.COM '), { value: 'ann@example.com' });
+});
+
+test('validateEmail reports missing, blank, non-string and malformed input', () => {
+  assert.deepEqual(validateEmail(undefined), { error: 'email is required' });
+  assert.deepEqual(validateEmail('   '), { error: 'email is required' });
+  assert.deepEqual(validateEmail(42), { error: 'email is required' });
+  assert.deepEqual(validateEmail('ann@example'), { error: 'email is invalid' });
+});
+
+test('validateName trims, requires a name by default and caps the length at 80', () => {
+  assert.deepEqual(validateName(' Ann Lee '), { value: 'Ann Lee' });
+  assert.deepEqual(validateName(''), { error: 'name is required' });
+  assert.deepEqual(validateName('a'.repeat(80)), { value: 'a'.repeat(80) });
+  assert.deepEqual(validateName('a'.repeat(81)), { error: 'name must be at most 80 characters' });
+});
+
+test('validateName with required: false accepts a missing name but still caps the length', () => {
+  assert.deepEqual(validateName(undefined, { required: false }), { value: '' });
+  assert.deepEqual(validateName('a'.repeat(81), { required: false }), { error: 'name must be at most 80 characters' });
+});
+
+test('validateRole requires a known role and honors the allowed list', () => {
+  assert.deepEqual(validateRole('owner'), { value: 'owner' });
+  assert.deepEqual(validateRole(undefined), { error: 'role is required' });
+  assert.deepEqual(validateRole('god'), { error: 'role is invalid' });
+  assert.deepEqual(validateRole('owner', { allowed: INVITABLE_ROLES }), { error: 'role is invalid' });
+});
