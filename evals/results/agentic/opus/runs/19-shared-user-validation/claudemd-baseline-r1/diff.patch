diff --git a/src/userValidation.js b/src/userValidation.js
new file mode 100644
index 0000000..f83727c
--- /dev/null
+++ b/src/userValidation.js
@@ -0,0 +1,39 @@
+// Field rules shared by createUser, updateUser and inviteUser. See docs/api.md for the contract.
+// Each validator returns either { value } with the normalized value or { error } with the client-facing message.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ROLES.filter((role) => role !== 'owner');
+export const MAX_NAME_LENGTH = 80;
+
+export function validateEmail(input) {
+  const email = typeof input === 'string' ? input.trim().toLowerCase() : '';
+  if (email === '') {
+    return { error: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { error: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function validateName(input, { required = true } = {}) {
+  const name = typeof input === 'string' ? input.trim() : '';
+  if (name === '' && required) {
+    return { error: 'name is required' };
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return { error: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
+
+export function validateRole(input, { allowed = ROLES } = {}) {
+  if (input === undefined) {
+    return { error: 'role is required' };
+  }
+  if (!allowed.includes(input)) {
+    return { error: 'role is invalid' };
+  }
+  return { value: input };
+}
