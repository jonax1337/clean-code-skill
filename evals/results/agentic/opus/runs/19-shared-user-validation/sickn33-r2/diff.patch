diff --git a/src/validation/userFields.js b/src/validation/userFields.js
new file mode 100644
index 0000000..c07e0a5
--- /dev/null
+++ b/src/validation/userFields.js
@@ -0,0 +1,69 @@
+// Field rules shared by every handler that accepts user input. See docs/api.md:
+// the message strings are part of the API contract and must not change.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export const USER_ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = USER_ROLES.filter((role) => role !== 'owner');
+
+export function checkEmail(input) {
+  const email = trimmedText(input).toLowerCase();
+  if (email === '') return rejected('email is required');
+  if (!EMAIL_PATTERN.test(email)) return rejected('email is invalid');
+  return accepted(email);
+}
+
+export function checkName(input) {
+  const name = trimmedText(input);
+  if (name === '') return rejected('name is required');
+  return checkNameLength(name);
+}
+
+export function checkOptionalName(input) {
+  return checkNameLength(trimmedText(input));
+}
+
+export function checkRole(role, allowedRoles = USER_ROLES) {
+  return allowedRoles.includes(role) ? accepted(role) : rejected('role is invalid');
+}
+
+export function checkRequiredRole(role, allowedRoles = USER_ROLES) {
+  return role === undefined ? rejected('role is required') : checkRole(role, allowedRoles);
+}
+
+/**
+ * Splits per-field results into accepted values and failure messages.
+ * Messages follow the order of the fields in `results` (email, name, role by convention).
+ */
+export function collectResults(results) {
+  const values = {};
+  const messages = [];
+  for (const [field, result] of Object.entries(results)) {
+    if (result.message === undefined) {
+      values[field] = result.value;
+    } else {
+      messages.push(result.message);
+    }
+  }
+  return { values, messages };
+}
+
+function checkNameLength(name) {
+  if (name.length > MAX_NAME_LENGTH) {
+    return rejected(`name must be at most ${MAX_NAME_LENGTH} characters`);
+  }
+  return accepted(name);
+}
+
+function trimmedText(input) {
+  return typeof input === 'string' ? input.trim() : '';
+}
+
+function accepted(value) {
+  return { value };
+}
+
+function rejected(message) {
+  return { message };
+}
