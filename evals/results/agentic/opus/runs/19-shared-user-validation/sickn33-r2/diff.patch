diff --git a/test/userFields.test.js b/test/userFields.test.js
new file mode 100644
index 0000000..85ceae2
--- /dev/null
+++ b/test/userFields.test.js
@@ -0,0 +1,59 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import {
+  INVITABLE_ROLES,
+  checkEmail,
+  checkName,
+  checkOptionalName,
+  checkRequiredRole,
+  checkRole,
+  collectResults,
+} from '../src/validation/userFields.js';
+
+test('checkEmail trims and lowercases a valid email', () => {
+  assert.deepEqual(checkEmail('  Ann@Example.COM '), { value: 'ann@example.com' });
+});
+
+test('checkEmail treats missing, non-string and blank input as required', () => {
+  for (const input of [undefined, null, 42, '   ']) {
+    assert.deepEqual(checkEmail(input), { message: 'email is required' });
+  }
+});
+
+test('checkEmail rejects malformed addresses', () => {
+  for (const input of ['nope', 'a@b', 'a b@c.de', 'a@@b.cd']) {
+    assert.deepEqual(checkEmail(input), { message: 'email is invalid' });
+  }
+});
+
+test('checkName trims, requires a value and caps the length at 80', () => {
+  assert.deepEqual(checkName(' Ann '), { value: 'Ann' });
+  assert.deepEqual(checkName('  '), { message: 'name is required' });
+  assert.deepEqual(checkName('x'.repeat(80)), { value: 'x'.repeat(80) });
+  assert.deepEqual(checkName('x'.repeat(81)), { message: 'name must be at most 80 characters' });
+});
+
+test('checkOptionalName accepts a missing name as an empty string but still caps the length', () => {
+  assert.deepEqual(checkOptionalName(undefined), { value: '' });
+  assert.deepEqual(checkOptionalName('x'.repeat(81)), { message: 'name must be at most 80 characters' });
+});
+
+test('checkRole accepts only the allowed roles', () => {
+  assert.deepEqual(checkRole('owner'), { value: 'owner' });
+  assert.deepEqual(checkRole('god'), { message: 'role is invalid' });
+  assert.deepEqual(checkRole('owner', INVITABLE_ROLES), { message: 'role is invalid' });
+});
+
+test('checkRequiredRole reports a missing role separately', () => {
+  assert.deepEqual(checkRequiredRole(undefined), { message: 'role is required' });
+  assert.deepEqual(checkRequiredRole('viewer', INVITABLE_ROLES), { value: 'viewer' });
+});
+
+test('collectResults keeps field order for messages and gathers accepted values', () => {
+  const result = collectResults({
+    email: { message: 'email is invalid' },
+    name: { value: 'Ann' },
+    role: { message: 'role is invalid' },
+  });
+  assert.deepEqual(result, { values: { name: 'Ann' }, messages: ['email is invalid', 'role is invalid'] });
+});
