diff --git a/src/userValidation.js b/src/userValidation.js
new file mode 100644
index 0000000..b5c0b55
--- /dev/null
+++ b/src/userValidation.js
@@ -0,0 +1,69 @@
+// Field rules shared by every handler that accepts user input. The messages are part of the API contract
+// (see docs/api.md), so change their wording only together with the docs.
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ROLES.filter((role) => role !== 'owner');
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export function checkEmail(raw) {
+  const email = trimmedString(raw).toLowerCase();
+  if (email === '') {
+    return rejected('email is required');
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return rejected('email is invalid');
+  }
+  return accepted(email);
+}
+
+export function checkName(raw, { optional = false } = {}) {
+  const name = trimmedString(raw);
+  if (name === '' && !optional) {
+    return rejected('name is required');
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return rejected(`name must be at most ${MAX_NAME_LENGTH} characters`);
+  }
+  return accepted(name);
+}
+
+export function checkRole(raw, allowedRoles = ROLES) {
+  if (raw === undefined) {
+    return rejected('role is required');
+  }
+  if (!allowedRoles.includes(raw)) {
+    return rejected('role is invalid');
+  }
+  return accepted(raw);
+}
+
+/**
+ * Combines field checks into `{ values, messages }`. Messages follow the order of `checks`, so callers list
+ * the fields in the documented order: email, name, role.
+ */
+export function collectChecks(checks) {
+  const values = {};
+  const messages = [];
+  for (const [field, check] of Object.entries(checks)) {
+    if (check.message) {
+      messages.push(check.message);
+    } else {
+      values[field] = check.value;
+    }
+  }
+  return { values, messages };
+}
+
+function trimmedString(raw) {
+  return typeof raw === 'string' ? raw.trim() : '';
+}
+
+function accepted(value) {
+  return { value };
+}
+
+function rejected(message) {
+  return { message };
+}
