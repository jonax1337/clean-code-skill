diff --git a/test/userValidation.test.js b/test/userValidation.test.js
new file mode 100644
index 0000000..18fb13e
--- /dev/null
+++ b/test/userValidation.test.js
@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { INVITABLE_ROLES, checkEmail, checkName, checkRole, collectChecks } from '../src/userValidation.js';
+
+test('checkEmail trims and lowercases a valid email', () => {
+  assert.deepEqual(checkEmail('  Ann@Example.com '), { value: 'ann@example.com' });
+});
+
+test('checkEmail requires a non-blank string', () => {
+  for (const raw of [undefined, null, 42, '   ']) {
+    assert.deepEqual(checkEmail(raw), { message: 'email is required' });
+  }
+});
+
+test('checkEmail rejects a malformed email', () => {
+  assert.deepEqual(checkEmail('ann@example'), { message: 'email is invalid' });
+});
+
+test('checkName trims and enforces the length limit', () => {
+  assert.deepEqual(checkName(' Ann Lee '), { value: 'Ann Lee' });
+  assert.deepEqual(checkName('a'.repeat(80)), { value: 'a'.repeat(80) });
+  assert.deepEqual(checkName('a'.repeat(81)), { message: 'name must be at most 80 characters' });
+});
+
+test('checkName requires a name unless it is optional', () => {
+  assert.deepEqual(checkName(''), { message: 'name is required' });
+  assert.deepEqual(checkName(undefined, { optional: true }), { value: '' });
+  assert.deepEqual(checkName('a'.repeat(81), { optional: true }), { message: 'name must be at most 80 characters' });
+});
+
+test('checkRole accepts only the allowed roles', () => {
+  assert.deepEqual(checkRole('owner'), { value: 'owner' });
+  assert.deepEqual(checkRole('owner', INVITABLE_ROLES), { message: 'role is invalid' });
+  assert.deepEqual(checkRole(null), { message: 'role is invalid' });
+  assert.deepEqual(checkRole(undefined), { message: 'role is required' });
+});
+
+test('collectChecks keeps the messages in field order', () => {
+  const result = collectChecks({
+    email: checkEmail('nope'),
+    name: checkName('Ann'),
+    role: checkRole('god'),
+  });
+  assert.deepEqual(result, { values: { name: 'Ann' }, messages: ['email is invalid', 'role is invalid'] });
+});
