 """Decide how much of an expense each person owes."""
 
 from tabtally.errors import MoneyError
 from tabtally.money import allocate
 
+WHOLE = 100
+
 
 def split_equally(cents: int, people: list[str]) -> dict[str, int]:
+    return _split(cents, [(name, 1) for name in people])
+
+
+def split_by_percent(cents: int, percentages: list[tuple[str, int]]) -> dict[str, int]:
+    """Split cents by whole-number percentages that add up to exactly 100."""
+    not_positive = [name for name, percent in percentages if percent <= 0]
+    if not_positive:
+        raise MoneyError(f"percentage must be positive: {', '.join(not_positive)}")
+    total = sum(percent for _, percent in percentages)
+    if total != WHOLE:
+        raise MoneyError(f"percentages must add up to {WHOLE}, not {total}")
+    return _split(cents, percentages)
+
+
+def _split(cents: int, weighted: list[tuple[str, int]]) -> dict[str, int]:
+    people = [name for name, _ in weighted]
     duplicates = sorted({name for name in people if people.count(name) > 1})
     if duplicates:
         raise MoneyError(f"listed more than once: {', '.join(duplicates)}")
-    return dict(zip(people, allocate(cents, [1] * len(people))))
+    return dict(zip(people, allocate(cents, [weight for _, weight in weighted])))
