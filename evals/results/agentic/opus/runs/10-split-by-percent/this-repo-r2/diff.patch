diff --git a/tabtally/splitting.py b/tabtally/splitting.py
index f5739ee..d9041f8 100644
--- a/tabtally/splitting.py
+++ b/tabtally/splitting.py
@@ -1,11 +1,40 @@
 """Decide how much of an expense each person owes."""
 
+import re
+
 from tabtally.errors import MoneyError
 from tabtally.money import allocate
 
+WHOLE_PERCENT = 100
+PERCENTAGE_PATTERN = re.compile(r"(?P<name>.+)=(?P<percent>[0-9]+)")
+
 
 def split_equally(cents: int, people: list[str]) -> dict[str, int]:
+    _reject_duplicates(people)
+    return dict(zip(people, allocate(cents, [1] * len(people))))
+
+
+def split_by_percentage(cents: int, percentages: list[tuple[str, int]]) -> dict[str, int]:
+    people = [name for name, _ in percentages]
+    weights = [percent for _, percent in percentages]
+    _reject_duplicates(people)
+    zero = [name for name, percent in percentages if percent == 0]
+    if zero:
+        raise MoneyError(f"percentage must be more than 0: {', '.join(zero)}")
+    if sum(weights) != WHOLE_PERCENT:
+        raise MoneyError(f"percentages must add up to {WHOLE_PERCENT}, not {sum(weights)}")
+    return dict(zip(people, allocate(cents, weights)))
+
+
+def parse_percentage(text: str) -> tuple[str, int]:
+    """Turn user input such as "alice=50" into a name and a whole-number percentage."""
+    match = PERCENTAGE_PATTERN.fullmatch(text)
+    if not match:
+        raise MoneyError(f"expected NAME=PERCENT with a whole-number percent: {text!r}")
+    return match["name"], int(match["percent"])
+
+
+def _reject_duplicates(people: list[str]) -> None:
     duplicates = sorted({name for name in people if people.count(name) > 1})
     if duplicates:
         raise MoneyError(f"listed more than once: {', '.join(duplicates)}")
-    return dict(zip(people, allocate(cents, [1] * len(people))))
