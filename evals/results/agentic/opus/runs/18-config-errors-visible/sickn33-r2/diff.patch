+++ b/src/main/java/com/acme/relay/config/ConfigException.java
@@ -1,8 +1,31 @@
 package com.acme.relay.config;
 
+import java.util.List;
+
 /** The configuration cannot be used to run the service. */
 public class ConfigException extends RuntimeException {
+    private static final long serialVersionUID = 1L;
+
+    private final transient List<String> problems;
+
     public ConfigException(String message) {
-        super(message);
+        this(List.of(message));
+    }
+
+    public ConfigException(List<String> problems) {
+        super(describe(problems));
+        this.problems = List.copyOf(problems);
+    }
+
+    /** Every problem found, one entry per offending key, so they can all be fixed in one pass. */
+    public List<String> problems() {
+        return problems;
+    }
+
+    private static String describe(List<String> problems) {
+        if (problems.size() == 1) {
+            return problems.get(0);
+        }
+        return problems.size() + " configuration problems:\n  - " + String.join("\n  - ", problems);
     }
 }
