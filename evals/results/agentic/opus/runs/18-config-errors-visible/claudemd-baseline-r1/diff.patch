@@ -0,0 +1,59 @@
+package com.acme.relay;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.PrintStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class MainTest {
+    private static final String VALID = """
+            upstream.url=https://uplink.example.com/v1/events
+            api.token=s3cret
+            worker.threads=1
+            """;
+
+    @TempDir
+    Path dir;
+
+    private final ByteArrayOutputStream out = new ByteArrayOutputStream();
+    private final ByteArrayOutputStream err = new ByteArrayOutputStream();
+
+    @Test
+    void refusesToStartWithAnInvalidConfigAndSaysWhy() throws Exception {
+        Path config = Files.writeString(dir.resolve("config.properties"),
+                "upstream.url=https://uplink.example.com/v1/events\napi.token=s3cret\nworker.threads=1O\n");
+
+        int status = run(config, "hello\n");
+
+        assertEquals(Main.EXIT_CONFIG_ERROR, status);
+        String error = err.toString(StandardCharsets.UTF_8);
+        assertTrue(error.contains("refusing to start"), error);
+        assertTrue(error.contains("worker.threads: '1O' is not a whole number"), error);
+        assertEquals("", out.toString(StandardCharsets.UTF_8), "no message may be relayed");
+    }
+
+    @Test
+    void relaysMessagesWithAValidConfig() throws Exception {
+        Path config = Files.writeString(dir.resolve("config.properties"), VALID);
+
+        int status = run(config, "hello\n");
+
+        assertEquals(0, status);
+        assertTrue(out.toString(StandardCharsets.UTF_8).contains("hello"));
+    }
+
+    private int run(Path config, String input) throws Exception {
+        return Main.run(
+                new String[] {config.toString()},
+                new ByteArrayInputStream(input.getBytes(StandardCharsets.UTF_8)),
+                new PrintStream(out, true, StandardCharsets.UTF_8),
+                new PrintStream(err, true, StandardCharsets.UTF_8));
+    }
+}
