index 109ad0d..e931c56 100644
--- a/src/main/java/com/acme/relay/config/ConfigException.java
+++ b/src/main/java/com/acme/relay/config/ConfigException.java
@@ -1,8 +1,32 @@
 package com.acme.relay.config;
 
+import java.nio.file.Path;
+import java.util.List;
+
 /** The configuration cannot be used to run the service. */
 public class ConfigException extends RuntimeException {
+    private final List<String> problems;
+
     public ConfigException(String message) {
         super(message);
+        this.problems = List.of(message);
+    }
+
+    public ConfigException(Path file, List<String> problems) {
+        super(describe(file, problems));
+        this.problems = List.copyOf(problems);
+    }
+
+    /** Each problem found, one per entry, for example {@code worker.threads: must be a whole number ...}. */
+    public List<String> problems() {
+        return problems;
+    }
+
+    private static String describe(Path file, List<String> problems) {
+        StringBuilder message = new StringBuilder("invalid configuration in ").append(file).append(':');
+        for (String problem : problems) {
+            message.append(System.lineSeparator()).append("  - ").append(problem);
+        }
+        return message.toString();
     }
 }
