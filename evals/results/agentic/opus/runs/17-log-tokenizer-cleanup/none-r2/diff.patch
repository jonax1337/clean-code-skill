+/// Spaces and tabs separate tokens.
+#[inline]
+fn is_separator(byte: u8) -> bool {
+    byte == b' ' || byte == b'\t'
+}
+
+/// A closing `]` or `"` at `end - 1` must be followed by a separator or the end of the line.
+#[inline]
+fn expect_separator(bytes: &[u8], end: usize) -> Result<(), LexError> {
+    match bytes.get(end) {
+        Some(&byte) if !is_separator(byte) => Err(LexError::ExpectedSeparator { pos: end }),
+        _ => Ok(()),
+    }
+}
+
+// Each `lex_*` method starts at `self.pos`. On success it moves `self.pos` past the token and sets the next
+// state; on error it leaves both alone, and `next` ends the stream.
+impl<'a> Tokens<'a> {
+    #[inline]
+    fn bytes(&self) -> &'a [u8] {
+        self.src.as_bytes()
+    }
+
+    #[inline]
+    fn skip_separators(&mut self) {
+        let bytes = self.bytes();
+        while self.pos < bytes.len() && is_separator(bytes[self.pos]) {
+            self.pos += 1;
+        }
+    }
+
+    /// A timestamp, key or word; `self.pos` is on its first byte.
+    #[inline]
+    fn lex_token(&mut self) -> Result<Token<'a>, LexError> {
+        let start = self.pos;
+        match self.bytes()[start] {
+            b'[' => self.lex_timestamp(start),
+            b'"' => Err(LexError::UnexpectedQuote { pos: start }),
+            b'=' => Err(LexError::EmptyKey { pos: start }),
+            _ => self.lex_key_or_word(start),
+        }
+    }
+
+    /// `[...]`, with `open` on the `[`.
+    #[inline]
+    fn lex_timestamp(&mut self, open: usize) -> Result<Token<'a>, LexError> {
+        let bytes = self.bytes();
+        let mut close = open + 1;
+        loop {
+            match bytes.get(close) {
+                None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+                Some(b']') => break,
+                Some(b'[') => return Err(LexError::NestedBracket { pos: close }),
+                Some(_) => close += 1,
+            }
+        }
+        expect_separator(bytes, close + 1)?;
+        self.pos = close + 1;
+        Ok(Token::Timestamp(&self.src[open + 1..close]))
+    }
+
+    /// Text up to a separator, `=` or the end of the line. It is a key if `=` ends it, a word otherwise.
+    #[inline]
+    fn lex_key_or_word(&mut self, start: usize) -> Result<Token<'a>, LexError> {
+        let bytes = self.bytes();
+        let mut end = start;
+        while let Some(&byte) = bytes.get(end) {
+            match byte {
+                b' ' | b'\t' | b'=' => break,
+                b'"' => return Err(LexError::UnexpectedQuote { pos: end }),
+                _ => end += 1,
+            }
+        }
+        let text = &self.src[start..end];
+        if bytes.get(end) == Some(&b'=') {
+            self.state = State::Value;
+            self.pos = end + 1;
+            Ok(Token::Key(text))
+        } else {
+            self.pos = end;
+            Ok(Token::Word(text))
+        }
+    }
+
+    /// The value after `key=`: quoted if it starts with `"`, bare (possibly empty) otherwise.
+    #[inline]
+    fn lex_value(&mut self) -> Result<Token<'a>, LexError> {
+        let start = self.pos;
+        if self.bytes().get(start) == Some(&b'"') {
+            self.lex_quoted(start)
+        } else {
+            self.lex_bare(start)
+        }
+    }
+
+    /// `"..."`, with `open` on the opening quote. Only `\"`, `\\`, `\n` and `\t` are valid escapes.
+    #[inline]
+    fn lex_quoted(&mut self, open: usize) -> Result<Token<'a>, LexError> {
+        let bytes = self.bytes();
+        let mut close = open + 1;
+        loop {
+            match bytes.get(close) {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"') => break,
+                Some(b'\\') => match bytes.get(close + 1) {
+                    None => return Err(LexError::UnterminatedQuote { pos: open }),
+                    Some(b'"' | b'\\' | b'n' | b't') => close += 2,
+                    Some(_) => return Err(LexError::InvalidEscape { pos: close }),
+                },
+                Some(_) => close += 1,
+            }
+        }
+        expect_separator(bytes, close + 1)?;
+        self.state = State::Token;
+        self.pos = close + 1;
+        Ok(Token::Quoted(&self.src[open + 1..close]))
+    }
+
+    /// An unquoted value up to a separator or the end of the line. It may be empty but must not contain `"`.
+    #[inline]
+    fn lex_bare(&mut self, start: usize) -> Result<Token<'a>, LexError> {
+        let bytes = self.bytes();
+        let mut end = start;
+        while let Some(&byte) = bytes.get(end) {
+            match byte {
+                b' ' | b'\t' => break,
+                b'"' => return Err(LexError::UnexpectedQuote { pos: end }),
+                _ => end += 1,
             }
-            _ => None,
         }
+        self.state = State::Token;
+        self.pos = end;
+        Ok(Token::Bare(&self.src[start..end]))
     }
