+/// What the tokenizer expects at `pos`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum State {
+    /// Separators, then a timestamp, key or word.
+    Token,
+    /// The value of the key just read, directly after its `=`.
+    Value,
+    /// Nothing: an error has been reported.
+    Failed,
+}
+
+type LexResult<'a> = Result<Token<'a>, LexError>;
+
 impl<'a> Tokens<'a> {
     pub fn new(src: &'a str) -> Self {
-        Tokens { src, pos: 0, st: 0 }
+        Tokens { src, pos: 0, state: State::Token }
+    }
+
+    fn bytes(&self) -> &'a [u8] {
+        self.src.as_bytes()
+    }
+
+    /// Reads a timestamp, key or word; `None` once only separators are left.
+    fn token(&mut self) -> Option<LexResult<'a>> {
+        let start = skip_separators(self.bytes(), self.pos);
+        self.pos = start;
+        let &first = self.bytes().get(start)?;
+        Some(match first {
+            b'[' => self.timestamp(start),
+            b'"' => Err(LexError::UnexpectedQuote { pos: start }),
+            b'=' => Err(LexError::EmptyKey { pos: start }),
+            _ => self.key_or_word(start),
+        })
+    }
+
+    fn timestamp(&mut self, open: usize) -> LexResult<'a> {
+        let close = find_timestamp_end(self.bytes(), open)?;
+        expect_separator(self.bytes(), close + 1)?;
+        self.pos = close + 1;
+        Ok(Token::Timestamp(&self.src[open + 1..close]))
+    }
+
+    fn key_or_word(&mut self, start: usize) -> LexResult<'a> {
+        let end = scan_unquoted(self.bytes(), start, |b| is_separator(b) || b == b'=')?;
+        let text = &self.src[start..end];
+        if self.bytes().get(end) == Some(&b'=') {
+            self.state = State::Value;
+            self.pos = end + 1;
+            Ok(Token::Key(text))
+        } else {
+            self.pos = end;
+            Ok(Token::Word(text))
+        }
+    }
+
+    fn value(&mut self) -> LexResult<'a> {
+        self.state = State::Token;
+        let start = self.pos;
+        if self.bytes().get(start) == Some(&b'"') {
+            self.quoted(start)
+        } else {
+            self.bare(start)
+        }
+    }
+
+    fn quoted(&mut self, open: usize) -> LexResult<'a> {
+        let close = find_closing_quote(self.bytes(), open)?;
+        expect_separator(self.bytes(), close + 1)?;
+        self.pos = close + 1;
+        Ok(Token::Quoted(&self.src[open + 1..close]))
+    }
+
+    /// An empty value when `start` is a separator or the end of the line.
+    fn bare(&mut self, start: usize) -> LexResult<'a> {
+        let end = scan_unquoted(self.bytes(), start, is_separator)?;
+        self.pos = end;
+        Ok(Token::Bare(&self.src[start..end]))
     }
 }
 
