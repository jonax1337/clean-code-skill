+
+/// Spaces and tabs separate tokens.
+#[inline]
+fn is_separator(byte: u8) -> bool {
+    byte == b' ' || byte == b'\t'
+}
+
+/// Index of the first byte at or after `from` that matches `stop`, or `bytes.len()` if there is none.
+#[inline]
+fn find(bytes: &[u8], from: usize, stop: impl Fn(u8) -> bool) -> usize {
+    bytes[from..].iter().position(|&b| stop(b)).map_or(bytes.len(), |offset| from + offset)
+}
+
+// Each `lex_*` method reads one token starting at `self.pos`. On success it moves `pos` past the token and sets
+// the state for what follows; on error `next` ends the stream, so the methods leave `pos` and `state` alone.
+impl<'a> Tokens<'a> {
+    fn bytes(&self) -> &'a [u8] {
+        self.src.as_bytes()
+    }
+
+    fn skip_separators(&mut self) {
+        self.pos = find(self.bytes(), self.pos, |b| !is_separator(b));
+    }
+
+    /// A timestamp, key or word. `pos` is on a non-separator byte.
+    fn lex_token(&mut self) -> Result<Token<'a>, LexError> {
+        let start = self.pos;
+        match self.bytes()[start] {
+            b'[' => self.lex_timestamp(),
+            b'"' => Err(LexError::UnexpectedQuote { pos: start }),
+            b'=' => Err(LexError::EmptyKey { pos: start }),
+            _ => self.lex_key_or_word(),
+        }
+    }
+
+    /// `[...]`, which must be followed by a separator or the end of the line. `pos` is on the `[`.
+    fn lex_timestamp(&mut self) -> Result<Token<'a>, LexError> {
+        let bytes = self.bytes();
+        let open = self.pos;
+        let close = find(bytes, open + 1, |b| b == b']' || b == b'[');
+        match bytes.get(close) {
+            None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+            Some(b'[') => return Err(LexError::NestedBracket { pos: close }),
+            Some(_) => {}
+        }
+        self.expect_separator_after(close)?;
+        self.pos = close + 1;
+        Ok(Token::Timestamp(&self.src[open + 1..close]))
+    }
+
+    /// `key=` (the value follows in the next call) or a plain word.
+    fn lex_key_or_word(&mut self) -> Result<Token<'a>, LexError> {
+        let bytes = self.bytes();
+        let start = self.pos;
+        let end = find(bytes, start, |b| is_separator(b) || b == b'=' || b == b'"');
+        match bytes.get(end) {
+            Some(b'"') => Err(LexError::UnexpectedQuote { pos: end }),
+            Some(b'=') => {
+                self.pos = end + 1;
+                self.state = State::Value;
+                Ok(Token::Key(&self.src[start..end]))
+            }
+            _ => {
+                self.pos = end;
+                Ok(Token::Word(&self.src[start..end]))
             }
-            _ => None,
+        }
+    }
+
+    /// The value after `key=`: quoted, or bare up to the next separator (possibly empty).
+    fn lex_value(&mut self) -> Result<Token<'a>, LexError> {
+        let token = if self.bytes().get(self.pos) == Some(&b'"') {
+            self.lex_quoted()?
+        } else {
+            self.lex_bare()?
+        };
+        self.state = State::Token;
+        Ok(token)
+    }
+
+    /// A bare value; `=` is allowed in it, `"` is not.
+    fn lex_bare(&mut self) -> Result<Token<'a>, LexError> {
+        let bytes = self.bytes();
+        let start = self.pos;
+        let end = find(bytes, start, |b| is_separator(b) || b == b'"');
+        if end < bytes.len() && bytes[end] == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: end });
+        }
+        self.pos = end;
+        Ok(Token::Bare(&self.src[start..end]))
+    }
+
+    /// `"..."` with the escapes `\"`, `\\`, `\n` and `\t`, followed by a separator or the end of the line.
+    /// `pos` is on the opening quote.
+    fn lex_quoted(&mut self) -> Result<Token<'a>, LexError> {
+        let bytes = self.bytes();
+        let open = self.pos;
+        let unterminated = LexError::UnterminatedQuote { pos: open };
+        let mut i = open + 1;
+        let close = loop {
+            i = find(bytes, i, |b| b == b'"' || b == b'\\');
+            match bytes.get(i) {
+                None => return Err(unterminated),
+                Some(b'"') => break i,
+                Some(_) => match bytes.get(i + 1) {
+                    None => return Err(unterminated),
+                    Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                    Some(_) => return Err(LexError::InvalidEscape { pos: i }),
+                },
+            }
+        };
+        self.expect_separator_after(close)?;
+        self.pos = close + 1;
+        Ok(Token::Quoted(&self.src[open + 1..close]))
+    }
+
+    /// The closing `]` or `"` at `close` must be followed by a separator or the end of the line.
+    fn expect_separator_after(&self, close: usize) -> Result<(), LexError> {
+        match self.bytes().get(close + 1) {
+            Some(&b) if !is_separator(b) => Err(LexError::ExpectedSeparator { pos: close + 1 }),
+            _ => Ok(()),
         }
     }
 }
diff --git a/tests/tokens.rs b/tests/tokens.rs
