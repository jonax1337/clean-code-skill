--- a/tests/tokens.rs
+++ b/tests/tokens.rs
@@ -68,8 +68,41 @@ fn unterminated_timestamp_is_an_error() {
 
 #[test]
 fn iteration_stops_after_an_error() {
     let mut stream = tokenize("ok =bad later=1");
     assert_eq!(stream.next(), Some(Ok(Token::Word("ok"))));
     assert_eq!(stream.next(), Some(Err(LexError::EmptyKey { pos: 3 })));
     assert_eq!(stream.next(), None);
 }
+
+#[test]
+fn empty_and_bare_values() {
+    assert_eq!(
+        tokens("a= b=x=y c=").unwrap(),
+        vec![
+            Token::Key("a"),
+            Token::Bare(""),
+            Token::Key("b"),
+            Token::Bare("x=y"),
+            Token::Key("c"),
+            Token::Bare(""),
+        ]
+    );
+}
+
+#[test]
+fn each_malformed_token_reports_its_error() {
+    let cases = [
+        ("[a[b]", LexError::NestedBracket { pos: 2 }),
+        ("[ts]x", LexError::ExpectedSeparator { pos: 4 }),
+        ("k=\"v\"x", LexError::ExpectedSeparator { pos: 5 }),
+        (r#"k="a\qb""#, LexError::InvalidEscape { pos: 4 }),
+        (r#"k="ab\"#, LexError::UnterminatedQuote { pos: 2 }),
+        ("\"word", LexError::UnexpectedQuote { pos: 0 }),
+        ("wo\"rd", LexError::UnexpectedQuote { pos: 2 }),
+        ("k=va\"l", LexError::UnexpectedQuote { pos: 4 }),
+        ("=v", LexError::EmptyKey { pos: 0 }),
+    ];
+    for (line, error) in cases {
+        assert_eq!(tokens(line), Err(error), "line {line:?}");
+    }
+}
