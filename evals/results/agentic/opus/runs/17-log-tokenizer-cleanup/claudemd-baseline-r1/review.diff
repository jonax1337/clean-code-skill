+//! Checks that the tokenizer behaves exactly like the frozen pre-refactor implementation.
+
+#[allow(dead_code)]
+#[path = "support/reference_token.rs"]
+mod reference;
+
+use std::time::Instant;
+
+/// Every byte class the tokenizer distinguishes, plus a multi-byte character.
+const ALPHABET: &[&str] = &[" ", "\t", "[", "]", "\"", "\\", "=", "n", "a", "é"];
+
+/// Compares the whole stream, including the `None`s after it ends or fails.
+fn assert_same(line: &str) {
+    let mut new = logscan::tokenize(line);
+    let mut old = reference::tokenize(line);
+    for _ in 0..line.len() + 3 {
+        let (n, o) = (new.next(), old.next());
+        let o = o.map(|r| {
+            r.map(|t| match t {
+                reference::Token::Timestamp(s) => logscan::Token::Timestamp(s),
+                reference::Token::Key(s) => logscan::Token::Key(s),
+                reference::Token::Quoted(s) => logscan::Token::Quoted(s),
+                reference::Token::Bare(s) => logscan::Token::Bare(s),
+                reference::Token::Word(s) => logscan::Token::Word(s),
+            })
+        });
+        assert_eq!(n, o, "line {line:?}");
+    }
+}
+
+#[test]
+fn matches_reference_on_all_short_lines() {
+    let mut line = String::new();
+    let mut digits = Vec::new();
+    for len in 0..=6 {
+        digits.clear();
+        digits.resize(len, 0usize);
+        loop {
+            line.clear();
+            for &d in &digits {
+                line.push_str(ALPHABET[d]);
+            }
+            assert_same(&line);
+            // Next combination, odometer style.
+            let mut k = 0;
+            while k < len && digits[k] == ALPHABET.len() - 1 {
+                digits[k] = 0;
+                k += 1;
+            }
+            if k == len {
+                break;
+            }
+            digits[k] += 1;
+        }
+    }
+}
+
+struct Lcg(u64);
+
+impl Lcg {
+    fn next(&mut self) -> usize {
+        self.0 = self.0.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        (self.0 >> 33) as usize
+    }
+}
+
+#[test]
+fn matches_reference_on_random_long_lines() {
+    let pieces = [
+        " ", "\t", "[", "]", "\"", "\\", "=", "n", "a", "é", "key=", "k=\"v w\" ", "[ts] ", "\\\"", "word ",
+    ];
+    let mut rng = Lcg(42);
+    let mut line = String::new();
+    for _ in 0..200_000 {
+        line.clear();
+        for _ in 0..rng.next() % 40 {
+            line.push_str(pieces[rng.next() % pieces.len()]);
+        }
+        assert_same(&line);
+    }
+}
+
+/// Timing comparison; run with `cargo test --release --test equivalence -- --ignored --nocapture`.
+#[test]
+#[ignore]
+fn compare_speed_with_reference() {
+    let sample = "[2024-05-01T12:00:00Z] level=info msg=\"disk 91% full \\\"sda\\\"\" user=ann retries= started worker-3";
+    let lines: Vec<String> = (0..200_000).map(|i| format!("{sample} id={i}")).collect();
+    let count_new = |lines: &[String]| lines.iter().map(|l| logscan::tokenize(l).count()).sum::<usize>();
+    let count_old = |lines: &[String]| lines.iter().map(|l| reference::tokenize(l).count()).sum::<usize>();
+    for round in 0..3 {
+        let t = Instant::now();
+        let a = std::hint::black_box(count_old(std::hint::black_box(&lines)));
+        let old = t.elapsed();
+        let t = Instant::now();
+        let b = std::hint::black_box(count_new(std::hint::black_box(&lines)));
+        let new = t.elapsed();
+        assert_eq!(a, b);
+        println!("round {round}: reference {old:?}, refactored {new:?}");
+    }
+}
