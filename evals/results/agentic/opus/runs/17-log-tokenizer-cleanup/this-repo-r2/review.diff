+// The scanners work on bytes: every delimiter is ASCII, so every position they stop at is a char boundary.
+impl<'a> Tokens<'a> {
+    fn bytes(&self) -> &'a [u8] {
+        self.line.as_bytes()
+    }
+
+    fn skip_separators(&self, start: usize) -> usize {
+        let bytes = self.bytes();
+        bytes[start..].iter().position(|&b| !is_separator(b)).map_or(bytes.len(), |offset| start + offset)
+    }
+
+    fn scan_token(&self, start: usize) -> Result<Scanned<'a>, LexError> {
+        match self.bytes()[start] {
+            b'[' => self.scan_timestamp(start),
+            b'"' => Err(LexError::UnexpectedQuote { pos: start }),
+            b'=' => Err(LexError::EmptyKey { pos: start }),
+            _ => self.scan_key_or_word(start),
         }
     }
+
+    fn scan_timestamp(&self, open: usize) -> Result<Scanned<'a>, LexError> {
+        let bytes = self.bytes();
+        let text_start = open + 1;
+        let close = match bytes[text_start..].iter().position(|&b| b == b']' || b == b'[') {
+            None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+            Some(offset) => text_start + offset,
+        };
+        if bytes[close] == b'[' {
+            return Err(LexError::NestedBracket { pos: close });
+        }
+        let end = close + 1;
+        self.expect_separator(end)?;
+        Ok(Scanned { token: Token::Timestamp(&self.line[text_start..close]), end, next_state: State::BeforeToken })
+    }
+
+    fn scan_key_or_word(&self, start: usize) -> Result<Scanned<'a>, LexError> {
+        let end = self.unquoted_run_end(start, |b| is_separator(b) || b == b'=')?;
+        let text = &self.line[start..end];
+        Ok(if self.bytes().get(end) == Some(&b'=') {
+            Scanned { token: Token::Key(text), end: end + 1, next_state: State::BeforeValue }
+        } else {
+            Scanned { token: Token::Word(text), end, next_state: State::BeforeToken }
+        })
+    }
+
+    /// A separator or the end of the line right here yields an empty bare value.
+    fn scan_value(&self, start: usize) -> Result<Scanned<'a>, LexError> {
+        if self.bytes().get(start) == Some(&b'"') {
+            return self.scan_quoted(start);
+        }
+        let end = self.unquoted_run_end(start, is_separator)?;
+        Ok(Scanned { token: Token::Bare(&self.line[start..end]), end, next_state: State::BeforeToken })
+    }
+
+    fn scan_quoted(&self, open: usize) -> Result<Scanned<'a>, LexError> {
+        let bytes = self.bytes();
+        let unterminated = LexError::UnterminatedQuote { pos: open };
+        let text_start = open + 1;
+        let mut i = text_start;
+        let close = loop {
+            match bytes.get(i) {
+                None => return Err(unterminated),
+                Some(b'"') => break i,
+                Some(b'\\') => match bytes.get(i + 1) {
+                    None => return Err(unterminated),
+                    Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                    Some(_) => return Err(LexError::InvalidEscape { pos: i }),
+                },
+                Some(_) => i += 1,
+            }
+        };
+        let end = close + 1;
+        self.expect_separator(end)?;
+        Ok(Scanned { token: Token::Quoted(&self.line[text_start..close]), end, next_state: State::BeforeToken })
+    }
+
+    /// Finds the end of unquoted text starting at `start`: the first byte for which `ends_run` holds, or the end
+    /// of the line. A `"` before that is an error.
+    fn unquoted_run_end(&self, start: usize, ends_run: impl Fn(u8) -> bool) -> Result<usize, LexError> {
+        let bytes = self.bytes();
+        let end = bytes[start..]
+            .iter()
+            .position(|&b| b == b'"' || ends_run(b))
+            .map_or(bytes.len(), |offset| start + offset);
+        if bytes.get(end) == Some(&b'"') {
+            return Err(LexError::UnexpectedQuote { pos: end });
+        }
+        Ok(end)
+    }
+
+    /// A timestamp or quoted value must be followed by a separator or the end of the line.
+    fn expect_separator(&self, pos: usize) -> Result<(), LexError> {
+        match self.bytes().get(pos) {
+            Some(&b) if !is_separator(b) => Err(LexError::ExpectedSeparator { pos }),
+            _ => Ok(()),
+        }
+    }
+}
+
+fn is_separator(byte: u8) -> bool {
+    byte == b' ' || byte == b'\t'
 }
