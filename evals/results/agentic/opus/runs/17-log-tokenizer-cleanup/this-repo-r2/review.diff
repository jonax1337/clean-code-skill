@@ -68,8 +68,155 @@ fn unterminated_timestamp_is_an_error() {
 
 #[test]
 fn iteration_stops_after_an_error() {
     let mut stream = tokenize("ok =bad later=1");
     assert_eq!(stream.next(), Some(Ok(Token::Word("ok"))));
     assert_eq!(stream.next(), Some(Err(LexError::EmptyKey { pos: 3 })));
     assert_eq!(stream.next(), None);
 }
+
+#[test]
+fn key_followed_by_space_or_end_has_an_empty_bare_value() {
+    assert_eq!(
+        tokens("a= b=").unwrap(),
+        vec![
+            Token::Key("a"),
+            Token::Bare(""),
+            Token::Key("b"),
+            Token::Bare("")
+        ]
+    );
+}
+
+#[test]
+fn bare_values_may_contain_equals_and_brackets() {
+    assert_eq!(
+        tokens("a==b c=[x]").unwrap(),
+        vec![
+            Token::Key("a"),
+            Token::Bare("=b"),
+            Token::Key("c"),
+            Token::Bare("[x]")
+        ]
+    );
+}
+
+#[test]
+fn words_may_contain_brackets_after_the_first_byte() {
+    assert_eq!(
+        tokens("a[b] c]").unwrap(),
+        vec![Token::Word("a[b]"), Token::Word("c]")]
+    );
+}
+
+#[test]
+fn timestamp_at_the_end_of_the_line() {
+    assert_eq!(
+        tokens("x [t]").unwrap(),
+        vec![Token::Word("x"), Token::Timestamp("t")]
+    );
+}
+
+#[test]
+fn surrounding_separators_are_skipped() {
+    assert_eq!(
+        tokens(" \t[t]\t a=\"q\"  ").unwrap(),
+        vec![Token::Timestamp("t"), Token::Key("a"), Token::Quoted("q"),]
+    );
+}
+
+#[test]
+fn non_ascii_text_is_kept_whole() {
+    assert_eq!(
+        tokens("[zeit] grüße=\"übel\" ok=ä").unwrap(),
+        vec![
+            Token::Timestamp("zeit"),
+            Token::Key("grüße"),
+            Token::Quoted("übel"),
+            Token::Key("ok"),
+            Token::Bare("ä"),
+        ]
+    );
+}
+
+#[test]
+fn nested_bracket_in_timestamp_is_an_error() {
+    assert_eq!(tokens("[a[b]"), Err(LexError::NestedBracket { pos: 2 }));
+}
+
+#[test]
+fn timestamp_must_be_followed_by_a_separator() {
+    assert_eq!(tokens("[t]x"), Err(LexError::ExpectedSeparator { pos: 3 }));
+}
+
+#[test]
+fn quoted_value_must_be_followed_by_a_separator() {
+    assert_eq!(
+        tokens("a=\"q\"x"),
+        Err(LexError::ExpectedSeparator { pos: 5 })
+    );
+}
+
+#[test]
+fn backslash_at_the_end_leaves_the_quote_unterminated() {
+    assert_eq!(
+        tokens(r#"k a="x\"#),
+        Err(LexError::UnterminatedQuote { pos: 4 })
+    );
+}
+
+#[test]
+fn escaped_quote_at_the_end_leaves_the_quote_unterminated() {
+    assert_eq!(
+        tokens(r#"a="x\""#),
+        Err(LexError::UnterminatedQuote { pos: 2 })
+    );
+}
+
+#[test]
+fn unknown_escape_is_an_error_at_the_backslash() {
+    assert_eq!(
+        tokens(r#"a="x\q""#),
+        Err(LexError::InvalidEscape { pos: 4 })
+    );
+    assert_eq!(tokens(r#"a="\ä""#), Err(LexError::InvalidEscape { pos: 3 }));
+}
+
+#[test]
+fn quote_opening_a_token_is_an_error() {
+    assert_eq!(
+        tokens("ok \"x\""),
+        Err(LexError::UnexpectedQuote { pos: 3 })
+    );
+}
+
+#[test]
+fn quote_inside_a_word_or_key_is_an_error() {
+    assert_eq!(tokens("ab\"c"), Err(LexError::UnexpectedQuote { pos: 2 }));
+    assert_eq!(tokens("ab\"c=1"), Err(LexError::UnexpectedQuote { pos: 2 }));
+}
+
+#[test]
+fn quote_inside_a_bare_value_is_an_error() {
+    assert_eq!(tokens("a=b\"c"), Err(LexError::UnexpectedQuote { pos: 3 }));
+}
+
+#[test]
+fn equals_opening_a_token_is_an_empty_key() {
+    assert_eq!(tokens("=1"), Err(LexError::EmptyKey { pos: 0 }));
+}
+
+#[test]
+fn iteration_stops_after_an_error_inside_a_value() {
+    let mut stream = tokenize(r#"a="x\q" b=1"#);
+    assert_eq!(stream.next(), Some(Ok(Token::Key("a"))));
+    assert_eq!(stream.next(), Some(Err(LexError::InvalidEscape { pos: 4 })));
+    assert_eq!(stream.next(), None);
+}
+
+#[test]
+fn iteration_stays_finished_at_the_end_of_the_line() {
+    let mut stream = tokenize("w ");
+    assert_eq!(stream.next(), Some(Ok(Token::Word("w"))));
+    assert_eq!(stream.next(), None);
+    assert_eq!(stream.next(), None);
+}
