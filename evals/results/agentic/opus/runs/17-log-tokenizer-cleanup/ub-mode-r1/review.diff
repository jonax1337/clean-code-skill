+//! Proves the tokenizer still behaves exactly like the frozen reference in `oracle`: same tokens, same
+//! byte ranges borrowed from the line, same errors, and nothing after the stream has ended.
+
+mod oracle;
+
+use logscan::{tokenize, LexError, Token};
+
+/// Every byte that means something to the line format, a plain letter, an escape letter and a
+/// multi-byte character, so that every branch and every char-boundary case is reached.
+const ALPHABET: [&str; 10] = [" ", "\t", "[", "]", "\"", "\\", "=", "a", "n", "é"];
+const MAX_LEN: u32 = 6;
+
+/// A token reduced to what a caller can observe: its kind and the byte range of the line it borrows.
+type Seen = Result<(&'static str, usize, usize), LexError>;
+
+fn observe(line: &str, item: Result<Token<'_>, LexError>) -> Seen {
+    let (kind, text) = match item? {
+        Token::Timestamp(t) => ("timestamp", t),
+        Token::Key(t) => ("key", t),
+        Token::Quoted(t) => ("quoted", t),
+        Token::Bare(t) => ("bare", t),
+        Token::Word(t) => ("word", t),
+    };
+    let start = text.as_ptr() as usize - line.as_ptr() as usize;
+    Ok((kind, start, start + text.len()))
+}
+
+/// Drains the stream and then asks a few more times, because callers may keep polling after `None`.
+fn run<'a, I>(line: &'a str, mut stream: I) -> Vec<Option<Seen>>
+where
+    I: Iterator<Item = Result<Token<'a>, LexError>>,
+{
+    let mut seen = Vec::new();
+    let mut nones = 0;
+    while nones < 3 {
+        let item = stream.next().map(|item| observe(line, item));
+        nones += usize::from(item.is_none());
+        seen.push(item);
+    }
+    seen
+}
+
+fn assert_same(line: &str) {
+    assert_eq!(run(line, tokenize(line)), run(line, oracle::Tokens::new(line)), "line {line:?}");
+}
+
+#[test]
+fn every_short_line_tokenizes_like_the_reference() {
+    let mut line = String::new();
+    let mut checked = 0u64;
+    for len in 0..=MAX_LEN {
+        for mut index in 0..ALPHABET.len().pow(len) {
+            line.clear();
+            for _ in 0..len {
+                line.push_str(ALPHABET[index % ALPHABET.len()]);
+                index /= ALPHABET.len();
+            }
+            assert_same(&line);
+            checked += 1;
+        }
+    }
+    assert_eq!(checked, (0..=MAX_LEN).map(|len| 10u64.pow(len)).sum::<u64>());
+}
+
+#[test]
+fn realistic_lines_tokenize_like_the_reference() {
+    for line in [
+        "[2024-05-01T12:00:00Z] level=info msg=\"disk 91% full\" retries= done",
+        "[2024-05-01T12:00:00Z]\tlevel=warn msg=\"say \\\"hi\\\"\\n\\t\\\\\" user=ann",
+        "[2024-05-01T12:00:00Z]x",
+        "[2024-05-01 [nested]",
+        "msg=\"bad \\q escape\"",
+        "msg=\"ok\"trailing",
+        "path=/a=b/c weird[word] end]",
+        "ünïcode=wörld \"oops",
+        "k=v\"q",
+    ] {
+        assert_same(line);
+    }
+}
