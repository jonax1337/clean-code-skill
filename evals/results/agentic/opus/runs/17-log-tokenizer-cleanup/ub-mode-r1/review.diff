+//! Measures tokenizer throughput on a synthetic dump: `cargo run --release --example throughput`.
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use logscan::tokenize;
+
+const LINES: [&str; 6] = [
+    "[2024-05-01T12:00:00Z] level=info msg=\"disk 91% full\" host=web-03 user=ann retries=0",
+    "[2024-05-01T12:00:01Z] level=warn msg=\"say \\\"hi\\\"\\n\" req_id=7f3a9c duration_ms=1532 path=/api/v2/items",
+    "[2024-05-01T12:00:02Z] started worker-3 ok queue=default size=128 note=",
+    "[2024-05-01T12:00:03Z]\tlevel=debug\tmsg=\"a fairly long quoted value with many words in it\" done",
+    "[2024-05-01T12:00:04Z] level=error msg=\"never closed",
+    "plain words only here and nothing else at all for the word path",
+];
+const REPEATS: usize = 400_000;
+const ROUNDS: usize = 7;
+
+fn main() {
+    let lines: Vec<&str> = LINES.iter().copied().cycle().take(LINES.len() * REPEATS).collect();
+    let bytes: usize = lines.iter().map(|line| line.len()).sum();
+    let mut best = f64::INFINITY;
+    for _ in 0..ROUNDS {
+        let start = Instant::now();
+        let mut tokens = 0usize;
+        for line in &lines {
+            for token in tokenize(black_box(line)) {
+                tokens += usize::from(black_box(token).is_ok());
+            }
+        }
+        black_box(tokens);
+        best = best.min(start.elapsed().as_secs_f64());
+    }
+    println!("best of {ROUNDS}: {:.1} ms, {:.0} MB/s", best * 1e3, bytes as f64 / best / 1e6);
+}
