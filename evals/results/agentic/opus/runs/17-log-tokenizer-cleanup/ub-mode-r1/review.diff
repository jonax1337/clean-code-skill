+
+/// The first position at or after `from` whose byte satisfies `stop`, or the end of the line.
+#[inline]
+fn scan_until(bytes: &[u8], from: usize, stop: impl Fn(u8) -> bool) -> usize {
+    let mut pos = from;
+    while pos < bytes.len() && !stop(bytes[pos]) {
+        pos += 1;
+    }
+    pos
+}
+
+/// A closing `]` or `"` must be followed by a blank or the end of the line.
+#[inline]
+fn expect_separator(bytes: &[u8], pos: usize) -> Result<(), LexError> {
+    match bytes.get(pos) {
+        Some(&byte) if !is_blank(byte) => Err(LexError::ExpectedSeparator { pos }),
+        _ => Ok(()),
+    }
+}
+
+/// Reads a timestamp, key or word starting at the non-blank byte at `start`.
+#[inline]
+fn lex_token(src: &str, start: usize) -> LexResult<'_> {
+    match src.as_bytes()[start] {
+        b'[' => lex_timestamp(src, start),
+        b'"' => Err(LexError::UnexpectedQuote { pos: start }),
+        b'=' => Err(LexError::EmptyKey { pos: start }),
+        _ => lex_key_or_word(src, start),
+    }
+}
+
+/// `[text]`, with `open` at the `[`.
+#[inline]
+fn lex_timestamp(src: &str, open: usize) -> LexResult<'_> {
+    let bytes = src.as_bytes();
+    let body = open + 1;
+    let close = scan_until(bytes, body, |byte| byte == b']' || byte == b'[');
+    match bytes.get(close) {
+        None => Err(LexError::UnterminatedTimestamp { pos: open }),
+        Some(b'[') => Err(LexError::NestedBracket { pos: close }),
+        Some(_) => {
+            expect_separator(bytes, close + 1)?;
+            Ok(Lexed { token: Token::Timestamp(&src[body..close]), end: close + 1, then: Expect::Token })
+        }
+    }
+}
+
+/// `key=` (the value follows separately) or a plain word.
+#[inline]
+fn lex_key_or_word(src: &str, start: usize) -> LexResult<'_> {
+    let bytes = src.as_bytes();
+    let end = scan_until(bytes, start, |byte| is_blank(byte) || byte == b'=' || byte == b'"');
+    match bytes.get(end) {
+        Some(b'"') => Err(LexError::UnexpectedQuote { pos: end }),
+        Some(b'=') => Ok(Lexed { token: Token::Key(&src[start..end]), end: end + 1, then: Expect::Value }),
+        _ => Ok(Lexed { token: Token::Word(&src[start..end]), end, then: Expect::Token }),
+    }
+}
+
+/// The value right after `key=`: quoted, bare, or empty when a blank or the end of the line follows.
+#[inline]
+fn lex_value(src: &str, start: usize) -> LexResult<'_> {
+    match src.as_bytes().get(start) {
+        Some(b'"') => lex_quoted(src, start),
+        Some(&byte) if !is_blank(byte) => lex_bare(src, start),
+        _ => Ok(Lexed { token: Token::Bare(&src[start..start]), end: start, then: Expect::Token }),
+    }
+}
+
+/// An unquoted value up to the next blank; it may not contain `"`.
+#[inline]
+fn lex_bare(src: &str, start: usize) -> LexResult<'_> {
+    let bytes = src.as_bytes();
+    let end = scan_until(bytes, start, |byte| is_blank(byte) || byte == b'"');
+    match bytes.get(end) {
+        Some(b'"') => Err(LexError::UnexpectedQuote { pos: end }),
+        _ => Ok(Lexed { token: Token::Bare(&src[start..end]), end, then: Expect::Token }),
+    }
+}
+
+/// `"text"`, with `open` at the opening quote. Escapes are checked but left as written.
+#[inline]
+fn lex_quoted(src: &str, open: usize) -> LexResult<'_> {
+    let bytes = src.as_bytes();
+    let body = open + 1;
+    let mut pos = body;
+    loop {
+        match bytes.get(pos) {
+            None => return Err(LexError::UnterminatedQuote { pos: open }),
+            Some(b'"') => break,
+            Some(b'\\') => match bytes.get(pos + 1) {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"' | b'\\' | b'n' | b't') => pos += 2,
+                Some(_) => return Err(LexError::InvalidEscape { pos }),
+            },
+            Some(_) => pos += 1,
         }
     }
+    expect_separator(bytes, pos + 1)?;
+    Ok(Lexed { token: Token::Quoted(&src[body..pos]), end: pos + 1, then: Expect::Token })
 }
