--- /dev/null
+++ b/tests/test_checkout_characterization.py
@@ -0,0 +1,109 @@
+"""Pins down checkout behavior that production relies on, so refactorings cannot change it unnoticed."""
+
+import pytest
+
+from shop.checkout import process_order
+from shop.errors import OrderRejected
+from shop.models import Customer, Item, Order
+
+CUSTOMER = Customer(email="ada@example.com")
+
+
+class FailingNotifier:
+    def send_receipt(self, email: str, order_id: int, receipt_id: str) -> None:
+        raise ConnectionError("mail server down")
+
+
+def checkout(order, inventory, gateway, notifier, coupons, customer=CUSTOMER):
+    return process_order(order, customer, inventory, gateway, notifier, coupons)
+
+
+def test_vip_discount_applies_after_coupon_and_unlocks_free_shipping(inventory, gateway, notifier, coupons):
+    order = Order(id=1, items=[Item("pen", 10, 1000)], coupon="SPRING10")
+    vip = Customer(email="vip@example.com", vip=True)
+
+    checkout(order, inventory, gateway, notifier, coupons, customer=vip)
+
+    # 10000 - 1000 coupon - 450 vip (5% of 9000), tax on undiscounted 10000, no shipping
+    assert order.total_cents == 8550 + 1900
+
+
+def test_shipping_is_free_from_exactly_the_threshold(inventory, gateway, notifier, coupons):
+    order = Order(id=1, items=[Item("pen", 5, 1000)])
+
+    checkout(order, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 5000 + 950
+
+
+def test_shipping_is_charged_just_below_the_threshold(inventory, gateway, notifier, coupons):
+    order = Order(id=1, items=[Item("pen", 1, 4999)])
+
+    checkout(order, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 4999 + 950 + 490
+
+
+def test_tax_is_rounded_per_line(inventory, gateway, notifier, coupons):
+    order = Order(id=1, items=[Item("pen", 1, 7), Item("ink", 1, 7)])
+    swiss = Customer(email="ch@example.com", country="CH")
+
+    checkout(order, inventory, gateway, notifier, coupons, customer=swiss)
+
+    # 7 * 0.081 = 0.567 rounds to 1 per line; rounding the sum (1.134) would give 1
+    assert order.total_cents == 14 + 2 + 490
+
+
+def test_non_positive_quantity_is_rejected_before_anything_happens(inventory, gateway, notifier, coupons):
+    order = Order(id=1, items=[Item("pen", 1, 100), Item("ink", 0, 100)])
+
+    with pytest.raises(OrderRejected, match="invalid quantity for ink"):
+        checkout(order, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+
+
+def test_invalid_coupon_is_rejected_before_stock_is_reserved(inventory, gateway, notifier, coupons):
+    order = Order(id=1, items=[Item("pen", 1, 100)], coupon="BOGUS")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: BOGUS"):
+        checkout(order, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_partial_reservation_is_released_when_a_later_item_is_out_of_stock(inventory, gateway, notifier, coupons):
+    order = Order(id=1, items=[Item("pen", 2, 100), Item("ink", 4, 100)])
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        checkout(order, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [("reserve", "pen", 2), ("release", "pen", 2)]
+
+
+def test_successful_checkout_reserves_commits_and_redeems_once(inventory, gateway, notifier, coupons):
+    order = Order(id=1, items=[Item("pen", 1, 100), Item("ink", 2, 100)], coupon="SPRING10")
+
+    checkout(order, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [
+        ("reserve", "pen", 1),
+        ("reserve", "ink", 2),
+        ("commit", "pen", 1),
+        ("commit", "ink", 2),
+    ]
+    assert coupons.discount_percent("SPRING10") == 10
+    coupons.redeem("SPRING10")
+    assert coupons.discount_percent("SPRING10") is None
+
+
+def test_failed_receipt_does_not_fail_a_paid_order(inventory, gateway, coupons):
+    order = Order(id=1, items=[Item("pen", 1, 100)])
+
+    receipt_id = checkout(order, inventory, gateway, FailingNotifier(), coupons)
+
+    assert receipt_id == "rcpt-1"
+    assert order.status == "paid"
