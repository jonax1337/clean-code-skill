+def test_non_positive_quantity_is_rejected_before_anything_happens(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), Item("ink", 0, 500))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+
+
+def test_unknown_coupon_is_rejected_before_stock_is_reserved(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), coupon="NOPE")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: NOPE"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+
+
+def test_vip_discount_applies_after_the_coupon_and_tax_ignores_discounts(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+    order = make_order(Item("pen", 4, 1000), coupon="SPRING10")
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 4000 - 400 coupon - 5% of 3600 (180) = 3420, + 760 tax on 4000, + 490 shipping
+    assert order.total_cents == 3420 + 760 + 490
+
+
+def test_shipping_is_free_from_the_threshold_after_discounts(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 5000 + 950
+
+
+def test_tax_is_rounded_per_line_with_the_customers_country_rate(inventory, gateway, notifier, coupons):
+    swiss = Customer(email="ada@example.com", country="CH")
+    order = make_order(Item("pen", 1, 1006), Item("ink", 1, 1006))
+
+    process_order(order, swiss, inventory, gateway, notifier, coupons)
+
+    # 8.1% of 1006 = 81.486 -> 81 per line; rounding the sum (162.97) would give 163
+    assert order.total_cents == 2012 + 162 + 490
+
+
