index 0000000..84e3e0a
--- /dev/null
+++ b/tests/test_checkout_behavior.py
@@ -0,0 +1,138 @@
+"""Characterization tests pinning down process_order behavior not covered by test_checkout.py."""
+
+import logging
+
+import pytest
+
+from shop.checkout import process_order
+from shop.coupons import CouponBook
+from shop.errors import OrderRejected
+from shop.inventory import Inventory
+from shop.models import Customer, Item, Order
+from tests.conftest import FakeGateway
+
+
+def make_order(*items: Item, coupon: str | None = None) -> Order:
+    return Order(id=7, items=list(items), coupon=coupon)
+
+
+class FailingNotifier:
+    def send_receipt(self, email: str, order_id: int, receipt_id: str) -> None:
+        raise RuntimeError("smtp down")
+
+
+def test_tax_is_rounded_per_line_half_up(inventory, gateway, notifier, coupons):
+    # 0.19 * 250 = 47.5 -> 48 per line; rounding the sum (95) once would give a different total.
+    order = make_order(Item("pen", 1, 250), Item("ink", 1, 250))
+
+    process_order(order, Customer(email="a@x"), inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 500 + 48 + 48 + 490
+
+
+def test_tax_uses_customer_country_and_undiscounted_price(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000), coupon="SPRING10")
+
+    process_order(order, Customer(email="a@x", country="CH"), inventory, gateway, notifier, coupons)
+
+    # 1000 - 100 discount, tax 8.1% of 1000 = 81, + shipping
+    assert order.total_cents == 900 + 81 + 490
+
+
+def test_vip_discount_stacks_on_top_of_coupon(gateway, notifier, coupons):
+    inventory = Inventory({"pen": 100})
+    order = make_order(Item("pen", 7, 1000), coupon="SPRING10")
+
+    process_order(order, Customer(email="a@x", vip=True), inventory, gateway, notifier, coupons)
+
+    # 7000 - 700 = 6300, VIP 5% of 6300 = 315 -> 5985 >= 5000 free shipping; tax 1330
+    assert order.total_cents == 5985 + 1330
+
+
+def test_free_shipping_threshold_uses_discounted_subtotal(gateway, notifier, coupons):
+    inventory = Inventory({"pen": 100})
+    order = make_order(Item("pen", 1, 5000))
+
+    process_order(order, Customer(email="a@x"), inventory, gateway, notifier, coupons)
+    assert order.total_cents == 5000 + 950
+
+    order = make_order(Item("pen", 1, 5000))
+    process_order(order, Customer(email="a@x", vip=True), inventory, gateway, notifier, coupons)
+    assert order.total_cents == 4750 + 950 + 490
+
+
+def test_invalid_quantity_is_rejected_before_anything_happens(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), Item("ink", 0, 100))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for ink"):
+        process_order(order, Customer(email="a@x"), inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+
+
+def test_invalid_coupon_is_rejected_before_reserving(inventory, gateway, notifier):
+    coupons = CouponBook({"USED": (10, 0)})
+    order = make_order(Item("pen", 1, 100), coupon="USED")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: USED"):
+        process_order(order, Customer(email="a@x"), inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_out_of_stock_releases_only_what_was_reserved(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 100), Item("ink", 99, 100), Item("pen", 1, 100))
+
+    with pytest.raises(OrderRejected, match="out of stock: ink") as info:
+        process_order(order, Customer(email="a@x"), inventory, gateway, notifier, coupons)
+
+    assert info.value.__cause__ is not None
+    assert inventory.log == [("reserve", "pen", 2), ("release", "pen", 2)]
+    assert inventory.available("pen") == 10
+
+
+def test_declined_payment_releases_all_and_keeps_coupon(inventory, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), Item("ink", 1, 100), coupon="SPRING10")
+
+    with pytest.raises(OrderRejected, match="payment declined: card declined"):
+        process_order(order, Customer(email="a@x"), inventory, FakeGateway(decline=True), notifier, coupons)
+
+    assert inventory.log == [
+        ("reserve", "pen", 1),
+        ("reserve", "ink", 1),
+        ("release", "pen", 1),
+        ("release", "ink", 1),
+    ]
+    assert order.total_cents == 0
+    assert coupons.discount_percent("SPRING10") == 10
+
+
+def test_successful_order_commits_stock_and_redeems_coupon(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), Item("ink", 2, 100), coupon="SPRING10")
+
+    process_order(order, Customer(email="a@x"), inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [
+        ("reserve", "pen", 1),
+        ("reserve", "ink", 2),
+        ("commit", "pen", 1),
+        ("commit", "ink", 2),
+    ]
+    coupons.redeem("SPRING10")
+    assert coupons.discount_percent("SPRING10") is None
+
+
+def test_receipt_failure_is_logged_but_order_stays_paid(inventory, gateway, coupons, caplog):
+    order = make_order(Item("pen", 1, 1000))
+
+    with caplog.at_level(logging.INFO, logger="shop.checkout"):
+        receipt_id = process_order(order, Customer(email="a@x"), inventory, gateway, FailingNotifier(), coupons)
+
+    assert receipt_id == "rcpt-1"
+    assert order.status == "paid"
+    messages = [record.getMessage() for record in caplog.records]
+    assert messages == ["order 7 paid: 1680 cents", "receipt for order 7 could not be sent"]
+    assert caplog.records[1].exc_info is not None
