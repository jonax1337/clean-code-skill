+def test_tax_is_rounded_half_up_per_line(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 250), Item("ink", 1, 250))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 19% of 250 is 47.5 -> 48 per line; rounding the summed tax would give 95
+    assert order.total_cents == 500 + 96 + 490
+
+
+def test_vip_discount_stacks_on_coupon_and_tax_ignores_discounts(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+    order = make_order(Item("pen", 6, 1000), coupon="SPRING10")
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 6000 - 600 coupon - 5% of 5400 (270) = 5130 -> free shipping; tax on 6000 = 1140
+    assert order.total_cents == 5130 + 1140
+
+
+def test_shipping_is_free_from_the_threshold_on(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 5000 + 950
+
+
