+def _coupon_discount_cents(subtotal: int, coupon: str | None, coupons: CouponBook) -> int:
+    if coupon is None:
+        return 0
+    percent = coupons.discount_percent(coupon)
+    if percent is None:
+        raise OrderRejected(f"invalid coupon: {coupon}")
+    return subtotal * percent // 100
