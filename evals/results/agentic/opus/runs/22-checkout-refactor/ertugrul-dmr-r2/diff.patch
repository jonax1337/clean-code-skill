+
+def _line_cents(item: Item) -> int:
+    return item.unit_price_cents * item.quantity
+
+
+def _tax_cents(items: list[Item], rate: Decimal) -> int:
+    """Tax is rounded per line, as the accounting export expects, and is charged on the undiscounted line price."""
+    return sum(
+        int((Decimal(_line_cents(item)) * rate).quantize(Decimal("1"), rounding=ROUND_HALF_UP)) for item in items
+    )
+
