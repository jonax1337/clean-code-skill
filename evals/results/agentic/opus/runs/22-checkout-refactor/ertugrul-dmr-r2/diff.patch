+def _order_total(order: Order, customer: Customer, coupons: CouponBook) -> int:
+    subtotal = sum(_line_cents(item) for item in order.items)
+    tax = _tax_cents(order.items, tax_rate(customer.country))
+    discounted = subtotal - _discount_cents(subtotal, order, customer, coupons)
+    return discounted + tax + _shipping_cents(discounted)
