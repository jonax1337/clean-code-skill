+def test_vip_discount_applies_after_coupon_and_earns_free_shipping(inventory, gateway, notifier, coupons):
+    vip = Customer(email="vip@example.com", vip=True)
+    order = make_order(Item("pen", 10, 1000), coupon="SPRING10")
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 10000 - 1000 coupon - 5% of 9000 (450) = 8550, free shipping, + 1900 tax on the undiscounted price
+    assert order.total_cents == 8550 + 1900
+
+
+def test_shipping_is_free_from_exactly_the_threshold(inventory, gateway, notifier, coupons):
+    at_threshold = make_order(Item("pen", 5, 1000))
