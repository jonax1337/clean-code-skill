 test("duplicates inside the incoming list are merged with each other", () => {
   const result = mergeContacts([], [contact("1", "a@x.io", { phone: "111" }), contact("2", "a@x.io", { name: "" })]);
   assert.equal(result.length, 1);
   assert.equal(result[0].phone, "111");
 });
+
+test("when the existing list already holds an email twice, the first entry receives the merge", () => {
+  const result = mergeContacts([contact("1", "a@x.io"), contact("2", "A@x.io")], [contact("3", "a@x.io", { phone: "999" })]);
+  assert.deepEqual(
+    result.map((c) => [c.id, c.phone]),
+    [
+      ["1", "999"],
+      ["2", ""],
+    ],
+  );
+});
+
+test("a large import finishes quickly", () => {
+  const existing = Array.from({ length: 50_000 }, (_, i) => contact(`e${i}`, `user${i}@x.io`));
+  const incoming = Array.from({ length: 30_000 }, (_, i) => contact(`n${i}`, `user${i * 2}@x.io`));
+  const start = performance.now();
+  const result = mergeContacts(existing, incoming);
+  const elapsed = performance.now() - start;
+  assert.equal(result.length, 50_000 + 5_000);
+  assert.ok(elapsed < 1_000, `took ${Math.round(elapsed)} ms`);
+});
