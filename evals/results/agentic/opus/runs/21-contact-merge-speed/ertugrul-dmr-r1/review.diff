  */
 export function mergeContacts(existing: Contact[], incoming: Contact[]): Contact[] {
   const result = [...existing];
+  const indexByEmail = new Map<string, number>();
+  result.forEach((entry, index) => rememberFirstIndex(indexByEmail, normalizeEmail(entry.email), index));
+
   for (const contact of incoming) {
-    const index = result.findIndex((entry) => normalizeEmail(entry.email) === normalizeEmail(contact.email));
-    if (index === -1) {
+    const email = normalizeEmail(contact.email);
+    const index = indexByEmail.get(email);
+    if (index === undefined) {
+      indexByEmail.set(email, result.length);
       result.push(contact);
     } else {
       result[index] = mergeContact(result[index], contact);
     }
   }
   return result;
 }
+
+/** Keeps the earliest position when the address book already holds the same email more than once. */
+function rememberFirstIndex(indexByEmail: Map<string, number>, email: string, index: number): void {
+  if (!indexByEmail.has(email)) {
+    indexByEmail.set(email, index);
+  }
+}
