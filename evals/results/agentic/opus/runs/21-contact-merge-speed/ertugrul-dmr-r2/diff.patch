-    if (index === -1) {
+    const email = normalizeEmail(contact.email);
+    const index = indexByEmail.get(email);
+    if (index === undefined) {
+      indexByEmail.set(email, result.length);
       result.push(contact);
     } else {
       result[index] = mergeContact(result[index], contact);
