 export function mergeContacts(existing: Contact[], incoming: Contact[]): Contact[] {
   const result = [...existing];
+  const indexByEmail = new Map<string, number>();
+  const remember = (email: string, index: number) => {
+    const key = normalizeEmail(email);
+    // Keep the first position: with duplicate emails, the earliest entry receives the merges.
+    if (!indexByEmail.has(key)) indexByEmail.set(key, index);
+  };
+  result.forEach((entry, index) => remember(entry.email, index));
+
   for (const contact of incoming) {
-    const index = result.findIndex((entry) => normalizeEmail(entry.email) === normalizeEmail(contact.email));
-    if (index === -1) {
-      result.push(contact);
+    const index = indexByEmail.get(normalizeEmail(contact.email));
