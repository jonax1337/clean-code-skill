 import type { Contact } from "./types.ts";
 
 /**
  * Adds the incoming contacts to the existing ones. A contact whose email is already present
  * is merged into that entry; everything else is appended in the order it arrives.
  */
 export function mergeContacts(existing: Contact[], incoming: Contact[]): Contact[] {
   const result = [...existing];
+  const indexByEmail = new Map<string, number>();
+  result.forEach((entry, index) => addToIndex(indexByEmail, entry, index));
+
   for (const contact of incoming) {
-    const index = result.findIndex((entry) => normalizeEmail(entry.email) === normalizeEmail(contact.email));
-    if (index === -1) {
+    const index = indexByEmail.get(normalizeEmail(contact.email));
+    if (index === undefined) {
+      addToIndex(indexByEmail, contact, result.length);
       result.push(contact);
     } else {
       result[index] = mergeContact(result[index], contact);
     }
   }
   return result;
 }
+
+/** Keeps the first position per email, so a merge targets the earliest matching entry. */
+function addToIndex(indexByEmail: Map<string, number>, contact: Contact, index: number): void {
+  const email = normalizeEmail(contact.email);
+  if (!indexByEmail.has(email)) {
+    indexByEmail.set(email, index);
+  }
+}
