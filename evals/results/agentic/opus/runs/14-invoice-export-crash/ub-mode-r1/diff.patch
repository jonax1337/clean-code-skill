diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..af4919b
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,25 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { loadCustomerRecords } from "../src/sources.js";
+
+function directoryWith(files) {
+  const directory = mkdtempSync(join(tmpdir(), "invoice-export-"));
+  for (const [name, content] of Object.entries(files)) {
+    writeFileSync(join(directory, name), JSON.stringify(content));
+  }
+  return directory;
+}
+
+test("loadCustomerRecords gives CRM customers the same shape as billing customers", () => {
+  const directory = directoryWith({
+    "billing-customers.json": [{ customerId: "C-1", name: "Acme", country: "DE" }],
+    "crm-customers.json": [{ customer_id: "C-2", name: "Birch & Co", country: "NL" }],
+  });
+  assert.deepEqual(loadCustomerRecords(directory), [
+    { customerId: "C-1", name: "Acme", country: "DE" },
+    { customerId: "C-2", name: "Birch & Co", country: "NL" },
+  ]);
+});
