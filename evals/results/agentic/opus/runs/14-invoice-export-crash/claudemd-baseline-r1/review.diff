diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..de20351
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,30 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { buildCustomerIndex } from "../src/customers.js";
+import { loadCustomerRecords } from "../src/sources.js";
+
+test("loadCustomerRecords brings CRM records (customer_id) into the customerId shape", () => {
+  const directory = mkdtempSync(join(tmpdir(), "invoice-export-"));
+  try {
+    writeFileSync(
+      join(directory, "billing-customers.json"),
+      JSON.stringify([{ customerId: "C-1001", name: "Acme GmbH", country: "DE" }]),
+    );
+    writeFileSync(
+      join(directory, "crm-customers.json"),
+      JSON.stringify([{ customer_id: "C-2201", name: "Birch & Co", country: "NL" }]),
+    );
+
+    const records = loadCustomerRecords(directory);
+    assert.deepEqual(records, [
+      { customerId: "C-1001", name: "Acme GmbH", country: "DE" },
+      { customerId: "C-2201", name: "Birch & Co", country: "NL" },
+    ]);
+    assert.equal(buildCustomerIndex(records).get("C-2201").name, "Birch & Co");
+  } finally {
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
