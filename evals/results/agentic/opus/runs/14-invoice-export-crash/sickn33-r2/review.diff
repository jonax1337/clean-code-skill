+
+test("exportInvoices names an invoice whose customer is unknown", () => {
+  const orphan = { ...invoices[0], id: "INV-9", customerId: "C-404" };
+  assert.throws(() => exportInvoices([orphan], customers), {
+    name: "UnknownReferenceError",
+    message: 'Unknown customer "C-404" (referenced by invoice INV-9)',
+  });
+});
diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..6be990b
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,16 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { loadCustomerRecords } from "../src/sources.js";
+
+test("loadCustomerRecords gives CRM customers the same shape as billing customers", () => {
+  const directory = mkdtempSync(join(tmpdir(), "sources-"));
+  writeFileSync(join(directory, "billing-customers.json"), '[{ "customerId": "C-1", "name": "Acme", "country": "DE" }]');
+  writeFileSync(join(directory, "crm-customers.json"), '[{ "customer_id": "C-2", "name": "Birch", "country": "NL" }]');
+  assert.deepEqual(loadCustomerRecords(directory), [
+    { customerId: "C-1", name: "Acme", country: "DE" },
+    { customerId: "C-2", name: "Birch", country: "NL" },
+  ]);
+});
