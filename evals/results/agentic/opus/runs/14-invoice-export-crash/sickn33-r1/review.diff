diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..819a85a
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,24 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { fromCrmRecord, loadCustomerRecords } from "../src/sources.js";
+
+test("fromCrmRecord renames customer_id to customerId", () => {
+  assert.deepEqual(fromCrmRecord({ customer_id: "C-2201", name: "Birch & Co", country: "NL" }), {
+    customerId: "C-2201",
+    name: "Birch & Co",
+    country: "NL",
+  });
+});
+
+test("loadCustomerRecords gives billing and CRM customers the same shape", () => {
+  const directory = mkdtempSync(join(tmpdir(), "invoice-export-"));
+  writeFileSync(join(directory, "billing-customers.json"), '[{ "customerId": "C-1", "name": "Acme", "country": "DE" }]');
+  writeFileSync(join(directory, "crm-customers.json"), '[{ "customer_id": "C-2", "name": "Birch", "country": "NL" }]');
+  assert.deepEqual(loadCustomerRecords(directory), [
+    { customerId: "C-1", name: "Acme", country: "DE" },
+    { customerId: "C-2", name: "Birch", country: "NL" },
+  ]);
+});
