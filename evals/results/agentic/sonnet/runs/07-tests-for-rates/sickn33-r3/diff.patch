--- /dev/null
+++ b/test/rates.test.ts
@@ -0,0 +1,173 @@
+import assert from "node:assert/strict";
+import { describe, test } from "node:test";
+import { InvalidAmountError, UnknownCurrencyError } from "../src/errors.ts";
+import { convert, feeFor, minorUnitsOf, quote } from "../src/rates.ts";
+
+describe("minorUnitsOf", () => {
+  test("returns the decimal places of each supported currency", () => {
+    assert.equal(minorUnitsOf("EUR"), 2);
+    assert.equal(minorUnitsOf("JPY"), 0);
+    assert.equal(minorUnitsOf("KWD"), 3);
+  });
+
+  test("rejects an unknown currency", () => {
+    assert.throws(() => minorUnitsOf("XXX"), UnknownCurrencyError);
+  });
+
+  test("is case-sensitive", () => {
+    assert.throws(() => minorUnitsOf("eur"), UnknownCurrencyError);
+  });
+});
+
+describe("convert", () => {
+  test("applies the euro rate of the target currency", () => {
+    assert.equal(convert(1000, "EUR", "USD"), 1100);
+    assert.equal(convert(1000, "EUR", "CHF"), 950);
+  });
+
+  test("returns the same amount for the same currency", () => {
+    assert.equal(convert(12345, "EUR", "EUR"), 12345);
+    assert.equal(convert(777, "JPY", "JPY"), 777);
+  });
+
+  test("shifts the decimal point between currencies with different minor units", () => {
+    assert.equal(convert(1000, "EUR", "JPY"), 1625);
+    assert.equal(convert(1625, "JPY", "EUR"), 1000);
+    assert.equal(convert(1000, "EUR", "KWD"), 3250);
+    assert.equal(convert(3250, "KWD", "EUR"), 1000);
+  });
+
+  test("converts between two non-euro currencies via the euro rate", () => {
+    assert.equal(convert(1100, "USD", "CHF"), 950);
+  });
+
+  test("converts zero to zero", () => {
+    assert.equal(convert(0, "EUR", "JPY"), 0);
+  });
+
+  test("rounds a non-tie remainder to the nearest unit", () => {
+    // 1 cent USD = 1.477... yen
+    assert.equal(convert(1, "USD", "JPY"), 1);
+    // 2 cents USD = 2.954... yen
+    assert.equal(convert(2, "USD", "JPY"), 3);
+  });
+
+  test("breaks ties away from zero for half-up currencies", () => {
+    assert.equal(convert(5, "EUR", "USD"), 6); // 5.5
+    assert.equal(convert(-5, "EUR", "USD"), -6);
+  });
+
+  test("breaks ties to the even neighbor for half-even currencies", () => {
+    assert.equal(convert(10, "EUR", "CHF"), 10); // 9.5 -> 10
+    assert.equal(convert(30, "EUR", "CHF"), 28); // 28.5 -> 28
+    assert.equal(convert(-10, "EUR", "CHF"), -10);
+    assert.equal(convert(-30, "EUR", "CHF"), -28);
+  });
+
+  test("keeps the sign of negative amounts", () => {
+    assert.equal(convert(-1000, "EUR", "USD"), -1100);
+  });
+
+  test("rejects an unknown source or target currency", () => {
+    assert.throws(() => convert(100, "XXX", "EUR"), UnknownCurrencyError);
+    assert.throws(() => convert(100, "EUR", "XXX"), UnknownCurrencyError);
+  });
+
+  test("names the unknown currency in the error", () => {
+    assert.throws(
+      () => convert(100, "EUR", "XXX"),
+      (error: unknown) => error instanceof UnknownCurrencyError && error.currency === "XXX",
+    );
+  });
+
+  test("rejects amounts that are not whole safe integers", () => {
+    for (const amount of [1.5, Number.NaN, Number.POSITIVE_INFINITY, Number.MAX_SAFE_INTEGER + 1]) {
+      assert.throws(() => convert(amount, "EUR", "USD"), InvalidAmountError, String(amount));
+    }
+  });
+
+  test("stays exact for the largest safe amount", () => {
+    assert.equal(convert(Number.MAX_SAFE_INTEGER, "EUR", "EUR"), Number.MAX_SAFE_INTEGER);
+  });
+});
+
+describe("feeFor", () => {
+  test("charges 2.5% of the amount", () => {
+    assert.equal(feeFor(10000, "EUR"), 250);
+    assert.equal(feeFor(10000, "JPY"), 250);
+  });
+
+  test("charges nothing on a zero amount", () => {
+    assert.equal(feeFor(0, "EUR"), 0);
+  });
+
+  test("raises small fees to the currency minimum", () => {
+    assert.equal(feeFor(1, "EUR"), 30);
+    assert.equal(feeFor(100, "USD"), 30);
+    assert.equal(feeFor(1000, "JPY"), 50);
+    assert.equal(feeFor(1000, "KWD"), 300);
+  });
+
+  test("charges exactly the minimum when the percentage equals it", () => {
+    assert.equal(feeFor(1200, "EUR"), 30);
+  });
+
+  test("caps large fees at the currency maximum", () => {
+    assert.equal(feeFor(1_000_000, "EUR"), 5000);
+    assert.equal(feeFor(1_000_000, "JPY"), 8000);
+    assert.equal(feeFor(100_000, "KWD"), 1500);
+  });
+
+  test("rounds the percentage with the currency's rounding mode", () => {
+    assert.equal(feeFor(1300, "USD"), 33); // 32.5, half-up
+    assert.equal(feeFor(1300, "EUR"), 32); // 32.5, half-even
+  });
+
+  test("rejects a negative amount", () => {
+    assert.throws(() => feeFor(-1, "EUR"), InvalidAmountError);
+  });
+
+  test("rejects an unknown currency", () => {
+    assert.throws(() => feeFor(100, "XXX"), UnknownCurrencyError);
+  });
+
+  test("rejects amounts that are not whole safe integers", () => {
+    assert.throws(() => feeFor(10.5, "EUR"), InvalidAmountError);
+    assert.throws(() => feeFor(Number.NaN, "EUR"), InvalidAmountError);
+  });
+});
+
+describe("quote", () => {
+  test("converts the amount and charges the fee in the target currency", () => {
+    assert.deepEqual(quote(10000, "EUR", "USD"), { converted: 11000, fee: 275, net: 10725 });
+  });
+
+  test("applies the minimum fee", () => {
+    assert.deepEqual(quote(1000, "EUR", "EUR"), { converted: 1000, fee: 30, net: 970 });
+  });
+
+  test("applies the maximum fee", () => {
+    assert.deepEqual(quote(1_000_000, "EUR", "EUR"), { converted: 1_000_000, fee: 5000, net: 995_000 });
+  });
+
+  test("quotes a zero amount without a fee", () => {
+    assert.deepEqual(quote(0, "EUR", "USD"), { converted: 0, fee: 0, net: 0 });
+  });
+
+  test("accepts an amount that exactly covers the fee", () => {
+    assert.deepEqual(quote(30, "EUR", "EUR"), { converted: 30, fee: 30, net: 0 });
+  });
+
+  test("rejects an amount that does not cover the fee", () => {
+    assert.throws(() => quote(20, "EUR", "EUR"), InvalidAmountError);
+  });
+
+  test("rejects a negative amount", () => {
+    assert.throws(() => quote(-1000, "EUR", "USD"), InvalidAmountError);
+  });
+
+  test("rejects unknown currencies", () => {
+    assert.throws(() => quote(1000, "XXX", "EUR"), UnknownCurrencyError);
+    assert.throws(() => quote(1000, "EUR", "XXX"), UnknownCurrencyError);
+  });
+});
