--- /dev/null
+++ b/test/rates.test.ts
@@ -0,0 +1,169 @@
+import assert from "node:assert/strict";
+import { describe, test } from "node:test";
+import { InvalidAmountError, UnknownCurrencyError } from "../src/errors.ts";
+import { convert, feeFor, minorUnitsOf, quote } from "../src/rates.ts";
+
+describe("minorUnitsOf", () => {
+  test("reports the decimal places of each supported currency", () => {
+    assert.equal(minorUnitsOf("EUR"), 2);
+    assert.equal(minorUnitsOf("JPY"), 0);
+    assert.equal(minorUnitsOf("KWD"), 3);
+  });
+
+  test("rejects unknown and lowercase currency codes", () => {
+    assert.throws(() => minorUnitsOf("XXX"), UnknownCurrencyError);
+    assert.throws(() => minorUnitsOf("eur"), UnknownCurrencyError);
+  });
+
+  test("names the offending currency on the error", () => {
+    assert.throws(
+      () => minorUnitsOf("XXX"),
+      (error: unknown) => error instanceof UnknownCurrencyError && error.currency === "XXX",
+    );
+  });
+});
+
+describe("convert", () => {
+  test("converts exactly through the euro rate", () => {
+    assert.equal(convert(1000, "EUR", "USD"), 1100);
+    assert.equal(convert(1000, "EUR", "CHF"), 950);
+  });
+
+  test("accounts for different minor-unit sizes", () => {
+    assert.equal(convert(1000, "EUR", "JPY"), 1625);
+    assert.equal(convert(1625, "JPY", "EUR"), 1000);
+    assert.equal(convert(1000, "EUR", "KWD"), 3250);
+    assert.equal(convert(1000, "KWD", "JPY"), 500);
+    assert.equal(convert(500, "JPY", "KWD"), 1000);
+  });
+
+  test("returns the same amount for the same currency", () => {
+    assert.equal(convert(1234, "EUR", "EUR"), 1234);
+    assert.equal(convert(77, "JPY", "JPY"), 77);
+  });
+
+  test("converts zero to zero", () => {
+    assert.equal(convert(0, "EUR", "USD"), 0);
+  });
+
+  test("rounds non-ties to the nearest unit", () => {
+    assert.equal(convert(4, "EUR", "USD"), 4); // 4.4
+    assert.equal(convert(9, "EUR", "USD"), 10); // 9.9
+  });
+
+  test("half-up targets round ties away from zero", () => {
+    assert.equal(convert(4, "EUR", "JPY"), 7); // 6.5
+    assert.equal(convert(15, "EUR", "USD"), 17); // 16.5
+  });
+
+  test("half-even targets round ties to the even neighbor", () => {
+    assert.equal(convert(10, "EUR", "CHF"), 10); // 9.5 -> odd 9 goes up
+    assert.equal(convert(30, "EUR", "CHF"), 28); // 28.5 -> even 28 stays
+  });
+
+  test("negative amounts round symmetrically to positive ones", () => {
+    assert.equal(convert(-4, "EUR", "JPY"), -7);
+    assert.equal(convert(-15, "EUR", "USD"), -17);
+    assert.equal(convert(-10, "EUR", "CHF"), -10);
+    assert.equal(convert(-30, "EUR", "CHF"), -28);
+    assert.equal(convert(-1000, "EUR", "USD"), -1100);
+  });
+
+  test("keeps full precision for the largest safe integer", () => {
+    assert.equal(convert(Number.MAX_SAFE_INTEGER, "EUR", "EUR"), Number.MAX_SAFE_INTEGER);
+  });
+
+  test("rejects amounts that are not whole safe integers", () => {
+    for (const amount of [1.5, Number.NaN, Number.POSITIVE_INFINITY, Number.MAX_SAFE_INTEGER + 1]) {
+      assert.throws(() => convert(amount, "EUR", "USD"), InvalidAmountError);
+    }
+  });
+
+  test("rejects unknown source and target currencies", () => {
+    assert.throws(() => convert(100, "XXX", "EUR"), UnknownCurrencyError);
+    assert.throws(() => convert(100, "EUR", "XXX"), UnknownCurrencyError);
+  });
+});
+
+describe("feeFor", () => {
+  test("charges 2.5% of the amount", () => {
+    assert.equal(feeFor(10000, "EUR"), 250);
+    assert.equal(feeFor(40000, "JPY"), 1000);
+    assert.equal(feeFor(40000, "KWD"), 1000);
+  });
+
+  test("charges nothing on a zero amount", () => {
+    assert.equal(feeFor(0, "EUR"), 0);
+    assert.equal(feeFor(0, "JPY"), 0);
+  });
+
+  test("raises small fees to the currency minimum", () => {
+    assert.equal(feeFor(1, "EUR"), 30);
+    assert.equal(feeFor(100, "EUR"), 30);
+    assert.equal(feeFor(1, "JPY"), 50);
+    assert.equal(feeFor(10000, "KWD"), 300);
+  });
+
+  test("caps large fees at the currency maximum", () => {
+    assert.equal(feeFor(200000, "EUR"), 5000);
+    assert.equal(feeFor(400000, "EUR"), 5000);
+    assert.equal(feeFor(400000, "JPY"), 8000);
+    assert.equal(feeFor(100000, "KWD"), 1500);
+  });
+
+  test("settles percentage ties by the currency's rounding mode", () => {
+    assert.equal(feeFor(1220, "EUR"), 30); // 30.5, half-even
+    assert.equal(feeFor(1220, "USD"), 31); // 30.5, half-up
+    assert.equal(feeFor(1260, "EUR"), 32); // 31.5, half-even
+  });
+
+  test("rejects negative amounts", () => {
+    assert.throws(() => feeFor(-1, "EUR"), InvalidAmountError);
+  });
+
+  test("rejects amounts that are not whole safe integers", () => {
+    assert.throws(() => feeFor(10.5, "EUR"), InvalidAmountError);
+    assert.throws(() => feeFor(Number.NaN, "EUR"), InvalidAmountError);
+  });
+
+  test("rejects unknown currencies", () => {
+    assert.throws(() => feeFor(100, "XXX"), UnknownCurrencyError);
+  });
+});
+
+describe("quote", () => {
+  test("converts and takes the fee in the target currency", () => {
+    assert.deepEqual(quote(10000, "EUR", "USD"), { converted: 11000, fee: 275, net: 10725 });
+  });
+
+  test("applies the target currency's minimum fee", () => {
+    assert.deepEqual(quote(1000, "EUR", "JPY"), { converted: 1625, fee: 50, net: 1575 });
+  });
+
+  test("applies the target currency's maximum fee", () => {
+    assert.deepEqual(quote(400000, "EUR", "EUR"), { converted: 400000, fee: 5000, net: 395000 });
+  });
+
+  test("accepts an amount that exactly covers the fee", () => {
+    assert.deepEqual(quote(30, "EUR", "EUR"), { converted: 30, fee: 30, net: 0 });
+  });
+
+  test("rejects an amount that does not cover the fee", () => {
+    assert.throws(() => quote(10, "EUR", "EUR"), InvalidAmountError);
+    assert.throws(() => quote(29, "EUR", "EUR"), InvalidAmountError);
+  });
+
+  test("quotes zero as free", () => {
+    assert.deepEqual(quote(0, "EUR", "USD"), { converted: 0, fee: 0, net: 0 });
+  });
+
+  test("rejects negative and fractional amounts", () => {
+    assert.throws(() => quote(-1000, "EUR", "USD"), InvalidAmountError);
+    assert.throws(() => quote(1.5, "EUR", "USD"), InvalidAmountError);
+  });
+
+  test("rejects unknown currencies", () => {
+    assert.throws(() => quote(1000, "XXX", "EUR"), UnknownCurrencyError);
+    assert.throws(() => quote(1000, "EUR", "XXX"), UnknownCurrencyError);
+  });
+});
