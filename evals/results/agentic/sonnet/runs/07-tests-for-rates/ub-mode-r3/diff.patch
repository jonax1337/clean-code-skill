diff --git a/test/rates.test.ts b/test/rates.test.ts
new file mode 100644
index 0000000..1f8bfda
--- /dev/null
+++ b/test/rates.test.ts
@@ -0,0 +1,171 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { InvalidAmountError, UnknownCurrencyError } from "../src/errors.ts";
+import { convert, feeFor, minorUnitsOf, quote } from "../src/rates.ts";
+
+test("minorUnitsOf reports the decimal places of each supported currency", () => {
+  assert.equal(minorUnitsOf("EUR"), 2);
+  assert.equal(minorUnitsOf("USD"), 2);
+  assert.equal(minorUnitsOf("CHF"), 2);
+  assert.equal(minorUnitsOf("JPY"), 0);
+  assert.equal(minorUnitsOf("KWD"), 3);
+});
+
+test("minorUnitsOf rejects unknown and wrongly cased currencies", () => {
+  assert.throws(() => minorUnitsOf("XXX"), UnknownCurrencyError);
+  assert.throws(() => minorUnitsOf("eur"), UnknownCurrencyError);
+  assert.throws(() => minorUnitsOf(""), UnknownCurrencyError);
+});
+
+test("UnknownCurrencyError names the offending currency", () => {
+  assert.throws(
+    () => convert(100, "EUR", "XXX"),
+    (error: unknown) => error instanceof UnknownCurrencyError && error.currency === "XXX",
+  );
+});
+
+test("convert applies the euro rate", () => {
+  assert.equal(convert(1000, "EUR", "USD"), 1100);
+  assert.equal(convert(1000, "EUR", "CHF"), 950);
+});
+
+test("convert returns the same amount for the same currency", () => {
+  assert.equal(convert(12345, "USD", "USD"), 12345);
+  assert.equal(convert(12345, "JPY", "JPY"), 12345);
+});
+
+test("convert crosses currencies through the euro", () => {
+  assert.equal(convert(1100, "USD", "JPY"), 1625);
+  assert.equal(convert(163, "JPY", "EUR"), 100);
+});
+
+test("convert rescales between different minor unit sizes", () => {
+  assert.equal(convert(100, "EUR", "KWD"), 325);
+  assert.equal(convert(325, "KWD", "EUR"), 100);
+  assert.equal(convert(1625, "JPY", "EUR"), 1000);
+});
+
+test("convert breaks ties away from zero when the target rounds half-up", () => {
+  assert.equal(convert(5, "EUR", "USD"), 6); // 5.5
+  assert.equal(convert(100, "EUR", "JPY"), 163); // 162.5
+  assert.equal(convert(-5, "EUR", "USD"), -6);
+});
+
+test("convert breaks ties to the even neighbor when the target rounds half-even", () => {
+  assert.equal(convert(10, "EUR", "CHF"), 10); // 9.5 -> 10
+  assert.equal(convert(30, "EUR", "CHF"), 28); // 28.5 -> 28
+  assert.equal(convert(2, "EUR", "KWD"), 6); // 6.5 -> 6
+  assert.equal(convert(6, "EUR", "KWD"), 20); // 19.5 -> 20
+});
+
+test("convert mirrors half-even ties for negative amounts", () => {
+  assert.equal(convert(-10, "EUR", "CHF"), -10);
+  assert.equal(convert(-30, "EUR", "CHF"), -28);
+});
+
+test("convert rounds non-ties to the nearest unit", () => {
+  assert.equal(convert(1, "EUR", "USD"), 1); // 1.1
+  assert.equal(convert(4, "EUR", "USD"), 4); // 4.4
+  assert.equal(convert(6, "EUR", "USD"), 7); // 6.6
+  assert.equal(convert(-6, "EUR", "USD"), -7);
+});
+
+test("convert handles zero", () => {
+  assert.equal(convert(0, "EUR", "USD"), 0);
+});
+
+test("convert stays exact for large amounts", () => {
+  assert.equal(convert(Number.MAX_SAFE_INTEGER, "EUR", "EUR"), Number.MAX_SAFE_INTEGER);
+  assert.equal(convert(900_000_000_000_000, "EUR", "USD"), 990_000_000_000_000);
+});
+
+test("convert rejects amounts that are not whole numbers of minor units", () => {
+  assert.throws(() => convert(1.5, "EUR", "USD"), InvalidAmountError);
+  assert.throws(() => convert(Number.NaN, "EUR", "USD"), InvalidAmountError);
+  assert.throws(() => convert(Number.POSITIVE_INFINITY, "EUR", "USD"), InvalidAmountError);
+  assert.throws(() => convert(Number.MAX_SAFE_INTEGER + 1, "EUR", "USD"), InvalidAmountError);
+});
+
+test("convert rejects an unknown source or target currency", () => {
+  assert.throws(() => convert(100, "XXX", "EUR"), UnknownCurrencyError);
+  assert.throws(() => convert(100, "EUR", "XXX"), UnknownCurrencyError);
+});
+
+test("feeFor charges 2.5%", () => {
+  assert.equal(feeFor(10000, "EUR"), 250);
+  assert.equal(feeFor(10000, "JPY"), 250);
+  assert.equal(feeFor(40000, "KWD"), 1000);
+});
+
+test("feeFor charges nothing on zero", () => {
+  assert.equal(feeFor(0, "EUR"), 0);
+  assert.equal(feeFor(0, "KWD"), 0);
+});
+
+test("feeFor raises small fees to the currency minimum", () => {
+  assert.equal(feeFor(1, "EUR"), 30);
+  assert.equal(feeFor(100, "EUR"), 30);
+  assert.equal(feeFor(100, "JPY"), 50);
+  assert.equal(feeFor(1000, "KWD"), 300);
+});
+
+test("feeFor caps large fees at the currency maximum", () => {
+  assert.equal(feeFor(1_000_000, "EUR"), 5000);
+  assert.equal(feeFor(1_000_000, "JPY"), 8000);
+  assert.equal(feeFor(100000, "KWD"), 1500);
+});
+
+test("feeFor sits exactly on the limits where the percentage meets them", () => {
+  assert.equal(feeFor(1200, "EUR"), 30); // 30 exactly
+  assert.equal(feeFor(1240, "EUR"), 31);
+  assert.equal(feeFor(200_000, "EUR"), 5000); // 5000 exactly
+  assert.equal(feeFor(200_040, "EUR"), 5000); // 5001 capped
+});
+
+test("feeFor settles percentage ties by the currency's rounding mode", () => {
+  assert.equal(feeFor(1380, "USD"), 35); // 34.5 half-up
+  assert.equal(feeFor(1380, "EUR"), 34); // 34.5 half-even
+  assert.equal(feeFor(1500, "EUR"), 38); // 37.5 half-even -> 38
+  assert.equal(feeFor(1500, "USD"), 38); // 37.5 half-up
+});
+
+test("feeFor rejects negative amounts", () => {
+  assert.throws(() => feeFor(-1, "EUR"), InvalidAmountError);
+});
+
+test("feeFor rejects amounts that are not whole numbers of minor units", () => {
+  assert.throws(() => feeFor(0.5, "EUR"), InvalidAmountError);
+  assert.throws(() => feeFor(Number.NaN, "EUR"), InvalidAmountError);
+});
+
+test("feeFor rejects an unknown currency", () => {
+  assert.throws(() => feeFor(100, "XXX"), UnknownCurrencyError);
+});
+
+test("quote converts, charges the fee in the target currency and returns the net", () => {
+  assert.deepEqual(quote(10000, "EUR", "USD"), { converted: 11000, fee: 275, net: 10725 });
+  assert.deepEqual(quote(1100, "USD", "JPY"), { converted: 1625, fee: 50, net: 1575 });
+});
+
+test("quote of zero is all zeros", () => {
+  assert.deepEqual(quote(0, "EUR", "USD"), { converted: 0, fee: 0, net: 0 });
+});
+
+test("quote accepts an amount that exactly covers the fee", () => {
+  assert.deepEqual(quote(27, "EUR", "USD"), { converted: 30, fee: 30, net: 0 });
+});
+
+test("quote rejects an amount that does not cover the fee", () => {
+  assert.throws(() => quote(10, "EUR", "USD"), InvalidAmountError);
+  assert.throws(() => quote(26, "EUR", "USD"), InvalidAmountError);
+});
+
+test("quote rejects negative amounts", () => {
+  assert.throws(() => quote(-100, "EUR", "USD"), InvalidAmountError);
+});
+
+test("quote rejects invalid input", () => {
+  assert.throws(() => quote(1.5, "EUR", "USD"), InvalidAmountError);
+  assert.throws(() => quote(100, "EUR", "XXX"), UnknownCurrencyError);
+  assert.throws(() => quote(100, "XXX", "EUR"), UnknownCurrencyError);
+});
