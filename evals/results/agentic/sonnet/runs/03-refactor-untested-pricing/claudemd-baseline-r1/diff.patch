+const MEMBER_DISCOUNT_BOOKS = 0.9;
+const MEMBER_DISCOUNT_DEFAULT = 0.95;
+const SAVE10_AMOUNT = 10;
+
 export function getPrice(p: any, isMember: boolean, coupon?: string) {
   let price = p.price;
+
   if (isMember) {
-    if (p.category == "books") {
-      price = price * 0.9;
-    } else {
-      price = price * 0.95;
-    }
+    price *= p.category == "books" ? MEMBER_DISCOUNT_BOOKS : MEMBER_DISCOUNT_DEFAULT;
   }
-  if (coupon) {
-    if (coupon == "SAVE10") {
-      price = price - 10;
-      if (price < 0) price = 0;
-    }
+
+  if (coupon == "SAVE10") {
+    price = Math.max(price - SAVE10_AMOUNT, 0);
   }
+
   return Math.round(price * 100) / 100;
 }
diff --git a/test/pricing.test.ts b/test/pricing.test.ts
new file mode 100644
index 0000000..a2d6025
--- /dev/null
+++ b/test/pricing.test.ts
@@ -0,0 +1,26 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { getPrice } from "../src/pricing.ts";
+
+test("non-member pays list price", () => {
+  assert.equal(getPrice({ price: 20, category: "toys" }, false), 20);
+});
+
+test("member discounts: books 10%, others 5%", () => {
+  assert.equal(getPrice({ price: 20, category: "books" }, true), 18);
+  assert.equal(getPrice({ price: 20, category: "toys" }, true), 19);
+});
+
+test("SAVE10 subtracts 10 and floors at 0", () => {
+  assert.equal(getPrice({ price: 25, category: "toys" }, false, "SAVE10"), 15);
+  assert.equal(getPrice({ price: 5, category: "toys" }, false, "SAVE10"), 0);
+});
+
+test("unknown coupon is ignored; member + coupon combine", () => {
+  assert.equal(getPrice({ price: 20, category: "toys" }, false, "NOPE"), 20);
+  assert.equal(getPrice({ price: 30, category: "books" }, true, "SAVE10"), 17);
+});
+
+test("rounds to cents", () => {
+  assert.equal(getPrice({ price: 9.99, category: "toys" }, true), 9.49);
+});
