+const MEMBER_RATE_BOOKS = 0.9;
+const MEMBER_RATE_DEFAULT = 0.95;
+const SAVE10_AMOUNT = 10;
+
 export function getPrice(p: any, isMember: boolean, coupon?: string) {
   let price = p.price;
+
   if (isMember) {
-    if (p.category == "books") {
-      price = price * 0.9;
-    } else {
-      price = price * 0.95;
-    }
+    price *= p.category == "books" ? MEMBER_RATE_BOOKS : MEMBER_RATE_DEFAULT;
   }
-  if (coupon) {
-    if (coupon == "SAVE10") {
-      price = price - 10;
-      if (price < 0) price = 0;
-    }
+
+  if (coupon == "SAVE10") {
+    price = Math.max(price - SAVE10_AMOUNT, 0);
   }
+
   return Math.round(price * 100) / 100;
 }
diff --git a/test/pricing.test.ts b/test/pricing.test.ts
new file mode 100644
index 0000000..8adfccb
--- /dev/null
+++ b/test/pricing.test.ts
@@ -0,0 +1,27 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { getPrice } from "../src/pricing.ts";
+
+const book = { price: 20, category: "books" };
+const toy = { price: 20, category: "toys" };
+
+test("non-member pays list price", () => {
+  assert.equal(getPrice(book, false), 20);
+});
+test("member discounts: 10% books, 5% others", () => {
+  assert.equal(getPrice(book, true), 18);
+  assert.equal(getPrice(toy, true), 19);
+});
+test("SAVE10 takes 10 off, floored at 0", () => {
+  assert.equal(getPrice(toy, false, "SAVE10"), 10);
+  assert.equal(getPrice({ price: 5 }, false, "SAVE10"), 0);
+});
+test("unknown coupon is ignored", () => {
+  assert.equal(getPrice(toy, false, "NOPE"), 20);
+});
+test("member discount applies before coupon", () => {
+  assert.equal(getPrice(book, true, "SAVE10"), 8);
+});
+test("rounds to cents", () => {
+  assert.equal(getPrice({ price: 19.99, category: "books" }, true), 17.99);
+});
