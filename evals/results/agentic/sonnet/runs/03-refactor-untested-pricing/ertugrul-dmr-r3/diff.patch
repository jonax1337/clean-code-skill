+const BOOK_MEMBER_MULTIPLIER = 0.9;
+const DEFAULT_MEMBER_MULTIPLIER = 0.95;
+const SAVE10_COUPON = "SAVE10";
+const SAVE10_DISCOUNT = 10;
+
+interface Priced {
+  price: number;
+  category?: string;
+}
+
+function applyMemberDiscount(price: number, category?: string): number {
+  const multiplier = category === "books" ? BOOK_MEMBER_MULTIPLIER : DEFAULT_MEMBER_MULTIPLIER;
+  return price * multiplier;
+}
+
+function applyCoupon(price: number, coupon?: string): number {
+  if (coupon !== SAVE10_COUPON) return price;
+  return Math.max(price - SAVE10_DISCOUNT, 0);
+}
+
+function roundToCents(amount: number): number {
+  return Math.round(amount * 100) / 100;
+}
+
+export function getPrice(product: Priced, isMember: boolean, coupon?: string): number {
+  const memberPrice = isMember ? applyMemberDiscount(product.price, product.category) : product.price;
+  return roundToCents(applyCoupon(memberPrice, coupon));
 }
