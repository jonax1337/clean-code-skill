+const BOOK_MEMBER_FACTOR = 0.9;
+const DEFAULT_MEMBER_FACTOR = 0.95;
+const SAVE10_COUPON = "SAVE10";
+const SAVE10_AMOUNT = 10;
+
+interface Priced {
+  price: number;
+  category?: string;
+}
+
+function applyMemberDiscount(price: number, category: string | undefined): number {
+  return price * (category === "books" ? BOOK_MEMBER_FACTOR : DEFAULT_MEMBER_FACTOR);
+}
+
+function applyCoupon(price: number, coupon: string | undefined): number {
+  return coupon === SAVE10_COUPON ? Math.max(price - SAVE10_AMOUNT, 0) : price;
+}
+
+export function getPrice(product: Priced, isMember: boolean, coupon?: string): number {
+  const memberPrice = isMember ? applyMemberDiscount(product.price, product.category) : product.price;
+  const finalPrice = applyCoupon(memberPrice, coupon);
+  return Math.round(finalPrice * 100) / 100;
 }
diff --git a/test/pricing.test.ts b/test/pricing.test.ts
new file mode 100644
index 0000000..11fbd7c
--- /dev/null
+++ b/test/pricing.test.ts
@@ -0,0 +1,43 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { getPrice } from "../src/pricing.ts";
+
+test("non-members pay the list price", () => {
+  assert.equal(getPrice({ price: 20, category: "games" }, false), 20);
+});
+
+test("members get 10% off books", () => {
+  assert.equal(getPrice({ price: 40, category: "books" }, true), 36);
+});
+
+test("members get 5% off other categories", () => {
+  assert.equal(getPrice({ price: 20, category: "games" }, true), 19);
+});
+
+test("products without a category get the 5% member discount", () => {
+  assert.equal(getPrice({ price: 20 }, true), 19);
+});
+
+test("SAVE10 takes 10 off", () => {
+  assert.equal(getPrice({ price: 25, category: "games" }, false, "SAVE10"), 15);
+});
+
+test("SAVE10 never goes below zero", () => {
+  assert.equal(getPrice({ price: 4, category: "games" }, false, "SAVE10"), 0);
+});
+
+test("unknown and empty coupons are ignored", () => {
+  assert.equal(getPrice({ price: 25 }, false, "OTHER"), 25);
+  assert.equal(getPrice({ price: 25 }, false, ""), 25);
+  assert.equal(getPrice({ price: 25 }, false, "save10"), 25);
+});
+
+test("member discount applies before the coupon", () => {
+  assert.equal(getPrice({ price: 40, category: "books" }, true, "SAVE10"), 26);
+});
+
+test("result is rounded to cents", () => {
+  assert.equal(getPrice({ price: 9.99, category: "games" }, true), 9.49);
+  assert.equal(getPrice({ price: 1.005, category: "games" }, false), 1);
+});
