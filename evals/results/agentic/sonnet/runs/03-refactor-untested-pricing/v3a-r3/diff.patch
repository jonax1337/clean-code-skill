+const BOOK_MEMBER_RATE = 0.9;
+const DEFAULT_MEMBER_RATE = 0.95;
+const SAVE10_COUPON = "SAVE10";
+const SAVE10_AMOUNT = 10;
+
+export interface Priceable {
+  price: number;
+  category?: string;
+}
+
+export function getPrice(item: Priceable, isMember: boolean, coupon?: string): number {
+  const memberPrice = isMember ? item.price * memberRate(item.category) : item.price;
+  const finalPrice = coupon === SAVE10_COUPON ? Math.max(memberPrice - SAVE10_AMOUNT, 0) : memberPrice;
+  return roundToCents(finalPrice);
+}
+
+function memberRate(category?: string): number {
+  return category === "books" ? BOOK_MEMBER_RATE : DEFAULT_MEMBER_RATE;
+}
+
+function roundToCents(amount: number): number {
+  return Math.round(amount * 100) / 100;
 }
diff --git a/test/pricing.test.ts b/test/pricing.test.ts
