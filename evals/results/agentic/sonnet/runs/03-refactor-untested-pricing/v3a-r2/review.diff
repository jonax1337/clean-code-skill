-  return Math.round(price * 100) / 100;
+interface Priced {
+  price: number;
+  category?: string;
+}
+
+const BOOK_MEMBER_FACTOR = 0.9;
+const DEFAULT_MEMBER_FACTOR = 0.95;
+const SAVE10_AMOUNT = 10;
+
+export function getPrice(item: Priced, isMember: boolean, coupon?: string): number {
+  const memberPrice = isMember ? item.price * memberFactor(item) : item.price;
+  const couponPrice = coupon === "SAVE10" ? Math.max(memberPrice - SAVE10_AMOUNT, 0) : memberPrice;
+  return Math.round(couponPrice * 100) / 100;
+}
+
+function memberFactor(item: Priced): number {
+  return item.category === "books" ? BOOK_MEMBER_FACTOR : DEFAULT_MEMBER_FACTOR;
 }
diff --git a/test/pricing.test.ts b/test/pricing.test.ts
new file mode 100644
