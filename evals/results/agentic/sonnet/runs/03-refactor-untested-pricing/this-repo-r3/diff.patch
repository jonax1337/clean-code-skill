+const BOOK_MEMBER_FACTOR = 0.9;
+const DEFAULT_MEMBER_FACTOR = 0.95;
+const SAVE10_COUPON = "SAVE10";
+const SAVE10_AMOUNT = 10;
+
+interface Priced {
+  price: number;
+  category?: string;
+}
+
+export function getPrice(item: Priced, isMember: boolean, coupon?: string): number {
+  const memberPrice = isMember ? item.price * memberFactor(item.category) : item.price;
+  const finalPrice = coupon === SAVE10_COUPON ? Math.max(memberPrice - SAVE10_AMOUNT, 0) : memberPrice;
+  return roundToCents(finalPrice);
+}
+
+function memberFactor(category: string | undefined): number {
+  return category === "books" ? BOOK_MEMBER_FACTOR : DEFAULT_MEMBER_FACTOR;
+}
+
+function roundToCents(amount: number): number {
+  return Math.round(amount * 100) / 100;
 }
diff --git a/test/pricing.test.ts b/test/pricing.test.ts
