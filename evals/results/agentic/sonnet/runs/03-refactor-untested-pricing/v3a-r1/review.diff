+const BOOK_MEMBER_RATE = 0.9;
+const DEFAULT_MEMBER_RATE = 0.95;
+const SAVE10_COUPON = "SAVE10";
+const SAVE10_AMOUNT = 10;
+
+interface Priced {
+  price: number;
+  category?: string;
+}
+
+export function getPrice(product: Priced, isMember: boolean, coupon?: string): number {
+  const memberPrice = isMember ? product.price * memberRate(product) : product.price;
+  return roundToCents(applyCoupon(memberPrice, coupon));
+}
+
+function memberRate(product: Priced): number {
+  return product.category === "books" ? BOOK_MEMBER_RATE : DEFAULT_MEMBER_RATE;
+}
+
+function applyCoupon(price: number, coupon?: string): number {
+  return coupon === SAVE10_COUPON ? Math.max(price - SAVE10_AMOUNT, 0) : price;
+}
+
+function roundToCents(amount: number): number {
+  return Math.round(amount * 100) / 100;
 }
diff --git a/test/pricing.test.ts b/test/pricing.test.ts
new file mode 100644
