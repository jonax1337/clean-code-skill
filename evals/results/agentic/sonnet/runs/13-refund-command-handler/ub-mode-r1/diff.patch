@@ -0,0 +1,41 @@
+package shop;
+
+import java.util.Optional;
+
+public final class RefundOrderHandler implements CommandHandler<RefundOrder> {
+    private final OrderRepository orders;
+
+    public RefundOrderHandler(OrderRepository orders) {
+        this.orders = orders;
+    }
+
+    @Override
+    public Result<Order> handle(RefundOrder command) {
+        Validator validator = new Validator()
+                .requireText("orderId", command.orderId())
+                .requireMoney("amount", command.amount());
+        if (!validator.isValid()) {
+            return validator.failure();
+        }
+        Optional<Order> found = orders.find(command.orderId());
+        if (found.isEmpty()) {
+            return Result.failure(ErrorCode.NOT_FOUND, "Order " + command.orderId() + " does not exist");
+        }
+        Order order = found.get();
+        if (order.status() != OrderStatus.SHIPPED && order.status() != OrderStatus.DELIVERED) {
+            return Result.failure(
+                    ErrorCode.INVALID_STATE,
+                    "Only shipped or delivered orders can be refunded, but order " + order.id() + " is "
+                            + order.status());
+        }
+        if (command.amount().compareTo(order.refundable()) > 0) {
+            return Result.failure(
+                    ErrorCode.INVALID_INPUT,
+                    "Refund " + command.amount() + " is more than the refundable " + order.refundable()
+                            + " of order " + order.id());
+        }
+        order.refund(command.amount());
+        orders.save(order);
+        return Result.ok(order);
+    }
+}
diff --git a/src/test/java/shop/RefundOrderHandlerTest.java b/src/test/java/shop/RefundOrderHandlerTest.java
new file mode 100644
index 0000000..0b0a0e1
--- /dev/null
+++ b/src/test/java/shop/RefundOrderHandlerTest.java
@@ -0,0 +1,97 @@
+package shop;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.math.BigDecimal;
+import org.junit.jupiter.api.Test;
+
+class RefundOrderHandlerTest {
+    private final OrderRepository orders = new InMemoryOrderRepository();
+    private final CommandBus bus = OrderServices.createBus(orders);
+
+    private void shippedOrder(String paid) {
+        bus.dispatch(new PlaceOrder("o-1", "c-1", new BigDecimal("100.00")));
+        bus.dispatch(new PayOrder("o-1", new BigDecimal(paid)));
+        bus.dispatch(new ShipOrder("o-1"));
+    }
+
+    private Result<Order> refund(String amount) {
+        return bus.dispatch(new RefundOrder("o-1", new BigDecimal(amount)));
+    }
+
+    private Order stored() {
+        return orders.find("o-1").orElseThrow();
+    }
+
+    @Test
+    void refundsPartOfAShippedOrderAndKeepsStatus() {
+        shippedOrder("100.00");
+
+        assertTrue(refund("30.00").isOk());
+
+        assertEquals(0, new BigDecimal("30.00").compareTo(stored().amountRefunded()));
+        assertEquals(OrderStatus.SHIPPED, stored().status());
+    }
+
+    @Test
+    void refundsADeliveredOrder() {
+        shippedOrder("100.00");
+        bus.dispatch(new DeliverOrder("o-1"));
+
+        assertTrue(refund("10.00").isOk());
+        assertEquals(OrderStatus.DELIVERED, stored().status());
+    }
+
+    @Test
+    void accumulatesRefundsUpToExactlyWhatWasPaid() {
+        shippedOrder("80.00");
+
+        assertTrue(refund("50.00").isOk());
+        assertTrue(refund("30.00").isOk());
+
+        assertEquals(0, new BigDecimal("80.00").compareTo(stored().amountRefunded()));
+    }
+
+    @Test
+    void rejectsRefundsBeyondWhatWasPaidNotTheTotal() {
+        shippedOrder("80.00");
+
+        Result<Order> result = refund("80.01");
+
+        assertFalse(result.isOk());
+        assertEquals(ErrorCode.INVALID_INPUT, result.error().code());
+        assertEquals(0, BigDecimal.ZERO.compareTo(stored().amountRefunded()));
+    }
+
+    @Test
+    void rejectsARefundThatTogetherWithEarlierOnesExceedsPayment() {
+        shippedOrder("80.00");
+        refund("50.00");
+
+        assertFalse(refund("30.01").isOk());
+        assertEquals(0, new BigDecimal("50.00").compareTo(stored().amountRefunded()));
+    }
+
+    @Test
+    void rejectsOrdersThatAreNotShippedOrDelivered() {
+        bus.dispatch(new PlaceOrder("o-1", "c-1", new BigDecimal("100.00")));
+        assertEquals(ErrorCode.INVALID_STATE, refund("10.00").error().code());
+
+        bus.dispatch(new PayOrder("o-1", new BigDecimal("100.00")));
+        assertEquals(ErrorCode.INVALID_STATE, refund("10.00").error().code());
+
+        bus.dispatch(new CancelOrder("o-1"));
+        assertEquals(ErrorCode.INVALID_STATE, refund("10.00").error().code());
+    }
+
+    @Test
+    void rejectsBadAmountsAndUnknownOrders() {
+        shippedOrder("100.00");
+        assertEquals(ErrorCode.INVALID_INPUT, refund("0").error().code());
+        assertEquals(ErrorCode.INVALID_INPUT, refund("1.234").error().code());
+        assertEquals(ErrorCode.NOT_FOUND,
+                bus.dispatch(new RefundOrder("missing", BigDecimal.ONE)).error().code());
+    }
+}
