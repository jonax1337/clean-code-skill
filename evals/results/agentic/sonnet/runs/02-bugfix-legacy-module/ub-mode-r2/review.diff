 """Date ranges for the sales reports. Every range is half-open: start <= day < end."""
 
 import datetime
 
 
+def _first_of_month(year, month):
+    """First day of the given month; month 13 rolls over to January of the next year."""
+    return datetime.date(year + (month - 1) // 12, (month - 1) % 12 + 1, 1)
+
+
 def month_range(year, month):
     """Return (first day of the month, first day of the next month)."""
-    start = datetime.date(year, month, 1)
-    end = datetime.date(year, month + 1, 1)
+    start = _first_of_month(year, month)
+    end = _first_of_month(year, month + 1)
     return start, end
 
 
 def quarter_range(year, quarter):
     """Return (first day of the quarter, first day of the next quarter) for quarter 1-4."""
-    start = datetime.date(year, 3 * quarter - 2, 1)
-    end = datetime.date(year, 3 * quarter + 1, 1)
+    start = _first_of_month(year, 3 * quarter - 2)
+    end = _first_of_month(year, 3 * quarter + 1)
     return start, end
 
 
 def week_range(day):
     """Return (Monday of the ISO week containing day, Monday of the following week)."""
     start = day - datetime.timedelta(days=day.weekday())
     return start, start + datetime.timedelta(days=7)
