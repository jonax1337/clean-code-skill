+// The three groupers deliberately differ in how they treat a leading '-'
+// (negative line amounts); the finance import has always received that output.
+function groupWithDots(integerPart) {
+  let grouped = '';
+  for (let i = 0; i < integerPart.length; i++) {
+    if (i > 0 && (integerPart.length - i) % 3 === 0) {
+      grouped += '.';
+    }
+    grouped += integerPart[i];
+  }
+  return grouped;
+}
+
+function groupWithSpaces(integerPart) {
+  return integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
+}
+
+function groupWithCommas(integerPart) {
+  const chunks = [];
+  const reversed = integerPart.split('').reverse();
+  for (let i = 0; i < reversed.length; i += 3) {
+    chunks.unshift(reversed.slice(i, i + 3).reverse().join(''));
+  }
+  return chunks.join(',');
+}
+
+// Order of this table is the order of the sections in the report.
+const REGIONS = [
+  {
+    code: 'DE',
+    title: 'Germany',
+    taxRate: 0.19,
+    formatLineAmount: ([whole, cents]) => groupWithDots(whole) + ',' + cents + ' €',
+  },
+  {
+    code: 'FR',
+    title: 'France',
+    taxRate: 0.2,
+    formatLineAmount: ([whole, cents]) => groupWithSpaces(whole) + ',' + cents + ' €',
+  },
+  {
+    code: 'UK',
+    title: 'United Kingdom',
+    taxRate: 0.2,
+    formatLineAmount: ([whole, cents]) => '£' + groupWithCommas(whole) + '.' + cents,
+  },
+];
