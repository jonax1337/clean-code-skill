+// Money as printed on a sale row. Identical to formatMoney except for negative amounts
+// (credits), where the old report counted the '-' as a digit when grouping (DE/UK gave
+// e.g. '-.123 €') and put it after the '£' for UK. Kept as-is because the finance import
+// receives this output; fixing it is a separate, visible change.
+function formatRowMoney(amount, region) {
+  if (amount >= 0 || region === 'FR') return formatMoney(amount, region);
+  const [whole, cents] = Math.abs(amount).toFixed(2).split('.');
+  const grouped = (separator) => groupThousands('-' + whole, separator);
+  return region === 'DE' ? `${grouped('.')},${cents} €` : `£${grouped(',')}.${cents}`;
+}
