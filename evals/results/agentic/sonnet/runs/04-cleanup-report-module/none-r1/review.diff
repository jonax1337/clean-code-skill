+export function formatMoney(amount, region) {
+  const sign = amount < 0 ? '-' : '';
+  const [whole, cents] = Math.abs(amount).toFixed(2).split('.');
+  switch (region) {
+    case 'DE':
+      return `${sign}${groupThousands(whole, '.')},${cents} €`;
+    case 'FR':
+      return `${sign}${groupThousands(whole, ' ')},${cents} €`;
+    case 'UK':
+      return `${sign}£${groupThousands(whole, ',')}.${cents}`;
+    default:
+      throw new Error('unknown region: ' + region);
   }
