+  assert.equal(formatMoney(1234567.5, 'FR'), '1 234 567,50 €');
+  assert.equal(formatMoney(1234567.5, 'UK'), '£1,234,567.50');
+  assert.throws(() => formatMoney(1, 'US'), /unknown region: US/);
+});
+
+test('formats negative totals with the sign in front', () => {
+  assert.equal(formatMoney(-1234567.5, 'DE'), '-1.234.567,50 €');
+  assert.equal(formatMoney(-1234567.5, 'FR'), '-1 234 567,50 €');
+  assert.equal(formatMoney(-1234567.5, 'UK'), '-£1,234,567.50');
+});
+
+// Characterization: row amounts of negative sales have always been printed with the minus
