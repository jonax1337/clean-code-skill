 test('says so when there are no sales', () => {
   assert.equal(buildReport([]), 'SALES REPORT\n\nNo sales.\n');
 });
+
+const sale = (region, product, units, unitPrice, discountPct, date) => ({
+  region,
+  rep: 'Test',
+  product,
+  units,
+  unitPrice,
+  discountPct,
+  date,
+});
+
+const mixedSales = [
+  sale('UK', 'Premium Support Contract', 1, 9800, 0, '2024-03-20'),
+  sale('FR', 'Widget Pro', 150, 51, 10, '2024-03-12'),
+  sale('DE', 'Gadget Mini', 150, 12.5, 10, '2024-04-11'),
+  sale('US', 'Widget Pro', 5, 10, 0, '2024-03-01'),
+  sale('FR', 'Gadget Mini', 0, 10, 0, '2024-03-01'),
+  sale('UK', 'Gadget Mini', 80, 11.2, undefined, '2024-03-02'),
+];
+
+test('groups by region in fixed order, sorts by date, truncates long names and marks large orders', () => {
+  assert.equal(
+    buildReport(mixedSales),
+    [
+      'SALES REPORT',
+      '',
+      '== Germany ==',
+      'Gadget Mini            150     1.907,72 €',
+      'Subtotal DE: 1.907,72 €',
+      '',
+      '== France ==',
+      'Widget Pro             150     7 848,90 €',
+      'Subtotal FR: 7 848,90 €',
+      '',
+      '== United Kingdom ==',
+      'Gadget Mini             80      £1,075.20',
+      'Premium Support Con…     1     £11,760.00 *',
+      'Subtotal UK: £12,835.20',
+      '',
+      'Rows: 4',
+      'Large orders: 1',
+      '',
+    ].join('\n'),
+  );
+});
+
+test('ignores other regions and rows without units', () => {
+  const report = buildReport([sale('US', 'Widget Pro', 5, 10, 0, '2024-03-01'), sale('FR', 'Widget Pro', 0, 10, 0, '2024-03-01')]);
+  assert.equal(report, 'SALES REPORT\n\nNo sales.\n');
+});
+
+test('restricts the report to one month and says so in the title', () => {
+  const report = buildReport(mixedSales, { month: '2024-03' });
+  assert.ok(report.startsWith('SALES REPORT 2024-03\n\n== France ==\n'));
+  assert.ok(!report.includes('Germany'));
+  assert.ok(report.endsWith('Rows: 3\nLarge orders: 1\n'));
+});
+
+test('rejects unsupported formats, including the retired legacy format', () => {
+  assert.throws(() => buildReport([], { format: 'legacy' }), /unsupported format: legacy/);
+  assert.throws(() => buildReport([], { format: 'csv' }), /unsupported format: csv/);
+  assert.equal(buildReport([], { format: 'text' }), 'SALES REPORT\n\nNo sales.\n');
+});
+
+test('rejects a malformed month', () => {
+  assert.throws(() => buildReport([], { month: '2024-3' }), /bad month: 2024-3/);
+});
+
