+      'Refund                   1      -148,14 €',
+      'Subtotal FR: -148,14 €',
+      '',
+      '== United Kingdom ==',
+      'Refund                   1      £-,148.14',
+      'Subtotal UK: -£148.14',
+      '',
+      'Rows: 3',
