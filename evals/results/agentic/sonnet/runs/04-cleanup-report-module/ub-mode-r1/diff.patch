+// Sales report. Used by the finance export (export.js) and the weekly digest (digest.js).
+// The layout is parsed by the finance team's import, so do not move columns around.
+// TODO: US region once the tax rules are clear
+
+export function formatMoney(amount, region) {
+  let sign = '';
+  if (amount < 0) {
+    sign = '-';
+    amount = -amount;
+  }
+  const fixed = amount.toFixed(2);
+  const ip = fixed.slice(0, fixed.length - 3);
+  const cents = fixed.slice(-2);
+  const groups = [];
+  for (let i = ip.length; i > 0; i -= 3) {
+    groups.unshift(ip.slice(Math.max(0, i - 3), i));
+  }
+  if (region === 'DE') {
+    return sign + groups.join('.') + ',' + cents + ' €';
+  }
+  if (region === 'FR') {
+    return sign + groups.join(' ') + ',' + cents + ' €';
+  }
+  if (region === 'UK') {
+    return sign + '£' + groups.join(',') + '.' + cents;
+  }
+  throw new Error('unknown region: ' + region);
+}
+
+// Thousands grouping of the integer part of a row amount. These two deliberately keep
+// the historical behaviour, including how a leading "-" is counted as a character
+// (a credit note of -123.00 renders "-.123,00 €" in DE and "£-,123.00" in UK).
+// The finance import is built on this output, so do not "fix" it without telling them.
+function groupFromRight(text, separator) {
+  let grouped = '';
+  for (let k = 0; k < text.length; k++) {
+    if (k > 0 && (text.length - k) % 3 === 0) grouped += separator;
+    grouped += text[k];
+  }
+  return grouped;
+}
+
+const REGIONS = [
+  {
+    code: 'DE',
+    title: 'Germany',
+    taxRate: 0.19,
+    group: (ip) => groupFromRight(ip, '.'),
+    money: (ip, cents) => ip + ',' + cents + ' €',
+  },
+  {
+    code: 'FR',
+    title: 'France',
+    taxRate: 0.2,
+    group: (ip) => ip.replace(/\B(?=(\d{3})+(?!\d))/g, ' '),
+    money: (ip, cents) => ip + ',' + cents + ' €',
+  },
+  {
+    code: 'UK',
+    title: 'United Kingdom',
+    taxRate: 0.2,
+    group: (ip) => groupFromRight(ip, ','),
+    money: (ip, cents) => '£' + ip + '.' + cents,
+  },
+];
+
+const NAME_WIDTH = 20;
+const LARGE_ORDER = 10000;
+const BULK_UNITS = 100;
+const BULK_FACTOR = 0.95;
+
+const round2 = (value) => Math.round(value * 100) / 100;
+
+// Gross amount of one sale: discount, bulk rebate, then tax, each step rounded to cents.
+function grossAmount(sale, taxRate) {
+  let net = sale.units * sale.unitPrice;
+  if (sale.discountPct) net = net - (net * sale.discountPct) / 100;
+  if (sale.units >= BULK_UNITS) net = net * BULK_FACTOR;
+  net = round2(net);
+  const tax = Math.round(net * taxRate * 100) / 100;
+  return round2(net + tax);
+}
+
+function formatRow(sale, amount, region) {
+  const [ip, cents] = amount.toFixed(2).split('.');
+  const money = region.money(region.group(ip), cents);
+  const name = sale.product.length > NAME_WIDTH ? sale.product.slice(0, NAME_WIDTH - 1) + '…' : sale.product;
+  let line = name.padEnd(NAME_WIDTH) + ' ' + String(sale.units).padStart(5) + ' ' + money.padStart(14);
+  if (amount >= LARGE_ORDER) line += ' *';
+  return line;
+}
+
+export function buildReport(sales, options) {
+  options = options || {};
+  if (options.format && options.format !== 'text') {
+    throw new Error('unsupported format: ' + options.format);
+  }
+  if (options.month && !/^\d{4}-\d{2}$/.test(options.month)) {
+    throw new Error('bad month: ' + options.month);
+  }
+  let data = sales.slice();
+  if (options.month) {
+    data = data.filter((s) => s.date.slice(0, 7) === options.month);
+  }
+  data.sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
+
+  const res = [options.month ? 'SALES REPORT ' + options.month : 'SALES REPORT', ''];
+  let rows = 0;
+  let large = 0;
+  for (const region of REGIONS) {
+    const regionSales = data.filter((s) => s.region === region.code && s.units > 0);
+    if (regionSales.length === 0) continue;
+    res.push('== ' + region.title + ' ==');
+    let subtotal = 0;
+    for (const sale of regionSales) {
+      const amount = grossAmount(sale, region.taxRate);
+      res.push(formatRow(sale, amount, region));
+      if (amount >= LARGE_ORDER) large++;
+      subtotal += amount;
+      rows++;
+    }
+    res.push('Subtotal ' + region.code + ': ' + formatMoney(subtotal, region.code));
+    res.push('');
+  }
+
+  if (rows === 0) {
+    res.push('No sales.');
+  } else {
+    res.push('Rows: ' + rows);
+    res.push('Large orders: ' + large);
+  }
+  return res.join('\n') + '\n';
+}
