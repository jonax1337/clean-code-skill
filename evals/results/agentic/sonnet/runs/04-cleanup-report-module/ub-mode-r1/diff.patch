+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import { buildReport } from '../src/report.js';
+
+// Output captured before the report.js cleanup. The finance import parses it, so it must not change.
+const golden = JSON.parse(readFileSync(new URL('./fixtures-golden.json', import.meta.url), 'utf8'));
+
+test('report for all regions is unchanged', () => {
+  assert.equal(buildReport(golden.sales), golden.all);
+});
+
+test('monthly report is unchanged', () => {
+  assert.equal(buildReport(golden.sales, { month: '2024-03' }), golden.march);
+});
