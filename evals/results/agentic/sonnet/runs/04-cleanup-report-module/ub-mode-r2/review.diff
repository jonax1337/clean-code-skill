+import { readFileSync } from 'node:fs';
 import { test } from 'node:test';
 import { buildReport, formatMoney } from '../src/report.js';
 
 const germanSales = [
   { region: 'DE', rep: 'Anke', product: 'Widget Pro', units: 12, unitPrice: 49.9, discountPct: 0, date: '2024-03-04' },
   { region: 'DE', rep: 'Jonas', product: 'Gadget Mini', units: 3, unitPrice: 12.5, discountPct: 10, date: '2024-03-11' },
 ];
 
@@ -28,8 +29,51 @@ test('lists German sales with VAT and a subtotal', () => {
       '',
     ].join('\n'),
   );
 });
 
 test('says so when there are no sales', () => {
   assert.equal(buildReport([]), 'SALES REPORT\n\nNo sales.\n');
 });
+
+// Characterization: the finance import parses this output, so it must not drift.
+const sample = JSON.parse(readFileSync(new URL('../data/sample.json', import.meta.url), 'utf8'));
+
+test('full sample report is byte-for-byte stable (all regions, large order, truncated name)', () => {
+  assert.equal(
+    buildReport(sample),
+    [
+      'SALES REPORT',
+      '',
+      '== Germany ==',
+      'Widget Pro              12       712,57 €',
+      'Gadget Mini            150     1.907,72 €',
+      'Subtotal DE: 2.620,29 €',
+      '',
+      '== France ==',
+      'Widget Pro              30     1 836,00 €',
+      'Subtotal FR: 1 836,00 €',
+      '',
+      '== United Kingdom ==',
+      'Gadget Mini             80      £1,075.20',
+      'Premium Support Con…     1     £11,760.00 *',
+      'Subtotal UK: £12,835.20',
+      '',
+      'Rows: 5',
+      'Large orders: 1',
+      '',
+    ].join('\n'),
+  );
+});
+
+test('month filter, bad month and unsupported format', () => {
+  assert.match(buildReport(sample, { month: '2024-03' }), /^SALES REPORT 2024-03\n/);
+  assert.throws(() => buildReport(sample, { month: '2024-3' }), /bad month: 2024-3/);
+  assert.throws(() => buildReport(sample, { format: 'legacy' }), /unsupported format: legacy/);
+});
+
+test('formatMoney per region, negatives, unknown region', () => {
+  assert.equal(formatMoney(1234567.891, 'FR'), '1 234 567,89 €');
+  assert.equal(formatMoney(1234.5, 'UK'), '£1,234.50');
+  assert.equal(formatMoney(-1234.5, 'UK'), '-£1,234.50');
+  assert.throws(() => formatMoney(1, 'US'), /unknown region: US/);
+});
