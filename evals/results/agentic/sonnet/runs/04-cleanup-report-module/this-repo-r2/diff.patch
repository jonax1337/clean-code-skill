+// Sales report. Used by the finance export (export.js) and the weekly digest (digest.js).
+// The layout is parsed by the finance team's import, so do not move columns around.
+// TODO: US region once the tax rules are clear
+
+const BULK_UNITS = 100;
+const BULK_FACTOR = 0.95;
+const LARGE_ORDER_AMOUNT = 10000;
+const PRODUCT_WIDTH = 20;
+const UNITS_WIDTH = 5;
+const MONEY_WIDTH = 14;
+const MONTH_PATTERN = /^\d{4}-\d{2}$/;
+
+// Sections appear in this order. `thousands` and `decimal` are the separators of the local number format.
+const REGIONS = [
+  { code: 'DE', title: 'Germany', taxRate: 0.19, prefix: '', suffix: ' €', thousands: '.', decimal: ',' },
+  { code: 'FR', title: 'France', taxRate: 0.2, prefix: '', suffix: ' €', thousands: ' ', decimal: ',' },
+  { code: 'UK', title: 'United Kingdom', taxRate: 0.2, prefix: '£', suffix: '', thousands: ',', decimal: '.' },
+];
+
+function findRegion(code) {
+  const region = REGIONS.find((r) => r.code === code);
+  if (!region) {
+    throw new Error('unknown region: ' + code);
+  }
+  return region;
+}
+
+// Inserts `separator` between groups of three characters, counted from the right.
+function groupThousands(text, separator) {
+  const groups = [];
+  for (let end = text.length; end > 0; end -= 3) {
+    groups.unshift(text.slice(Math.max(0, end - 3), end));
+  }
+  return groups.join(separator);
+}
+
+export function formatMoney(amount, regionCode) {
+  const region = findRegion(regionCode);
+  const sign = amount < 0 ? '-' : '';
+  const fixed = Math.abs(amount).toFixed(2);
+  const integerPart = fixed.slice(0, -3);
+  const cents = fixed.slice(-2);
+  return sign + region.prefix + groupThousands(integerPart, region.thousands) + region.decimal + cents + region.suffix;
+}
+
+// Money as shown in a report line. For negative amounts DE and UK historically group the digits together
+// with the minus sign ("-.146,37 €", "£-,147.60"). The finance import has been fed that output, so it stays.
+function formatLineMoney(amount, region) {
+  if (amount >= 0 || region.code === 'FR') {
+    return formatMoney(amount, region.code);
+  }
+  const [integerPart, cents] = amount.toFixed(2).split('.');
+  return region.prefix + groupThousands(integerPart, region.thousands) + region.decimal + cents + region.suffix;
+}
+
+function roundToCents(value) {
+  return Math.round(value * 100) / 100;
+}
+
+// Net price after discount and bulk rebate, plus the region's tax, each step rounded to cents.
+function grossAmount(sale, taxRate) {
+  let net = sale.units * sale.unitPrice;
+  if (sale.discountPct) {
+    net = net - (net * sale.discountPct) / 100;
+  }
+  if (sale.units >= BULK_UNITS) {
+    net = net * BULK_FACTOR;
+  }
+  net = roundToCents(net);
+  const tax = roundToCents(net * taxRate);
+  return roundToCents(net + tax);
+}
+
+function truncateProduct(product) {
+  return product.length > PRODUCT_WIDTH ? product.slice(0, PRODUCT_WIDTH - 1) + '…' : product;
+}
+
+function formatLine(sale, amount, region) {
+  const line =
+    truncateProduct(sale.product).padEnd(PRODUCT_WIDTH) +
+    ' ' +
+    String(sale.units).padStart(UNITS_WIDTH) +
+    ' ' +
+    formatLineMoney(amount, region).padStart(MONEY_WIDTH);
+  return amount >= LARGE_ORDER_AMOUNT ? line + ' *' : line;
+}
+
+function validateOptions(options) {
+  if (options.format && options.format !== 'text') {
+    throw new Error('unsupported format: ' + options.format);
+  }
+  if (options.month && !MONTH_PATTERN.test(options.month)) {
+    throw new Error('bad month: ' + options.month);
+  }
+  return options;
+}
+
+function selectSales(sales, month) {
+  const selected = month ? sales.filter((s) => s.date.slice(0, 7) === month) : sales.slice();
+  return selected.sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
+}
+
+// Lines of one region's section, or null when the region has no sales.
+function buildSection(sales, region) {
+  const regionSales = sales.filter((s) => s.region === region.code && s.units > 0);
+  if (regionSales.length === 0) {
+    return null;
+  }
+  const lines = ['== ' + region.title + ' =='];
+  let subtotal = 0;
+  let largeOrders = 0;
+  for (const sale of regionSales) {
+    const amount = grossAmount(sale, region.taxRate);
+    lines.push(formatLine(sale, amount, region));
+    subtotal += amount;
+    if (amount >= LARGE_ORDER_AMOUNT) {
+      largeOrders++;
+    }
+  }
+  lines.push('Subtotal ' + region.code + ': ' + formatMoney(subtotal, region.code));
+  lines.push('');
+  return { lines, rows: regionSales.length, largeOrders };
+}
+
+export function buildReport(sales, options) {
+  const { month } = validateOptions(options || {});
+  const lines = [month ? 'SALES REPORT ' + month : 'SALES REPORT', ''];
+  const selected = selectSales(sales, month);
+
+  let rows = 0;
+  let largeOrders = 0;
+  for (const region of REGIONS) {
+    const section = buildSection(selected, region);
+    if (section) {
+      lines.push(...section.lines);
+      rows += section.rows;
+      largeOrders += section.largeOrders;
+    }
+  }
+
+  if (rows === 0) {
+    lines.push('No sales.');
+  } else {
+    lines.push('Rows: ' + rows, 'Large orders: ' + largeOrders);
+  }
+  return lines.join('\n') + '\n';
+}
