+const sale = (region, product, units, unitPrice, date, discountPct) => ({
+  region,
+  rep: 'Rep',
+  product,
+  units,
+  unitPrice,
+  discountPct,
+  date,
+});
+
+test('groups regions in the order DE, FR, UK with local formats, bulk rebate and large-order marks', () => {
+  const report = buildReport([
+    sale('UK', 'Premium Support Contract', 1, 9800, '2024-04-02'),
+    sale('FR', 'Widget Pro', 30, 51, '2024-03-12'),
+    sale('DE', 'Gadget Mini', 150, 12.5, '2024-03-11', 10),
+    sale('UK', 'Gadget Mini', 80, 11.2, '2024-03-20'),
+    sale('FR', 'Big Order', 1000, 1234.5, '2024-03-01'),
+  ]);
+  assert.equal(
+    report,
+    [
+      'SALES REPORT',
+      '',
+      '== Germany ==',
+      'Gadget Mini            150     1.907,72 €',
+      'Subtotal DE: 1.907,72 €',
+      '',
+      '== France ==',
+      'Big Order             1000 1 407 330,00 € *',
+      'Widget Pro              30     1 836,00 €',
+      'Subtotal FR: 1 409 166,00 €',
+      '',
+      '== United Kingdom ==',
+      'Gadget Mini             80      £1,075.20',
+      'Premium Support Con…     1     £11,760.00 *',
+      'Subtotal UK: £12,835.20',
+      '',
+      'Rows: 5',
+      'Large orders: 2',
+      '',
+    ].join('\n'),
+  );
+});
+
+test('skips sales with no positive units and regions it does not know', () => {
