+    sale('DE', 'Returned', -2, 5, '2024-03-01'),
+    sale('DE', 'Zero', 0, 5, '2024-03-01'),
+  ]);
+  assert.equal(report, 'SALES REPORT\n\nNo sales.\n');
+});
+
+test('restricts the report to the requested month and names it in the title', () => {
+  const sales = [sale('DE', 'A', 1, 10, '2024-03-01'), sale('DE', 'B', 1, 10, '2024-04-01')];
+  assert.equal(
+    buildReport(sales, { month: '2024-04' }),
+    'SALES REPORT 2024-04\n\n== Germany ==\nB                        1        11,90 €\nSubtotal DE: 11,90 €\n\nRows: 1\nLarge orders: 0\n',
+  );
+  assert.equal(buildReport(sales, { month: '2024-05' }), 'SALES REPORT 2024-05\n\nNo sales.\n');
+});
+
+test('cuts product names longer than 20 characters to 19 plus an ellipsis', () => {
+  const report = buildReport([
+    sale('DE', 'Exactly twenty chars', 1, 1, '2024-03-01'),
+    sale('FR', 'Exactly twenty chars!', 1, 1, '2024-03-01'),
+  ]);
+  assert.match(report, /^Exactly twenty chars {5}1 /m);
+  assert.match(report, /^Exactly twenty char… {5}1 /m);
+});
+
+// The next test pins output that looks wrong: DE and UK put the minus sign into the digit grouping
+// ("-.146,37 €", "£-,147.60"). The finance import receives it today, so a fix has to be deliberate.
+test('keeps the odd DE and UK grouping of negative line amounts', () => {
+  const report = buildReport([
+    sale('DE', 'N', 1, -123, '2024-03-01'),
+    sale('DE', 'N', 1, -1234.5, '2024-03-02'),
+    sale('FR', 'N', 1, -123, '2024-03-01'),
+    sale('FR', 'N', 1, -1234.5, '2024-03-02'),
+    sale('UK', 'N', 1, -123, '2024-03-01'),
+    sale('UK', 'N', 1, -1234.5, '2024-03-02'),
+  ]);
+  assert.equal(
+    report,
+    [
+      'SALES REPORT',
+      '',
+      '== Germany ==',
+      'N                        1     -.146,37 €',
+      'N                        1    -1.469,05 €',
+      'Subtotal DE: -1.615,42 €',
+      '',
+      '== France ==',
+      'N                        1      -147,60 €',
+      'N                        1    -1 481,40 €',
+      'Subtotal FR: -1 629,00 €',
+      '',
+      '== United Kingdom ==',
+      'N                        1      £-,147.60',
+      'N                        1     £-1,481.40',
+      'Subtotal UK: -£1,629.00',
+      '',
+      'Rows: 6',
+      'Large orders: 0',
+      '',
+    ].join('\n'),
+  );
+});
+
+test('formats amounts for every region, negatives and rounding included', () => {
+  assert.equal(formatMoney(-1234567.891, 'DE'), '-1.234.567,89 €');
+  assert.equal(formatMoney(0, 'FR'), '0,00 €');
+  assert.equal(formatMoney(999.999, 'UK'), '£1,000.00');
+  assert.equal(formatMoney(-5, 'UK'), '-£5.00');
+});
+
+test('rejects unknown regions, formats and malformed months', () => {
+  assert.throws(() => formatMoney(1, 'US'), { message: 'unknown region: US' });
+  assert.throws(() => buildReport([], { format: 'legacy' }), { message: 'unsupported format: legacy' });
+  assert.throws(() => buildReport([], { month: '2024-3' }), { message: 'bad month: 2024-3' });
+});
