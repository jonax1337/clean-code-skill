+
+const mixedSales = [
+  { region: 'FR', rep: 'Claire', product: 'Widget Pro', units: 30, unitPrice: 51, date: '2024-03-12' },
+  { region: 'UK', rep: 'Oliver', product: 'Gadget Mini', units: 80, unitPrice: 11.2, date: '2024-03-20' },
+  { region: 'UK', rep: 'Priya', product: 'Premium Support Contract', units: 1, unitPrice: 9800, date: '2024-04-02' },
+  { region: 'DE', rep: 'Jonas', product: 'Gadget Mini', units: 150, unitPrice: 12.5, discountPct: 10, date: '2024-03-11' },
+  { region: 'US', rep: 'Sam', product: 'Widget Pro', units: 5, unitPrice: 10, date: '2024-03-01' },
+  { region: 'DE', rep: 'Anke', product: 'Returned', units: 0, unitPrice: 10, date: '2024-03-02' },
+];
+
+test('groups sales by region, applies the bulk rebate, flags large orders and skips unknown regions and zero units', () => {
+  assert.equal(
+    buildReport(mixedSales),
+    [
+      'SALES REPORT',
+      '',
+      '== Germany ==',
+      'Gadget Mini            150     1.907,72 €',
+      'Subtotal DE: 1.907,72 €',
+      '',
+      '== France ==',
+      'Widget Pro              30     1 836,00 €',
+      'Subtotal FR: 1 836,00 €',
+      '',
+      '== United Kingdom ==',
+      'Gadget Mini             80      £1,075.20',
+      'Premium Support Con…     1     £11,760.00 *',
+      'Subtotal UK: £12,835.20',
+      '',
+      'Rows: 4',
+      'Large orders: 1',
+      '',
+    ].join('\n'),
+  );
+});
+
+test('restricts the report to one month and names it in the title', () => {
