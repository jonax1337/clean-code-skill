+const LARGE_ORDER = 10000;
+const NAME_WIDTH = 20;
+
+// Output order of the sections is the order of this list.
+const REGIONS = {
+  DE: { title: 'Germany', taxRate: 0.19, thousands: '.', decimal: ',', symbol: 'suffix' },
+  FR: { title: 'France', taxRate: 0.2, thousands: ' ', decimal: ',', symbol: 'suffix' },
+  UK: { title: 'United Kingdom', taxRate: 0.2, thousands: ',', decimal: '.', symbol: 'prefix' },
+};
+
+const round2 = (n) => Math.round(n * 100) / 100;
+
+// Splits a string into groups of three from the right and joins them with `sep`.
+function groupThousands(digits, sep) {
+  const groups = [];
+  for (let end = digits.length; end > 0; end -= 3) {
+    groups.unshift(digits.slice(Math.max(0, end - 3), end));
+  }
+  return groups.join(sep);
+}
+
+function joinMoney(sign, integerPart, cents, region) {
+  const { thousands, decimal, symbol } = REGIONS[region];
+  const number = groupThousands(integerPart, thousands) + decimal + cents;
+  return symbol === 'prefix' ? sign + '£' + number : sign + number + ' €';
+}
