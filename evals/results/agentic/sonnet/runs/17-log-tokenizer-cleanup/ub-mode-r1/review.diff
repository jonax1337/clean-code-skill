 impl<'a> Tokens<'a> {
     pub fn new(src: &'a str) -> Self {
-        Tokens { src, pos: 0, st: 0 }
+        Tokens { src, pos: 0, state: State::Item }
+    }
+
+    /// Records the error, skips the rest of the line and returns the error.
+    #[cold]
+    fn fail(&mut self, error: LexError) -> Option<Result<Token<'a>, LexError>> {
+        self.state = State::Failed;
+        self.pos = self.src.len();
+        Some(Err(error))
+    }
+
+    /// Reads a timestamp; `at` is the position of its `[`.
+    fn timestamp(&mut self, at: usize) -> Option<Result<Token<'a>, LexError>> {
+        let b = self.src.as_bytes();
+        let start = at + 1;
+        let mut i = start;
+        loop {
+            match b.get(i) {
+                None => return self.fail(LexError::UnterminatedTimestamp { pos: at }),
+                Some(b']') => break,
+                Some(b'[') => return self.fail(LexError::NestedBracket { pos: i }),
+                Some(_) => i += 1,
+            }
+        }
+        if let Err(error) = require_separator(b, i + 1) {
+            return self.fail(error);
+        }
+        self.pos = i + 1;
+        Some(Ok(Token::Timestamp(&self.src[start..i])))
+    }
+
+    /// Reads a key (when `=` follows) or a word starting at `at`.
+    fn key_or_word(&mut self, at: usize) -> Option<Result<Token<'a>, LexError>> {
+        let b = self.src.as_bytes();
+        let mut i = at;
+        while let Some(&c) = b.get(i) {
+            match c {
+                b' ' | b'\t' | b'=' => break,
+                b'"' => return self.fail(LexError::UnexpectedQuote { pos: i }),
+                _ => i += 1,
+            }
+        }
+        let text = &self.src[at..i];
+        if b.get(i) == Some(&b'=') {
+            self.state = State::Value;
+            self.pos = i + 1;
+            Some(Ok(Token::Key(text)))
+        } else {
+            self.pos = i;
+            Some(Ok(Token::Word(text)))
+        }
+    }
+
+    /// Reads a quoted value; `at` is the position of its opening quote.
+    fn quoted(&mut self, at: usize) -> Option<Result<Token<'a>, LexError>> {
+        let b = self.src.as_bytes();
+        let start = at + 1;
+        let mut i = start;
+        loop {
+            match b.get(i) {
+                None => return self.fail(LexError::UnterminatedQuote { pos: at }),
+                Some(b'"') => break,
+                Some(b'\\') => match b.get(i + 1) {
+                    None => return self.fail(LexError::UnterminatedQuote { pos: at }),
+                    Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                    Some(_) => return self.fail(LexError::InvalidEscape { pos: i }),
+                },
+                Some(_) => i += 1,
+            }
+        }
+        if let Err(error) = require_separator(b, i + 1) {
+            return self.fail(error);
+        }
+        self.state = State::Item;
+        self.pos = i + 1;
+        Some(Ok(Token::Quoted(&self.src[start..i])))
+    }
+
+    /// Reads an unquoted value (possibly empty) starting at `at`.
+    fn bare(&mut self, at: usize) -> Option<Result<Token<'a>, LexError>> {
+        let b = self.src.as_bytes();
+        let mut i = at;
+        while let Some(&c) = b.get(i) {
+            match c {
+                b' ' | b'\t' => break,
+                b'"' => return self.fail(LexError::UnexpectedQuote { pos: i }),
+                _ => i += 1,
+            }
+        }
+        self.state = State::Item;
+        self.pos = i;
+        Some(Ok(Token::Bare(&self.src[at..i])))
+    }
+
+    fn next_item(&mut self) -> Option<Result<Token<'a>, LexError>> {
+        let at = skip_blanks(self.src.as_bytes(), self.pos);
+        self.pos = at;
+        match self.src.as_bytes().get(at)? {
+            b'[' => self.timestamp(at),
+            b'"' => self.fail(LexError::UnexpectedQuote { pos: at }),
+            b'=' => self.fail(LexError::EmptyKey { pos: at }),
+            _ => self.key_or_word(at),
+        }
+    }
+
+    fn next_value(&mut self) -> Option<Result<Token<'a>, LexError>> {
+        let at = self.pos;
+        match self.src.as_bytes().get(at) {
+            Some(b'"') => self.quoted(at),
+            _ => self.bare(at),
+        }
+    }
+}
+
+fn skip_blanks(b: &[u8], mut i: usize) -> usize {
+    while matches!(b.get(i), Some(b' ' | b'\t')) {
+        i += 1;
+    }
+    i
+}
+
+/// A closing delimiter must be followed by a blank or the end of the line.
+fn require_separator(b: &[u8], at: usize) -> Result<(), LexError> {
+    match b.get(at) {
+        None | Some(b' ' | b'\t') => Ok(()),
+        Some(_) => Err(LexError::ExpectedSeparator { pos: at }),
     }
 }
 
