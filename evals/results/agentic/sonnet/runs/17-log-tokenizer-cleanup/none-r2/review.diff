+    /// Records an error: the rest of the line is abandoned.
+    #[cold]
+    fn fail(&mut self, err: LexError) -> Lexed<'a> {
+        self.state = State::Failed;
+        self.pos = self.src.len();
+        Err(err)
+    }
+
+    /// A token must be followed by a blank or the end of the line;
+    /// `end` is the offset just past the token.
+    #[inline(always)]
+    fn check_separator(&self, end: usize) -> Result<(), LexError> {
+        match self.src.as_bytes().get(end) {
+            Some(&c) if !is_blank(c) => Err(LexError::ExpectedSeparator { pos: end }),
+            _ => Ok(()),
+        }
+    }
+
+    /// `[timestamp]`, with `start` at the opening bracket.
+    fn timestamp(&mut self, start: usize) -> Lexed<'a> {
+        let b = self.src.as_bytes();
+        let body = start + 1;
+        let mut i = body;
+        loop {
+            match b.get(i) {
+                None => return self.fail(LexError::UnterminatedTimestamp { pos: start }),
+                Some(b']') => break,
+                Some(b'[') => return self.fail(LexError::NestedBracket { pos: i }),
+                Some(_) => i += 1,
+            }
+        }
+        if let Err(e) = self.check_separator(i + 1) {
+            return self.fail(e);
+        }
+        self.pos = i + 1;
+        Ok(Token::Timestamp(&self.src[body..i]))
+    }
+
+    /// A `key` (when followed by `=`) or a plain word, with `start` at its first byte.
+    fn key_or_word(&mut self, start: usize) -> Lexed<'a> {
+        let b = self.src.as_bytes();
+        let mut i = start;
+        while let Some(&c) = b.get(i) {
+            match c {
+                b' ' | b'\t' | b'=' => break,
+                b'"' => return self.fail(LexError::UnexpectedQuote { pos: i }),
+                _ => i += 1,
+            }
+        }
+        let text = &self.src[start..i];
+        if b.get(i) == Some(&b'=') {
+            self.state = State::Value;
+            self.pos = i + 1;
+            Ok(Token::Key(text))
+        } else {
+            self.pos = i;
+            Ok(Token::Word(text))
+        }
+    }
+
+    /// A `"quoted"` value, with `start` at the opening quote.
+    fn quoted(&mut self, start: usize) -> Lexed<'a> {
+        let b = self.src.as_bytes();
+        let body = start + 1;
+        let mut i = body;
+        loop {
+            match b.get(i) {
+                None => return self.fail(LexError::UnterminatedQuote { pos: start }),
+                Some(b'"') => break,
+                Some(b'\\') => match b.get(i + 1) {
+                    None => return self.fail(LexError::UnterminatedQuote { pos: start }),
+                    Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                    Some(_) => return self.fail(LexError::InvalidEscape { pos: i }),
+                },
+                Some(_) => i += 1,
+            }
+        }
+        if let Err(e) = self.check_separator(i + 1) {
+            return self.fail(e);
+        }
+        self.state = State::Item;
+        self.pos = i + 1;
+        Ok(Token::Quoted(&self.src[body..i]))
+    }
+
+    /// An unquoted value (possibly empty), with `start` at its first byte.
+    fn bare(&mut self, start: usize) -> Lexed<'a> {
+        let b = self.src.as_bytes();
+        let mut i = start;
+        while let Some(&c) = b.get(i) {
+            match c {
+                b' ' | b'\t' => break,
+                b'"' => return self.fail(LexError::UnexpectedQuote { pos: i }),
+                _ => i += 1,
+            }
+        }
+        self.state = State::Item;
+        self.pos = i;
+        Ok(Token::Bare(&self.src[start..i]))
+    }
+
+    /// Next token in the `Item` state.
+    fn item(&mut self) -> Option<Lexed<'a>> {
+        let b = self.src.as_bytes();
+        let mut p = self.pos;
+        while b.get(p).copied().is_some_and(is_blank) {
+            p += 1;
+        }
+        let Some(&c) = b.get(p) else {
+            self.pos = p;
+            return None;
+        };
+        Some(match c {
+            b'[' => self.timestamp(p),
+            b'"' => self.fail(LexError::UnexpectedQuote { pos: p }),
+            b'=' => self.fail(LexError::EmptyKey { pos: p }),
+            _ => self.key_or_word(p),
+        })
+    }
+
+    /// Next token in the `Value` state.
+    fn value(&mut self) -> Lexed<'a> {
+        let p = self.pos;
+        match self.src.as_bytes().get(p) {
+            Some(b'"') => self.quoted(p),
+            _ => self.bare(p),
+        }
     }
 }
 
