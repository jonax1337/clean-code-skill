+/// Where the tokenizer is in the `key=value` grammar.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum State {
+    /// Between tokens: expecting a timestamp, a key or a word.
+    Item,
+    /// Just after `key=`: expecting a quoted or bare value.
+    Value,
+    /// An error was reported; nothing more is produced.
+    Failed,
