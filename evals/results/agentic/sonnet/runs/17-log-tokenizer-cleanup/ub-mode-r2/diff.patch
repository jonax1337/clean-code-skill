+    /// Stop for good and report `err`.
+    #[inline(always)]
+    fn fail(&mut self, err: LexError) -> Step<'a> {
+        self.state = State::Done;
+        self.pos = self.src.len();
+        Some(Err(err))
+    }
+
+    /// Move to `state` at `pos` and yield `token`.
+    #[inline(always)]
+    fn emit(&mut self, state: State, pos: usize, token: Token<'a>) -> Step<'a> {
+        self.state = state;
+        self.pos = pos;
+        Some(Ok(token))
+    }
+
+    /// `p` is at `[`.
+    #[inline(always)]
+    fn timestamp(&mut self, p: usize) -> Step<'a> {
+        let b = self.src.as_bytes();
+        let n = b.len();
+        let s = p + 1;
+        let mut i = s;
+        loop {
+            if i >= n {
+                return self.fail(LexError::UnterminatedTimestamp { pos: p });
+            }
+            match b[i] {
+                b']' => break,
+                b'[' => return self.fail(LexError::NestedBracket { pos: i }),
+                _ => i += 1,
+            }
+        }
+        if i + 1 < n && !is_blank(b[i + 1]) {
+            return self.fail(LexError::ExpectedSeparator { pos: i + 1 });
+        }
+        self.emit(State::Start, i + 1, Token::Timestamp(&self.src[s..i]))
+    }
+
+    /// `p` is at the first byte of a key or word.
+    #[inline(always)]
+    fn key_or_word(&mut self, p: usize) -> Step<'a> {
+        let b = self.src.as_bytes();
+        let n = b.len();
+        let mut i = p;
+        while i < n && !is_blank(b[i]) && b[i] != b'=' {
+            if b[i] == b'"' {
+                return self.fail(LexError::UnexpectedQuote { pos: i });
+            }
+            i += 1;
+        }
+        if i < n && b[i] == b'=' {
+            self.emit(State::Value, i + 1, Token::Key(&self.src[p..i]))
+        } else {
+            self.emit(State::Start, i, Token::Word(&self.src[p..i]))
+        }
+    }
+
+    /// `p` is at the opening `"`.
+    #[inline(always)]
+    fn quoted(&mut self, p: usize) -> Step<'a> {
+        let b = self.src.as_bytes();
+        let n = b.len();
+        let s = p + 1;
+        let mut i = s;
+        loop {
+            if i >= n {
+                return self.fail(LexError::UnterminatedQuote { pos: p });
+            }
+            match b[i] {
+                b'"' => break,
+                b'\\' => {
+                    if i + 1 >= n {
+                        return self.fail(LexError::UnterminatedQuote { pos: p });
+                    }
+                    match b[i + 1] {
+                        b'"' | b'\\' | b'n' | b't' => i += 2,
+                        _ => return self.fail(LexError::InvalidEscape { pos: i }),
+                    }
+                }
+                _ => i += 1,
+            }
+        }
+        if i + 1 < n && !is_blank(b[i + 1]) {
+            return self.fail(LexError::ExpectedSeparator { pos: i + 1 });
+        }
+        self.emit(State::Start, i + 1, Token::Quoted(&self.src[s..i]))
+    }
+
+    /// `p` is at the first byte of an unquoted value (possibly empty).
+    #[inline(always)]
+    fn bare(&mut self, p: usize) -> Step<'a> {
+        let b = self.src.as_bytes();
+        let n = b.len();
+        let mut i = p;
+        while i < n && !is_blank(b[i]) {
+            if b[i] == b'"' {
+                return self.fail(LexError::UnexpectedQuote { pos: i });
+            }
+            i += 1;
+        }
+        self.emit(State::Start, i, Token::Bare(&self.src[p..i]))
     }
 }
 
+#[inline(always)]
+fn is_blank(c: u8) -> bool {
+    c == b' ' || c == b'\t'
+}
