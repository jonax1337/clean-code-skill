+#[inline]
+fn is_blank(byte: u8) -> bool {
+    byte == b' ' || byte == b'\t'
+}
+
+fn skip_blanks(bytes: &[u8], mut pos: usize) -> usize {
+    while pos < bytes.len() && is_blank(bytes[pos]) {
+        pos += 1;
+    }
+    pos
+}
+
+/// Fails unless a blank or the end of the line follows the token that ended at `end - 1`.
+#[inline]
+fn expect_separator(bytes: &[u8], end: usize) -> Result<(), LexError> {
+    match bytes.get(end) {
+        Some(&b) if !is_blank(b) => Err(LexError::ExpectedSeparator { pos: end }),
+        _ => Ok(()),
+    }
+}
+
+/// Scans a timestamp, key, or word starting at the non-blank byte `pos`.
+fn scan_field(src: &str, pos: usize) -> Scan<'_> {
+    match src.as_bytes()[pos] {
+        b'[' => scan_timestamp(src, pos),
+        b'"' => Err(LexError::UnexpectedQuote { pos }),
+        b'=' => Err(LexError::EmptyKey { pos }),
+        _ => scan_key_or_word(src, pos),
+    }
+}
+
+fn scan_timestamp(src: &str, open: usize) -> Scan<'_> {
+    let bytes = src.as_bytes();
+    let start = open + 1;
+    let mut i = start;
+    loop {
+        match bytes.get(i) {
+            None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+            Some(b']') => break,
+            Some(b'[') => return Err(LexError::NestedBracket { pos: i }),
+            Some(_) => i += 1,
+        }
+    }
+    expect_separator(bytes, i + 1)?;
+    Ok((Token::Timestamp(&src[start..i]), i + 1))
+}
+
+fn scan_key_or_word(src: &str, start: usize) -> Scan<'_> {
+    let bytes = src.as_bytes();
+    let mut i = start;
+    while i < bytes.len() && !is_blank(bytes[i]) && bytes[i] != b'=' {
+        if bytes[i] == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: i });
+        }
+        i += 1;
+    }
+    if i < bytes.len() && bytes[i] == b'=' {
+        Ok((Token::Key(&src[start..i]), i + 1))
+    } else {
+        Ok((Token::Word(&src[start..i]), i))
+    }
+}
+
+/// Scans the value after a key's `=`; `pos` may be at the end of the line.
+fn scan_value(src: &str, pos: usize) -> Scan<'_> {
+    match src.as_bytes().get(pos) {
+        None => Ok((Token::Bare(&src[pos..pos]), pos)),
+        Some(&b) if is_blank(b) => Ok((Token::Bare(&src[pos..pos]), pos)),
+        Some(b'"') => scan_quoted(src, pos),
+        Some(_) => scan_bare(src, pos),
+    }
+}
+
+fn scan_quoted(src: &str, open: usize) -> Scan<'_> {
+    let bytes = src.as_bytes();
+    let start = open + 1;
+    let mut i = start;
+    loop {
+        match bytes.get(i) {
+            None => return Err(LexError::UnterminatedQuote { pos: open }),
+            Some(b'"') => break,
+            Some(b'\\') => match bytes.get(i + 1) {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                Some(_) => return Err(LexError::InvalidEscape { pos: i }),
+            },
+            Some(_) => i += 1,
+        }
+    }
+    expect_separator(bytes, i + 1)?;
+    Ok((Token::Quoted(&src[start..i]), i + 1))
+}
+
+fn scan_bare(src: &str, start: usize) -> Scan<'_> {
+    let bytes = src.as_bytes();
+    let mut i = start;
+    while i < bytes.len() && !is_blank(bytes[i]) {
+        if bytes[i] == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: i });
         }
+        i += 1;
     }
+    Ok((Token::Bare(&src[start..i]), i))
 }
