+// The scanners below run once per token on multi-gigabyte inputs. `#[inline(always)]` keeps them as fast as the
+// single-function tokenizer they replaced: without it the import ran up to ~15% slower on word-heavy lines.
+
+/// Offset of the `]` that closes the timestamp opened at `open`; a separator or the line's end must follow it.
+#[inline(always)]
+fn scan_timestamp(bytes: &[u8], open: usize) -> Result<usize, LexError> {
+    let mut close = open + 1;
+    loop {
+        match bytes.get(close) {
+            None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+            Some(b']') => break,
+            Some(b'[') => return Err(LexError::NestedBracket { pos: close }),
+            Some(_) => close += 1,
+        }
+    }
+    expect_separator_after(bytes, close)?;
+    Ok(close)
+}
+
+/// End offset of the text that starts at `start` and runs up to a separator or a `=`.
+#[inline(always)]
+fn scan_name(bytes: &[u8], start: usize) -> Result<usize, LexError> {
+    let mut end = start;
+    while let Some(&byte) = bytes.get(end) {
+        if is_separator(byte) || byte == b'=' {
+            break;
+        }
+        if byte == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: end });
+        }
+        end += 1;
+    }
+    Ok(end)
+}
+
+/// Offset of the `"` that closes the quoted value opened at `open`; a separator or the line's end must follow it.
+#[inline(always)]
+fn scan_quoted(bytes: &[u8], open: usize) -> Result<usize, LexError> {
+    let mut close = open + 1;
+    loop {
+        match bytes.get(close) {
+            None => return Err(LexError::UnterminatedQuote { pos: open }),
+            Some(b'"') => break,
+            Some(b'\\') => match bytes.get(close + 1) {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"' | b'\\' | b'n' | b't') => close += 2,
+                Some(_) => return Err(LexError::InvalidEscape { pos: close }),
+            },
+            Some(_) => close += 1,
+        }
+    }
+    expect_separator_after(bytes, close)?;
+    Ok(close)
+}
+
+/// End offset of the unquoted value that starts at `start`.
+#[inline(always)]
+fn scan_bare(bytes: &[u8], start: usize) -> Result<usize, LexError> {
+    let mut end = start;
+    while let Some(&byte) = bytes.get(end) {
+        if is_separator(byte) {
+            break;
+        }
+        if byte == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: end });
+        }
+        end += 1;
+    }
+    Ok(end)
+}
+
+#[inline(always)]
+fn expect_separator_after(bytes: &[u8], close: usize) -> Result<(), LexError> {
+    let after = close + 1;
+    match bytes.get(after) {
+        Some(&byte) if !is_separator(byte) => Err(LexError::ExpectedSeparator { pos: after }),
+        _ => Ok(()),
+    }
+}
+
+#[inline(always)]
+fn is_separator(byte: u8) -> bool {
+    byte == b' ' || byte == b'\t'
+}
+
+#[inline(always)]
+fn skip_separators(bytes: &[u8], from: usize) -> usize {
+    let mut pos = from;
+    while bytes.get(pos).is_some_and(|&byte| is_separator(byte)) {
+        pos += 1;
+    }
+    pos
+}
