+                    self.state = State::Value;
+                    self.pos = end + 1;
+                    Token::Key(&src[start..end])
+                } else {
+                    self.pos = end;
+                    Token::Word(&src[start..end])
+                }
+            }
+        };
+        Ok(Some(token))
+    }
+
+    /// Reads the value after a key: quoted, bare, or empty.
+    fn read_value(&mut self) -> Result<Token<'a>, LexError> {
+        let src = self.src;
+        let bytes = src.as_bytes();
+        let start = self.pos;
+        self.state = State::Field;
+        match bytes.get(start) {
+            Some(b'"') => {
+                let close = scan_quoted(bytes, start)?;
+                self.pos = close + 1;
+                Ok(Token::Quoted(&src[start + 1..close]))
+            }
+            Some(&byte) if !is_separator(byte) => {
+                let end = scan_bare(bytes, start)?;
+                self.pos = end;
+                Ok(Token::Bare(&src[start..end]))
+            }
+            _ => Ok(Token::Bare("")),
+        }
     }
 }
 
