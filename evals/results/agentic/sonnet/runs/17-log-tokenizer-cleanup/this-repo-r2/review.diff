+impl Tokens<'_> {
+    /// Ends the token stream; the rest of the line is not read.
+    #[cold]
+    fn fail(&mut self, error: LexError) -> LexError {
+        self.state = State::Failed;
+        self.pos = self.src.len();
+        error
+    }
+}
