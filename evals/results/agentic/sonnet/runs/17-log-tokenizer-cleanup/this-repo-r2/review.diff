+    /// Reads a timestamp, key or word; `Ok(None)` when only separators remain.
+    fn read_field(&mut self) -> Result<Option<Token<'a>>, LexError> {
+        let src = self.src;
+        let bytes = src.as_bytes();
+        let start = skip_separators(bytes, self.pos);
+        let token = match bytes.get(start) {
+            None => return Ok(None),
+            Some(b'[') => {
+                let close = scan_timestamp(bytes, start)?;
+                self.pos = close + 1;
+                Token::Timestamp(&src[start + 1..close])
+            }
+            Some(b'"') => return Err(LexError::UnexpectedQuote { pos: start }),
+            Some(b'=') => return Err(LexError::EmptyKey { pos: start }),
+            Some(_) => {
