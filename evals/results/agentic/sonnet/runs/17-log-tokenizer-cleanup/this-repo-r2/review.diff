--- a/tests/tokens.rs
+++ b/tests/tokens.rs
@@ -68,8 +68,106 @@ fn unterminated_timestamp_is_an_error() {
 
 #[test]
 fn iteration_stops_after_an_error() {
     let mut stream = tokenize("ok =bad later=1");
     assert_eq!(stream.next(), Some(Ok(Token::Word("ok"))));
     assert_eq!(stream.next(), Some(Err(LexError::EmptyKey { pos: 3 })));
     assert_eq!(stream.next(), None);
 }
+
+#[test]
+fn timestamps_may_be_empty_and_follow_each_other() {
+    assert_eq!(
+        tokens("[] [a]\t[b]").unwrap(),
+        vec![Token::Timestamp(""), Token::Timestamp("a"), Token::Timestamp("b")]
+    );
+}
+
+#[test]
+fn timestamp_must_be_followed_by_a_separator() {
+    assert_eq!(tokens("[a]b"), Err(LexError::ExpectedSeparator { pos: 3 }));
+}
+
+#[test]
+fn timestamp_cannot_contain_an_opening_bracket() {
+    assert_eq!(tokens("[a[b]"), Err(LexError::NestedBracket { pos: 2 }));
+}
+
+#[test]
+fn quote_at_the_start_of_a_token_is_an_error() {
+    assert_eq!(tokens("\"x\""), Err(LexError::UnexpectedQuote { pos: 0 }));
+}
+
+#[test]
+fn quote_inside_a_word_is_an_error() {
+    assert_eq!(tokens("ab\"c"), Err(LexError::UnexpectedQuote { pos: 2 }));
+}
+
+#[test]
+fn quote_inside_a_bare_value_is_an_error() {
+    assert_eq!(tokens("k=v\"w"), Err(LexError::UnexpectedQuote { pos: 3 }));
+}
+
+#[test]
+fn missing_key_is_an_error() {
+    assert_eq!(tokens("=x"), Err(LexError::EmptyKey { pos: 0 }));
+}
+
+#[test]
+fn empty_bare_values_end_at_a_separator_or_the_end_of_the_line() {
+    assert_eq!(tokens("k=").unwrap(), vec![Token::Key("k"), Token::Bare("")]);
+    assert_eq!(
+        tokens("k= x").unwrap(),
+        vec![Token::Key("k"), Token::Bare(""), Token::Word("x")]
+    );
+}
+
+#[test]
+fn bare_values_may_contain_equals_signs() {
+    assert_eq!(tokens("a=b=c").unwrap(), vec![Token::Key("a"), Token::Bare("b=c")]);
+}
+
+#[test]
+fn quoted_values_may_be_empty_or_end_in_an_escaped_backslash() {
+    assert_eq!(tokens("k=\"\"").unwrap(), vec![Token::Key("k"), Token::Quoted("")]);
+    assert_eq!(
+        tokens(r#"k="a\\" next"#).unwrap(),
+        vec![Token::Key("k"), Token::Quoted(r"a\\"), Token::Word("next")]
+    );
+}
+
+#[test]
+fn quoted_value_must_be_followed_by_a_separator() {
+    assert_eq!(tokens("k=\"a\"b"), Err(LexError::ExpectedSeparator { pos: 5 }));
+}
+
+#[test]
+fn unknown_escape_is_an_error() {
+    assert_eq!(tokens(r#"k="a\q""#), Err(LexError::InvalidEscape { pos: 4 }));
+}
+
+#[test]
+fn escape_at_the_end_of_the_line_leaves_the_quote_unterminated() {
+    assert_eq!(tokens(r#"k="a\"#), Err(LexError::UnterminatedQuote { pos: 2 }));
+    assert_eq!(tokens(r#"k="a\""#), Err(LexError::UnterminatedQuote { pos: 2 }));
+}
+
+#[test]
+fn error_positions_are_byte_offsets_in_multibyte_lines() {
+    assert_eq!(
