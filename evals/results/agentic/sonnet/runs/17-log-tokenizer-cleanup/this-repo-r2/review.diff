+}
+
+#[test]
+fn nothing_is_yielded_after_the_first_error_of_a_value() {
+    let mut stream = tokenize(r#"k="a\q" later=1"#);
+    assert_eq!(stream.next(), Some(Ok(Token::Key("k"))));
+    assert_eq!(stream.next(), Some(Err(LexError::InvalidEscape { pos: 4 })));
