@@ -84,8 +84,77 @@ def test_wait_for_label_gives_up_when_the_label_never_arrives(make_client):
 
 def test_error_status_raises_api_error_with_the_status(make_client):
     transport = FakeTransport(reply(404, {"error": "no such shipment"}))
 
     with pytest.raises(ApiError) as raised:
         make_client(transport).get_shipment("sh-404")
 
     assert raised.value.status == 404
+
+
+@pytest.mark.parametrize("failure", [RequestTimeout("timed out"), ConnectionFailed("reset"), reply(502), reply(503), reply(504)])
+def test_get_retries_transient_failures_with_backoff(make_client, sleeps, failure):
+    transport = FakeTransport(failure, failure, reply(200, shipment_payload("sh-7")))
+
+    shipment = make_client(transport).get_shipment("sh-7")
+
+    assert shipment.id == "sh-7"
+    assert len(transport.requests) == 3
+    assert sleeps == [5.0, 10.0]
+
+
+def test_retries_outlast_an_outage_of_a_minute(make_client, sleeps):
+    transport = FakeTransport(reply(503))
+
+    with pytest.raises(ApiError) as raised:
+        make_client(transport).get_shipment("sh-1")
+
+    assert raised.value.status == 503
+    assert len(transport.requests) == RETRY_ATTEMPTS
+    assert sum(sleeps) >= 60
+
+
+def test_gives_up_with_the_transport_error_after_the_last_attempt(make_client):
+    transport = FakeTransport(RequestTimeout("timed out"))
+
+    with pytest.raises(RequestTimeout):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == RETRY_ATTEMPTS
+
+
+@pytest.mark.parametrize("status", [400, 404, 500])
+def test_other_error_statuses_are_not_retried(make_client, sleeps, status):
+    transport = FakeTransport(reply(status))
+
+    with pytest.raises(ApiError):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == 1
+    assert sleeps == []
+
+
+def test_create_shipment_with_a_key_is_retried_with_the_same_key(make_client):
+    transport = FakeTransport(RequestTimeout("timed out"), reply(201, shipment_payload()))
+
+    make_client(transport).create_shipment("A-1001", ADDRESS, idempotency_key="order-A-1001")
+
+    assert [r.headers["Idempotency-Key"] for r in transport.requests] == ["order-A-1001"] * 2
+
+
+def test_create_shipment_without_a_key_is_not_retried(make_client):
+    transport = FakeTransport(RequestTimeout("timed out"), reply(201, shipment_payload()))
+
+    with pytest.raises(RequestTimeout):
+        make_client(transport).create_shipment("A-1001", ADDRESS)
+
+    assert len(transport.requests) == 1
+
+
+@pytest.mark.parametrize("failure", [RequestTimeout("timed out"), ConnectionFailed("reset"), reply(503)])
+def test_request_pickup_is_never_retried(make_client, failure):
+    transport = FakeTransport(failure, reply(201, {"id": "pk-1"}))
+
+    with pytest.raises((RequestTimeout, ConnectionFailed, ApiError)):
+        make_client(transport).request_pickup(date(2026, 3, 2), ["sh-1"])
+
+    assert len(transport.requests) == 1
