-from shipsync.errors import ApiError, LabelNotReady
+from shipsync.errors import ApiError, LabelNotReady, TransportError
 from shipsync.models import Address, Shipment
 from shipsync.transport import Request, Response, Transport
 
 DEFAULT_BASE_URL = "https://api.carrier.example/v2"
 LABEL_POLL_ATTEMPTS = 5
 LABEL_POLL_INTERVAL_S = 2.0
+# Backoff 5 + 10 + 20 + 40 s = 75 s of waiting, enough to outlast a carrier outage of about a minute.
+RETRY_ATTEMPTS = 5
+RETRY_BASE_DELAY_S = 5.0
+RETRYABLE_STATUSES = frozenset({502, 503, 504})
 
 
 class ShippingClient:
     def __init__(
         self,
         transport: Transport,
         api_key: str,
         base_url: str = DEFAULT_BASE_URL,
@@ -64,12 +68,36 @@ class ShippingClient:
         headers: dict[str, str] | None = None,
     ) -> Response:
         request = Request(
             method,
             self._base_url + path,
             {"Authorization": f"Bearer {self._api_key}", **(headers or {})},
             json.dumps(payload).encode() if payload is not None else None,
         )
-        response = self._transport.send(request)
+        response = self._send_with_retries(request)
         if response.status >= 400:
             raise ApiError(response.status, response.body.decode(errors="replace"))
         return response
+
+    def _send_with_retries(self, request: Request) -> Response:
+        """Retry timeouts, connection failures and gateway errors, but only for requests that are safe to repeat.
+
+        A request that timed out may still have been processed, so repeating a POST without an
+        Idempotency-Key (the pickup booking) could book twice. Those are sent exactly once.
+        """
+        attempts = RETRY_ATTEMPTS if _is_safe_to_repeat(request) else 1
+        for attempt in range(1, attempts + 1):
+            is_last_attempt = attempt == attempts
+            try:
+                response = self._transport.send(request)
+            except TransportError:
+                if is_last_attempt:
+                    raise
+            else:
+                if response.status not in RETRYABLE_STATUSES or is_last_attempt:
+                    return response
+            self._sleep(RETRY_BASE_DELAY_S * 2 ** (attempt - 1))
+        raise AssertionError("unreachable: the last attempt returns or raises")
+
+
+def _is_safe_to_repeat(request: Request) -> bool:
+    return request.method == "GET" or "Idempotency-Key" in request.headers
