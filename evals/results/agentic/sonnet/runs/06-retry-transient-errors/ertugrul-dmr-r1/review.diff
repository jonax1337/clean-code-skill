+def test_get_is_retried_after_a_transient_failure(make_client, sleeps, failure):
+    transport = FakeTransport(failure, reply(200, shipment_payload("sh-7")))
+
+    shipment = make_client(transport).get_shipment("sh-7")
+
+    assert shipment.id == "sh-7"
+    assert len(transport.requests) == 2
