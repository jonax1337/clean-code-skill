+    def _send_with_retries(self, request: Request) -> Response:
+        """Retry transient failures, but only for requests that are safe to repeat."""
+        retryable = _is_safe_to_repeat(request)
+        delay_s = RETRY_INITIAL_DELAY_S
+        for attempt in range(1, MAX_ATTEMPTS + 1):
+            is_last_attempt = attempt == MAX_ATTEMPTS
+            try:
+                response = self._transport.send(request)
+            except TransportError:
+                if not retryable or is_last_attempt:
+                    raise
+            else:
+                if response.status not in RETRYABLE_STATUSES or not retryable or is_last_attempt:
+                    return response
+            self._sleep(delay_s)
+            delay_s = min(delay_s * 2, RETRY_MAX_DELAY_S)
+        raise AssertionError("unreachable: the last attempt returns or raises")
+
+
+def _is_safe_to_repeat(request: Request) -> bool:
+    """A repeated POST could create a duplicate, unless the carrier dedupes it by idempotency key."""
+    return request.method == "GET" or "Idempotency-Key" in request.headers
