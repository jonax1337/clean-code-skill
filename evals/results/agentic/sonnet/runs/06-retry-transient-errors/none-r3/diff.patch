+def test_get_retries_transport_errors_and_bad_gateway(make_client, sleeps):
+    transport = FakeTransport(
+        RequestTimeout("slow"), ConnectionFailed("reset"), reply(503), reply(200, shipment_payload())
+    )
+
+    shipment = make_client(transport).get_shipment("sh-1")
+
+    assert shipment.id == "sh-1"
+    assert len(transport.requests) == 4
+    assert sleeps == [1.0, 2.0, 4.0]
+
+
+def test_retries_stop_after_max_attempts(make_client):
+    transport = FakeTransport(reply(502))
+
+    with pytest.raises(ApiError) as raised:
+        make_client(transport).get_shipment("sh-1")
+
+    assert raised.value.status == 502
+    assert len(transport.requests) == MAX_ATTEMPTS
+
+
+def test_persistent_transport_error_is_raised_after_max_attempts(make_client):
+    transport = FakeTransport(ConnectionFailed("reset"))
+
+    with pytest.raises(ConnectionFailed):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == MAX_ATTEMPTS
+
+
+def test_client_errors_are_not_retried(make_client):
+    transport = FakeTransport(reply(404))
+
+    with pytest.raises(ApiError):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == 1
+
+
+def test_create_shipment_with_key_is_retried(make_client):
+    transport = FakeTransport(RequestTimeout("slow"), reply(201, shipment_payload()))
+
+    make_client(transport).create_shipment("A-1001", ADDRESS, idempotency_key="order-A-1001")
+
+    assert len(transport.requests) == 2
+
+
+def test_create_shipment_without_key_is_not_retried(make_client):
