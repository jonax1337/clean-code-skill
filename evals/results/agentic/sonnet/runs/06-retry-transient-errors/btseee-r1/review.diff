     def _request(
         self,
         method: str,
         path: str,
         payload: dict[str, Any] | None = None,
         headers: dict[str, str] | None = None,
+        *,
+        retry: bool | None = None,
     ) -> Response:
+        """Send a request, retrying transient failures when that cannot duplicate anything.
+
+        Retries default to on for GET only. A POST passes retry=True when the carrier
+        deduplicates it (Idempotency-Key); otherwise a lost response could repeat the action.
+        """
         request = Request(
             method,
             self._base_url + path,
             {"Authorization": f"Bearer {self._api_key}", **(headers or {})},
             json.dumps(payload).encode() if payload is not None else None,
         )
-        response = self._transport.send(request)
-        if response.status >= 400:
-            raise ApiError(response.status, response.body.decode(errors="replace"))
-        return response
+        attempts = MAX_ATTEMPTS if (method == "GET" if retry is None else retry) else 1
+        for attempt in range(1, attempts + 1):
+            try:
+                response = self._transport.send(request)
+                if response.status >= 400:
+                    raise ApiError(response.status, response.body.decode(errors="replace"))
+                return response
+            except (TransportError, ApiError) as error:
+                if attempt == attempts or not _is_transient(error):
+                    raise
+                self._sleep(RETRY_BACKOFF_S[attempt - 1])
+        raise AssertionError("unreachable")
+
+
+def _is_transient(error: Exception) -> bool:
+    if isinstance(error, ApiError):
+        return error.status in RETRYABLE_STATUSES
+    return isinstance(error, TransportError)
