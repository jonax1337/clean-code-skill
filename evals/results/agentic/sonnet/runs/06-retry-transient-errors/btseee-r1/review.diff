+@pytest.mark.parametrize("failure", [RequestTimeout("slow"), ConnectionFailed("reset"), reply(502), reply(503)])
+def test_get_retries_transient_failures(make_client, sleeps, failure):
+    transport = FakeTransport(failure, failure, reply(200, shipment_payload()))
+
+    shipment = make_client(transport).get_shipment("sh-1")
+
+    assert shipment.id == "sh-1"
+    assert len(transport.requests) == 3
+    assert sleeps == list(RETRY_BACKOFF_S[:2])
+
+
+def test_get_gives_up_after_max_attempts_and_raises_the_last_error(make_client, sleeps):
+    transport = FakeTransport(reply(503))
+
+    with pytest.raises(ApiError) as raised:
+        make_client(transport).get_shipment("sh-1")
+
+    assert raised.value.status == 503
+    assert len(transport.requests) == MAX_ATTEMPTS
+    assert sleeps == list(RETRY_BACKOFF_S)
+
+
+@pytest.mark.parametrize("status", [400, 404, 500])
+def test_non_transient_statuses_are_not_retried(make_client, status):
+    transport = FakeTransport(reply(status))
+
+    with pytest.raises(ApiError):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == 1
+
+
