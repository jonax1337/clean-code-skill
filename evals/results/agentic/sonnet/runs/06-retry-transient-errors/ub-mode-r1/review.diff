+@pytest.mark.parametrize(
+    "failure", [RequestTimeout("slow"), ConnectionFailed("reset"), reply(502), reply(503)]
+)
+def test_get_retries_transient_failures_with_backoff(make_client, sleeps, failure):
+    transport = FakeTransport(failure, failure, reply(200, shipment_payload("sh-9")))
+
+    shipment = make_client(transport).get_shipment("sh-9")
+
+    assert shipment.id == "sh-9"
+    assert len(transport.requests) == 3
+    assert sleeps == [RETRY_BACKOFF_S, RETRY_BACKOFF_S * 2]
+
+
+def test_retries_give_up_and_raise_the_last_failure(make_client):
+    transport = FakeTransport(reply(503))
+
+    with pytest.raises(ApiError) as raised:
+        make_client(transport).get_shipment("sh-1")
+
+    assert raised.value.status == 503
+    assert len(transport.requests) == MAX_ATTEMPTS
+
+
+def test_retries_give_up_on_a_persistent_transport_error(make_client):
+    transport = FakeTransport(RequestTimeout("slow"))
+
+    with pytest.raises(RequestTimeout):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == MAX_ATTEMPTS
+
+
+def test_client_errors_are_not_retried(make_client):
+    transport = FakeTransport(reply(404), reply(200, shipment_payload()))
+
+    with pytest.raises(ApiError):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == 1
+
+
+def test_create_with_an_idempotency_key_is_retried(make_client):
+    transport = FakeTransport(ConnectionFailed("reset"), reply(201, shipment_payload()))
+
+    make_client(transport).create_shipment("A-1001", ADDRESS, idempotency_key="order-A-1001")
+
+    assert len(transport.requests) == 2
+
+
+def test_create_without_a_key_is_not_retried(make_client):
+    transport = FakeTransport(ConnectionFailed("reset"), reply(201, shipment_payload()))
+
+    with pytest.raises(ConnectionFailed):
+        make_client(transport).create_shipment("A-1001", ADDRESS)
+
+    assert len(transport.requests) == 1
