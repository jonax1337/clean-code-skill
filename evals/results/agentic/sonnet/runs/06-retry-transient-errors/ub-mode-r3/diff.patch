@@ -84,8 +84,75 @@ def test_wait_for_label_gives_up_when_the_label_never_arrives(make_client):
 
 def test_error_status_raises_api_error_with_the_status(make_client):
     transport = FakeTransport(reply(404, {"error": "no such shipment"}))
 
     with pytest.raises(ApiError) as raised:
         make_client(transport).get_shipment("sh-404")
 
     assert raised.value.status == 404
+
+
+@pytest.mark.parametrize("failure", [RequestTimeout("t"), ConnectionFailed("reset"), reply(502), reply(503)])
+def test_get_retries_transient_failures(make_client, sleeps, failure):
+    transport = FakeTransport(failure, failure, reply(200, shipment_payload()))
+
+    shipment = make_client(transport).get_shipment("sh-1")
+
+    assert shipment.id == "sh-1"
+    assert len(transport.requests) == 3
+    assert len(sleeps) == 2 and sleeps[1] > sleeps[0]
+
+
+def test_retries_give_up_and_raise_the_last_error(make_client):
+    transport = FakeTransport(reply(503))
+
+    with pytest.raises(ApiError) as caught:
+        make_client(transport).get_shipment("sh-1")
+
+    assert caught.value.status == 503
+    assert len(transport.requests) == MAX_ATTEMPTS
+
+
+def test_transport_failure_is_raised_after_the_last_attempt(make_client):
+    transport = FakeTransport(RequestTimeout("t"))
+
+    with pytest.raises(RequestTimeout):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == MAX_ATTEMPTS
+
+
+@pytest.mark.parametrize("status", [400, 404, 500])
+def test_other_errors_are_not_retried(make_client, status):
+    transport = FakeTransport(reply(status))
+
+    with pytest.raises(ApiError):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == 1
+
+
+def test_create_shipment_with_a_key_is_retried(make_client):
+    transport = FakeTransport(RequestTimeout("t"), reply(201, shipment_payload()))
+
+    make_client(transport).create_shipment("A-1", ADDRESS, idempotency_key="order-A-1")
+
+    assert len(transport.requests) == 2
+
+
+def test_create_shipment_without_a_key_is_not_retried(make_client):
+    transport = FakeTransport(RequestTimeout("t"), reply(201, shipment_payload()))
+
+    with pytest.raises(RequestTimeout):
+        make_client(transport).create_shipment("A-1", ADDRESS)
+
+    assert len(transport.requests) == 1
+
+
+@pytest.mark.parametrize("failure", [RequestTimeout("t"), reply(502), reply(503)])
+def test_request_pickup_is_never_retried(make_client, failure):
+    transport = FakeTransport(failure, reply(200, {"id": "pk-1"}))
+
+    with pytest.raises((RequestTimeout, ApiError)):
+        make_client(transport).request_pickup(date(2026, 1, 2), ["sh-1"])
+
+    assert len(transport.requests) == 1
