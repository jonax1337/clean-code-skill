+@pytest.mark.parametrize("failure", [RequestTimeout("slow"), ConnectionFailed("reset"), reply(502), reply(503)])
+def test_get_is_retried_after_a_transient_failure(make_client, sleeps, failure):
+    transport = FakeTransport(failure, reply(200, shipment_payload("sh-2")))
+
+    shipment = make_client(transport).get_shipment("sh-2")
+
+    assert shipment.id == "sh-2"
+    assert len(transport.requests) == 2
+    assert sleeps == [RETRY_BASE_DELAY_S]
+
+
+def test_retries_back_off_exponentially_then_give_up(make_client, sleeps):
+    transport = FakeTransport(reply(503))
+
+    with pytest.raises(ApiError) as raised:
+        make_client(transport).get_shipment("sh-1")
+
+    assert raised.value.status == 503
+    assert len(transport.requests) == MAX_REQUEST_ATTEMPTS
+    assert sleeps == [RETRY_BASE_DELAY_S * 2**n for n in range(MAX_REQUEST_ATTEMPTS - 1)]
+
+
+def test_persistent_transport_error_is_raised_after_the_last_attempt(make_client):
+    transport = FakeTransport(RequestTimeout("slow"))
+
+    with pytest.raises(RequestTimeout):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == MAX_REQUEST_ATTEMPTS
+
+
+def test_client_errors_are_not_retried(make_client, sleeps):
+    transport = FakeTransport(reply(404))
+
+    with pytest.raises(ApiError):
+        make_client(transport).get_shipment("sh-404")
+
+    assert len(transport.requests) == 1
+    assert sleeps == []
+
+
+def test_create_shipment_with_a_key_is_retried(make_client):
+    transport = FakeTransport(ConnectionFailed("reset"), reply(201, shipment_payload()))
+
+    make_client(transport).create_shipment("A-1001", ADDRESS, idempotency_key="order-A-1001")
+
+    assert len(transport.requests) == 2
+
+
+def test_create_shipment_without_a_key_is_not_retried(make_client):
+    transport = FakeTransport(ConnectionFailed("reset"), reply(201, shipment_payload()))
+
+    with pytest.raises(ConnectionFailed):
+        make_client(transport).create_shipment("A-1001", ADDRESS)
+
+    assert len(transport.requests) == 1
+
+
