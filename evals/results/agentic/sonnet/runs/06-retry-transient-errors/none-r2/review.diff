     def wait_for_label(self, shipment_id: str) -> str:
         for _ in range(LABEL_POLL_ATTEMPTS):
             response = self._request("GET", f"/shipments/{shipment_id}/label")
             if response.status == 200:
                 return response.json()["url"]
             self._sleep(LABEL_POLL_INTERVAL_S)
         raise LabelNotReady(shipment_id)
 
     def _request(
         self,
         method: str,
         path: str,
         payload: dict[str, Any] | None = None,
         headers: dict[str, str] | None = None,
+        *,
+        retry: bool = True,
     ) -> Response:
+        """Send a request, retrying transient failures with exponential backoff.
+
+        Pass retry=False for calls that are not safe to repeat (no idempotency key): a timeout or
+        502/503 may mean the carrier already acted on the request.
+        """
         request = Request(
             method,
             self._base_url + path,
             {"Authorization": f"Bearer {self._api_key}", **(headers or {})},
             json.dumps(payload).encode() if payload is not None else None,
         )
-        response = self._transport.send(request)
+        attempts = RETRY_ATTEMPTS if retry else 1
+        for attempt in range(1, attempts + 1):
+            try:
+                response = self._transport.send(request)
+            except TransportError:
+                if attempt == attempts:
+                    raise
+            else:
+                if response.status not in RETRYABLE_STATUSES or attempt == attempts:
+                    break
+            self._sleep(RETRY_BACKOFF_S * 2 ** (attempt - 1))
         if response.status >= 400:
             raise ApiError(response.status, response.body.decode(errors="replace"))
         return response
