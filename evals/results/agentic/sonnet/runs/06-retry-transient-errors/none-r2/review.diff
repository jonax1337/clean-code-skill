+@pytest.mark.parametrize("failure", [RequestTimeout("t"), ConnectionFailed("reset"), reply(502), reply(503)])
+def test_get_retries_transient_failures(make_client, sleeps, failure):
+    transport = FakeTransport(failure, failure, reply(200, shipment_payload()))
+
+    shipment = make_client(transport).get_shipment("sh-1")
+
+    assert shipment.id == "sh-1"
+    assert len(transport.requests) == 3
+    assert sleeps == [RETRY_BACKOFF_S, RETRY_BACKOFF_S * 2]
+
+
+def test_gives_up_after_the_attempt_limit(make_client):
+    transport = FakeTransport(reply(503))
+
+    with pytest.raises(ApiError) as raised:
+        make_client(transport).get_shipment("sh-1")
+
+    assert raised.value.status == 503
+    assert len(transport.requests) == RETRY_ATTEMPTS
+
+
+def test_gives_up_on_persistent_transport_errors(make_client):
+    transport = FakeTransport(RequestTimeout("t"))
+
+    with pytest.raises(RequestTimeout):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == RETRY_ATTEMPTS
+
+
+def test_client_errors_are_not_retried(make_client):
+    transport = FakeTransport(reply(404))
+
+    with pytest.raises(ApiError):
+        make_client(transport).get_shipment("sh-1")
+
+    assert len(transport.requests) == 1
+
+
+def test_create_shipment_with_a_key_is_retried(make_client):
+    transport = FakeTransport(RequestTimeout("t"), reply(201, shipment_payload()))
+
+    make_client(transport).create_shipment("A-1001", ADDRESS, idempotency_key="order-A-1001")
+
+    assert len(transport.requests) == 2
+
+
+def test_create_shipment_without_a_key_is_not_retried(make_client):
+    transport = FakeTransport(RequestTimeout("t"), reply(201, shipment_payload()))
+
+    with pytest.raises(RequestTimeout):
