 import assert from "node:assert/strict";
 import { test } from "node:test";
 import { buildCustomerIndex } from "../src/customers.js";
+import { UnknownReferenceError } from "../src/errors.js";
 import { exportInvoices } from "../src/export.js";
 
 const customers = buildCustomerIndex([
   { customerId: "C-1", name: "Acme", country: "DE" },
   { customerId: "C-2", name: "Nordwind, Inc.", country: "US" },
 ]);
 
 const invoices = [
@@ -31,8 +32,18 @@ test("exportInvoices writes the header and one row per invoice in order", () =>
     exportInvoices(invoices, customers),
     ["invoice_id,customer,issued_on,total", 'INV-1,"Nordwind, Inc.",2026-10-01,30.00', "INV-2,Acme,2026-10-02,17.50", ""].join("\n"),
   );
 });
 
 test("exportInvoices of no invoices is just the header", () => {
   assert.equal(exportInvoices([], customers), "invoice_id,customer,issued_on,total\n");
 });
+
+test("exportInvoices reports an invoice whose customer does not exist", () => {
+  const orphan = { ...invoices[0], id: "INV-9", customerId: "C-9" };
+  assert.throws(
+    () => exportInvoices([orphan], customers),
+    (error) =>
+      error instanceof UnknownReferenceError &&
+      error.message === 'Unknown customer "C-9" (referenced by invoice INV-9)',
+  );
+});
diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..c001b2e
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,9 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { loadCustomerRecords } from "../src/sources.js";
+
+test("loadCustomerRecords reads CRM customers under the same customerId as billing customers", () => {
+  const records = loadCustomerRecords("data");
+  const birch = records.find((record) => record.name === "Birch & Co");
+  assert.deepEqual(birch, { customerId: "C-2201", name: "Birch & Co", country: "NL" });
+});
