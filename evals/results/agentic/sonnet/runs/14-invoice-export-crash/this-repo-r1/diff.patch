 import assert from "node:assert/strict";
 import { test } from "node:test";
 import { buildCustomerIndex } from "../src/customers.js";
+import { UnknownReferenceError } from "../src/errors.js";
 import { exportInvoices } from "../src/export.js";
 
 const customers = buildCustomerIndex([
   { customerId: "C-1", name: "Acme", country: "DE" },
   { customerId: "C-2", name: "Nordwind, Inc.", country: "US" },
 ]);
 
 const invoices = [
@@ -31,8 +32,16 @@ test("exportInvoices writes the header and one row per invoice in order", () =>
     exportInvoices(invoices, customers),
     ["invoice_id,customer,issued_on,total", 'INV-1,"Nordwind, Inc.",2026-10-01,30.00', "INV-2,Acme,2026-10-02,17.50", ""].join("\n"),
   );
 });
 
 test("exportInvoices of no invoices is just the header", () => {
   assert.equal(exportInvoices([], customers), "invoice_id,customer,issued_on,total\n");
 });
+
+test("exportInvoices names the invoice whose customer is unknown", () => {
+  const orphan = [{ ...invoices[0], id: "INV-9", customerId: "C-404" }];
+  assert.throws(
+    () => exportInvoices(orphan, customers),
+    (error) => error instanceof UnknownReferenceError && error.message === 'Unknown customer "C-404" (referenced by invoice INV-9)',
+  );
+});
diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..c796a86
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,17 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { loadCustomerRecords } from "../src/sources.js";
+
+test("loadCustomerRecords gives CRM customers the same customerId field as billing customers", () => {
+  const directory = mkdtempSync(join(tmpdir(), "sources-"));
+  writeFileSync(join(directory, "billing-customers.json"), JSON.stringify([{ customerId: "C-1", name: "Acme", country: "DE" }]));
+  writeFileSync(join(directory, "crm-customers.json"), JSON.stringify([{ customer_id: "C-2", name: "Birch", country: "NL" }]));
+
+  assert.deepEqual(loadCustomerRecords(directory), [
+    { customerId: "C-1", name: "Acme", country: "DE" },
+    { customerId: "C-2", name: "Birch", country: "NL" },
+  ]);
+});
