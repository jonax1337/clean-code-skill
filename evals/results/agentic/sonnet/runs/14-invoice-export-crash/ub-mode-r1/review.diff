diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..2330842
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,19 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { buildCustomerIndex } from "../src/customers.js";
+import { exportInvoices } from "../src/export.js";
+import { loadCustomerRecords, loadInvoices } from "../src/sources.js";
+
+test("customers from both systems are keyed by customerId", () => {
+  const records = loadCustomerRecords("data");
+  for (const record of records) {
+    assert.equal(typeof record.customerId, "string", JSON.stringify(record));
+  }
+  assert.equal(buildCustomerIndex(records).get("C-2201").name, "Birch & Co");
+});
+
+test("the real data exports every invoice", () => {
+  const invoices = loadInvoices("data");
+  const csv = exportInvoices(invoices, buildCustomerIndex(loadCustomerRecords("data")));
+  assert.equal(csv.trim().split("\n").length, invoices.length + 1);
+});
