diff --git a/tests/sources.test.js b/tests/sources.test.js
new file mode 100644
index 0000000..e5c115e
--- /dev/null
+++ b/tests/sources.test.js
@@ -0,0 +1,16 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { buildCustomerIndex } from "../src/customers.js";
+import { loadCustomerRecords } from "../src/sources.js";
+
+test("CRM customers (snake_case ids) are indexed by their customer id", () => {
+  const dir = mkdtempSync(join(tmpdir(), "src-"));
+  writeFileSync(join(dir, "billing-customers.json"), JSON.stringify([{ customerId: "C-1", name: "Acme", country: "DE" }]));
+  writeFileSync(join(dir, "crm-customers.json"), JSON.stringify([{ customer_id: "C-2", name: "Birch", country: "NL" }]));
+  const index = buildCustomerIndex(loadCustomerRecords(dir));
+  assert.equal(index.get("C-2")?.name, "Birch");
+  assert.equal(index.get("C-1")?.name, "Acme");
+});
