+
+test("exportInvoices of an invoice with an unknown customer is a data error naming the invoice", () => {
+  const orphan = { ...invoices[0], id: "INV-9", customerId: "C-404" };
+  assert.throws(() => exportInvoices([orphan], customers), {
+    name: "UnknownReferenceError",
+    message: 'Unknown customer "C-404" (referenced by INV-9)',
+  });
+});
