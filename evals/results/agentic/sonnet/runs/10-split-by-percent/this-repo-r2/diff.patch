+        "--percent", "alice=50", "--percent", "bob=30", "--percent", "carol=20",
+    )  # fmt: skip
+    assert code == 0
+    assert out == "added #1: 10.00 for Dinner\n"
+    assert run("balances")[1] == "alice 5.00\nbob -3.00\ncarol -2.00\n"
+
+
+def test_percentages_not_adding_up_are_rejected_and_nothing_is_saved(run):
+    code, _, err = run(
+        "add", "--paid-by", "alice", "--amount", "10", "--description", "x",
+        "--percent", "alice=50", "--percent", "bob=40",
+    )  # fmt: skip
+    assert code == 2
+    assert "100" in err
+    assert run("list")[1] == ""
+
+
+def test_with_and_percent_cannot_be_combined(run, capsys):
