diff --git a/tabtally/splitting.py b/tabtally/splitting.py
index f5739ee..e41c5fe 100644
--- a/tabtally/splitting.py
+++ b/tabtally/splitting.py
@@ -1,11 +1,32 @@
 """Decide how much of an expense each person owes."""
 
 from tabtally.errors import MoneyError
 from tabtally.money import allocate
 
 
+def split_by_percent(cents: int, percents: dict[str, int]) -> dict[str, int]:
+    if not percents:
+        raise MoneyError("no percentages given")
+    if any(pct < 0 for pct in percents.values()):
+        raise MoneyError("percentages must not be negative")
+    total = sum(percents.values())
+    if total != 100:
+        raise MoneyError(f"percentages must add up to 100, got {total}")
+    names = list(percents)
+    return dict(zip(names, allocate(cents, [percents[name] for name in names])))
+
+
+def parse_percent(text: str) -> tuple[str, int]:
+    """Parse NAME=PCT where PCT is a whole number."""
+    name, sep, value = text.partition("=")
+    name, value = name.strip(), value.strip()
+    if not sep or not name or not value.isascii() or not value.isdigit():
+        raise MoneyError(f"expected NAME=PCT with a whole number, got {text!r}")
+    return name, int(value)
+
+
 def split_equally(cents: int, people: list[str]) -> dict[str, int]:
     duplicates = sorted({name for name in people if people.count(name) > 1})
     if duplicates:
         raise MoneyError(f"listed more than once: {', '.join(duplicates)}")
     return dict(zip(people, allocate(cents, [1] * len(people))))
