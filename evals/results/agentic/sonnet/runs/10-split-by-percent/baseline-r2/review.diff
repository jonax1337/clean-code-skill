@@ -56,8 +56,35 @@ def test_bad_amount_is_reported_and_nothing_is_saved(run):
 
 def test_person_listed_twice_is_rejected(run):
     code, _, err = run(
         "add", "--paid-by", "alice", "--amount", "9", "--description", "x", "--with", "bob", "--with", "bob"
     )
     assert code == 2
     assert "bob" in err
     assert run("list")[1] == ""
+
+
+def test_percent_split(run):
+    code, _, _ = run(
+        "add", "--paid-by", "alice", "--amount", "10.00", "--description", "x",
+        "--percent", "alice=50", "--percent", "bob=30", "--percent", "carol=20",
+    )  # fmt: skip
+    assert code == 0
+    assert run("balances")[1] == "alice 5.00\nbob -3.00\ncarol -2.00\n"
+
+
+@pytest.mark.parametrize(
+    "extra",
+    [
+        ["--percent", "bob=50", "--percent", "carol=40"],
+        ["--percent", "bob=50.5", "--percent", "carol=49.5"],
+        ["--percent", "bob", "--percent", "carol=100"],
+        ["--percent", "bob=50", "--percent", "bob=50"],
+        ["--percent", "bob=100", "--with", "carol"],
+        [],
+    ],
+)
+def test_bad_percent_options_are_rejected(run, extra):
+    code, _, err = run("add", "--paid-by", "alice", "--amount", "9", "--description", "x", *extra)
+    assert code == 2
+    assert err.startswith("error:")
+    assert run("list")[1] == ""
