diff --git a/tabtally/splitting.py b/tabtally/splitting.py
index f5739ee..a7f3390 100644
--- a/tabtally/splitting.py
+++ b/tabtally/splitting.py
@@ -1,11 +1,34 @@
 """Decide how much of an expense each person owes."""
 
 from tabtally.errors import MoneyError
 from tabtally.money import allocate
 
 
-def split_equally(cents: int, people: list[str]) -> dict[str, int]:
+def _split_by_weights(cents: int, people: list[str], weights: list[int]) -> dict[str, int]:
     duplicates = sorted({name for name in people if people.count(name) > 1})
     if duplicates:
         raise MoneyError(f"listed more than once: {', '.join(duplicates)}")
-    return dict(zip(people, allocate(cents, [1] * len(people))))
+    return dict(zip(people, allocate(cents, weights)))
+
+
+def split_equally(cents: int, people: list[str]) -> dict[str, int]:
+    return _split_by_weights(cents, people, [1] * len(people))
+
+
+def _parse_percent(entry: str) -> tuple[str, int]:
+    name, separator, text = entry.rpartition("=")
+    if not separator or not name.strip():
+        raise MoneyError(f"expected NAME=PCT: {entry!r}")
+    if not (text.isascii() and text.isdigit()):
+        raise MoneyError(f"percentage must be a whole number: {entry!r}")
+    return name.strip(), int(text)
+
+
+def split_by_percent(cents: int, entries: list[str]) -> dict[str, int]:
+    """Split by NAME=PCT entries; the whole-number percentages must add up to 100."""
+    parsed = [_parse_percent(entry) for entry in entries]
+    people = [name for name, _ in parsed]
+    percents = [percent for _, percent in parsed]
+    if sum(percents) != 100:
+        raise MoneyError(f"percentages must add up to 100, got {sum(percents)}")
+    return _split_by_weights(cents, people, percents)
