 def test_person_listed_twice_is_rejected(run):
     code, _, err = run(
         "add", "--paid-by", "alice", "--amount", "9", "--description", "x", "--with", "bob", "--with", "bob"
     )
     assert code == 2
     assert "bob" in err
     assert run("list")[1] == ""
+
+
+def test_add_records_a_percentage_split(run):
+    code, out, _ = run(
+        "add", "--paid-by", "alice", "--amount", "10.00", "--description", "Rent",
+        "--percent", "alice=50", "--percent", "bob=30", "--percent", "carol=20",
+    )
+    assert code == 0
+    assert out == "added #1: 10.00 for Rent\n"
+    assert run("balances")[1] == "alice 5.00\nbob -3.00\ncarol -2.00\n"
+
+
+@pytest.mark.parametrize(
+    "split",
+    [
+        ["--percent", "bob=50", "--percent", "carol=40"],
+        ["--percent", "bob=fifty"],
+        ["--percent", "bob=12.5"],
+        ["--percent", "bob"],
+        ["--percent", "bob=100", "--with", "carol"],
+        [],
+    ],
+)
+def test_bad_split_options_are_reported_and_nothing_is_saved(run, split):
+    code, _, err = run("add", "--paid-by", "alice", "--amount", "9", "--description", "x", *split)
+    assert code == 2
+    assert err.startswith("error:")
+    assert run("list")[1] == ""
