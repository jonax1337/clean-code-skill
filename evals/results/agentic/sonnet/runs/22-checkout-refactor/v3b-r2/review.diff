+
+
+# Characterization tests: they pin the behavior of process_order before it is refactored.
+
+
+def run(order, inventory, gateway, notifier, coupons, customer=CUSTOMER):
+    return process_order(order, customer, inventory, gateway, notifier, coupons)
+
+
+@pytest.mark.parametrize("quantity", [0, -1])
+def test_non_positive_quantity_is_rejected_before_anything_happens(inventory, gateway, notifier, coupons, quantity):
+    order = make_order(Item("pen", 1, 100), Item("ink", quantity, 100))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for ink"):
+        run(order, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_unknown_coupon_is_rejected_before_stock_is_reserved(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), coupon="NOPE")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: NOPE"):
+        run(order, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+
+
+def test_vip_discount_is_applied(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 4, 1000))
+
+    run(order, inventory, gateway, notifier, coupons, Customer("v@example.com", vip=True))
+
+    # 4000 - 5% (200) + 760 tax + 490 shipping
+    assert order.total_cents == 3800 + 760 + 490
+
+
+def test_vip_discount_applies_on_top_of_the_coupon(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 4, 1000), coupon="SPRING10")
+
+    run(order, inventory, gateway, notifier, coupons, Customer("v@example.com", vip=True))
+
+    # 4000 - 400 (coupon) - 180 (5% of 3600) + 760 tax + 490 shipping
+    assert order.total_cents == 3420 + 760 + 490
+
+
+def test_shipping_is_free_from_the_threshold(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000))
+
+    run(order, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 5000 + 950
+
+
+def test_shipping_is_charged_just_below_the_threshold(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 4999))
+
+    run(order, inventory, gateway, notifier, coupons)
+
+    # tax 949.81 rounds to 950
+    assert order.total_cents == 4999 + 950 + 490
+
+
+def test_shipping_threshold_looks_at_the_discounted_amount(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000), coupon="SPRING10")
+
+    run(order, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 4500 + 950 + 490
+
+
+def test_tax_is_rounded_half_up_per_line(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 150), Item("ink", 1, 50))
+
+    run(order, inventory, gateway, notifier, coupons)
+
+    # 28.5 -> 29 and 9.5 -> 10, not 38 from the summed 200
+    assert order.total_cents == 200 + 39 + 490
+
+
+def test_unknown_country_uses_the_default_tax_rate(inventory, gateway, notifier, coupons):
+    run(make_order(Item("pen", 1, 1000)), inventory, gateway, notifier, coupons, Customer("u@example.com", country="US"))
+
+    assert gateway.charges == [("u@example.com", 1000 + 210 + 490)]
+
+
+def test_partial_reservation_is_rolled_back_when_a_later_item_is_out_of_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 100), Item("ink", 4, 100))
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        run(order, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [("reserve", "pen", 2), ("release", "pen", 2)]
+    assert inventory.available("pen") == 10
+
+
+def test_successful_order_reserves_then_commits_every_item(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 100), Item("ink", 1, 100))
+
+    run(order, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [
+        ("reserve", "pen", 2),
+        ("reserve", "ink", 1),
+        ("commit", "pen", 2),
+        ("commit", "ink", 1),
+    ]
+
+
+def test_declined_payment_releases_every_item_and_keeps_the_coupon(inventory, notifier, coupons):
+    order = make_order(Item("pen", 2, 1000), Item("ink", 1, 1000), coupon="SPRING10")
+
+    with pytest.raises(OrderRejected, match="payment declined: card declined"):
+        run(order, inventory, FakeGateway(decline=True), notifier, coupons)
+
+    assert inventory.log[2:] == [("release", "pen", 2), ("release", "ink", 1)]
+    assert coupons.discount_percent("SPRING10") == 10
+    assert order.total_cents == 0
+
+
+def test_coupon_is_redeemed_only_once_per_order(inventory, gateway, notifier, coupons):
+    run(make_order(Item("pen", 1, 1000), coupon="SPRING10"), inventory, gateway, notifier, coupons)
+    run(make_order(Item("pen", 1, 1000), coupon="SPRING10"), inventory, gateway, notifier, coupons)
+
+    assert coupons.discount_percent("SPRING10") is None
+
+
+def test_failing_receipt_does_not_fail_the_order(inventory, gateway, coupons, caplog):
+    class BrokenNotifier:
+        def send_receipt(self, email, order_id, receipt_id):
+            raise ConnectionError("smtp down")
+
+    order = make_order(Item("pen", 1, 1000))
+
+    receipt_id = run(order, inventory, gateway, BrokenNotifier(), coupons)
+
+    assert (order.status, receipt_id) == ("paid", "rcpt-1")
+    assert "receipt for order 7 could not be sent" in caplog.text
