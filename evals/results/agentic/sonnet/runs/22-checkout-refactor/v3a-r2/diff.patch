+"""Pins down edge cases of process_order that the main checkout tests do not cover."""
+
+import pytest
+
+from shop.checkout import process_order
+from shop.errors import OrderRejected
+from shop.models import Customer, Item, Order
+from tests.conftest import FakeGateway
+
+CUSTOMER = Customer(email="ada@example.com")
+
+
+def make_order(*items: Item, coupon: str | None = None) -> Order:
+    return Order(id=7, items=list(items), coupon=coupon)
+
+
+def test_non_positive_quantity_is_rejected_before_anything_happens(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), Item("ink", 0, 100))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_unknown_coupon_is_rejected_without_touching_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), coupon="NOPE")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: NOPE"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+
+
+def test_vip_discount_applies_after_coupon_discount(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 4, 1000), coupon="SPRING10")
+    vip = Customer(email="ada@example.com", vip=True)
+
+    process_order(order, vip, inventory, gateway, notifier, coupons)
+
+    # 4000 - 400 (coupon) - 180 (5% of 3600) = 3420, tax on undiscounted 4000 = 760, shipping 490
+    assert order.total_cents == 3420 + 760 + 490
+
+
+def test_shipping_is_free_from_the_threshold_on_the_discounted_price(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 5000 + 950
+
+
+def test_shipping_threshold_is_checked_after_discount(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000), coupon="SPRING10")
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 4500 + 950 + 490
+
+
+@pytest.mark.parametrize(
+    ("country", "expected_tax"),
+    [("FR", 200), ("CH", 81), ("US", 210)],
+)
+def test_tax_rate_depends_on_country(inventory, gateway, notifier, coupons, country, expected_tax):
+    order = make_order(Item("pen", 1, 1000))
+    customer = Customer(email="ada@example.com", country=country)
+
+    process_order(order, customer, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 1000 + expected_tax + 490
+
+
+def test_tax_is_rounded_half_up_per_line(inventory, gateway, notifier, coupons):
+    # 19% of 25 = 4.75 -> 5 and 19% of 50 = 9.5 -> 10 (half up); summed unrounded it would be 14
+    order = make_order(Item("pen", 1, 25), Item("pen", 1, 50))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == 75 + 5 + 10 + 490
+
+
+def test_partial_reservation_is_released_when_a_later_item_is_out_of_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 100), Item("ink", 4, 100), coupon="SPRING10")
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [("reserve", "pen", 2), ("release", "pen", 2)]
+    assert coupons.discount_percent("SPRING10") == 10
+    assert gateway.charges == []
+
+
+def test_declined_payment_does_not_redeem_the_coupon(inventory, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), coupon="SPRING10")
+
+    with pytest.raises(OrderRejected):
+        process_order(order, CUSTOMER, inventory, FakeGateway(decline=True), notifier, coupons)
+
+    assert inventory.log == [("reserve", "pen", 1), ("release", "pen", 1)]
+    assert coupons.discount_percent("SPRING10") == 10
+    assert order.total_cents == 0
+
+
+def test_successful_order_commits_stock_in_item_order_and_redeems_coupon(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), Item("ink", 2, 100), coupon="SPRING10")
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [
+        ("reserve", "pen", 1),
+        ("reserve", "ink", 2),
+        ("commit", "pen", 1),
+        ("commit", "ink", 2),
+    ]
+    coupons.redeem("SPRING10")
+    assert coupons.discount_percent("SPRING10") is None
+
+
+def test_failing_receipt_does_not_fail_the_order(inventory, gateway, coupons):
+    class BrokenNotifier:
+        def send_receipt(self, email, order_id, receipt_id):
+            raise RuntimeError("smtp down")
+
+    order = make_order(Item("pen", 1, 100))
+
+    receipt_id = process_order(order, CUSTOMER, inventory, gateway, BrokenNotifier(), coupons)
+
+    assert (order.status, receipt_id) == ("paid", "rcpt-1")
