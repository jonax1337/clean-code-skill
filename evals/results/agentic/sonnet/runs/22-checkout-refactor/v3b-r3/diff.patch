+"""Pins the exact behavior of process_order: pricing rules, ordering of side effects and failure handling."""
+
+import pytest
+
+from shop.checkout import process_order
+from shop.errors import OrderRejected
+from shop.models import Customer, Item, Order
+from tests.conftest import FakeGateway
+
+CUSTOMER = Customer(email="ada@example.com")
+
+
+def make_order(*items: Item, coupon: str | None = None) -> Order:
+    return Order(id=7, items=list(items), coupon=coupon)
+
+
+def total_for(order, inventory, gateway, notifier, coupons, customer=CUSTOMER) -> int:
+    process_order(order, customer, inventory, gateway, notifier, coupons)
+    return order.total_cents
+
+
+@pytest.mark.parametrize("quantity", [0, -1])
+def test_non_positive_quantity_is_rejected_before_anything_happens(quantity, inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), Item("ink", quantity, 100))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_unknown_coupon_is_rejected_without_touching_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), coupon="NOPE")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: NOPE"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_exhausted_coupon_is_rejected(inventory, gateway, notifier, coupons):
+    coupons.redeem("SPRING10")
+    coupons.redeem("SPRING10")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: SPRING10"):
+        process_order(make_order(Item("pen", 1, 100), coupon="SPRING10"), CUSTOMER, inventory, gateway, notifier, coupons)
+
+
+def test_vip_discount_applies_to_the_already_coupon_discounted_amount(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+    order = make_order(Item("pen", 4, 1001), coupon="SPRING10")
+
+    total = total_for(order, inventory, gateway, notifier, coupons, vip)
+
+    subtotal = 4004
+    coupon_discount = subtotal * 10 // 100  # 400
+    vip_discount = (subtotal - coupon_discount) * 5 // 100  # 180
+    tax = 761  # 4004 * 0.19 = 760.76, charged on the undiscounted price
+    assert total == subtotal - coupon_discount - vip_discount + tax + 490
+
+
+def test_vip_without_coupon(inventory, gateway, notifier, coupons):
+    vip = Customer(email="ada@example.com", vip=True)
+
+    total = total_for(make_order(Item("pen", 1, 1000)), inventory, gateway, notifier, coupons, vip)
+
+    assert total == 1000 - 50 + 190 + 490
+
+
+@pytest.mark.parametrize(
+    ("unit_price", "shipping"),
+    [(4999, 490), (5000, 0)],
+)
+def test_free_shipping_starts_at_the_threshold_after_discounts(unit_price, shipping, inventory, gateway, notifier, coupons):
+    country = Customer(email="ada@example.com", country="FR")
+
+    total = total_for(make_order(Item("pen", 1, unit_price)), inventory, gateway, notifier, coupons, country)
+
+    assert total == unit_price + round(unit_price * 0.20) + shipping
+
+
+def test_free_shipping_is_judged_after_the_discount(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 5, 1000), coupon="SPRING10")  # 5000 -> 4500 after coupon
+
+    total = total_for(order, inventory, gateway, notifier, coupons)
+
+    assert total == 4500 + 950 + 490
+
+
+def test_tax_is_rounded_half_up_per_line(inventory, gateway, notifier, coupons):
+    # CH 8.1%: 5 * 0.081 = 0.405 -> 0, 25 * 0.081 = 2.025 -> 2, 50 * 0.081 = 4.05 -> 4, 5 * 10 = 50 -> 4.05
+    swiss = Customer(email="ada@example.com", country="CH")
+    order = make_order(Item("pen", 1, 5), Item("pen", 1, 25), Item("pen", 1, 50))
+
+    total = total_for(order, inventory, gateway, notifier, coupons, swiss)
+
+    assert total == 80 + (0 + 2 + 4) + 490
+
+
+def test_tax_rounds_exact_halves_up(inventory, gateway, notifier, coupons):
+    # DE 19%: 50 * 0.19 = 9.5 -> 10
+    total = total_for(make_order(Item("pen", 1, 50)), inventory, gateway, notifier, coupons)
+
+    assert total == 50 + 10 + 490
+
+
+def test_unknown_country_uses_the_default_rate(inventory, gateway, notifier, coupons):
+    other = Customer(email="ada@example.com", country="US")
+
+    total = total_for(make_order(Item("pen", 1, 1000)), inventory, gateway, notifier, coupons, other)
+
+    assert total == 1000 + 210 + 490
+
+
+def test_out_of_stock_releases_what_was_already_reserved(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 100), Item("ink", 4, 100), Item("pen", 1, 100), coupon="SPRING10")
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [("reserve", "pen", 2), ("release", "pen", 2)]
+    assert inventory.available("pen") == 10
+    assert coupons.discount_percent("SPRING10") == 10
+    assert gateway.charges == []
+
+
+def test_declined_payment_releases_every_item_and_keeps_the_coupon(inventory, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), Item("ink", 1, 100), coupon="SPRING10")
+
+    with pytest.raises(OrderRejected, match="payment declined: card declined"):
+        process_order(order, CUSTOMER, inventory, FakeGateway(decline=True), notifier, coupons)
+
+    assert inventory.log == [
+        ("reserve", "pen", 1),
+        ("reserve", "ink", 1),
+        ("release", "pen", 1),
+        ("release", "ink", 1),
+    ]
+    assert order.total_cents == 0
+    coupons.redeem("SPRING10")
+    assert coupons.discount_percent("SPRING10") == 10
+
+
+def test_successful_payment_commits_stock_and_redeems_the_coupon_once(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), Item("ink", 2, 100), coupon="SPRING10")
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [
+        ("reserve", "pen", 1),
+        ("reserve", "ink", 2),
+        ("commit", "pen", 1),
+        ("commit", "ink", 2),
+    ]
+    coupons.redeem("SPRING10")  # two uses in total, one was consumed by the order
+    assert coupons.discount_percent("SPRING10") is None
+
+
+def test_failing_receipt_does_not_fail_the_order(inventory, gateway, coupons):
+    class BrokenNotifier:
+        def send_receipt(self, email, order_id, receipt_id):
+            raise RuntimeError("smtp down")
+
+    order = make_order(Item("pen", 1, 1000))
+
+    receipt_id = process_order(order, CUSTOMER, inventory, gateway, BrokenNotifier(), coupons)
+
+    assert (receipt_id, order.status, order.total_cents) == ("rcpt-1", "paid", 1000 + 190 + 490)
