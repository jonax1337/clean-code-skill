+def test_vip_discount_stacks_on_the_coupon_discount(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 4, 1000), coupon="SPRING10")
+
+    process_order(order, Customer(email="v@example.com", vip=True), inventory, gateway, notifier, coupons)
+
+    # 4000 - 400 (coupon) - 180 (5% of 3600) = 3420, + 760 tax (on undiscounted) + 490 shipping
+    assert order.total_cents == 3420 + 760 + 490
+
