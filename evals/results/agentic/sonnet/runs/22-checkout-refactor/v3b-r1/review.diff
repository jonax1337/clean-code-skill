@@ -0,0 +1,163 @@
+"""Pins the behavior of process_order's branches that test_checkout.py does not reach."""
+
+import pytest
+
+from shop.checkout import process_order
+from shop.errors import OrderRejected
+from shop.models import Customer, Item, Order
+from tests.conftest import FakeGateway
+
+CUSTOMER = Customer(email="ada@example.com")
+VIP_CUSTOMER = Customer(email="ada@example.com", vip=True)
+
+
+def make_order(*items: Item, coupon: str | None = None) -> Order:
+    return Order(id=7, items=list(items), coupon=coupon)
+
+
+def total_for(order, customer, inventory, gateway, notifier, coupons) -> int:
+    process_order(order, customer, inventory, gateway, notifier, coupons)
+    return order.total_cents
+
+
+@pytest.mark.parametrize("quantity", [0, -1])
+def test_non_positive_quantity_is_rejected_before_anything_happens(
+    inventory, gateway, notifier, coupons, quantity
+):
+    order = make_order(Item("pen", 1, 100), Item("ink", quantity, 100))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_unknown_coupon_is_rejected_without_touching_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), coupon="NOPE")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: NOPE"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_exhausted_coupon_is_rejected(inventory, gateway, notifier, coupons):
+    coupons.redeem("SPRING10")
+    coupons.redeem("SPRING10")
+    order = make_order(Item("pen", 1, 100), coupon="SPRING10")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: SPRING10"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+
+def test_vip_discount_is_five_percent(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 4, 1000))
+
+    # 4000 - 200 + 760 tax (on the undiscounted price) + 490 shipping
+    assert total_for(order, VIP_CUSTOMER, inventory, gateway, notifier, coupons) == 5050
+
+
+def test_vip_discount_applies_after_the_coupon(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 4, 1000), coupon="SPRING10")
+
+    # coupon 400, vip 5% of 3600 = 180 -> 3420 + 760 tax + 490 shipping
+    assert total_for(order, VIP_CUSTOMER, inventory, gateway, notifier, coupons) == 4670
+
+
+def test_shipping_is_free_from_the_threshold_on(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 5000))
+
+    # 5000 + 950 tax, no shipping
+    assert total_for(order, CUSTOMER, inventory, gateway, notifier, coupons) == 5950
+
+
+def test_shipping_is_charged_just_below_the_threshold(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 4999))
+
+    # 4999 + 950 tax (949.81 rounded) + 490 shipping
+    assert total_for(order, CUSTOMER, inventory, gateway, notifier, coupons) == 6439
+
+
+def test_free_shipping_is_decided_after_discounts(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 5200), coupon="SPRING10")
+
+    # 5200 - 520 = 4680 < 5000 -> shipping; tax 988 on 5200
+    assert total_for(order, CUSTOMER, inventory, gateway, notifier, coupons) == 4680 + 988 + 490
+
+
+def test_tax_is_rounded_per_line_half_up(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 50), Item("ink", 1, 50))
+
+    # 9.5 -> 10 per line = 20 (not 19 for the combined 100), + 490 shipping
+    assert total_for(order, CUSTOMER, inventory, gateway, notifier, coupons) == 100 + 20 + 490
+
+
+@pytest.mark.parametrize(
+    ("country", "tax"),
+    [("DE", 190), ("FR", 200), ("CH", 81), ("US", 210)],
+)
+def test_tax_rate_depends_on_the_country(inventory, gateway, notifier, coupons, country, tax):
+    order = make_order(Item("pen", 1, 1000))
+    customer = Customer(email="ada@example.com", country=country)
+
+    assert total_for(order, customer, inventory, gateway, notifier, coupons) == 1000 + tax + 490
+
+
+def test_partial_reservation_is_rolled_back_when_a_later_item_is_out_of_stock(
+    inventory, gateway, notifier, coupons
+):
+    order = make_order(Item("pen", 2, 100), Item("ink", 4, 100))
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [("reserve", "pen", 2), ("release", "pen", 2)]
+    assert inventory.available("pen") == 10
+    assert order.status == "rejected"
+
+
+def test_successful_order_reserves_then_commits_every_item(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 100), Item("ink", 1, 100))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [
+        ("reserve", "pen", 2),
+        ("reserve", "ink", 1),
+        ("commit", "pen", 2),
+        ("commit", "ink", 1),
+    ]
+
+
+def test_declined_payment_releases_every_item_and_keeps_the_coupon(inventory, notifier, coupons):
+    coupons.redeem("SPRING10")  # one use left
+    order = make_order(Item("pen", 2, 100), Item("ink", 1, 100), coupon="SPRING10")
+
+    with pytest.raises(OrderRejected, match="payment declined: card declined"):
+        process_order(order, CUSTOMER, inventory, FakeGateway(decline=True), notifier, coupons)
+
+    assert inventory.log == [
+        ("reserve", "pen", 2),
+        ("reserve", "ink", 1),
+        ("release", "pen", 2),
+        ("release", "ink", 1),
+    ]
+    assert order.total_cents == 0
+    assert coupons.discount_percent("SPRING10") == 10
+
+
+def test_failing_receipt_does_not_fail_the_order(inventory, gateway, coupons):
+    class BrokenNotifier:
+        def send_receipt(self, email, order_id, receipt_id):
+            raise RuntimeError("smtp down")
+
+    order = make_order(Item("pen", 1, 1000))
+
+    receipt_id = process_order(order, CUSTOMER, inventory, gateway, BrokenNotifier(), coupons)
+
+    assert receipt_id == "rcpt-1"
+    assert order.status == "paid"
