+def _validate_items(order: Order) -> None:
+    if not order.items:
+        raise OrderRejected("order has no items")
+    for item in order.items:
+        if item.quantity <= 0:
+            raise OrderRejected(f"invalid quantity for {item.sku}")
+
+
+def _order_total(order: Order, customer: Customer, coupons: CouponBook) -> int:
+    subtotal = sum(item.unit_price_cents * item.quantity for item in order.items)
+    tax = _tax_cents(order.items, tax_rate(customer.country))
+    discount = _discount_cents(subtotal, order.coupon, customer.vip, coupons)
+    shipping = _shipping_cents(subtotal - discount)
+    return subtotal - discount + tax + shipping
+
+
+def _tax_cents(items: list[Item], rate: Decimal) -> int:
+    """Tax is rounded per line, as the accounting export expects, and is charged on the undiscounted line price."""
+    return sum(
+        int((Decimal(item.unit_price_cents * item.quantity) * rate).quantize(Decimal("1"), rounding=ROUND_HALF_UP))
+        for item in items
+    )
+
+
+def _discount_cents(subtotal: int, coupon: str | None, vip: bool, coupons: CouponBook) -> int:
+    """The coupon applies first; the VIP discount is then taken from what is left."""
+    discount = 0
+    if coupon is not None:
+        percent = coupons.discount_percent(coupon)
+        if percent is None:
+            raise OrderRejected(f"invalid coupon: {coupon}")
+        discount += subtotal * percent // 100
+    if vip:
+        discount += (subtotal - discount) * VIP_DISCOUNT_PERCENT // 100
+    return discount
+
+
+def _shipping_cents(discounted_subtotal: int) -> int:
+    return 0 if discounted_subtotal >= FREE_SHIPPING_FROM_CENTS else SHIPPING_CENTS
+
+
+def _reserve_all(items: list[Item], inventory: Inventory) -> list[Item]:
+    """Reserves every item or, if one is out of stock, releases what was reserved and re-raises OutOfStock."""
+    reserved: list[Item] = []
+    try:
+        for item in items:
+            inventory.reserve(item.sku, item.quantity)
+            reserved.append(item)
+    except OutOfStock:
+        _release_all(reserved, inventory)
+        raise
+    return reserved
+
+
+def _release_all(reserved: list[Item], inventory: Inventory) -> None:
+    for item in reserved:
+        inventory.release(item.sku, item.quantity)
+
+
