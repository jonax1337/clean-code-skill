diff --git a/src/userValidation.js b/src/userValidation.js
new file mode 100644
index 0000000..ccb9e84
--- /dev/null
+++ b/src/userValidation.js
@@ -0,0 +1,47 @@
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export const USER_ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ['admin', 'member', 'viewer'];
+
+const valid = (value) => ({ value });
+const invalid = (error) => ({ error });
+
+export function validateEmail(input, { lowercase = true } = {}) {
+  const trimmed = typeof input === 'string' ? input.trim() : '';
+  const email = lowercase ? trimmed.toLowerCase() : trimmed;
+  if (email === '') return invalid('email is required');
+  if (!EMAIL_PATTERN.test(email)) return invalid('email is invalid');
+  return valid(email);
+}
+
+export function validateName(input, { required = true } = {}) {
+  const name = typeof input === 'string' ? input.trim() : '';
+  if (name === '' && required) return invalid('name is required');
+  if (name.length > MAX_NAME_LENGTH) {
+    return invalid(`name must be at most ${MAX_NAME_LENGTH} characters`);
+  }
+  return valid(name);
+}
+
+export function validateRole(input, { allowedRoles = USER_ROLES } = {}) {
+  if (!allowedRoles.includes(input)) return invalid('role is invalid');
+  return valid(input);
+}
+
+/**
+ * Runs each [field, result] pair, collecting error messages and valid values.
+ * Skips nothing: callers decide which fields to include.
+ */
+export function collectResults(resultsByField) {
+  const values = {};
+  const messages = [];
+  for (const [field, result] of Object.entries(resultsByField)) {
+    if (result.error) {
+      messages.push(result.error);
+    } else {
+      values[field] = result.value;
+    }
+  }
+  return { values, messages };
+}
