diff --git a/src/validation.js b/src/validation.js
new file mode 100644
index 0000000..52838c7
--- /dev/null
+++ b/src/validation.js
@@ -0,0 +1,38 @@
+// Single home for user field validation. Each validator returns
+// { value } on success or { error } with the message to report.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+const MAX_NAME_LENGTH = 80;
+
+export function validateEmail(raw, { lowercase = true } = {}) {
+  let email = typeof raw === 'string' ? raw.trim() : '';
+  if (lowercase) {
+    email = email.toLowerCase();
+  }
+  if (email === '') {
+    return { error: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { error: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function validateName(raw, { required = true } = {}) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  if (name === '' && required) {
+    return { error: 'name is required' };
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return { error: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
+
+export function validateRole(role, allowed = ROLES) {
+  if (!allowed.includes(role)) {
+    return { error: 'role is invalid' };
+  }
+  return { value: role };
+}
diff --git a/test/validation.test.js b/test/validation.test.js
new file mode 100644
index 0000000..705948b
--- /dev/null
+++ b/test/validation.test.js
@@ -0,0 +1,22 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { validateEmail, validateName, validateRole } from '../src/validation.js';
+
+test('email is trimmed and lowercased by default, case kept on request', () => {
+  assert.deepEqual(validateEmail('  A@B.io '), { value: 'a@b.io' });
+  assert.deepEqual(validateEmail('A@B.io', { lowercase: false }), { value: 'A@B.io' });
+  assert.deepEqual(validateEmail(' '), { error: 'email is required' });
+  assert.deepEqual(validateEmail('nope'), { error: 'email is invalid' });
+});
+
+test('name is required unless told otherwise and capped at 80 characters', () => {
+  assert.deepEqual(validateName(' Ann '), { value: 'Ann' });
+  assert.deepEqual(validateName(''), { error: 'name is required' });
+  assert.deepEqual(validateName(undefined, { required: false }), { value: '' });
+  assert.deepEqual(validateName('x'.repeat(81)), { error: 'name must be at most 80 characters' });
+});
+
+test('role must be in the allowed list', () => {
+  assert.deepEqual(validateRole('admin'), { value: 'admin' });
+  assert.deepEqual(validateRole('owner', ['admin']), { error: 'role is invalid' });
+});
