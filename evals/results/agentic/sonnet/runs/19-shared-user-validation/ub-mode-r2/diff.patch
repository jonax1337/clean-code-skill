+import { conflict, notFound, ok, validationFailed } from '../response.js';
+import { validateEmail, validateName, validateRole } from '../validation.js';
+
+export function updateUser(store, request) {
+  const user = store.getUser(Number(request.params.id));
+  if (!user) {
+    return notFound('user not found');
+  }
+
+  const body = request.body ?? {};
+  const checks = [
+    ['email', body.email, (v) => validateEmail(v, { lowercase: true })],
+    ['name', body.name, validateName],
+    ['role', body.role, validateRole],
+  ];
+  const messages = [];
+  const changes = {};
+  for (const [field, input, validate] of checks) {
+    if (input === undefined) continue;
+    const result = validate(input);
+    if (result.error) messages.push(result.error);
+    else changes[field] = result.value;
+  }
+
+  if (messages.length > 0) {
+    return validationFailed(messages);
+  }
+  if (Object.keys(changes).length === 0) {
+    return validationFailed(['no fields to update']);
+  }
+
+  const owner = changes.email && store.findUserByEmail(changes.email);
+  if (owner && owner.id !== user.id) {
+    return conflict('email already in use');
+  }
+  return ok(store.updateUser(user.id, changes));
+}
diff --git a/src/validation.js b/src/validation.js
new file mode 100644
index 0000000..0f551a3
--- /dev/null
+++ b/src/validation.js
@@ -0,0 +1,27 @@
+// Single home for user field rules. Each validator returns { value } or { error }.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+const MAX_NAME_LENGTH = 80;
+
+export function validateEmail(input, { lowercase = false } = {}) {
+  let email = typeof input === 'string' ? input.trim() : '';
+  if (lowercase) email = email.toLowerCase();
+  if (email === '') return { error: 'email is required' };
+  if (!EMAIL_PATTERN.test(email)) return { error: 'email is invalid' };
+  return { value: email };
+}
+
+export function validateName(input, { allowEmpty = false } = {}) {
+  const name = typeof input === 'string' ? input.trim() : '';
+  if (name === '' && !allowEmpty) return { error: 'name is required' };
+  if (name.length > MAX_NAME_LENGTH) {
+    return { error: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
+
+export function validateRole(input, { allowed = ROLES } = {}) {
+  if (!allowed.includes(input)) return { error: 'role is invalid' };
+  return { value: input };
+}
diff --git a/test/validation.test.js b/test/validation.test.js
