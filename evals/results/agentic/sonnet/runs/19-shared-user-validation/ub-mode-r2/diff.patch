index 0000000..74b5258
--- /dev/null
+++ b/test/validation.test.js
@@ -0,0 +1,27 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { validateEmail, validateName, validateRole } from '../src/validation.js';
+
+test('email is trimmed, optionally lowercased, and checked', () => {
+  assert.deepEqual(validateEmail('  A@B.io '), { value: 'A@B.io' });
+  assert.deepEqual(validateEmail(' A@B.io ', { lowercase: true }), { value: 'a@b.io' });
+  assert.deepEqual(validateEmail(undefined), { error: 'email is required' });
+  assert.deepEqual(validateEmail(42), { error: 'email is required' });
+  assert.deepEqual(validateEmail('nope'), { error: 'email is invalid' });
+});
+
+test('name is trimmed, length-limited, and required unless allowed empty', () => {
+  assert.deepEqual(validateName('  Ann '), { value: 'Ann' });
+  assert.deepEqual(validateName(''), { error: 'name is required' });
+  assert.deepEqual(validateName('x'.repeat(81)), { error: 'name must be at most 80 characters' });
+  assert.deepEqual(validateName(undefined, { allowEmpty: true }), { value: '' });
+  assert.deepEqual(validateName('x'.repeat(81), { allowEmpty: true }), {
+    error: 'name must be at most 80 characters',
+  });
+});
+
+test('role must be one of the allowed roles', () => {
+  assert.deepEqual(validateRole('admin'), { value: 'admin' });
+  assert.deepEqual(validateRole('root'), { error: 'role is invalid' });
+  assert.deepEqual(validateRole('owner', { allowed: ['admin'] }), { error: 'role is invalid' });
+});
