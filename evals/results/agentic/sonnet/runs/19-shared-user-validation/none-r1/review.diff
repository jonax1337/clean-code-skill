diff --git a/src/validation.js b/src/validation.js
new file mode 100644
index 0000000..575dc97
--- /dev/null
+++ b/src/validation.js
@@ -0,0 +1,47 @@
+// Single home for user field validation. Each validator returns `{ value }` on success or `{ message }` on
+// failure. The message wording is part of the API contract (see docs/api.md).
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const MAX_NAME_LENGTH = 80;
+
+// Emails are stored trimmed and lowercase, for users and invitations alike.
+export function validateEmail(raw) {
+  const email = typeof raw === 'string' ? raw.trim().toLowerCase() : '';
+  if (email === '') {
+    return { message: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { message: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+// With `required: false` a missing or blank name is accepted and stored as an empty string.
+export function validateName(raw, { required = true } = {}) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  if (name === '' && required) {
+    return { message: 'name is required' };
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return { message: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
+
+// `allowed` narrows the accepted roles; `defaultRole` is used when the role is missing, otherwise a missing
+// role is an error only when `required` is set.
+export function validateRole(raw, { allowed = ROLES, defaultRole, required = false } = {}) {
+  if (raw === undefined) {
+    if (defaultRole !== undefined) {
+      return { value: defaultRole };
+    }
+    if (required) {
+      return { message: 'role is required' };
+    }
+  }
+  if (!allowed.includes(raw)) {
+    return { message: 'role is invalid' };
+  }
+  return { value: raw };
+}
