diff --git a/src/validateUser.js b/src/validateUser.js
new file mode 100644
index 0000000..b31635e
--- /dev/null
+++ b/src/validateUser.js
@@ -0,0 +1,49 @@
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ROLES.filter((role) => role !== 'owner');
+
+// Each validator returns { value } for valid input or { message } for invalid input.
+
+export function validateEmail(input) {
+  const email = typeof input === 'string' ? input.trim().toLowerCase() : '';
+  if (email === '') {
+    return { message: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { message: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function validateName(input) {
+  const name = typeof input === 'string' ? input.trim() : '';
+  if (name === '') {
+    return { message: 'name is required' };
+  }
+  return validateNameLength(name);
+}
+
+export function validateOptionalName(input) {
+  const name = typeof input === 'string' ? input.trim() : '';
+  return validateNameLength(name);
+}
+
+export function validateRole(input, allowedRoles = ROLES) {
+  if (!allowedRoles.includes(input)) {
+    return { message: 'role is invalid' };
+  }
+  return { value: input };
+}
+
+export function collectMessages(results) {
+  return results.filter((result) => result.message !== undefined).map((result) => result.message);
+}
+
+function validateNameLength(name) {
+  if (name.length > MAX_NAME_LENGTH) {
+    return { message: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
