diff --git a/test/validateUser.test.js b/test/validateUser.test.js
new file mode 100644
index 0000000..0fda30e
--- /dev/null
+++ b/test/validateUser.test.js
@@ -0,0 +1,43 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import {
+  INVITABLE_ROLES,
+  collectMessages,
+  validateEmail,
+  validateName,
+  validateOptionalName,
+  validateRole,
+} from '../src/validateUser.js';
+
+test('validateEmail trims and lowercases', () => {
+  assert.deepEqual(validateEmail('  Bob@Example.COM '), { value: 'bob@example.com' });
+});
+
+test('validateEmail distinguishes missing from invalid', () => {
+  assert.deepEqual(validateEmail('   '), { message: 'email is required' });
+  assert.deepEqual(validateEmail(42), { message: 'email is required' });
+  assert.deepEqual(validateEmail('bob@example'), { message: 'email is invalid' });
+});
+
+test('validateName accepts exactly 80 characters and rejects 81', () => {
+  assert.deepEqual(validateName('a'.repeat(80)), { value: 'a'.repeat(80) });
+  assert.deepEqual(validateName('a'.repeat(81)), { message: 'name must be at most 80 characters' });
+});
+
+test('validateName requires a non-blank name', () => {
+  assert.deepEqual(validateName('  '), { message: 'name is required' });
+});
+
+test('validateOptionalName allows a blank or missing name but not a long one', () => {
+  assert.deepEqual(validateOptionalName(undefined), { value: '' });
+  assert.deepEqual(validateOptionalName('a'.repeat(81)), { message: 'name must be at most 80 characters' });
+});
+
+test('validateRole checks against the allowed roles', () => {
+  assert.deepEqual(validateRole('owner'), { value: 'owner' });
+  assert.deepEqual(validateRole('owner', INVITABLE_ROLES), { message: 'role is invalid' });
+});
+
+test('collectMessages keeps only failures, in order', () => {
+  assert.deepEqual(collectMessages([{ value: 1 }, { message: 'a' }, { message: 'b' }]), ['a', 'b']);
+});
