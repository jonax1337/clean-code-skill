+
+    process_order(order, Customer(email="a@b.c", vip=True), inventory, gateway, notifier, coupons)
+
+    # discount 500 (coupon) + 225 (5% of 4500); tax 950 on the undiscounted 5000; 4275 is below free shipping
+    assert order.total_cents == 4275 + 950 + 490
