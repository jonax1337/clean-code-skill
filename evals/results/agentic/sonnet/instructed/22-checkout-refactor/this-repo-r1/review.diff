+def test_tax_is_rounded_half_up_per_line(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 250), Item("ink", 1, 250))
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    # 19% of 250 is 47.5 -> 48 per line (96), not 95 for the 500 subtotal
+    assert order.total_cents == 500 + 96 + 490
+
+
+@pytest.mark.parametrize("country, expected_total", [("FR", 1000 + 200 + 490), ("US", 1000 + 210 + 490)])
+def test_tax_rate_depends_on_country(country, expected_total, inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 1000))
+
+    process_order(order, Customer(email="a@b.c", country=country), inventory, gateway, notifier, coupons)
+
+    assert order.total_cents == expected_total
+
+
+def test_vip_discount_applies_after_coupon(inventory, gateway, notifier, coupons):
