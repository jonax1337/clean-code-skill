+fn is_blank(c: u8) -> bool {
+    c == b' ' || c == b'\t'
+}
+
+fn skip_blanks(b: &[u8], mut p: usize) -> usize {
+    while p < b.len() && is_blank(b[p]) {
+        p += 1;
+    }
+    p
+}
+
+/// A token that ends at `end` must be followed by a blank or the end of the line.
+fn expect_separator(b: &[u8], end: usize) -> Result<(), LexError> {
+    match b.get(end) {
+        Some(&c) if !is_blank(c) => Err(LexError::ExpectedSeparator { pos: end }),
+        _ => Ok(()),
+    }
+}
+
+/// Scans a token at `p`, which is not blank and not past the end.
+fn scan_start(src: &str, p: usize) -> Scan<'_> {
+    match src.as_bytes()[p] {
+        b'[' => scan_timestamp(src, p),
+        b'"' => Err(LexError::UnexpectedQuote { pos: p }),
+        b'=' => Err(LexError::EmptyKey { pos: p }),
+        _ => scan_key_or_word(src, p),
+    }
+}
+
+/// `[` text `]`, where `p` is at the `[`.
+fn scan_timestamp(src: &str, p: usize) -> Scan<'_> {
+    let b = src.as_bytes();
+    let start = p + 1;
+    for (i, &c) in b.iter().enumerate().skip(start) {
+        match c {
+            b']' => {
+                expect_separator(b, i + 1)?;
+                return Ok((Token::Timestamp(&src[start..i]), i + 1));
             }
-            _ => None,
+            b'[' => return Err(LexError::NestedBracket { pos: i }),
+            _ => {}
+        }
+    }
+    Err(LexError::UnterminatedTimestamp { pos: p })
+}
+
+/// A run up to a blank or `=`: a key if `=` follows, otherwise a word.
+fn scan_key_or_word(src: &str, p: usize) -> Scan<'_> {
+    let b = src.as_bytes();
+    let mut i = p;
+    while i < b.len() && !is_blank(b[i]) && b[i] != b'=' {
+        if b[i] == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: i });
+        }
+        i += 1;
+    }
+    if i < b.len() && b[i] == b'=' {
+        Ok((Token::Key(&src[p..i]), i + 1))
+    } else {
+        Ok((Token::Word(&src[p..i]), i))
+    }
+}
+
+/// The value after `key=`, where `p` is just past the `=`.
+fn scan_value(src: &str, p: usize) -> Scan<'_> {
+    match src.as_bytes().get(p) {
+        None => Ok((Token::Bare(""), p)),
+        Some(&c) if is_blank(c) => Ok((Token::Bare(""), p)),
+        Some(b'"') => scan_quoted(src, p),
+        Some(_) => scan_bare(src, p),
+    }
+}
+
+/// `"` text `"` with `\"`, `\`, `\n` and `\t` escapes, where `p` is at the opening quote.
+fn scan_quoted(src: &str, p: usize) -> Scan<'_> {
+    let b = src.as_bytes();
+    let start = p + 1;
+    let mut i = start;
+    while i < b.len() {
+        match b[i] {
+            b'"' => {
+                expect_separator(b, i + 1)?;
+                return Ok((Token::Quoted(&src[start..i]), i + 1));
+            }
+            b'\\' => match b.get(i + 1) {
+                Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                Some(_) => return Err(LexError::InvalidEscape { pos: i }),
+                None => break,
+            },
+            _ => i += 1,
+        }
+    }
+    Err(LexError::UnterminatedQuote { pos: p })
+}
+
+/// An unquoted value up to the next blank; it may not contain `"`.
+fn scan_bare(src: &str, p: usize) -> Scan<'_> {
+    let b = src.as_bytes();
+    let mut i = p;
+    while i < b.len() && !is_blank(b[i]) {
+        if b[i] == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: i });
         }
+        i += 1;
     }
+    Ok((Token::Bare(&src[p..i]), i))
 }
diff --git a/tests/tokens.rs b/tests/tokens.rs
index 35088c9..96fcd06 100644
--- a/tests/tokens.rs
+++ b/tests/tokens.rs
@@ -68,8 +68,36 @@ fn unterminated_timestamp_is_an_error() {
 
 #[test]
 fn iteration_stops_after_an_error() {
     let mut stream = tokenize("ok =bad later=1");
     assert_eq!(stream.next(), Some(Ok(Token::Word("ok"))));
     assert_eq!(stream.next(), Some(Err(LexError::EmptyKey { pos: 3 })));
     assert_eq!(stream.next(), None);
 }
+
+#[test]
+fn a_value_may_be_empty() {
+    assert_eq!(
+        tokens("a= b=").unwrap(),
+        vec![Token::Key("a"), Token::Bare(""), Token::Key("b"), Token::Bare("")]
+    );
+}
+
+#[test]
+fn timestamps_and_quoted_values_must_be_followed_by_a_separator() {
+    assert_eq!(tokens("[t]x"), Err(LexError::ExpectedSeparator { pos: 3 }));
+    assert_eq!(tokens("a=\"b\"c"), Err(LexError::ExpectedSeparator { pos: 5 }));
+}
+
+#[test]
+fn malformed_timestamps_are_errors() {
+    assert_eq!(tokens("[a[b]"), Err(LexError::NestedBracket { pos: 2 }));
+}
+
+#[test]
+fn bad_quotes_and_escapes_are_errors() {
+    assert_eq!(tokens("\"x\""), Err(LexError::UnexpectedQuote { pos: 0 }));
+    assert_eq!(tokens("ab\"c"), Err(LexError::UnexpectedQuote { pos: 2 }));
+    assert_eq!(tokens("a=b\"c"), Err(LexError::UnexpectedQuote { pos: 3 }));
+    assert_eq!(tokens(r#"a="\q""#), Err(LexError::InvalidEscape { pos: 3 }));
+    assert_eq!(tokens(r#"a="x\"#), Err(LexError::UnterminatedQuote { pos: 2 }));
+}
