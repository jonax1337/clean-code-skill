+    /// Moves past the closing delimiter at `close`, which must be followed by a blank or the end of the line.
+    fn finish_delimited(&mut self, close: usize) -> Result<(), LexError> {
+        let after = close + 1;
+        match self.src.as_bytes().get(after) {
+            Some(&byte) if !is_blank(byte) => Err(LexError::ExpectedSeparator { pos: after }),
