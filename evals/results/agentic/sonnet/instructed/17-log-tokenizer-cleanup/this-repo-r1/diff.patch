+// The scanners below are the hot path of the import: they work on bytes and
+// allocate nothing. Each one moves `pos` and `state` only when it succeeds;
+// `next` parks the tokenizer after an error.
+impl<'a> Tokens<'a> {
+    fn fail(&mut self) {
+        self.state = State::Failed;
+        self.pos = self.src.len();
+    }
+
+    fn next_field(&mut self) -> Option<Result<Token<'a>, LexError>> {
+        let bytes = self.src.as_bytes();
+        let start = self.skip_blanks();
+        self.pos = start;
+        if start >= bytes.len() {
+            return None;
+        }
+        Some(match bytes[start] {
+            b'[' => self.timestamp(start),
+            b'"' => Err(LexError::UnexpectedQuote { pos: start }),
+            b'=' => Err(LexError::EmptyKey { pos: start }),
+            _ => self.key_or_word(start),
+        })
+    }
+
+    fn next_value(&mut self) -> Result<Token<'a>, LexError> {
+        let start = self.pos;
+        self.state = State::Field;
+        if self.src.as_bytes().get(start) == Some(&b'"') {
+            self.quoted(start)
+        } else {
+            self.bare(start)
+        }
+    }
+
+    fn skip_blanks(&self) -> usize {
+        let bytes = self.src.as_bytes();
+        let mut pos = self.pos;
+        while pos < bytes.len() && is_blank(bytes[pos]) {
+            pos += 1;
+        }
+        pos
+    }
+
+    /// `[` at `open`, then everything up to the closing `]`.
+    fn timestamp(&mut self, open: usize) -> Result<Token<'a>, LexError> {
+        let bytes = self.src.as_bytes();
+        let start = open + 1;
+        let mut close = start;
+        loop {
+            match bytes.get(close) {
+                None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+                Some(b']') => break,
+                Some(b'[') => return Err(LexError::NestedBracket { pos: close }),
+                Some(_) => close += 1,
+            }
+        }
+        self.finish_delimited(close)?;
+        Ok(Token::Timestamp(&self.src[start..close]))
+    }
+
+    /// A run of text that is a key if `=` ends it, and a word otherwise.
+    fn key_or_word(&mut self, start: usize) -> Result<Token<'a>, LexError> {
+        let end = self.unquoted_end(start, |byte| is_blank(byte) || byte == b'=')?;
+        if self.src.as_bytes().get(end) == Some(&b'=') {
+            self.state = State::Value;
+            self.pos = end + 1;
+            Ok(Token::Key(&self.src[start..end]))
+        } else {
+            self.pos = end;
+            Ok(Token::Word(&self.src[start..end]))
+        }
+    }
+
+    /// A value without quotes; empty when `start` is a blank or the end of the line.
+    fn bare(&mut self, start: usize) -> Result<Token<'a>, LexError> {
+        let end = self.unquoted_end(start, is_blank)?;
+        self.pos = end;
+        Ok(Token::Bare(&self.src[start..end]))
+    }
