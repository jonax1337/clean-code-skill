+    /// Index of the first byte from `start` for which `is_end` holds, or the end of the line.
+    /// A `"` before that point is an error.
+    fn unquoted_end(&self, start: usize, is_end: impl Fn(u8) -> bool) -> Result<usize, LexError> {
+        let bytes = self.src.as_bytes();
+        let mut end = start;
+        while end < bytes.len() && !is_end(bytes[end]) {
+            if bytes[end] == b'"' {
+                return Err(LexError::UnexpectedQuote { pos: end });
+            }
+            end += 1;
+        }
+        Ok(end)
+    }
