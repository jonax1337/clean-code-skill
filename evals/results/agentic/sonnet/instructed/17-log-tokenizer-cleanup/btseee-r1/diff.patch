+use crate::error::LexError;
+
+/// One piece of a log line, borrowed from the line itself.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Token<'a> {
+    /// The text between `[` and `]`.
+    Timestamp(&'a str),
+    /// The name in front of `=`.
+    Key(&'a str),
+    /// A double-quoted value without its quotes, escapes left as written.
+    Quoted(&'a str),
+    /// An unquoted value; empty for `key=` followed by a space or the end of the line.
+    Bare(&'a str),
+    /// A run of characters that is neither a timestamp nor part of a pair.
+    Word(&'a str),
+}
+
+/// Where the tokenizer is within a line.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum State {
+    /// At the start of a line or after a complete pair: a timestamp, key or word comes next.
+    BetweenItems,
+    /// Just after `key=`: the value comes next.
+    ExpectValue,
+    /// An error was reported; nothing more is yielded.
+    Failed,
+}
+
+/// A scanned token and the offset where scanning resumes.
+type Scan<'a> = Result<(Token<'a>, usize), LexError>;
+
+/// Streams the tokens of one line. After the first error it yields nothing more.
+#[derive(Debug, Clone)]
+pub struct Tokens<'a> {
+    src: &'a str,
+    pos: usize,
+    state: State,
+}
+
+impl<'a> Tokens<'a> {
+    pub fn new(src: &'a str) -> Self {
+        Tokens { src, pos: 0, state: State::BetweenItems }
+    }
+}
+
+/// Tokenizes one log line without copying any of it.
+pub fn tokenize(line: &str) -> Tokens<'_> {
+    Tokens::new(line)
+}
+
+impl<'a> Iterator for Tokens<'a> {
+    type Item = Result<Token<'a>, LexError>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        let scan = match self.state {
+            State::BetweenItems => {
+                let start = skip_blanks(self.src.as_bytes(), self.pos);
+                if start >= self.src.len() {
+                    self.pos = start;
+                    return None;
+                }
+                scan_item(self.src, start)
+            }
+            State::ExpectValue => scan_value(self.src, self.pos),
+            State::Failed => return None,
+        };
+        Some(match scan {
+            Ok((token, end)) => {
+                self.pos = end;
+                self.state = match token {
+                    Token::Key(_) => State::ExpectValue,
+                    _ => State::BetweenItems,
+                };
+                Ok(token)
+            }
+            Err(error) => {
+                self.pos = self.src.len();
+                self.state = State::Failed;
+                Err(error)
+            }
+        })
+    }
+}
+
+#[inline(always)]
+fn is_blank(byte: u8) -> bool {
+    byte == b' ' || byte == b'\t'
+}
+
+#[inline(always)]
+fn skip_blanks(bytes: &[u8], mut pos: usize) -> usize {
+    while pos < bytes.len() && is_blank(bytes[pos]) {
+        pos += 1;
+    }
+    pos
+}
+
+/// A token must be followed by a blank or the end of the line.
+#[inline(always)]
+fn expect_separator(bytes: &[u8], pos: usize) -> Result<(), LexError> {
+    if pos < bytes.len() && !is_blank(bytes[pos]) {
+        Err(LexError::ExpectedSeparator { pos })
+    } else {
+        Ok(())
+    }
+}
+
+/// Scans the timestamp, key or word that starts at `start`, a non-blank byte.
+#[inline(always)]
+fn scan_item(src: &str, start: usize) -> Scan<'_> {
+    match src.as_bytes()[start] {
+        b'[' => scan_timestamp(src, start),
+        b'"' => Err(LexError::UnexpectedQuote { pos: start }),
+        b'=' => Err(LexError::EmptyKey { pos: start }),
+        _ => scan_key_or_word(src, start),
+    }
+}
+
+#[inline(always)]
+fn scan_timestamp(src: &str, open: usize) -> Scan<'_> {
+    let bytes = src.as_bytes();
+    let text_start = open + 1;
+    let mut i = text_start;
+    loop {
+        match bytes.get(i) {
+            None => return Err(LexError::UnterminatedTimestamp { pos: open }),
+            Some(b']') => break,
+            Some(b'[') => return Err(LexError::NestedBracket { pos: i }),
+            Some(_) => i += 1,
+        }
+    }
+    expect_separator(bytes, i + 1)?;
+    Ok((Token::Timestamp(&src[text_start..i]), i + 1))
+}
+
+#[inline(always)]
+fn scan_key_or_word(src: &str, start: usize) -> Scan<'_> {
+    let bytes = src.as_bytes();
+    let mut i = start;
+    while i < bytes.len() && !is_blank(bytes[i]) && bytes[i] != b'=' {
+        if bytes[i] == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: i });
+        }
+        i += 1;
+    }
+    if i < bytes.len() && bytes[i] == b'=' {
+        Ok((Token::Key(&src[start..i]), i + 1))
+    } else {
+        Ok((Token::Word(&src[start..i]), i))
+    }
+}
+
+/// Scans the value after `key=`, which may be empty, quoted or bare.
+#[inline(always)]
+fn scan_value(src: &str, start: usize) -> Scan<'_> {
+    let bytes = src.as_bytes();
+    match bytes.get(start) {
+        None => Ok(empty_value(src, start)),
+        Some(&byte) if is_blank(byte) => Ok(empty_value(src, start)),
+        Some(b'"') => scan_quoted(src, start),
+        Some(_) => scan_bare(src, start),
+    }
+}
+
+#[inline(always)]
+fn empty_value(src: &str, pos: usize) -> (Token<'_>, usize) {
+    (Token::Bare(&src[pos..pos]), pos)
+}
+
+#[inline(always)]
+fn scan_quoted(src: &str, open: usize) -> Scan<'_> {
+    let bytes = src.as_bytes();
+    let text_start = open + 1;
+    let mut i = text_start;
+    loop {
+        match bytes.get(i) {
+            None => return Err(LexError::UnterminatedQuote { pos: open }),
+            Some(b'"') => break,
+            Some(b'\\') => match bytes.get(i + 1) {
+                None => return Err(LexError::UnterminatedQuote { pos: open }),
+                Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                Some(_) => return Err(LexError::InvalidEscape { pos: i }),
+            },
+            Some(_) => i += 1,
+        }
+    }
+    expect_separator(bytes, i + 1)?;
+    Ok((Token::Quoted(&src[text_start..i]), i + 1))
+}
+
+#[inline(always)]
+fn scan_bare(src: &str, start: usize) -> Scan<'_> {
+    let bytes = src.as_bytes();
+    let mut i = start;
+    while i < bytes.len() && !is_blank(bytes[i]) {
+        if bytes[i] == b'"' {
+            return Err(LexError::UnexpectedQuote { pos: i });
+        }
+        i += 1;
+    }
+    Ok((Token::Bare(&src[start..i]), i))
+}
