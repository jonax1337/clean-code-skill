diff --git a/src/validation.js b/src/validation.js
new file mode 100644
index 0000000..904cec7
--- /dev/null
+++ b/src/validation.js
@@ -0,0 +1,48 @@
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+
+// Each validator returns either { value } or { message }.
+
+export function validateEmail(raw) {
+  const email = typeof raw === 'string' ? raw.trim() : '';
+  if (email === '') {
+    return { message: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { message: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function validateName(raw) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  if (name === '') {
+    return { message: 'name is required' };
+  }
+  return validateNameLength(name);
+}
+
+export function validateOptionalName(raw) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  return validateNameLength(name);
+}
+
+export function validateRole(raw, allowedRoles = ROLES) {
+  if (!allowedRoles.includes(raw)) {
+    return { message: 'role is invalid' };
+  }
+  return { value: raw };
+}
+
+function validateNameLength(name) {
+  if (name.length > MAX_NAME_LENGTH) {
+    return { message: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
+
+export function collectMessages(checks) {
+  return checks.filter((check) => check.message).map((check) => check.message);
+}
diff --git a/test/validation.test.js b/test/validation.test.js
new file mode 100644
index 0000000..eb37262
--- /dev/null
+++ b/test/validation.test.js
@@ -0,0 +1,32 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { collectMessages, validateEmail, validateName, validateOptionalName, validateRole } from '../src/validation.js';
+
+test('validateEmail trims and rejects missing or malformed values', () => {
+  assert.deepEqual(validateEmail(' a@b.co '), { value: 'a@b.co' });
+  assert.deepEqual(validateEmail('  '), { message: 'email is required' });
+  assert.deepEqual(validateEmail(42), { message: 'email is required' });
+  assert.deepEqual(validateEmail('nope'), { message: 'email is invalid' });
+});
+
+test('validateName requires a name of at most 80 characters', () => {
+  assert.deepEqual(validateName(' Ann '), { value: 'Ann' });
+  assert.deepEqual(validateName(''), { message: 'name is required' });
+  assert.deepEqual(validateName('x'.repeat(80)), { value: 'x'.repeat(80) });
+  assert.deepEqual(validateName('x'.repeat(81)), { message: 'name must be at most 80 characters' });
+});
+
+test('validateOptionalName accepts an empty name but still limits length', () => {
+  assert.deepEqual(validateOptionalName(undefined), { value: '' });
+  assert.deepEqual(validateOptionalName('x'.repeat(81)), { message: 'name must be at most 80 characters' });
+});
+
+test('validateRole checks against the allowed roles', () => {
+  assert.deepEqual(validateRole('owner'), { value: 'owner' });
+  assert.deepEqual(validateRole('owner', ['member']), { message: 'role is invalid' });
+  assert.deepEqual(validateRole(null), { message: 'role is invalid' });
+});
+
+test('collectMessages keeps only the failures, in order', () => {
+  assert.deepEqual(collectMessages([{ value: 1 }, { message: 'a' }, { message: 'b' }]), ['a', 'b']);
+});
