new file mode 100644
index 0000000..2ce0657
--- /dev/null
+++ b/src/validateUser.js
@@ -0,0 +1,54 @@
+// The single home for user field rules. Each validator returns
+// { value } when the input is acceptable, or { error } with the message.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const MAX_NAME_LENGTH = 80;
+
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ROLES.filter((role) => role !== 'owner');
+
+export function validateEmail(input, { lowercase = true } = {}) {
+  let email = typeof input === 'string' ? input.trim() : '';
+  if (lowercase) {
+    email = email.toLowerCase();
+  }
+  if (email === '') {
+    return { error: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { error: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function validateName(input, { required = true } = {}) {
+  const name = typeof input === 'string' ? input.trim() : '';
+  if (name === '' && required) {
+    return { error: 'name is required' };
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return { error: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
+
+export function validateRole(input, { allowed = ROLES } = {}) {
+  if (!allowed.includes(input)) {
+    return { error: 'role is invalid' };
+  }
+  return { value: input };
+}
+
+// Runs the checks and splits them into collected values and error messages.
+export function collect(checks) {
+  const values = {};
+  const messages = [];
+  for (const [field, result] of checks) {
+    if (result.error) {
+      messages.push(result.error);
+    } else {
+      values[field] = result.value;
+    }
+  }
+  return { values, messages };
+}
