diff --git a/test/userFields.test.js b/test/userFields.test.js
new file mode 100644
index 0000000..4ab200a
--- /dev/null
+++ b/test/userFields.test.js
@@ -0,0 +1,41 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import {
+  collectResults,
+  validateEmail,
+  validateInvitedRole,
+  validateName,
+  validateOptionalName,
+  validateRole,
+} from '../src/validation/userFields.js';
+
+test('normalises the email to trimmed lowercase', () => {
+  assert.deepEqual(validateEmail('  Ann@Example.com '), { value: 'ann@example.com' });
+});
+
+test('reports a missing and a malformed email differently', () => {
+  assert.equal(validateEmail(undefined).message, 'email is required');
+  assert.equal(validateEmail('nope').message, 'email is invalid');
+});
+
+test('requires a name of at most 80 characters', () => {
+  assert.equal(validateName('  ').message, 'name is required');
+  assert.equal(validateName('x'.repeat(81)).message, 'name must be at most 80 characters');
+});
+
+test('an optional name may be blank but not too long', () => {
+  assert.deepEqual(validateOptionalName(undefined), { value: '' });
+  assert.equal(validateOptionalName('x'.repeat(81)).message, 'name must be at most 80 characters');
+});
+
+test('accepts owner as a role but not as an invited role', () => {
+  assert.deepEqual(validateRole('owner'), { value: 'owner' });
+  assert.equal(validateInvitedRole('owner').message, 'role is invalid');
+  assert.equal(validateInvitedRole(undefined).message, 'role is required');
+});
+
+test('collects values and messages in the given order', () => {
+  const { values, messages } = collectResults({ email: { value: 'a@b.co' }, name: { message: 'name is required' } });
+  assert.deepEqual(messages, ['name is required']);
+  assert.equal(values.email, 'a@b.co');
+});
