diff --git a/src/validation/userFields.js b/src/validation/userFields.js
new file mode 100644
index 0000000..0322a1e
--- /dev/null
+++ b/src/validation/userFields.js
@@ -0,0 +1,55 @@
+// Single home for the rules on user email, name and role. Each validator returns
+// either { value } (normalised) or { message }; messages are part of the API contract.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const ROLES = ['owner', 'admin', 'member', 'viewer'];
+const INVITABLE_ROLES = ROLES.filter((role) => role !== 'owner');
+const MAX_NAME_LENGTH = 80;
+
+export const DEFAULT_ROLE = 'member';
+
+const valid = (value) => ({ value });
+const invalid = (message) => ({ message });
+
+export function validateEmail(raw) {
+  const email = typeof raw === 'string' ? raw.trim().toLowerCase() : '';
+  if (email === '') {
+    return invalid('email is required');
+  }
+  return EMAIL_PATTERN.test(email) ? valid(email) : invalid('email is invalid');
+}
+
+function validateNameLength(name) {
+  return name.length > MAX_NAME_LENGTH
+    ? invalid(`name must be at most ${MAX_NAME_LENGTH} characters`)
+    : valid(name);
+}
+
+export function validateName(raw) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  return name === '' ? invalid('name is required') : validateNameLength(name);
+}
+
+// An invitee fills in their name on acceptance, so blank is stored as ''.
+export function validateOptionalName(raw) {
+  return validateNameLength(typeof raw === 'string' ? raw.trim() : '');
+}
+
+export function validateRole(raw) {
+  return ROLES.includes(raw) ? valid(raw) : invalid('role is invalid');
+}
+
+export function validateInvitedRole(raw) {
+  if (raw === undefined) {
+    return invalid('role is required');
+  }
+  return INVITABLE_ROLES.includes(raw) ? valid(raw) : invalid('role is invalid');
+}
+
+// Takes { field: result } in reporting order; returns the values or every message.
+export function collectResults(results) {
+  const entries = Object.entries(results);
+  const messages = entries.flatMap(([, result]) => (result.message ? [result.message] : []));
+  const values = Object.fromEntries(entries.map(([field, result]) => [field, result.value]));
+  return { values, messages };
+}
