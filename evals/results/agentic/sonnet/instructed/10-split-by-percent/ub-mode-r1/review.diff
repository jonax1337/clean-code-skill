+        (["alice=60", "bob=50"], "100"),
+        (["alice=50", "alice=50"], "alice"),
+        (["alice=5.5", "bob=94.5"], "alice"),
+        (["alice=-10", "bob=110"], "alice"),
+        (["alice", "bob=100"], "alice"),
+        (["=100"], "="),
+    ],
+)
+def test_split_by_percent_rejects_bad_input(specs, message):
