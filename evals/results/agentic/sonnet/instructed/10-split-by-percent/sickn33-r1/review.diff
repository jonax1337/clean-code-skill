diff --git a/tabtally/splitting.py b/tabtally/splitting.py
index f5739ee..5f4d7d4 100644
--- a/tabtally/splitting.py
+++ b/tabtally/splitting.py
@@ -1,11 +1,39 @@
 """Decide how much of an expense each person owes."""
 
 from tabtally.errors import MoneyError
 from tabtally.money import allocate
 
 
+FULL_PERCENT = 100
+
+
 def split_equally(cents: int, people: list[str]) -> dict[str, int]:
+    _reject_duplicates(people)
+    return dict(zip(people, allocate(cents, [1] * len(people))))
+
+
+def split_by_percent(cents: int, percents: dict[str, int]) -> dict[str, int]:
+    """Split cents by whole-number percentages that must add up to 100."""
+    if sum(percents.values()) != FULL_PERCENT:
+        raise MoneyError(f"percentages must add up to {FULL_PERCENT}, got {sum(percents.values())}")
+    return dict(zip(percents, allocate(cents, list(percents.values()))))
+
+
+def parse_percent_option(text: str) -> tuple[str, int]:
+    """Parse "NAME=PCT" into a name and a whole, non-negative percentage."""
+    name, separator, number = text.rpartition("=")
+    if not separator or not name.strip() or not number.isascii() or not number.isdigit():
+        raise MoneyError(f"expected NAME=PCT with a whole number, got {text!r}")
+    return name.strip(), int(number)
+
+
+def percents_from_options(options: list[str]) -> dict[str, int]:
+    pairs = [parse_percent_option(option) for option in options]
+    _reject_duplicates([name for name, _ in pairs])
+    return dict(pairs)
+
+
+def _reject_duplicates(people: list[str]) -> None:
     duplicates = sorted({name for name in people if people.count(name) > 1})
     if duplicates:
         raise MoneyError(f"listed more than once: {', '.join(duplicates)}")
-    return dict(zip(people, allocate(cents, [1] * len(people))))
