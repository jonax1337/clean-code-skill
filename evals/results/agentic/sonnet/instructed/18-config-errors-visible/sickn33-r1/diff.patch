+package com.acme.relay.config;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.net.URI;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class ConfigLoaderTest {
+    private static final String REQUIRED = """
+            upstream.url=https://uplink.example.com/v1/events
+            api.token=s3cret
+            """;
+
+    @TempDir
+    Path dir;
+
+    @Test
+    void loadsEveryKey() throws IOException {
+        Path file = write(REQUIRED + """
+                worker.threads=8
+                queue.capacity=250
+                retry.max-attempts=5
+                request.timeout=2m
+                metrics.enabled=true
+                """);
+
+        ServiceConfig config = ConfigLoader.load(file);
+
+        assertEquals(URI.create("https://uplink.example.com/v1/events"), config.upstream());
+        assertEquals("s3cret", config.apiToken());
+        assertEquals(8, config.workerThreads());
+        assertEquals(250, config.queueCapacity());
+        assertEquals(5, config.retryAttempts());
+        assertEquals(Duration.ofMinutes(2), config.requestTimeout());
+        assertTrue(config.metricsEnabled());
+    }
+
+    @Test
+    void optionalKeysUseTheirDefaults() throws IOException {
+        ServiceConfig config = ConfigLoader.load(write(REQUIRED));
+
+        assertEquals(ConfigLoader.DEFAULT_WORKER_THREADS, config.workerThreads());
+        assertEquals(ConfigLoader.DEFAULT_QUEUE_CAPACITY, config.queueCapacity());
+        assertEquals(ConfigLoader.DEFAULT_RETRY_ATTEMPTS, config.retryAttempts());
+        assertEquals(ConfigLoader.DEFAULT_REQUEST_TIMEOUT, config.requestTimeout());
+        assertFalse(config.metricsEnabled());
+    }
+
+    @Test
+    void parsesAllTimeoutUnits() throws IOException {
+        assertEquals(
+                Duration.ofMillis(500),
+                ConfigLoader.load(write(REQUIRED + "request.timeout=500ms\n")).requestTimeout());
+        assertEquals(
+                Duration.ofSeconds(45),
+                ConfigLoader.load(write(REQUIRED + "request.timeout=45s\n")).requestTimeout());
+    }
+
+    @Test
+    void apiTokenIsRequired() throws IOException {
+        Path file = write("upstream.url=https://uplink.example.com/v1/events\n");
+
+        ConfigException error = assertThrows(ConfigException.class, () -> ConfigLoader.load(file));
+
+        assertTrue(error.getMessage().contains("api.token"));
+    }
+
+    @Test
+    void rejectsWorkerCountThatIsNotANumber() throws IOException {
+        assertRejected(REQUIRED + "worker.threads=4x\n","worker.threads", "'4x'");
+    }
+
+    @Test
+    void rejectsValuesBelowTheMinimum() throws IOException {
+        assertRejected(REQUIRED + "worker.threads=0\n","worker.threads", "at least 1");
+    }
+
+    @Test
+    void rejectsTimeoutWithoutUnit() throws IOException {
+        assertRejected(REQUIRED + "request.timeout=30\n","request.timeout", "'30'");
+    }
+
+    @Test
+    void rejectsNonBooleanMetricsFlag() throws IOException {
+        assertRejected(REQUIRED + "metrics.enabled=yes\n","metrics.enabled", "'yes'");
+    }
+
+    @Test
+    void rejectsUnknownKeys() throws IOException {
+        assertRejected(REQUIRED + "worker.thread=8\n","unknown key 'worker.thread'");
+    }
+
+    @Test
+    void rejectsMissingOrMalformedUpstreamUrl() throws IOException {
+        assertRejected("api.token=x\n", "upstream.url is required");
+        assertRejected("api.token=x\nupstream.url=not a url\n", "upstream.url");
+        assertRejected("api.token=x\nupstream.url=/just/a/path\n", "upstream.url");
+    }
+
+    @Test
+    void rejectsMissingFile() {
+        ConfigException error =
+                assertThrows(ConfigException.class, () -> ConfigLoader.load(dir.resolve("absent.properties")));
+
+        assertTrue(error.getMessage().contains("absent.properties"));
+    }
+
+    @Test
+    void reportsEveryProblemAtOnce() throws IOException {
+        Path file = write("upstream.url=https://x.example\nworker.threads=x\nqueue.capacity=y\n");
+
+        String message = assertThrows(ConfigException.class, () -> ConfigLoader.load(file)).getMessage();
+
+        assertTrue(message.contains("api.token"));
+        assertTrue(message.contains("worker.threads"));
+        assertTrue(message.contains("queue.capacity"));
+    }
+
+    private void assertRejected(String content, String... expectedFragments) throws IOException {
+        Path file = write(content);
+
+        String message = assertThrows(ConfigException.class, () -> ConfigLoader.load(file)).getMessage();
+
+        for (String fragment : expectedFragments) {
+            assertTrue(message.contains(fragment), () -> "expected '" + fragment + "' in: " + message);
+        }
+    }
+
+    private Path write(String content) throws IOException {
+        return Files.writeString(dir.resolve("config.properties"), content);
+    }
+}
