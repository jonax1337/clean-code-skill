+/// A token that ends at `end` (exclusive) must be followed by a blank or the end of the line.
+#[inline(always)]
+fn expect_separator(b: &[u8], end: usize) -> Result<(), LexError> {
+    match b.get(end) {
+        Some(&c) if !is_blank(c) => Err(LexError::ExpectedSeparator { pos: end }),
+        _ => Ok(()),
+    }
