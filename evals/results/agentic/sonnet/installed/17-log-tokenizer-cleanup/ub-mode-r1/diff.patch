+/// A key (`name=`) or a plain word, with `p` at its first character.
+#[inline(always)]
+fn scan_key_or_word<'a>(src: &'a str, p: usize) -> Scan<'a> {
+    let b = src.as_bytes();
+    let mut i = p;
+    while i < b.len() && !is_blank(b[i]) && b[i] != b'=' {
