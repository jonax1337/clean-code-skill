+/// `[timestamp]`, with `p` at the opening bracket.
+#[inline(always)]
+fn scan_timestamp<'a>(src: &'a str, p: usize) -> Scan<'a> {
+    let b = src.as_bytes();
+    let start = p + 1;
+    let mut i = start;
+    loop {
+        match b.get(i) {
+            None => return Err(LexError::UnterminatedTimestamp { pos: p }),
+            Some(b']') => break,
+            Some(b'[') => return Err(LexError::NestedBracket { pos: i }),
+            Some(_) => i += 1,
+        }
+    }
+    expect_separator(b, i + 1)?;
+    Ok((Token::Timestamp(&src[start..i]), i + 1, State::Item))
+}
