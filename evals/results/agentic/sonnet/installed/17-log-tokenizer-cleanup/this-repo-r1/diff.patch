new file mode 100644
index 0000000..89e1e85
--- /dev/null
+++ b/tests/token_edges.rs
@@ -0,0 +1,99 @@
+//! Pins the exact tokens and errors, including positions and the end of the stream after an error.
+use logscan::{tokenize, LexError, Token};
+
+type Item<'a> = Result<Token<'a>, LexError>;
+
+fn all(line: &str) -> Vec<Item<'_>> {
+    tokenize(line).collect()
+}
+
+fn ends_with_error(line: &str, error: LexError) {
+    let items = all(line);
+    assert_eq!(items.last(), Some(&Err(error)), "line {line:?}");
+    assert_eq!(items.iter().filter(|item| item.is_err()).count(), 1, "line {line:?}");
+}
+
+#[test]
+fn timestamp_may_be_empty_or_appear_mid_line() {
+    assert_eq!(all("[]"), vec![Ok(Token::Timestamp(""))]);
+    assert_eq!(
+        all("a [t] b"),
+        vec![Ok(Token::Word("a")), Ok(Token::Timestamp("t")), Ok(Token::Word("b"))]
+    );
+}
+
+#[test]
+fn timestamp_errors() {
+    ends_with_error("[t]x", LexError::ExpectedSeparator { pos: 3 });
+    ends_with_error("[a[b]", LexError::NestedBracket { pos: 2 });
+    ends_with_error("a=1 [t", LexError::UnterminatedTimestamp { pos: 4 });
+    ends_with_error("[", LexError::UnterminatedTimestamp { pos: 0 });
+}
+
+#[test]
+fn timestamp_error_after_valid_tokens_keeps_them() {
+    assert_eq!(
+        all("k=v [t]x"),
+        vec![
+            Ok(Token::Key("k")),
+            Ok(Token::Bare("v")),
+            Err(LexError::ExpectedSeparator { pos: 7 }),
+        ]
+    );
+}
+
+#[test]
+fn key_and_word_errors() {
+    ends_with_error("\"x\"", LexError::UnexpectedQuote { pos: 0 });
+    ends_with_error("x \"y\"", LexError::UnexpectedQuote { pos: 2 });
+    ends_with_error("ab\"c", LexError::UnexpectedQuote { pos: 2 });
+    ends_with_error("  =v", LexError::EmptyKey { pos: 2 });
+}
+
+#[test]
+fn bare_values() {
+    assert_eq!(all("a="), vec![Ok(Token::Key("a")), Ok(Token::Bare(""))]);
+    assert_eq!(
+        all("a= b"),
+        vec![Ok(Token::Key("a")), Ok(Token::Bare("")), Ok(Token::Word("b"))]
+    );
+    assert_eq!(all("a=b=c"), vec![Ok(Token::Key("a")), Ok(Token::Bare("b=c"))]);
+    assert_eq!(all("a=v[x]"), vec![Ok(Token::Key("a")), Ok(Token::Bare("v[x]"))]);
+    ends_with_error("a=b\"c", LexError::UnexpectedQuote { pos: 3 });
+}
+
+#[test]
+fn quoted_values() {
+    assert_eq!(all("a=\"\""), vec![Ok(Token::Key("a")), Ok(Token::Quoted(""))]);
+    assert_eq!(
+        all(r#"a="x y" b=1"#),
+        vec![
+            Ok(Token::Key("a")),
+            Ok(Token::Quoted("x y")),
+            Ok(Token::Key("b")),
+            Ok(Token::Bare("1")),
+        ]
+    );
+    assert_eq!(
+        all(r#"a="\\\"\n\t""#),
+        vec![Ok(Token::Key("a")), Ok(Token::Quoted(r#"\\\"\n\t"#))]
+    );
+}
+
+#[test]
+fn quoted_value_errors() {
+    ends_with_error("a=\"x\"y", LexError::ExpectedSeparator { pos: 5 });
+    ends_with_error(r#"a="x\qy""#, LexError::InvalidEscape { pos: 4 });
+    ends_with_error(r#"a="x\"#, LexError::UnterminatedQuote { pos: 2 });
+    ends_with_error(r#"a="x\""#, LexError::UnterminatedQuote { pos: 2 });
+    ends_with_error("a=\"x", LexError::UnterminatedQuote { pos: 2 });
+}
+
+#[test]
+fn multibyte_text_is_sliced_on_byte_offsets() {
+    assert_eq!(
+        all("é=\"ü\" ö"),
+        vec![Ok(Token::Key("é")), Ok(Token::Quoted("ü")), Ok(Token::Word("ö"))]
+    );
+    ends_with_error("é\"", LexError::UnexpectedQuote { pos: 2 });
+}
