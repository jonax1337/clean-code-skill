 impl<'a> Tokens<'a> {
     pub fn new(src: &'a str) -> Self {
-        Tokens { src, pos: 0, st: 0 }
+        Tokens { src, pos: 0, state: State::Field }
+    }
+
+    #[inline]
+    fn bytes(&self) -> &'a [u8] {
+        self.src.as_bytes()
+    }
+
+    /// Emits `token`, continues at `next_pos` and expects `next_state` next.
+    #[inline]
+    fn emit(&mut self, token: Token<'a>, next_pos: usize, next_state: State) -> Step<'a> {
+        self.pos = next_pos;
+        self.state = next_state;
+        Some(Ok(token))
+    }
+
+    /// Emits `err` and stops tokenizing the rest of the line.
+    #[cold]
+    fn fail(&mut self, err: LexError) -> Step<'a> {
+        self.pos = self.src.len();
+        self.state = State::Failed;
+        Some(Err(err))
+    }
+
+    /// Fails with `ExpectedSeparator` unless a separator (or the end) follows `end`.
+    #[inline]
+    fn check_separator_after(&mut self, end: usize) -> Result<(), Step<'a>> {
+        match self.bytes().get(end + 1) {
+            Some(&c) if !is_separator(c) => Err(self.fail(LexError::ExpectedSeparator { pos: end + 1 })),
+            _ => Ok(()),
+        }
+    }
+
+    /// Reads a timestamp; `start` is the position of its `[`.
+    #[inline]
+    fn lex_timestamp(&mut self, start: usize) -> Step<'a> {
+        let b = self.bytes();
+        let body = start + 1;
+        let mut i = body;
+        loop {
+            match b.get(i) {
+                None => return self.fail(LexError::UnterminatedTimestamp { pos: start }),
+                Some(b']') => break,
+                Some(b'[') => return self.fail(LexError::NestedBracket { pos: i }),
+                Some(_) => i += 1,
+            }
+        }
+        if let Err(step) = self.check_separator_after(i) {
+            return step;
+        }
+        self.emit(Token::Timestamp(&self.src[body..i]), i + 1, State::Field)
+    }
+
+    /// Reads either `key=` (moving on to its value) or a loose word.
+    #[inline]
+    fn lex_key_or_word(&mut self, start: usize) -> Step<'a> {
+        let b = self.bytes();
+        let mut i = start;
+        while let Some(&c) = b.get(i) {
+            if is_separator(c) || c == b'=' {
+                break;
+            }
+            if c == b'"' {
+                return self.fail(LexError::UnexpectedQuote { pos: i });
+            }
+            i += 1;
+        }
+        let text = &self.src[start..i];
+        if b.get(i) == Some(&b'=') {
+            self.emit(Token::Key(text), i + 1, State::Value)
+        } else {
+            self.emit(Token::Word(text), i, State::Field)
+        }
+    }
+
+    #[inline]
+    fn lex_field(&mut self) -> Step<'a> {
+        let b = self.bytes();
+        let mut p = self.pos;
+        while p < b.len() && is_separator(b[p]) {
+            p += 1;
+        }
+        self.pos = p;
+        match b.get(p)? {
+            b'[' => self.lex_timestamp(p),
+            b'"' => self.fail(LexError::UnexpectedQuote { pos: p }),
+            b'=' => self.fail(LexError::EmptyKey { pos: p }),
+            _ => self.lex_key_or_word(p),
+        }
+    }
+
+    #[inline]
+    fn lex_value(&mut self) -> Step<'a> {
+        let p = self.pos;
+        match self.bytes().get(p) {
+            Some(b'"') => self.lex_quoted(p),
+            Some(&c) if !is_separator(c) => self.lex_bare(p),
+            // `key=` followed by a separator or the end of the line.
+            _ => self.emit(Token::Bare(&self.src[p..p]), p, State::Field),
+        }
+    }
+
+    /// Reads a quoted value; `start` is the position of the opening quote.
+    #[inline]
+    fn lex_quoted(&mut self, start: usize) -> Step<'a> {
+        let b = self.bytes();
+        let body = start + 1;
+        let mut i = body;
+        loop {
+            match b.get(i) {
+                None => return self.fail(LexError::UnterminatedQuote { pos: start }),
+                Some(b'"') => break,
+                Some(b'\\') => match b.get(i + 1) {
+                    None => return self.fail(LexError::UnterminatedQuote { pos: start }),
+                    Some(b'"' | b'\\' | b'n' | b't') => i += 2,
+                    Some(_) => return self.fail(LexError::InvalidEscape { pos: i }),
+                },
+                Some(_) => i += 1,
+            }
+        }
+        if let Err(step) = self.check_separator_after(i) {
+            return step;
+        }
+        self.emit(Token::Quoted(&self.src[body..i]), i + 1, State::Field)
+    }
+
+    #[inline]
+    fn lex_bare(&mut self, start: usize) -> Step<'a> {
+        let b = self.bytes();
+        let mut i = start;
+        while let Some(&c) = b.get(i) {
+            if is_separator(c) {
+                break;
+            }
+            if c == b'"' {
+                return self.fail(LexError::UnexpectedQuote { pos: i });
+            }
+            i += 1;
+        }
+        self.emit(Token::Bare(&self.src[start..i]), i, State::Field)
     }
 }
 
+#[inline(always)]
+fn is_separator(c: u8) -> bool {
+    c == b' ' || c == b'\t'
+}
