+/// Where the tokenizer is within a line.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum State {
+    /// Expecting a timestamp, a `key=` or a loose word.
+    Field,
+    /// Just consumed `key=`; expecting its value.
+    Value,
+    /// A lex error was returned; nothing more is produced.
+    Failed,
+}
