diff --git a/src/userValidation.js b/src/userValidation.js
new file mode 100644
index 0000000..cbf2e69
--- /dev/null
+++ b/src/userValidation.js
@@ -0,0 +1,36 @@
+// Single home for the rules on user fields. Each validator returns either
+// `{ value }` (normalized) or `{ message }` (why it was rejected).
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const MAX_NAME_LENGTH = 80;
+
+export function validateEmail(input, { lowercase = true } = {}) {
+  const trimmed = typeof input === 'string' ? input.trim() : '';
+  if (trimmed === '') {
+    return { message: 'email is required' };
+  }
+  const value = lowercase ? trimmed.toLowerCase() : trimmed;
+  if (!EMAIL_PATTERN.test(value)) {
+    return { message: 'email is invalid' };
+  }
+  return { value };
+}
+
+export function validateName(input, { required = true } = {}) {
+  const value = typeof input === 'string' ? input.trim() : '';
+  if (value === '' && required) {
+    return { message: 'name is required' };
+  }
+  if (value.length > MAX_NAME_LENGTH) {
+    return { message: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value };
+}
+
+export function validateRole(input, { allowed = ROLES } = {}) {
+  if (!allowed.includes(input)) {
+    return { message: 'role is invalid' };
+  }
+  return { value: input };
+}
