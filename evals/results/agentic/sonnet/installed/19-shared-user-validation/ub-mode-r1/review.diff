diff --git a/src/validation.js b/src/validation.js
new file mode 100644
index 0000000..892e5db
--- /dev/null
+++ b/src/validation.js
@@ -0,0 +1,39 @@
+// Shared field validation for user-related handlers.
+// Each validator returns either { value } or { error }.
+
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+export const INVITABLE_ROLES = ['admin', 'member', 'viewer'];
+export const MAX_NAME_LENGTH = 80;
+
+export function validateEmail(input, { lowercase = true } = {}) {
+  let email = typeof input === 'string' ? input.trim() : '';
+  if (lowercase) {
+    email = email.toLowerCase();
+  }
+  if (email === '') {
+    return { error: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { error: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function validateName(input, { required = true } = {}) {
+  const name = typeof input === 'string' ? input.trim() : '';
+  if (name === '' && required) {
+    return { error: 'name is required' };
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    return { error: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
+
+export function validateRole(input, { allowed = ROLES } = {}) {
+  if (!allowed.includes(input)) {
+    return { error: 'role is invalid' };
+  }
+  return { value: input };
+}
