diff --git a/src/userFields.js b/src/userFields.js
new file mode 100644
index 0000000..9927ea9
--- /dev/null
+++ b/src/userFields.js
@@ -0,0 +1,44 @@
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+export const ROLES = ['owner', 'admin', 'member', 'viewer'];
+const MAX_NAME_LENGTH = 80;
+
+// Each parser returns { value } for valid input or { error } with the message to report.
+
+export function parseEmail(raw) {
+  const email = typeof raw === 'string' ? raw.trim().toLowerCase() : '';
+  if (email === '') {
+    return { error: 'email is required' };
+  }
+  if (!EMAIL_PATTERN.test(email)) {
+    return { error: 'email is invalid' };
+  }
+  return { value: email };
+}
+
+export function parseName(raw) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  if (name === '') {
+    return { error: 'name is required' };
+  }
+  return checkNameLength(name);
+}
+
+// For callers where a missing or blank name is acceptable and is stored as ''.
+export function parseOptionalName(raw) {
+  const name = typeof raw === 'string' ? raw.trim() : '';
+  return checkNameLength(name);
+}
+
+export function parseRole(raw, allowedRoles = ROLES) {
+  if (!allowedRoles.includes(raw)) {
+    return { error: 'role is invalid' };
+  }
+  return { value: raw };
+}
+
+function checkNameLength(name) {
+  if (name.length > MAX_NAME_LENGTH) {
+    return { error: `name must be at most ${MAX_NAME_LENGTH} characters` };
+  }
+  return { value: name };
+}
