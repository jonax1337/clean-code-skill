 });
 
 test('answers 409 when a user already has the email', () => {
   const result = inviteUser(storeWith(ann()), { body: { email: 'ann@example.com', role: 'member' } });
   assert.equal(result.status, 409);
 });
+
+test('lowercases the email like every other user email', () => {
+  const result = inviteUser(storeWith(ann()), { body: { email: 'ANN@example.com', role: 'member' } });
+  assert.equal(result.status, 409);
+});
+
+test('accepts a missing name and rejects one over 80 characters', () => {
+  const missing = inviteUser(storeWith(), { body: { email: 'bob@example.com', role: 'viewer' } });
+  assert.equal(missing.body.name, '');
+  const tooLong = inviteUser(storeWith(), { body: { email: 'bob@example.com', role: 'viewer', name: 'x'.repeat(81) } });
+  assert.deepEqual(tooLong.body.messages, ['name must be at most 80 characters']);
+});
+
+test('rejects owner as an invited role', () => {
+  const result = inviteUser(storeWith(), { body: { email: 'bob@example.com', role: 'owner' } });
+  assert.deepEqual(result.body.messages, ['role is invalid']);
+});
