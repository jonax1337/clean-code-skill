+"""Pins the exact behaviour of process_order (pricing rules, ordering, failure handling)."""
+
+import pytest
+
+from shop.checkout import process_order
+from shop.coupons import CouponBook
+from shop.errors import OrderRejected
+from shop.models import Customer, Item, Order
+from tests.conftest import FakeGateway
+
+CUSTOMER = Customer(email="ada@example.com")
+
+
+def make_order(*items: Item, coupon: str | None = None) -> Order:
+    return Order(id=7, items=list(items), coupon=coupon)
+
+
+def total_for(order, customer, coupons, inventory, gateway, notifier) -> int:
+    process_order(order, customer, inventory, gateway, notifier, coupons)
+    return order.total_cents
+
+
+def test_non_positive_quantity_is_rejected_before_anything_happens(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), Item("ink", 0, 100))
+
+    with pytest.raises(OrderRejected, match="invalid quantity for ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+
+
+def test_negative_quantity_is_rejected(inventory, gateway, notifier, coupons):
+    with pytest.raises(OrderRejected, match="invalid quantity for pen"):
+        process_order(make_order(Item("pen", -1, 100)), CUSTOMER, inventory, gateway, notifier, coupons)
+
+
+def test_unknown_coupon_is_rejected_without_touching_stock_or_status(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 100), coupon="NOPE")
+
+    with pytest.raises(OrderRejected, match="invalid coupon: NOPE"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert order.status == "new"
+    assert inventory.log == []
+    assert gateway.charges == []
+
+
+def test_exhausted_coupon_is_rejected(inventory, gateway, notifier):
+    coupons = CouponBook({"ONCE": (10, 0)})
+
+    with pytest.raises(OrderRejected, match="invalid coupon: ONCE"):
+        process_order(make_order(Item("pen", 1, 100), coupon="ONCE"), CUSTOMER, inventory, gateway, notifier, coupons)
+
+
+def test_vip_discount_applies_to_subtotal(inventory, gateway, notifier, coupons):
+    vip = Customer(email="v@example.com", vip=True)
+    order = make_order(Item("pen", 2, 1000))
+
+    # 2000 - 5% (100) = 1900; tax on undiscounted 2000 = 380; shipping 490
+    assert total_for(order, vip, coupons, inventory, gateway, notifier) == 1900 + 380 + 490
+
+
+def test_vip_discount_stacks_on_coupon_discount(inventory, gateway, notifier, coupons):
+    vip = Customer(email="v@example.com", vip=True)
+    order = make_order(Item("pen", 4, 1000), coupon="SPRING10")
+
+    # 4000 - 400 (coupon) = 3600; VIP 5% of 3600 = 180; tax 760; shipping 490
+    assert total_for(order, vip, coupons, inventory, gateway, notifier) == 4000 - 400 - 180 + 760 + 490
+
+
+def test_discounts_round_down(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 999), coupon="SPRING10")
+
+    # 999 * 10 // 100 = 99 -> 900; tax round(189.81) = 190; shipping 490
+    assert total_for(order, CUSTOMER, coupons, inventory, gateway, notifier) == 900 + 190 + 490
+
+
+def test_shipping_is_free_from_the_threshold_on_discounted_amount(inventory, gateway, notifier, coupons):
+    exactly = make_order(Item("pen", 1, 5000))
+    assert total_for(exactly, CUSTOMER, coupons, inventory, gateway, notifier) == 5000 + 950
+
+    below = make_order(Item("pen", 1, 4999))
+    assert total_for(below, CUSTOMER, coupons, inventory, gateway, notifier) == 4999 + 950 + 490
+
+
+def test_shipping_threshold_uses_the_discounted_amount(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 1, 5500), coupon="SPRING10")
+
+    # 5500 - 550 = 4950 < 5000, so shipping is charged; tax 1045
+    assert total_for(order, CUSTOMER, coupons, inventory, gateway, notifier) == 4950 + 1045 + 490
+
+
+def test_tax_is_rounded_half_up_per_line(inventory, gateway, notifier, coupons):
+    # 19%: 10 -> 1.9 -> 2, 50 -> 9.5 -> 10 (half up), 3 -> 0.57 -> 1
+    order = make_order(Item("pen", 1, 10), Item("pen", 1, 50), Item("ink", 1, 3))
+
+    assert total_for(order, CUSTOMER, coupons, inventory, gateway, notifier) == 63 + (2 + 10 + 1) + 490
+
+
+@pytest.mark.parametrize(
+    ("country", "tax"),
+    [("DE", 190), ("FR", 200), ("CH", 81), ("US", 210)],
+)
+def test_tax_rate_depends_on_country(country, tax, inventory, gateway, notifier, coupons):
+    customer = Customer(email="a@example.com", country=country)
+    order = make_order(Item("pen", 1, 1000))
+
+    assert total_for(order, customer, coupons, inventory, gateway, notifier) == 1000 + tax + 490
+
+
+def test_partial_reservation_is_released_on_out_of_stock(inventory, gateway, notifier, coupons):
+    order = make_order(Item("pen", 2, 100), Item("ink", 4, 100))
+
+    with pytest.raises(OrderRejected, match="out of stock: ink"):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [("reserve", "pen", 2), ("release", "pen", 2)]
+    assert order.status == "rejected"
+    assert order.total_cents == 0
+
+
+def test_out_of_stock_does_not_redeem_coupon(inventory, gateway, notifier, coupons):
+    order = make_order(Item("ink", 4, 100), coupon="SPRING10")
+
+    with pytest.raises(OrderRejected):
+        process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert coupons.discount_percent("SPRING10") == 10
+    coupons.redeem("SPRING10")
+    assert coupons.discount_percent("SPRING10") == 10  # 2 uses, one left
+
+
+def test_declined_payment_releases_every_item_and_keeps_coupon(inventory, notifier, coupons):
+    order = make_order(Item("pen", 2, 100), Item("ink", 1, 100), coupon="SPRING10")
+
+    with pytest.raises(OrderRejected, match="payment declined: card declined"):
+        process_order(order, CUSTOMER, inventory, FakeGateway(decline=True), notifier, coupons)
+
+    assert inventory.log == [
+        ("reserve", "pen", 2),
+        ("reserve", "ink", 1),
+        ("release", "pen", 2),
+        ("release", "ink", 1),
+    ]
+    assert order.total_cents == 0
+    coupons.redeem("SPRING10")
+    assert coupons.discount_percent("SPRING10") == 10
+
+
+def test_successful_order_reserves_then_commits_each_item_and_redeems_coupon(inventory, gateway, notifier):
+    coupons = CouponBook({"SPRING10": (10, 1)})
+    order = make_order(Item("pen", 2, 100), Item("ink", 1, 100), coupon="SPRING10")
+
+    process_order(order, CUSTOMER, inventory, gateway, notifier, coupons)
+
+    assert inventory.log == [
+        ("reserve", "pen", 2),
+        ("reserve", "ink", 1),
+        ("commit", "pen", 2),
+        ("commit", "ink", 1),
+    ]
+    assert coupons.discount_percent("SPRING10") is None
+
+
+def test_receipt_failure_does_not_fail_the_order(inventory, gateway, coupons, caplog):
+    class BrokenNotifier:
+        def send_receipt(self, email, order_id, receipt_id):
+            raise RuntimeError("smtp down")
+
+    order = make_order(Item("pen", 1, 1000))
+
+    receipt_id = process_order(order, CUSTOMER, inventory, gateway, BrokenNotifier(), coupons)
+
+    assert receipt_id == "rcpt-1"
+    assert order.status == "paid"
+    assert "receipt for order 7 could not be sent" in caplog.text
