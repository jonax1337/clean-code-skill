+package com.acme.relay.config;
+
+import java.io.IOException;
+import java.io.Reader;
+import java.net.URI;
+import java.net.URISyntaxException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Properties;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Reads the relay's configuration from a properties file. Anything wrong with the file is reported, all problems
+ * at once, as a {@link ConfigException}; nothing is silently replaced by a default.
+ */
+public final class ConfigLoader {
+    static final int DEFAULT_WORKER_THREADS = 4;
+    static final int DEFAULT_QUEUE_CAPACITY = 1000;
+    static final int DEFAULT_RETRY_ATTEMPTS = 3;
+    static final Duration DEFAULT_REQUEST_TIMEOUT = Duration.ofSeconds(30);
+
+    private static final Pattern DURATION = Pattern.compile("(\\d+)(ms|s|m)");
+    private static final Set<String> KNOWN_KEYS = Set.of(
+            "upstream.url", "api.token", "worker.threads", "queue.capacity", "retry.max-attempts",
+            "request.timeout", "metrics.enabled");
+
+    private final Properties properties;
+    private final List<String> problems = new ArrayList<>();
+
+    private ConfigLoader(Properties properties) {
+        this.properties = properties;
+    }
+
+    public static ServiceConfig load(Path file) {
+        ConfigLoader loader = new ConfigLoader(read(file));
+        ServiceConfig config = loader.parse();
+        if (!loader.problems.isEmpty()) {
+            throw new ConfigException("in " + file.toAbsolutePath(), loader.problems);
+        }
+        return config;
+    }
+
+    private static Properties read(Path file) {
+        Properties properties = new Properties();
+        try (Reader reader = Files.newBufferedReader(file)) {
+            properties.load(reader);
+        } catch (IOException | IllegalArgumentException e) {
+            throw new ConfigException("Cannot read configuration file " + file.toAbsolutePath() + ": " + e);
+        }
+        return properties;
+    }
+
+    private ServiceConfig parse() {
+        for (String key : properties.stringPropertyNames()) {
+            if (!KNOWN_KEYS.contains(key)) {
+                problems.add("unknown key '" + key + "'");
+            }
+        }
+        return new ServiceConfig(
+                uri("upstream.url"),
+                required("api.token"),
+                intValue("worker.threads", DEFAULT_WORKER_THREADS, 1),
+                intValue("queue.capacity", DEFAULT_QUEUE_CAPACITY, 1),
+                intValue("retry.max-attempts", DEFAULT_RETRY_ATTEMPTS, 0),
+                duration("request.timeout"),
+                bool("metrics.enabled"));
+    }
+
+    /** The trimmed value, or null when the key is absent (an error is recorded if it is present but blank). */
+    private String optional(String key) {
+        String value = properties.getProperty(key);
+        if (value == null) {
+            return null;
+        }
+        if (value.isBlank()) {
+            problems.add(key + " is set but empty; remove it to use the default");
+            return null;
+        }
+        return value.trim();
+    }
+
+    private String required(String key) {
+        String value = properties.getProperty(key);
+        if (value == null || value.isBlank()) {
+            problems.add(key + " is required");
+            return null;
+        }
+        return value.trim();
+    }
+
+    private URI uri(String key) {
+        String raw = required(key);
+        if (raw == null) {
+            return null;
+        }
+        try {
+            URI uri = new URI(raw);
+            if (!uri.isAbsolute() || uri.getHost() == null) {
+                problems.add(key + " must be an absolute URL such as https://host/path, but is '" + raw + "'");
+            }
+            return uri;
+        } catch (URISyntaxException e) {
+            problems.add(key + " is not a valid URL: '" + raw + "'");
+            return null;
+        }
+    }
+
+    private int intValue(String key, int defaultValue, int minimum) {
+        String raw = optional(key);
+        if (raw == null) {
+            return defaultValue;
+        }
+        try {
+            int value = Integer.parseInt(raw);
+            if (value < minimum) {
+                problems.add(key + " must be at least " + minimum + ", but is " + value);
+                return defaultValue;
+            }
+            return value;
+        } catch (NumberFormatException e) {
+            problems.add(key + " must be a whole number, but is '" + raw + "'");
+            return defaultValue;
+        }
+    }
+
+    private Duration duration(String key) {
+        String raw = optional(key);
+        if (raw == null) {
+            return DEFAULT_REQUEST_TIMEOUT;
+        }
+        Matcher matcher = DURATION.matcher(raw);
+        if (matcher.matches()) {
+            try {
+                long amount = Long.parseLong(matcher.group(1));
+                return switch (matcher.group(2)) {
+                    case "ms" -> Duration.ofMillis(amount);
+                    case "s" -> Duration.ofSeconds(amount);
+                    default -> Duration.ofMinutes(amount);
+                };
+            } catch (ArithmeticException | NumberFormatException e) {
+                // falls through to the report below
+            }
+        }
+        problems.add(key + " must be a whole number plus ms, s or m (for example 30s), but is '" + raw + "'");
+        return DEFAULT_REQUEST_TIMEOUT;
+    }
+
+    private boolean bool(String key) {
+        String raw = optional(key);
+        if (raw == null) {
+            return false;
+        }
+        if (!raw.equals("true") && !raw.equals("false")) {
+            problems.add(key + " must be true or false, but is '" + raw + "'");
+        }
+        return Boolean.parseBoolean(raw);
+    }
+}
