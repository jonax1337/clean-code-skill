+package com.acme.relay.config;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.net.URI;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class ConfigLoaderTest {
+    private static final String REQUIRED = """
+            upstream.url=https://uplink.example.com/v1/events
+            api.token=s3cret
+            """;
+
+    @TempDir
+    Path dir;
+
+    @Test
+    void loadsEveryKey() throws IOException {
+        Path file = write(REQUIRED + """
+                worker.threads=8
+                queue.capacity=250
+                retry.max-attempts=5
+                request.timeout=2m
+                metrics.enabled=true
+                """);
+
+        ServiceConfig config = ConfigLoader.load(file);
+
+        assertEquals(URI.create("https://uplink.example.com/v1/events"), config.upstream());
+        assertEquals("s3cret", config.apiToken());
+        assertEquals(8, config.workerThreads());
+        assertEquals(250, config.queueCapacity());
+        assertEquals(5, config.retryAttempts());
+        assertEquals(Duration.ofMinutes(2), config.requestTimeout());
+        assertTrue(config.metricsEnabled());
+    }
+
+    @Test
+    void optionalKeysUseTheirDefaults() throws IOException {
+        ServiceConfig config = ConfigLoader.load(write(REQUIRED));
+
+        assertEquals(ConfigLoader.DEFAULT_WORKER_THREADS, config.workerThreads());
+        assertEquals(ConfigLoader.DEFAULT_QUEUE_CAPACITY, config.queueCapacity());
+        assertEquals(ConfigLoader.DEFAULT_RETRY_ATTEMPTS, config.retryAttempts());
+        assertEquals(ConfigLoader.DEFAULT_REQUEST_TIMEOUT, config.requestTimeout());
+        assertFalse(config.metricsEnabled());
+    }
+
+    @Test
+    void parsesAllTimeoutUnits() throws IOException {
+        assertEquals(
+                Duration.ofMillis(500),
+                ConfigLoader.load(write(REQUIRED + "request.timeout=500ms\n")).requestTimeout());
+        assertEquals(
+                Duration.ofSeconds(45),
+                ConfigLoader.load(write(REQUIRED + "request.timeout=45s\n")).requestTimeout());
+    }
+
+    @Test
+    void apiTokenIsRequired() throws IOException {
+        Path file = write("upstream.url=https://uplink.example.com/v1/events\n");
+
+        ConfigException error = assertThrows(ConfigException.class, () -> ConfigLoader.load(file));
+
+        assertTrue(error.getMessage().contains("api.token"));
+    }
+
+    @Test
+    void rejectsWorkerCountThatIsNotANumber() throws IOException {
+        assertRejected("worker.threads=4x\n", "worker.threads must be a whole number, but is '4x'");
+    }
+
+    @Test
+    void rejectsValuesBelowTheMinimum() throws IOException {
+        assertRejected("worker.threads=0\n", "worker.threads must be at least 1");
+        assertRejected("queue.capacity=-5\n", "queue.capacity must be at least 1");
+        assertRejected("retry.max-attempts=-1\n", "retry.max-attempts must be at least 0");
+    }
+
+    @Test
+    void acceptsZeroRetries() throws IOException {
+        assertEquals(0, ConfigLoader.load(write(REQUIRED + "retry.max-attempts=0\n")).retryAttempts());
+    }
+
+    @Test
+    void rejectsTimeoutWithoutUnit() throws IOException {
+        assertRejected("request.timeout=30\n", "request.timeout must be a whole number plus ms, s or m");
+    }
+
+    @Test
+    void rejectsTimeoutTooLargeToRepresent() throws IOException {
+        assertRejected("request.timeout=99999999999999999999s\n", "request.timeout must be");
+    }
+
+    @Test
+    void rejectsMetricsFlagThatIsNotABoolean() throws IOException {
+        assertRejected("metrics.enabled=yes\n", "metrics.enabled must be true or false, but is 'yes'");
+    }
+
+    @Test
+    void rejectsEmptyOptionalValue() throws IOException {
+        assertRejected("worker.threads=\n", "worker.threads is set but empty");
+    }
+
+    @Test
+    void rejectsUnknownKeys() throws IOException {
+        assertRejected("worker.thread=8\n", "unknown key 'worker.thread'");
+    }
+
+    @Test
+    void rejectsMissingUpstreamUrl() throws IOException {
+        Path file = write("api.token=s3cret\n");
+
+        ConfigException error = assertThrows(ConfigException.class, () -> ConfigLoader.load(file));
+
+        assertTrue(error.getMessage().contains("upstream.url is required"));
+    }
+
+    @Test
+    void rejectsUpstreamThatIsNotAnAbsoluteUrl() throws IOException {
+        Path file = write("api.token=s3cret\nupstream.url=/just/a/path\n");
+
+        ConfigException error = assertThrows(ConfigException.class, () -> ConfigLoader.load(file));
+
